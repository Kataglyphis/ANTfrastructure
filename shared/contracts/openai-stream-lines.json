{
 "_comment": "OpenAI chat stream lines and what a binding's reader makes of them (CON237). Owner decisions 2026-11-19: a chunk that is no JSON fails the stream; an `error:` line is the server's error. Owner decision 2026-11-21 (D8, CON288): any non-null `error` fails the stream, and so does a chunk that is not an object; reading stops at [DONE]; the finish reason keeps its raw value; whole-number float counts count, negative ones are missing. Whole, non-streamed answers are the sibling openai-chat-answers.json.",
 "schema_version": 1,
 "events": "text and thinking are deltas in order, up to [DONE]; finish is the raw finish_reason; usage is [prompt_tokens, completion_tokens], or null unless both are whole, non-negative numbers; done is whether [DONE] arrived. An error is the message when the error is, or holds as `message`, a non-empty string, and the error's JSON text otherwise; a chunk that is not an object fails with its text. Errors match as substrings",
 "cases": [
  {"name": "a delta, its finish with usage, then done",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"Pa\"},\"finish_reason\":null}]}",
             "data: {\"choices\":[{\"delta\":{\"content\":\"ris\"},\"finish_reason\":null}]}",
             "data: {\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":7,\"completion_tokens\":2}}",
             "data: [DONE]"],
   "expect": {"text": "Paris", "thinking": "", "finish": "stop", "usage": [7, 2], "done": true}},
  {"name": "data: without a space, as GenieX sends it",
   "lines": ["data:{\"choices\":[{\"delta\":{\"content\":\"a\"}}]}", "data:[DONE]"],
   "expect": {"text": "a", "thinking": "", "finish": null, "usage": null, "done": true}},
  {"name": "a usage-only chunk with empty choices",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"x\"},\"finish_reason\":\"stop\"}]}",
             "data: {\"choices\":[],\"usage\":{\"prompt_tokens\":2,\"completion_tokens\":5}}",
             "data: [DONE]"],
   "expect": {"text": "x", "thinking": "", "finish": "stop", "usage": [2, 5], "done": true}},
  {"name": "finish reason length",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"cut\"},\"finish_reason\":\"length\"}]}", "data: [DONE]"],
   "expect": {"text": "cut", "thinking": "", "finish": "length", "usage": null, "done": true}},
  {"name": "reasoning deltas under either name, apart from the text",
   "lines": ["data: {\"choices\":[{\"delta\":{\"reasoning_content\":\"think \"}}]}",
             "data: {\"choices\":[{\"delta\":{\"reasoning\":\"more\"}}]}",
             "data: {\"choices\":[{\"delta\":{\"content\":\"answer\"},\"finish_reason\":\"stop\"}]}",
             "data: [DONE]"],
   "expect": {"text": "answer", "thinking": "think more", "finish": "stop", "usage": null, "done": true}},
  {"name": "keep-alive comments and blank lines carry nothing",
   "lines": [": keep-alive", "", "event: message", "data: {\"choices\":[{\"delta\":{\"content\":\"y\"}}]}", "data: [DONE]"],
   "expect": {"text": "y", "thinking": "", "finish": null, "usage": null, "done": true}},
  {"name": "a stream cut before [DONE]",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"half\"}}]}"],
   "expect": {"text": "half", "thinking": "", "finish": null, "usage": null, "done": false}},
  {"name": "an OpenAI error object",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"a\"}}]}", "data: {\"error\":{\"message\":\"model gone\"}}"],
   "expect": {"error": "model gone"}},
  {"name": "a plain-text error, as Ollama sends it",
   "lines": ["data: {\"error\":\"out of memory\"}"],
   "expect": {"error": "out of memory"}},
  {"name": "an error: line without data:",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"a\"}}]}", "error: upstream timed out"],
   "expect": {"error": "upstream timed out"}},
  {"name": "a chunk that is no JSON fails the stream",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"a\"}}]}", "data: {broken"],
   "expect": {"error": "{broken"}},
  {"name": "a line after [DONE] is not read",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"a\"}}]}",
             "data: [DONE]",
             "data: {\"choices\":[{\"delta\":{\"content\":\"late\"}}]}",
             "data: {broken"],
   "expect": {"text": "a", "thinking": "", "finish": null, "usage": null, "done": true}},
  {"name": "a finish reason beyond stop and length keeps its raw value",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"no\"},\"finish_reason\":\"content_filter\"}]}",
             "data: [DONE]"],
   "expect": {"text": "no", "thinking": "", "finish": "content_filter", "usage": null, "done": true}},
  {"name": "usage with total_tokens and reasoning_tokens counts prompt and completion alone",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"4\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":7,\"completion_tokens\":9,\"total_tokens\":16,\"completion_tokens_details\":{\"reasoning_tokens\":4}}}",
             "data: [DONE]"],
   "expect": {"text": "4", "thinking": "", "finish": "stop", "usage": [7, 9], "done": true}},
  {"name": "whole-number float counts count",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"f\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":7.0,\"completion_tokens\":2.0}}",
             "data: [DONE]"],
   "expect": {"text": "f", "thinking": "", "finish": "stop", "usage": [7, 2], "done": true}},
  {"name": "a negative count is missing, and so is the usage",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"n\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":-1,\"completion_tokens\":3}}",
             "data: [DONE]"],
   "expect": {"text": "n", "thinking": "", "finish": "stop", "usage": null, "done": true}},
  {"name": "a null error is no error",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"ok\"},\"finish_reason\":null}],\"error\":null}",
             "data: [DONE]"],
   "expect": {"text": "ok", "thinking": "", "finish": null, "usage": null, "done": true}},
  {"name": "an error object without a message fails with its JSON text",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"a\"}}]}",
             "data: {\"error\":{\"code\":503,\"type\":\"overloaded\"}}"],
   "expect": {"error": "overloaded"}},
  {"name": "a false error fails the stream too",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"a\"},\"finish_reason\":null}],\"error\":false}"],
   "expect": {"error": "false"}},
  {"name": "an empty error string fails the stream too",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"a\"}}]}",
             "data: {\"error\":\"\"}"],
   "expect": {"error": "\"\""}},
  {"name": "an empty error object fails the stream too",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"a\"}}]}",
             "data: {\"error\":{}}"],
   "expect": {"error": "{}"}},
  {"name": "a JSON chunk that is not an object fails the stream",
   "lines": ["data: {\"choices\":[{\"delta\":{\"content\":\"a\"}}]}",
             "data: \"a bare string\""],
   "expect": {"error": "a bare string"}}
 ]
}
