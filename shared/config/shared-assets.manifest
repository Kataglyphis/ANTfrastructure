#
# The ANTfrastructure-owned files a consumer may hold a COPY of, and how each one
# is compared. This is the OWNER side; a consumer declares which of these ids it
# takes in its own .antfrastructure-shared.manifest. See README.md next to this file.
#
# id | canonical path (ANTfrastructure-relative) | default path in the consumer | mode | knob line prefixes (';'-separated)
#
# mode=exact  the copy must match byte for byte (line endings normalised).
# mode=body   the leading prose header is a legitimate per-consumer delta; from
#             the first line of CODE down the copy must match, except that a
#             line starting with a declared knob prefix may carry any value.

clang-format         | shared/config/.clang-format                      | .clang-format                           | exact |
python-wheel-rewrite | shared/python/kataglyphis_wheel.py                | build_support/kataglyphis_wheel.py       | exact |
clang-tidy           | shared/config/.clang-tidy                        | .clang-tidy                             | exact |
cmake-format         | shared/config/.cmake-format.yaml                 | .cmake-format.yaml                      | exact |
gcovr                | shared/config/gcovr.cfg                          | gcovr.cfg                               | exact |
pre-commit           | shared/config/.pre-commit-config.yaml            | .pre-commit-config.yaml                 | exact |
antfrastructure-sh      | shared/linux/templates/antfrastructure.sh           | scripts/linux/lib/antfrastructure.sh       | body  | : "${KATAGLYPHIS_REPO_ROOT_RELATIVE:=
resolve-build-module | shared/windows/templates/Resolve-BuildModule.ps1 | scripts/windows/Resolve-BuildModule.ps1 | body  | $script:RepoRootRelativeToHere
agentic-loop-sh      | shared/agentic-loop/templates/Run-AgenticLoop.sh     | scripts/agentic-loop/Run-AgenticLoop.sh     | body  |
agentic-loop-ps1     | shared/agentic-loop/templates/Invoke-AgenticLoop.ps1 | scripts/agentic-loop/Invoke-AgenticLoop.ps1 | body  |
web-cookie-css       | shared/web/css/cookie.css                         | web/css/cookie.css                          | exact |
web-loading-css      | shared/web/css/loading_animation.css              | web/css/loading_animation.css               | exact |
web-cookies-js       | shared/web/javascript/cookies.js                  | web/javascript/cookies.js                   | exact |
web-utils-js         | shared/web/javascript/utils.js                    | web/javascript/utils.js                     | exact |
web-init-js          | shared/web/javascript/init.js                     | web/javascript/init.js                      | exact |
flutter-web-htaccess | linux/webserver/templates/flutter-web.htaccess    | web/.htaccess                               | body  |
