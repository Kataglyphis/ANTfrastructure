+static migraphx::module create_negative_padded_pool(migraphx::op::pooling_mode mode)
+{
+    migraphx::module m;
+    migraphx::shape s{migraphx::shape::float_type, {1, 1, 2, 2}};
+    std::vector<float> input{-1, -2, -3, -4};
+    auto x = m.add_literal(migraphx::literal{s, input});
+    auto padded = m.add_instruction(
+        migraphx::make_op("pad", {{"pads", {0, 0, 0, 0, 0, 0, 1, 1}}}), x);
+    auto pooled = m.add_instruction(
+        migraphx::make_op("pooling", {{"mode", mode}, {"lengths", {2, 2}}, {"stride", {1, 1}}}),
+        padded);
+    m.add_return({pooled, padded});
+    return m;
+}
+
+TEST_CASE(eliminate_pad_preserves_zero_max_pool_negative)
+{
+    auto actual = create_negative_padded_pool(migraphx::op::pooling_mode::max);
+    migraphx::module expected = actual;
+    run_pass(actual);
+    migraphx::run_passes(
+        expected, {migraphx::normalize_ops{}, migraphx::dead_code_elimination{}});
+    EXPECT(actual == expected);
+}
+
+TEST_CASE(eliminate_pad_keeps_lpnorm_zero_fold)
+{
+    auto actual = create_negative_padded_pool(migraphx::op::pooling_mode::lpnorm);
+    run_pass(actual);
+    auto pooled = std::find_if(actual.begin(), actual.end(), [](const migraphx::instruction& ins) {
+        return ins.name() == "pooling";
+    });
+    EXPECT(pooled != actual.end());
+    if(pooled == actual.end())
+        return;
+    EXPECT(pooled->inputs().front()->name() != "pad");
+    EXPECT(pooled->get_operator().to_value()["padding"].to_vector<std::size_t>() ==
+           std::vector<std::size_t>{0, 0, 1, 1});
+}
+
 int main(int argc, const char* argv[]) { test::run(argc, argv); }
