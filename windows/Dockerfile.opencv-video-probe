# escape=`
# Diagnostic only: asks a built media image which video backends OpenCV really has.
ARG BASE_IMAGE=local/kataglyphis:bk-windows-media-core-ffmpeg
FROM ${BASE_IMAGE} AS probe

# Cache buster: a CACHED run replays an old verdict, and --no-cache would empty the cache mounts.
ARG PROBE_NONCE="0"

# sccache-logs holds the persistent opencv-configure.log, the only record of why configure dropped a backend.
RUN --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/diagnostics/Test-OpencvVideoBackends.ps1,target=C:\bkmnt\Test-OpencvVideoBackends.ps1 `
    & 'C:\bkmnt\Test-OpencvVideoBackends.ps1' -Nonce "${PROBE_NONCE}"
