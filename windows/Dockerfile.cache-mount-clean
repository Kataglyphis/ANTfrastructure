# escape=`
# One-shot sccache mount cleanup, ships nothing; run via Invoke-DiagnosticProbe.ps1 -Dockerfile Dockerfile.cache-mount-clean.
ARG BASE_IMAGE=local/kataglyphis:bk-windows-toolchain
FROM ${BASE_IMAGE} AS probe

# Cache buster: a CACHED run replays an old verdict, and --no-cache would empty the mount being cleaned.
ARG PROBE_NONCE="0"

RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=locked `
    --mount=type=bind,source=windows/scripts/host/Clear-SccacheMount.ps1,target=C:\bkmnt\Clear-SccacheMount.ps1 `
    & 'C:\bkmnt\Clear-SccacheMount.ps1' -Nonce "${PROBE_NONCE}"; `
    Write-Host 'probe complete'
