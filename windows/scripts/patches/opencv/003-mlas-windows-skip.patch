diff --git a/3rdparty/mlas/CMakeLists.txt b/3rdparty/mlas/CMakeLists.txt
index c773ec0..6ba1094 100644
--- a/3rdparty/mlas/CMakeLists.txt
+++ b/3rdparty/mlas/CMakeLists.txt
@@ -84,6 +84,31 @@ if(MLAS_X86_64 OR MLAS_X86 OR MLAS_ARM64 OR MLAS_LOONGARCH64)
   set(_MLAS_REQUIRES_ASM TRUE)
 endif()
 
+# PATCHED (clang-cl Windows lane): the x86/64 vendored kernels are GAS/ELF-only
+# (`.type sym,@function`; no MASM/COFF port exists), and clang-cl IS a working
+# GAS assembler, so the check_language(ASM) guard below does not save us the
+# way it does on MSVC - the .S files then die in the integrated assembler
+# ("expected absolute expression" in SgemmKernelSse2.S). Same fallback as the
+# Android skip above: the DNN module's built-in SGEMM.
+#
+# On ARM64/AArch64 this skip is NOT applied: MLAS's arm64 kernels are C++ NEON
+# (in mlas/lib/arm64/), NOT .S assembly, so the GAS/COFF issue does not arise.
+# The arm64 NEON kernels compile cleanly under clang-cl and provide optimized
+# GEMM/GEMV for cv::dnn instead of the built-in SGEMM fallback.
+#
+# Gated on WIN32 AND (MLAS_X86_64 OR MLAS_X86), deliberately NOT on
+# _MLAS_REQUIRES_ASM alone: upstream derives that from
+# MLAS_X86_64/MLAS_ARM64/..., whose detection does not fire for a
+# CMAKE_SYSTEM_PROCESSOR=ARM64 cross configure. By gating on MLAS_X86_64 OR
+# MLAS_X86 (not MLAS_ARM64), the skip fires only on x86/64 where the .S GAS
+# kernels are the problem; arm64's C++ NEON kernels proceed to build.
+if(WIN32 AND (MLAS_X86_64 OR MLAS_X86))
+  set(OPENCV_DNN_MLAS_SKIP_REASON
+    "vendored GAS kernels have no MASM/COFF port on Windows x86/64"
+    CACHE INTERNAL "" FORCE)
+  message(STATUS "MLAS: skipped on Windows x86/64 (GAS-only kernels; DNN uses its built-in SGEMM)")
+  return()
+endif()
+
 include(CheckLanguage)
 set(MLAS_HAS_ASM FALSE CACHE INTERNAL "" FORCE)
 check_language(ASM)
