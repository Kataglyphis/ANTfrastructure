diff --git a/3rdparty/mlas/CMakeLists.txt b/3rdparty/mlas/CMakeLists.txt
index c773ec0..6ba1094 100644
--- a/3rdparty/mlas/CMakeLists.txt
+++ b/3rdparty/mlas/CMakeLists.txt
@@ -84,6 +84,31 @@ if(MLAS_X86_64 OR MLAS_X86 OR MLAS_ARM64 OR MLAS_LOONGARCH64)
   set(_MLAS_REQUIRES_ASM TRUE)
 endif()
 
+if(WIN32)
+  # PATCHED (clang-cl Windows lane): the vendored kernels are GAS/ELF-only
+  # (`.type sym,@function`; no MASM/COFF port exists), and clang-cl IS a
+  # working GAS assembler, so the check_language(ASM) guard below does not
+  # save us the way it does on MSVC - the .S files then die in the
+  # integrated assembler ("expected absolute expression" in
+  # SgemmKernelSse2.S). Same fallback as the Android skip above: the DNN
+  # module's built-in SGEMM.
+  #
+  # Gated on WIN32 ALONE, deliberately NOT on _MLAS_REQUIRES_ASM: upstream
+  # derives that from MLAS_X86_64/MLAS_ARM64/..., whose detection does not
+  # fire for a CMAKE_SYSTEM_PROCESSOR=ARM64 cross configure. The skip then
+  # silently did nothing on the arm64 lane, MLAS built a C++-only subset
+  # whose objects still referenced the asm kernels, and it failed at LINK:
+  #   undefined symbol: MlasGemvFloatKernel
+  #   undefined symbol: MlasHGemmSupported
+  # amd64 is unchanged: _MLAS_REQUIRES_ASM is TRUE there, so both forms of
+  # the condition fire identically.
+  set(OPENCV_DNN_MLAS_SKIP_REASON
+    "vendored GAS kernels have no MASM/COFF port on Windows"
+    CACHE INTERNAL "" FORCE)
+  message(STATUS "MLAS: skipped on Windows (GAS-only kernels; DNN uses its built-in SGEMM)")
+  return()
+endif()
+
 include(CheckLanguage)
 set(MLAS_HAS_ASM FALSE CACHE INTERNAL "" FORCE)
 check_language(ASM)
