@@ -50,6 +50,15 @@
 #include "opencv2/core/cuda.hpp"
 #include "opencv2/core/cuda_stream_accessor.hpp"
 
+// PATCHED (Windows LLP64): Unix supplies 'ulong' via <sys/types.h>; Windows does not.
+// cudev uses 'ulong' as a scalar element type, and (unlike Unix LP64) int64_t/uint64_t
+// are 'long long'/'unsigned long long' here, so add single-token aliases for them.
+#if defined(_WIN32) || defined(_WIN64)
+typedef unsigned long ulong;
+typedef long long longlong;
+typedef unsigned long long ulonglong;
+#endif
+
 namespace cv { namespace cudev {
 
