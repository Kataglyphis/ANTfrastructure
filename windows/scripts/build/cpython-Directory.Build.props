<?xml version="1.0" encoding="utf-8"?>
<!-- Clang's -march overrides /arch, so dispatched files need their own floor. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PlatformToolset>ClangCL</PlatformToolset>
  </PropertyGroup>
  <Target Name="ApplyCpythonIsaFloor" BeforeTargets="ClCompile"
          Condition="'$(Platform)' == 'x64' and '$(PlatformToolset)' == 'ClangCL'">
    <ItemGroup>
      <ClCompile>
        <AdditionalOptions Condition="'%(ClCompile.EnableEnhancedInstructionSet)' != 'AdvancedVectorExtensions512'">/clang:-march=x86-64-v3 %(ClCompile.AdditionalOptions)</AdditionalOptions>
        <AdditionalOptions Condition="'%(ClCompile.EnableEnhancedInstructionSet)' == 'AdvancedVectorExtensions512'">/clang:-march=x86-64-v4 %(ClCompile.AdditionalOptions)</AdditionalOptions>
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>
