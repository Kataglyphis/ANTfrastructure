#
# Consolidated builder image for all three media run+commit branches
# (windows/build.ps1). A multi-stage build where each stage name matches
# the branch name (media-core / media-litert / media-tvm). The orchestrator
# selects the target stage via `--target <name>`.
#
# Each stage carries its build scripts + patches but runs NO heavy compile,
# so layers commit reliably under Hyper-V `docker build`. The heavy compile
# runs via:
#   docker run --isolation hyperv --cpu-count N --memory Mg <--target image> \
#       pwsh -File C:\temp\scripts\<build-*-all.ps1>
#   docker commit <container> local/kataglyphis:windows-media-<branch>
# because `docker build` on this host is capped at 2 CPUs and process isolation
# cannot commit layers (see build.ps1 CPU note).

ARG BASE_IMAGE=local/kataglyphis:windows-toolchain
# Solve-chain handoff images for the BuildKit media-core lane (see the
# media-core-built-* stages below for why this is four solves, not one).
ARG MEDIA_CORE_ONNX_IMAGE=docker.io/local/kataglyphis:bk-windows-media-core-onnx
ARG MEDIA_CORE_OPENCV_IMAGE=docker.io/local/kataglyphis:bk-windows-media-core-opencv
ARG MEDIA_CORE_FFMPEG_IMAGE=docker.io/local/kataglyphis:bk-windows-media-core-ffmpeg

# ── Common base: shared boilerplate for all three builders ────────────────────
FROM ${BASE_IMAGE} AS common

ARG MEMORY_LIMIT_GB=""
ARG SCCACHE_WEBDAV_ENDPOINT=""

ENV MEMORY_LIMIT_GB="${MEMORY_LIMIT_GB}" `
    SCCACHE_WEBDAV_ENDPOINT="${SCCACHE_WEBDAV_ENDPOINT}"

SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# NO versions.env COPY HERE — deliberately removed 2026-08-07.
#
# It used to sit in this stage so the run-time `load-versions.ps1` would read
# CURRENT values instead of the stale copy baked into the base image. The cost
# was brutal and invisible: this stage is the ancestor of all three branch envs,
# so ANY byte changed in versions.env invalidated all six media compiles — three
# Windows-only toolchain pins triggered a full ~75-minute ONNX rebuild that day.
#
# Versions now arrive as build-args (Get-MediaBranchVersionArg, forwarded by both
# drivers) and are declared as ARG+ENV in each `media-*-env` stage below, so a
# pin only invalidates the branch that actually consumes it. The stale-file trap
# is closed at the other end: `load-versions.ps1` now treats a value already
# present in the process environment as authoritative and never overwrites it,
# so the base-baked file can only fill gaps, never win.
#
# CONSEQUENCE FOR NEW BUILD SCRIPTS: whatever a script reads must be listed in
# Get-MediaBranchVersionArg. Anything missing silently falls back to the
# base-baked value — audit with the greps documented at that function.

# Common modules for all builder images.
COPY windows\scripts\modules\WindowsScripts.Shared.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Common.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Patches.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Cuda.psm1 `
     windows\scripts\modules\WindowsNative.Common.psm1 `
     C:\temp\scripts\modules\

# ── Mount source for the BK lane's module closure ────────────────────────────
# Every compile RUN below needs the SAME five modules (the in-container closure
# of the build scripts: SourceBuild.Common + its imports Shared, Patches, Cuda,
# Native.Common). They used to be listed as five separate --mount lines in each
# of six RUNs — 30 duplicated lines that had to be edited in lockstep.
#
# Cache behaviour is UNCHANGED by this collapse, which is the whole reason it is
# safe: because all six RUNs mount all five files, editing any one of them
# already invalidated all six. Keying them on one stage that contains exactly
# those five files preserves the property that actually matters — edits to the
# ~24 host-only modules (BuildDriver, BuildKit, Flutter, …) still touch nothing
# here, which is why a whole-modules-dir mount remains wrong.
#
# Parent is BASE_IMAGE, not `common`: `common` also carries versions.env, and
# there is no reason for a versions bump to key into this stage.
#
# PATH TRAP (cost a chain launch on 2026-08-07): in `--mount=...,from=<stage>`
# the SOURCE is a Unix-style path inside that stage, with NO drive letter, even
# on Windows containers. `source=C:\bkmods` is normalised to "/C:/bkmods" and
# fails the solve with `failed to calculate checksum ... not found`. The COPY
# destination below stays Windows-shaped (C:\bkmods); only the mount source is
# `/bkmods`. Probed on this host before re-landing: a bare Test-Path assertion
# through the mount returns the file content.
FROM ${BASE_IMAGE} AS buildmods
COPY windows\scripts\modules\WindowsSourceBuild.Common.psm1 `
     windows\scripts\modules\WindowsScripts.Shared.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Patches.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Cuda.psm1 `
     windows\scripts\modules\WindowsNative.Common.psm1 `
     C:\bkmods\

# ── media-core version env — SHARED ANCESTOR of both lanes ───────────────────
# The classic `media-core` stage and the BK compile stages used to declare this
# ARG+ENV block twice (a `media-core-bk` twin), kept in step by sync_versions.py
# and BuildKit.TwinParity.Tests.ps1. Declaring it ONCE and descending both lanes
# from it makes divergence structurally impossible instead of policed.
# The BK lane still must not inherit the classic stage's script/patch COPY
# layers — hence a shared ANCESTOR rather than one lane building on the other.
FROM common AS media-core-env

ARG ONNXRUNTIME_VERSION=v1.28.0
ARG ONNXRUNTIME_GENAI_VERSION=v0.15.0
ARG OPENCV_SOURCE_VERSION=5.x
ARG FFMPEG_VERSION=n9.0
ARG PYAV_VERSION=18.0.0
ARG NV_CODEC_HEADERS_REF=n13.1.15.0
ARG CUDA_ARCHITECTURES="80;86;89;90"
# Consumed by build-opencv-from-source.ps1 (bindings target + its own version
# alias). Present here because the versions.env COPY is gone — see the `common`
# stage comment; a key missing from this list silently uses the base-baked value.
ARG OPENCV_VERSION=5.x
ARG PYTHON_VERSION=3.14.6

# ONE ENV instruction: the classic builder pays a layer per instruction and the
# chain runs against Docker's 125-layer cap (see docs/windows-builds.md § layer
# budget). Plain ARG passthroughs, no interdependency.
ENV ONNXRUNTIME_VERSION="${ONNXRUNTIME_VERSION}" `
    ONNXRUNTIME_GENAI_VERSION="${ONNXRUNTIME_GENAI_VERSION}" `
    OPENCV_SOURCE_VERSION="${OPENCV_SOURCE_VERSION}" `
    FFMPEG_VERSION="${FFMPEG_VERSION}" `
    PYAV_VERSION="${PYAV_VERSION}" `
    NV_CODEC_HEADERS_REF="${NV_CODEC_HEADERS_REF}" `
    CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" `
    OPENCV_VERSION="${OPENCV_VERSION}" `
    PYTHON_VERSION="${PYTHON_VERSION}"

# ── media-core builder, classic lane (ONNX Runtime -> GenAI -> OpenCV -> FFmpeg)
FROM media-core-env AS media-core

COPY windows\scripts\patches\onnxruntime     C:\temp\scripts\patches\onnxruntime
COPY windows\scripts\patches\opencv          C:\temp\scripts\patches\opencv
COPY windows\scripts\patches\opencv_contrib  C:\temp\scripts\patches\opencv_contrib
COPY windows\scripts\patches\ffmpeg          C:\temp\scripts\patches\ffmpeg

COPY windows\scripts\build-onnx-from-source.ps1 `
     windows\scripts\build-onnx-genai-from-source.ps1 `
     windows\scripts\build-opencv-from-source.ps1 `
     windows\scripts\build-ffmpeg-from-source.ps1 `
     windows\scripts\build-media-core-all.ps1 `
     C:\temp\scripts\

# ── media-litert version env — SHARED ANCESTOR of both lanes (see media-core-env)
FROM common AS media-litert-env

ARG LITERT_VERSION=v2.1.6
ARG LITERT_LM_VERSION=0.14.0
# PROTOC_VERSION is NOT independent software: it must match the protobuf runtime
# pinned inside LiteRT-LM (v0.14.0 -> 6.31.1 -> protoc 31.1). A stale value emits
# gencode the pinned headers #error on (bit us 2026-08-03). JRE_VERSION feeds
# Bazel. Both are here because the versions.env COPY is gone — see `common`.
ARG PROTOC_VERSION=31.1
ARG JRE_VERSION=21

ENV LITERT_VERSION="${LITERT_VERSION}" `
    LITERT_LM_VERSION="${LITERT_LM_VERSION}" `
    PROTOC_VERSION="${PROTOC_VERSION}" `
    JRE_VERSION="${JRE_VERSION}"

# ── media-litert builder, classic lane (LiteRT -> LiteRT-LM) ─────────────────
FROM media-litert-env AS media-litert

# LiteRT-LM's Windows shims (POSIX headers + CRT-compat source) and CMake patch
# snippets -- the build script stages them from these $PSScriptRoot-relative dirs.
COPY windows\scripts\shims C:\temp\scripts\shims
COPY windows\scripts\patches\litert-lm C:\temp\scripts\patches\litert-lm

COPY windows\scripts\build-litert-from-source.ps1 `
     windows\scripts\build-litert-lm-from-source.ps1 `
     windows\scripts\litert-lm-export-bridge.ps1 `
     windows\scripts\build-litert-all.ps1 `
     windows\scripts\debug-litertlm-link.ps1 `
     C:\temp\scripts\

# ── media-tvm version env — SHARED ANCESTOR of both lanes (see media-core-env)
FROM common AS media-tvm-env

ARG TVM_REF=v0.25.0
ARG IREE_VERSION=v3.11.0

ENV TVM_REF="${TVM_REF}" `
    IREE_VERSION="${IREE_VERSION}"

# ── media-tvm builder, classic lane (TVM -> IREE) ────────────────────────────
FROM media-tvm-env AS media-tvm

COPY windows\scripts\patches\iree C:\temp\scripts\patches\iree

COPY windows\scripts\build-tvm-from-source.ps1 `
     windows\scripts\build-iree-from-source.ps1 `
     windows\scripts\build-media-tvm-all.ps1 `
     C:\temp\scripts\

# ── BuildKit lane (buildctl --opt target=media-<branch>-built) ───────────────
# Under buildkitd/containerd this host commits PROCESS-isolated layers and RUN
# steps see all host CPUs, so each branch compile is a plain LAYER — no
# run+commit. The classic docker lane always passes --target media-<branch>
# (build.ps1 Get-MediaBranchSpecs) and never executes these RUNs.
#
# BIND-MOUNTED SCRIPTS, NOT COPYs (2026-08-04): the *-bk stages below carry NO
# script/patch COPY layers — every RUN bind-mounts exactly its transitive
# script closure from the build context at C:\bkmnt (single-file mounts probed
# working on WCOW buildkitd v0.32). Cache consequence: editing a build script
# re-runs ONLY the RUNs that mount it — an OpenCV script fix no longer
# invalidates the 75-minute ONNX layer (with COPY layers it invalidated every
# RUN downstream of the COPY). Modules are mounted PER FILE too (the in-
# container closure is exactly: SourceBuild.Common + its imports Shared,
# SourceBuild.Patches, SourceBuild.Cuda, Native.Common — plus Installer.Common
# for GStreamer in the merge builder): a whole-dir modules/ mount let edits to
# the 24 host-only modules (BuildDriver, BuildKit, Flutter, …) bust every
# compile RUN in the chain. load-versions.ps1 is mounted into every BUILD run
# so Initialize-SourceBuildScript re-reads the freshly COPY'd versions.env
# instead of silently falling back to the base image's baked Machine env
# (stale after a versions.env edit + -Stages media iteration). The wrappers
# receive -ScriptDir C:\bkmnt so chain + leaf scripts resolve
# modules/patches/shims via their usual $PSScriptRoot-relative paths.
#
# DIRECT SOLVES (de-warmed 2026-08-06, round 2): every library layer builds
# AND exports in one plain RUN. The former warm/materialize pairs existed
# for the ExportLayer-0x3 defect — ROOT CAUSE: the runhcs shim's hardcoded
# 30s tearDownTimeout terminated the measured ~117s heavy-churn silo
# teardown mid-hive-flush, permanently poisoning the scratch. FIXED by the
# patched shim (45min timeouts) in Stevedore\bin — proven by 3x consecutive
# direct OpenCV finalizes (docs/windows-builds.md § roadmap "DEFECT
# SOLVED", incl. the maintenance rule: Stevedore updates overwrite the
# patched binary). If the canary ever 0x3s again (e.g. shim reverted),
# restore the warm/materialize pattern from git history (c9586c1^) —
# bk-warm.ps1/bk-materialize.ps1 and the handoff helpers remain in the
# tree for exactly that case.

# The BK compile stages descend from the SHARED media-core-env ancestor — the
# former `media-core-bk` ENV twin (and the sync_versions.py bookkeeping it
# required) is gone; see media-core-env above.
FROM media-core-env AS media-core-built-onnx
RUN --mount=type=bind,source=windows/scripts/build-media-core-all.ps1,target=C:\bkmnt\build-media-core-all.ps1 `
    --mount=type=bind,source=windows/scripts/build-onnx-from-source.ps1,target=C:\bkmnt\build-onnx-from-source.ps1 `
    --mount=type=bind,source=windows/scripts/load-versions.ps1,target=C:\bkmnt\load-versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/patches/onnxruntime,target=C:\bkmnt\patches\onnxruntime `
    & 'C:\bkmnt\build-media-core-all.ps1' -Until 'ONNX Runtime' -ScriptDir 'C:\bkmnt' -ScrubAfter

FROM ${MEDIA_CORE_ONNX_IMAGE} AS media-core-built-opencv
RUN --mount=type=bind,source=windows/scripts/build-media-core-all.ps1,target=C:\bkmnt\build-media-core-all.ps1 `
    --mount=type=bind,source=windows/scripts/build-opencv-from-source.ps1,target=C:\bkmnt\build-opencv-from-source.ps1 `
    --mount=type=bind,source=windows/scripts/load-versions.ps1,target=C:\bkmnt\load-versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/patches/opencv,target=C:\bkmnt\patches\opencv `
    --mount=type=bind,source=windows/scripts/patches/opencv_contrib,target=C:\bkmnt\patches\opencv_contrib `
    & 'C:\bkmnt\build-media-core-all.ps1' -ResumeFrom 'OpenCV' -Until 'OpenCV' -ScriptDir 'C:\bkmnt' -ScrubAfter

FROM ${MEDIA_CORE_OPENCV_IMAGE} AS media-core-built-ffmpeg
RUN --mount=type=bind,source=windows/scripts/build-media-core-all.ps1,target=C:\bkmnt\build-media-core-all.ps1 `
    --mount=type=bind,source=windows/scripts/build-ffmpeg-from-source.ps1,target=C:\bkmnt\build-ffmpeg-from-source.ps1 `
    --mount=type=bind,source=windows/scripts/load-versions.ps1,target=C:\bkmnt\load-versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/patches/ffmpeg,target=C:\bkmnt\patches\ffmpeg `
    & 'C:\bkmnt\build-media-core-all.ps1' -ResumeFrom 'FFmpeg' -ScriptDir 'C:\bkmnt' -ScrubAfter

FROM ${MEDIA_CORE_FFMPEG_IMAGE} AS media-core-built
RUN --mount=type=bind,source=windows/scripts/build-media-core-all.ps1,target=C:\bkmnt\build-media-core-all.ps1 `
    --mount=type=bind,source=windows/scripts/build-onnx-genai-from-source.ps1,target=C:\bkmnt\build-onnx-genai-from-source.ps1 `
    --mount=type=bind,source=windows/scripts/load-versions.ps1,target=C:\bkmnt\load-versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    & 'C:\bkmnt\build-media-core-all.ps1' -ResumeFrom 'ONNX GenAI' -Until 'ONNX GenAI' -ScriptDir 'C:\bkmnt' -ScrubAfter

# litert: direct solve (bazel — never trips the defect), same mount pattern.
FROM media-litert-env AS media-litert-built
RUN --mount=type=bind,source=windows/scripts/build-litert-all.ps1,target=C:\bkmnt\build-litert-all.ps1 `
    --mount=type=bind,source=windows/scripts/build-litert-from-source.ps1,target=C:\bkmnt\build-litert-from-source.ps1 `
    --mount=type=bind,source=windows/scripts/build-litert-lm-from-source.ps1,target=C:\bkmnt\build-litert-lm-from-source.ps1 `
    --mount=type=bind,source=windows/scripts/litert-lm-export-bridge.ps1,target=C:\bkmnt\litert-lm-export-bridge.ps1 `
    --mount=type=bind,source=windows/scripts/debug-litertlm-link.ps1,target=C:\bkmnt\debug-litertlm-link.ps1 `
    --mount=type=bind,source=windows/scripts/load-versions.ps1,target=C:\bkmnt\load-versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/shims,target=C:\bkmnt\shims `
    --mount=type=bind,source=windows/scripts/patches/litert-lm,target=C:\bkmnt\patches\litert-lm `
    & 'C:\bkmnt\build-litert-all.ps1' -ScriptDir 'C:\bkmnt' -ScrubAfter

# tvm: direct solve (de-warmed 2026-08-05), same mount pattern.
FROM media-tvm-env AS media-tvm-built
RUN --mount=type=bind,source=windows/scripts/build-media-tvm-all.ps1,target=C:\bkmnt\build-media-tvm-all.ps1 `
    --mount=type=bind,source=windows/scripts/build-tvm-from-source.ps1,target=C:\bkmnt\build-tvm-from-source.ps1 `
    --mount=type=bind,source=windows/scripts/build-iree-from-source.ps1,target=C:\bkmnt\build-iree-from-source.ps1 `
    --mount=type=bind,source=windows/scripts/load-versions.ps1,target=C:\bkmnt\load-versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/patches/iree,target=C:\bkmnt\patches\iree `
    & 'C:\bkmnt\build-media-tvm-all.ps1' -ScriptDir 'C:\bkmnt' -ScrubAfter
