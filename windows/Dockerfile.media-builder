# escape=`
# Copyright (c) 2025 Kataglyphis
# SPDX-License-Identifier: MIT
#
# Consolidated builder image for all three media run+commit branches
# (windows/build.ps1). A multi-stage build where each stage name matches
# the branch name (media-core / media-litert / media-tvm). The orchestrator
# selects the target stage via `--target <name>`.
#
# Each stage carries its build scripts + patches but runs NO heavy compile,
# so layers commit reliably under Hyper-V `docker build`. The heavy compile
# runs via:
#   docker run --isolation hyperv --cpu-count N --memory Mg <--target image> \
#       pwsh -File C:\temp\scripts\<build-*-all.ps1>
#   docker commit <container> local/kataglyphis:windows-media-<branch>
# because `docker build` on this host is capped at 2 CPUs and process isolation
# cannot commit layers (see build.ps1 CPU note).

ARG BASE_IMAGE=local/kataglyphis:windows-toolchain
# Solve-chain handoff images for the BuildKit media-core lane (see the
# media-core-built-* stages below for why this is four solves, not one).
ARG MEDIA_CORE_ONNX_IMAGE=docker.io/local/kataglyphis:bk-windows-media-core-onnx
ARG MEDIA_CORE_OPENCV_IMAGE=docker.io/local/kataglyphis:bk-windows-media-core-opencv
ARG MEDIA_CORE_FFMPEG_IMAGE=docker.io/local/kataglyphis:bk-windows-media-core-ffmpeg

# ── Common base: shared boilerplate for all three builders ────────────────────
FROM ${BASE_IMAGE} AS common

# MEMORY_LIMIT_GB deliberately has NO ARG/ENV here (#51): a scheduling
# knob as image metadata was a CACHE KEY - toggling -ConcurrentAux
# invalidated every litert/tvm compile. The driver publishes it on the
# webdav; Get-BuildJobCount fetches it at RUN time (fail-open to CIM).
# Compile TARGET architecture. FIRST declared here, deliberately: base/sdk/
# toolchain install host tooling shared by both lanes, and an ARG there would
# key their cache on it -- re-paying the VS Build Tools layer on every lane
# switch (Dockerfile.base: "every RUN after an ARG declaration keys its cache
# on the ARG's value"). Mirrored to ENV so the build scripts' arch resolution
# (Get-WindowsTargetArch -> $env:WINDOWS_TARGET_ARCH) sees it at RUN time and
# in every derived stage.
ARG WINDOWS_TARGET_ARCH=amd64
ENV WINDOWS_TARGET_ARCH=${WINDOWS_TARGET_ARCH}
ARG SCCACHE_WEBDAV_ENDPOINT=""
# Overridable so a single stage can be re-run at debug level without editing
# this file: build-buildkit.ps1 -BuildArg SCCACHE_LOG=debug (backlog #98).
ARG SCCACHE_LOG="warn"

# THE CACHE LAYOUT. Empty (the default) = NO chain: the WebDAV remote is the one
# and only cache. To restore the two-level layout later:
#   build-buildkit.ps1 ... -BuildArg SCCACHE_MULTILEVEL_CHAIN=disk,webdav
#
# WHY THE DISK LEVEL IS OFF (2026-08-16, backlog #99): Windows BuildKit cache
# mounts LOSE WRITES into a directory an earlier RUN populated (isolated A/B:
# 158/250 failures on the inherited mount dir vs 0/250 on plain fs — full
# measurement + per-stage failure ladder in docs/windows-builds.md, #99
# archive). The WebDAV remote is not a cache mount and is unaffected.
#
# RESTORE THE TWO-LEVEL LAYOUT once BuildKit's WCOW cache mounts mature (support
# only landed in v0.21.0, moby/buildkit#5603 / PR #5708; a mounter race was fixed
# in PR #5885; "cache mounts fail silently" is #1648). Re-verify by rebuilding
# media with `-BuildArg SCCACHE_MULTILEVEL_CHAIN=disk,webdav` and checking that
# genai reports 0 write errors — not by assuming a newer buildkit fixed it.
# `windows/scripts/diagnostics/probe-sccache-write.ps1` answers it in ~2 minutes.
ARG SCCACHE_MULTILEVEL_CHAIN=""

# Also an ARG so an experiment can start from a GUARANTEED-EMPTY cache dir:
#   -BuildArg SCCACHE_DIR=C:\sccache\v3
# This matters because the L0 failure rate depends on how much the directory
# already holds — measured 2026-08-16 with `chain=disk`: onnx started empty and
# wrote 1263 objects with 225 failures, opencv then started with those 1263 and
# failed 1849 of 1862, genai 157 of 157. Comparing a fresh-dir run against a
# run that inherits a full one measures the wrong thing.
ARG SCCACHE_DIR="C:\sccache\v2"

# DIAGNOSTIC ONLY (backlog #99). The cmake launcher wiring is gated on a
# configured REMOTE (Test-SccacheRemoteConfigured); with the endpoint cleared,
# sccache is not wired at all and a run reports `Compile requests 0` -- which
# reads like a clean build and measures nothing. Set to 1 to wire sccache with a
# LOCAL-ONLY backend so the disk level can be measured by itself:
#   -BuildArg SCCACHE_FORCE_LOCAL=1,SCCACHE_WEBDAV_ENDPOINT=,SCCACHE_MULTILEVEL_CHAIN=
# Never for production builds: without a remote the cache is only as persistent
# as SCCACHE_DIR's mount, and the whole point of the gate is to stop that
# happening by accident.
ARG SCCACHE_FORCE_LOCAL=""

# NB: OPENCV_LINK_CHAIN_FFMPEG deliberately does NOT live in this common block.
# It sat here for one day (2026-08-16→17) and a single flip of the value re-ran
# the whole media branch including the ~50-min ONNX stage, although only the
# opencv stage reads it. It is declared in `media-core-built-opencv` below —
# backlog #103, the concrete instance of the #49 disease.

# sccache TWO-TIER, wired 2026-08-08. Until then WebDAV was the only tier, so
# every one of the ~5000 compiles per stage paid an HTTP round-trip even on a hit.
#
# SCCACHE_DIR ALONE DOES NOTHING. With a remote configured, sccache runs in
# single-level *legacy* mode and the disk backend is not in the chain at all --
# this repo's own note claimed the opposite until it was checked against
# mozilla/sccache's docs/Configuration.md. The chain variable is what selects
# the hierarchy: "Order matters: left-to-right is fast-to-slow (L0, L1, ...)",
# read-through / write-through with automatic backfill.
#
# Requires sccache >= v0.16.0 (2026-06-19). Older versions ignore the variable
# SILENTLY, which is why sccache is now PINNED in versions.env and asserted by
# verify-toolchain.ps1 -- a speed feature that can vanish without a signal is
# worse than no feature at all.
#
# SCCACHE_CACHE_SIZE=15G is deliberate: buildkitd's tier-0 GC rule bounds
# type==exec.cachemount (windows/buildkitd.toml), so an unbounded L0 would be
# evicted between chains and quietly buy nothing. Raise BOTH together or
# neither. NB the cap figure quoted here was stale ("20GB/168h"): as of
# 2026-08-15 that tier is reservedSpace 30GB / maxUsedSpace 60GB — the
# reservedSpace FLOOR was the actual fix for backlog #89, where GC reclaimed the
# whole mount mid-chain and every write after the first stage failed. Read the
# live numbers from buildkitd.toml, not from this comment.
#
# SCCACHE_DIR points at a SUBDIRECTORY (`\v2`), not at the mount root. The tree
# that grew directly in C:\sccache is damaged in a PATH-DEPENDENT way: writing
# an object whose hash lands on a bad path fails with `The system cannot find
# the path specified. (os error 3)`, which is why a build (157 objects, spread
# over every bucket) failed 157/157 while single-compile probes were erratic -
# 1/1, then 5/6, then 0/6, depending on where that one hash landed. Chasing that
# noise cost several wrong "root causes" (the CWD, the multilevel chain, the
# mount itself, the foreign `logs` dir, process detachment, concurrency - each
# measured and each dead). A FRESH directory writes cleanly, on this mount, in
# every probe and across container boundaries; the damaged tree is simply
# abandoned. Bump to \v3 if it ever recurs, and see backlog #99.
#
# SCCACHE_ERROR_LOG lives on its OWN cache mount (C:\sccache-logs,
# id=sccache-logs-winamd64), NOT inside SCCACHE_DIR - corrected 2026-08-15,
# backlog #90. It used to sit at C:\sccache\logs\, i.e. inside the directory
# sccache itself manages by LRU, and sccache deleted it: a probe of a healthy
# mount holding 236 MB of cache content found `logs\` simply GONE, even though
# the creation code runs on every entrypoint and the mount persists. That is
# why the server's error trail was unobtainable through the whole multi-day
# write-failure investigation - it was pruned by design, not lost by accident,
# which left the genai 157/157 write failures undiagnosable. A log must live
# where no other tool has a delete policy over it.
# Owner directive: NEVER swallow logs. SCCACHE_LOG="warn" is NOT optional
# decoration - corrected 2026-08-15. The previous note claimed "the error log is
# always on and near-free" with SCCACHE_LOG left unset. That was FALSE: with no
# level configured sccache never initialises its logger, so SCCACHE_ERROR_LOG
# names a file that is never created. Proof: after moving the log to its own
# unpruned mount the directory existed and the file still did not (LOGDIR=True,
# NO_ERRORLOG) - while a hand probe that set SCCACHE_LOG=info DID produce
# content. `warn` is the cheap level that still captures write/read failures
# (opendal reports them at WARN); `debug` remains opt-in because it is
# voluminous.
# Historical note (backlog #23): the original \logs subdirectory was meant to
# keep postmortems out of the GC-capped cache root (shared with build-onnx's
# persistent ninja log);
# Initialize-SourceBuildEnvironment creates it before the server spawns.
# SCCACHE_IDLE_TIMEOUT=0 (2026-08-10 night): the default 600 s idle exit
# killed the server mid-vertex during the long bare-CUDA tail (>10 min with
# zero C/CXX requests), so the end-of-build stats emission talked to a
# FRESH server and reported all-zero counters (runs 12+13) - measurement
# poison, and the async webdav write-through tail dies with the server too.
# The RUN step's process tree ends with the step, so 0 leaks nothing.
ENV SCCACHE_WEBDAV_ENDPOINT="${SCCACHE_WEBDAV_ENDPOINT}" `
    SCCACHE_MULTILEVEL_CHAIN="${SCCACHE_MULTILEVEL_CHAIN}" `
    SCCACHE_DIR="${SCCACHE_DIR}" `
    SCCACHE_FORCE_LOCAL="${SCCACHE_FORCE_LOCAL}" `
    SCCACHE_CACHE_SIZE="15G" `
    SCCACHE_ERROR_LOG="C:\sccache-logs\sccache-error.log" `
    SCCACHE_LOG="${SCCACHE_LOG}" `
    SCCACHE_IDLE_TIMEOUT="0"

SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; $PSNativeCommandUseErrorActionPreference = $false;"]

# NO versions.env COPY HERE — deliberately removed 2026-08-07.
#
# It used to sit in this stage so the run-time `load-versions.ps1` would read
# CURRENT values instead of the stale copy baked into the base image. The cost
# was brutal and invisible: this stage is the ancestor of all three branch envs,
# so ANY byte changed in versions.env invalidated all six media compiles — three
# Windows-only toolchain pins triggered a full ~75-minute ONNX rebuild that day.
#
# Versions now arrive as build-args (Get-MediaBranchVersionArg, forwarded by both
# drivers) and are declared as ARG+ENV in each `media-*-env` stage below, so a
# pin only invalidates the branch that actually consumes it. The stale-file trap
# is closed at the other end: `load-versions.ps1` now treats a value already
# present in the process environment as authoritative and never overwrites it,
# so the base-baked file can only fill gaps, never win.
#
# CONSEQUENCE FOR NEW BUILD SCRIPTS: whatever a script reads must be listed in
# Get-MediaBranchVersionArg. Anything missing silently falls back to the
# base-baked value — audit with the greps documented at that function.

# Common modules for all builder images.
COPY windows\scripts\modules\WindowsScripts.Shared.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Common.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Patches.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Cuda.psm1 `
     windows\scripts\modules\WindowsNative.Common.psm1 `
     windows\scripts\modules\WindowsTargetArch.Common.psm1 `
     C:\temp\scripts\modules\

# ── Mount source for the BK lane's module closure ────────────────────────────
# Every compile RUN below needs the SAME five modules (the in-container closure
# of the build scripts: SourceBuild.Common + its imports Shared, Patches, Cuda,
# Native.Common). They used to be listed as five separate --mount lines in each
# of six RUNs — 30 duplicated lines that had to be edited in lockstep.
#
# Cache behaviour is UNCHANGED by this collapse, which is the whole reason it is
# safe: because all six RUNs mount all five files, editing any one of them
# already invalidated all six. Keying them on one stage that contains exactly
# those five files preserves the property that actually matters — edits to the
# ~24 host-only modules (BuildDriver, BuildKit, Flutter, …) still touch nothing
# here, which is why a whole-modules-dir mount remains wrong.
#
# Parent is BASE_IMAGE, not `common`: `common` also carries versions.env, and
# there is no reason for a versions bump to key into this stage.
#
# PATH TRAP (cost a chain launch on 2026-08-07): in `--mount=...,from=<stage>`
# the SOURCE is a Unix-style path inside that stage, with NO drive letter, even
# on Windows containers. `source=C:\bkmods` is normalised to "/C:/bkmods" and
# fails the solve with `failed to calculate checksum ... not found`. The COPY
# destination below stays Windows-shaped (C:\bkmods); only the mount source is
# `/bkmods`. Probed on this host before re-landing: a bare Test-Path assertion
# through the mount returns the file content.
FROM ${BASE_IMAGE} AS buildmods
COPY windows\scripts\modules\WindowsSourceBuild.Common.psm1 `
     windows\scripts\modules\WindowsScripts.Shared.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Patches.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Cuda.psm1 `
     windows\scripts\modules\WindowsNative.Common.psm1 `
     windows\scripts\modules\WindowsTargetArch.Common.psm1 `
     C:\bkmods\

# ── media-core version env — CLASSIC-lane ancestor (since #49, 2026-08-19) ───
# The classic `media-core` stage runs the whole chain in one stage and takes
# its version keys from here. The BK compile stages deliberately do NOT
# descend from this (they declare their component keys per stage, see
# media-core-built-onnx below, so a single-component bump no longer cascades
# through the whole branch); TwinParity asserts the two key SETS stay equal.
# History: both lanes once shared this ancestor (and before that, a hand-kept
# media-core-bk twin) — see git log on this header for the evolution.
FROM common AS media-core-env

ARG ONNXRUNTIME_VERSION=v1.29.0
ARG ONNXRUNTIME_GENAI_VERSION=v0.15.2
ARG OPENCV_SOURCE_VERSION=5.0.0
ARG FFMPEG_VERSION=n9.0
ARG PYAV_VERSION=18.1.0
ARG NV_CODEC_HEADERS_REF=n13.1.15.0
ARG CUDA_ARCHITECTURES="80;86;89;90"
# Consumed by build-opencv-from-source.ps1 (bindings target + its own version
# alias). Present here because the versions.env COPY is gone — see the `common`
# stage comment; a key missing from this list silently uses the base-baked value.
ARG OPENCV_VERSION=5.0.0
ARG PYTHON_VERSION=3.14.7

# ONE ENV instruction: the classic builder pays a layer per instruction and the
# chain runs against Docker's 125-layer cap (see docs/windows-builds.md § layer
# budget). Plain ARG passthroughs, no interdependency.
ENV ONNXRUNTIME_VERSION="${ONNXRUNTIME_VERSION}" `
    ONNXRUNTIME_GENAI_VERSION="${ONNXRUNTIME_GENAI_VERSION}" `
    OPENCV_SOURCE_VERSION="${OPENCV_SOURCE_VERSION}" `
    FFMPEG_VERSION="${FFMPEG_VERSION}" `
    PYAV_VERSION="${PYAV_VERSION}" `
    NV_CODEC_HEADERS_REF="${NV_CODEC_HEADERS_REF}" `
    CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" `
    OPENCV_VERSION="${OPENCV_VERSION}" `
    PYTHON_VERSION="${PYTHON_VERSION}"

# ── media-core builder, classic lane (ONNX Runtime -> GenAI -> OpenCV -> FFmpeg)
FROM media-core-env AS media-core

COPY windows\scripts\patches\onnxruntime     C:\temp\scripts\patches\onnxruntime
COPY windows\scripts\patches\opencv          C:\temp\scripts\patches\opencv
COPY windows\scripts\patches\opencv_contrib  C:\temp\scripts\patches\opencv_contrib
COPY windows\scripts\patches\ffmpeg          C:\temp\scripts\patches\ffmpeg

COPY windows\scripts\build\build-onnx-from-source.ps1 `
     windows\scripts\build\build-onnx-genai-from-source.ps1 `
     windows\scripts\build\build-opencv-from-source.ps1 `
     windows\scripts\build\build-ffmpeg-from-source.ps1 `
     windows\scripts\build\build-media-core-all.ps1 `
     C:\temp\scripts\

# ── media-litert version env — SHARED ANCESTOR of both lanes (see media-core-env)
FROM common AS media-litert-env

ARG LITERT_VERSION=v2.2.0
ARG LITERT_LM_VERSION=0.16.1
# PROTOC_VERSION is NOT independent software: it must match the protobuf runtime
# pinned inside LiteRT-LM (v0.14.0 -> 6.31.1 -> protoc 31.1). A stale value emits
# gencode the pinned headers #error on (bit us 2026-08-03). JRE_VERSION feeds
# Bazel. Both are here because the versions.env COPY is gone — see `common`.
ARG PROTOC_VERSION=31.1
ARG JRE_VERSION=21

ENV LITERT_VERSION="${LITERT_VERSION}" `
    LITERT_LM_VERSION="${LITERT_LM_VERSION}" `
    PROTOC_VERSION="${PROTOC_VERSION}" `
    JRE_VERSION="${JRE_VERSION}"

# ── media-litert builder, classic lane (LiteRT -> LiteRT-LM) ─────────────────
FROM media-litert-env AS media-litert

# LiteRT-LM's Windows shims (POSIX headers + CRT-compat source) and CMake patch
# snippets -- the build script stages them from these $PSScriptRoot-relative dirs.
COPY windows\scripts\shims C:\temp\scripts\shims
COPY windows\scripts\patches\litert-lm C:\temp\scripts\patches\litert-lm

COPY windows\scripts\build\build-litert-from-source.ps1 `
     windows\scripts\build\build-litert-lm-bazel.ps1 `
     windows\scripts\build\build-litert-lm-from-source.ps1 `
     windows\scripts\build\litert-lm-export-bridge.ps1 `
     windows\scripts\build\build-litert-all.ps1 `
     windows\scripts\build\debug-litertlm-link.ps1 `
     C:\temp\scripts\

# ── media-tvm version env — SHARED ANCESTOR of both lanes (see media-core-env)
FROM common AS media-tvm-env

ARG TVM_REF=v0.26.0
ARG IREE_VERSION=v3.11.0

ENV TVM_REF="${TVM_REF}" `
    IREE_VERSION="${IREE_VERSION}"

# ── media-tvm builder, classic lane (TVM -> IREE) ────────────────────────────
FROM media-tvm-env AS media-tvm

COPY windows\scripts\patches\iree C:\temp\scripts\patches\iree

COPY windows\scripts\build\build-tvm-from-source.ps1 `
     windows\scripts\build\build-iree-from-source.ps1 `
     windows\scripts\build\build-media-tvm-all.ps1 `
     C:\temp\scripts\

# ── BuildKit lane (buildctl --opt target=media-<branch>-built) ───────────────
# Under buildkitd/containerd this host commits PROCESS-isolated layers and RUN
# steps see all host CPUs, so each branch compile is a plain LAYER — no
# run+commit. The classic docker lane always passes --target media-<branch>
# (build.ps1 Get-MediaBranchSpecs) and never executes these RUNs.
#
# BIND-MOUNTED SCRIPTS, NOT COPYs (2026-08-04): the *-bk stages below carry NO
# script/patch COPY layers — every RUN bind-mounts exactly its transitive
# script closure from the build context at C:\bkmnt (single-file mounts probed
# working on WCOW buildkitd v0.32). Cache consequence: editing a build script
# re-runs ONLY the RUNs that mount it — an OpenCV script fix no longer
# invalidates the 75-minute ONNX layer (with COPY layers it invalidated every
# RUN downstream of the COPY). Modules are mounted PER FILE too (the in-
# container closure is exactly: SourceBuild.Common + its imports Shared,
# SourceBuild.Patches, SourceBuild.Cuda, Native.Common — plus Installer.Common
# for GStreamer in the merge builder): a whole-dir modules/ mount let edits to
# the 24 host-only modules (BuildDriver, BuildKit, Flutter, …) bust every
# compile RUN in the chain. load-versions.ps1 is mounted into every BUILD run
# so Initialize-SourceBuildScript re-reads the freshly COPY'd versions.env
# instead of silently falling back to the base image's baked Machine env
# (stale after a versions.env edit + -Stages media iteration). The wrappers
# receive -ScriptDir C:\bkmnt so chain + leaf scripts resolve
# modules/patches/shims via their usual $PSScriptRoot-relative paths.
#
# DIRECT SOLVES (de-warmed 2026-08-06, round 2): every library layer builds
# AND exports in one plain RUN. The former warm/materialize pairs existed
# for the ExportLayer-0x3 defect — ROOT CAUSE: the runhcs shim's hardcoded
# 30s tearDownTimeout terminated the measured ~117s heavy-churn silo
# teardown mid-hive-flush, permanently poisoning the scratch. FIXED by the
# patched shim (45min timeouts) in Stevedore\bin — proven by 3x consecutive
# direct OpenCV finalizes (docs/windows-builds.md § roadmap "DEFECT
# SOLVED", incl. the maintenance rule: Stevedore updates overwrite the
# patched binary). If the canary ever 0x3s again (e.g. shim reverted),
# restore the warm/materialize pattern from git history (c9586c1^) —
# bk-warm.ps1/bk-materialize.ps1 and the handoff helpers remain in the
# tree for exactly that case.

# #49 (2026-08-19): the BK compile stages NO LONGER descend from the shared
# media-core-env ancestor - each stage declares exactly the version keys its
# component consumes, so a PyAV/FFmpeg bump re-runs ffmpeg+downstream instead
# of the full ~75-min ONNX build, and a GenAI bump re-runs genai alone.
# ENV (not bare ARG) so the values persist into the downstream stages via the
# image config: CUDA_ARCHITECTURES/PYTHON_VERSION set here are inherited by
# ffmpeg/opencv/genai. media-core-env remains for the CLASSIC lane only,
# which runs the whole chain in one stage and has no granularity to gain.
FROM common AS media-core-built-onnx
ARG ONNXRUNTIME_VERSION=v1.29.0
ARG CUDA_ARCHITECTURES="80;86;89;90"
ARG PYTHON_VERSION=3.14.7
ENV ONNXRUNTIME_VERSION="${ONNXRUNTIME_VERSION}" `
    CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" `
    PYTHON_VERSION="${PYTHON_VERSION}"
# Both DORMANT by default (empty ARG = inert; the scripts test for -eq '1').
# Declared in the CONSUMING stage per the #103 lesson, and declared AT ALL
# because buildctl silently DISCARDS a --opt build-arg no Dockerfile ARG
# matches (the lesson that cost a 25-minute "the flag does not work" run).
#
#   SCCACHE_CUDA_LAUNCHER    routes nvcc through sccache. DEFAULT ON since
#                            2026-08-18: the 2026-08-10 miscompile was
#                            root-caused to the dryrun quote-collapse bug
#                            (mozilla/sccache#2811), the patched sccache
#                            shipped with the #114 base ride, and the
#                            three-canary bar passed the same evening -
#                            fused_moe compile green, providers_cuda link
#                            green COLD (153 device writes) and green on the
#                            HIT run at a 100.00% CUDA/PTX/CUBIN hit rate
#                            (207/816 hits). Opt OUT for experiments with:
#                            -BuildArg SCCACHE_CUDA_LAUNCHER=
#                            Do not flip this back off silently - without it
#                            the onnx stage re-pays ~25 min of CUDA compiles
#                            per rebuild.
#   SCCACHE_REPRO_CUDA_LLM   RETIRED 2026-08-18 with patch 006 (it existed
#                            only to skip 006 for the #2808 server-trace
#                            repro; 006's fused_moe family now goes through
#                            the launcher by default). ARG kept declared so
#                            historical commands don't silently no-op via
#                            buildctl's discard behavior; the env is unread.
# ARG only, deliberately NO ENV mirror: a declared ARG is already an env var
# inside this stage's RUN steps, while an ENV would BAKE the experiment value
# into the image and every downstream stage would inherit it (discovered
# 2026-08-18: the opencv experiment's launcher leaked into genai's build).
ARG SCCACHE_CUDA_LAUNCHER="1"
ARG SCCACHE_REPRO_CUDA_LLM=""
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=locked `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/build-media-core-all.ps1,target=C:\bkmnt\build-media-core-all.ps1 `
    --mount=type=bind,source=windows/scripts/build/build-onnx-from-source.ps1,target=C:\bkmnt\build-onnx-from-source.ps1 `
    --mount=type=bind,source=windows/scripts/build/load-versions.ps1,target=C:\bkmnt\load-versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/patches/onnxruntime,target=C:\bkmnt\patches\onnxruntime `
    & 'C:\bkmnt\build-media-core-all.ps1' -Until 'ONNX Runtime' -ScriptDir 'C:\bkmnt' -ScrubAfter

# FFMPEG BEFORE OPENCV (swapped 2026-08-16, backlog #94). OpenCV's videoio
# needs FFmpeg to EXIST at configure time or it silently falls back to the
# prebuilt `opencv_videoio_ffmpeg*.dll` it downloads itself — which is what
# shipped for months: `FFMPEG: YES (prebuilt binaries)`, avcodec 61 while this
# chain builds avcodec 63, two FFmpeg generations in one image and
# cv::VideoCapture using the older. The swap is safe because the dependency runs
# ONE way: FFmpeg is configured without `--enable-libopencv`, so it needs
# nothing from OpenCV. (GStreamer↔OpenCV genuinely IS circular — that is #93,
# a different problem with a different fix.)
#
# Every RUN below now passes BOTH -ResumeFrom and -Until. The ffmpeg step used
# to pass only -ResumeFrom and rely on being LAST in the stage list; after the
# swap that would have silently dragged OpenCV into the ffmpeg layer.
FROM ${MEDIA_CORE_ONNX_IMAGE} AS media-core-built-ffmpeg
# #49: ffmpeg-component keys live HERE - a bump re-runs ffmpeg+downstream,
# never the ONNX stage above.
ARG FFMPEG_VERSION=n9.0
ARG PYAV_VERSION=18.1.0
ARG NV_CODEC_HEADERS_REF=n13.1.15.0
ENV FFMPEG_VERSION="${FFMPEG_VERSION}" `
    PYAV_VERSION="${PYAV_VERSION}" `
    NV_CODEC_HEADERS_REF="${NV_CODEC_HEADERS_REF}"
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=locked `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/build-media-core-all.ps1,target=C:\bkmnt\build-media-core-all.ps1 `
    --mount=type=bind,source=windows/scripts/build/build-ffmpeg-from-source.ps1,target=C:\bkmnt\build-ffmpeg-from-source.ps1 `
    --mount=type=bind,source=windows/scripts/build/load-versions.ps1,target=C:\bkmnt\load-versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/patches/ffmpeg,target=C:\bkmnt\patches\ffmpeg `
    & 'C:\bkmnt\build-media-core-all.ps1' -ResumeFrom 'FFmpeg' -Until 'FFmpeg' -ScriptDir 'C:\bkmnt' -ScrubAfter

FROM ${MEDIA_CORE_FFMPEG_IMAGE} AS media-core-built-opencv
# DEFAULT ON since 2026-08-17: OpenCV links the FFmpeg this chain builds
# (avcodec 63) instead of downloading its own prebuilt one (avcodec 61,
# avdevice NO). Verified by the full-chain smoke gate: 188 passed / 1 failed,
# the 1 being the deliberately-red #93 GStreamer guard. Requires the FFmpeg-9
# source patch + PkgConfig shim (both applied by build-opencv-from-source.ps1
# when this is 1). Opt OUT with: -BuildArg OPENCV_LINK_CHAIN_FFMPEG=
#
# Declared HERE, not in `common` (#103): only this stage reads it, and in the
# common ENV block one flip re-ran the ~50-min ONNX stage for nothing. Here a
# flip re-runs opencv+genai only (~25 min). NB the ARG must exist in the
# Dockerfile or buildctl silently DISCARDS the --opt build-arg (cost a
# 25-minute run on 2026-08-16).
ARG OPENCV_LINK_CHAIN_FFMPEG="1"
# DEFAULT ON since 2026-08-19 (#115 closed): OpenCV's CUDA compiles route
# through the sccache launcher. The old blocker - every .cu rejected as
# CannotCache(multiple input files) because the SEPARATED --diag-suppress
# form was missing from sccache's nvcc table - is fixed by patch 0003 in
# windows/upstream/sccache-nvcc-quote-fix (upstream PR pending). Canary bar
# passed 2026-08-19 evening: COLD run wrote all CUDA categories (155
# cudafe++/nvcc, 620 cicc/ptxas) with a green link; the no-cache HIT run
# came back at 100.00% across every CUDA category (99.97% overall) and cut
# the stage from ~13 to ~4.3 min. Opt OUT for experiments with:
#   -BuildArg OPENCV_CUDA_LAUNCHER=
# DELIBERATELY NOT named SCCACHE_CUDA_LAUNCHER: the driver's -BuildArg is
# global across stages, and the shared name once flipped the ONNX stage's
# cache key too (2026-08-18). The stage-local name maps onto the env var
# only HERE, INSIDE the RUN - never via ENV (an ENV mapping once baked the
# flag into the image and genai inherited an active CUDA launcher).
# History, for the record: the 2026-08-18 run 2 verdict "rsp files pass
# through uncached" was true but NOT the root cause - the diag-suppress
# table gap was (backlog #115).
ARG OPENCV_CUDA_LAUNCHER="1"
# Companion experiment knob: disable CMake's CUDA response files so nvcc
# calls arrive inline and can enter sccache's decomposition at all (rsp files
# are passed through uncached - measured 2026-08-18). Only meaningful with
# OPENCV_CUDA_LAUNCHER=1 AND the shipped quote fix (#114). RUN-scoped, no
# ENV bake.
ARG OPENCV_CUDA_NO_RSP=""
# #49: opencv-component keys live HERE.
ARG OPENCV_SOURCE_VERSION=5.0.0
ARG OPENCV_VERSION=5.0.0
ENV OPENCV_LINK_CHAIN_FFMPEG="${OPENCV_LINK_CHAIN_FFMPEG}" `
    OPENCV_SOURCE_VERSION="${OPENCV_SOURCE_VERSION}" `
    OPENCV_VERSION="${OPENCV_VERSION}"
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=locked `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/build-media-core-all.ps1,target=C:\bkmnt\build-media-core-all.ps1 `
    --mount=type=bind,source=windows/scripts/build/build-opencv-from-source.ps1,target=C:\bkmnt\build-opencv-from-source.ps1 `
    --mount=type=bind,source=windows/scripts/build/load-versions.ps1,target=C:\bkmnt\load-versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/patches/opencv,target=C:\bkmnt\patches\opencv `
    --mount=type=bind,source=windows/scripts/patches/opencv_contrib,target=C:\bkmnt\patches\opencv_contrib `
    $env:SCCACHE_CUDA_LAUNCHER = $env:OPENCV_CUDA_LAUNCHER; `
    & 'C:\bkmnt\build-media-core-all.ps1' -ResumeFrom 'OpenCV' -Until 'OpenCV' -ScriptDir 'C:\bkmnt' -ScrubAfter

FROM ${MEDIA_CORE_OPENCV_IMAGE} AS media-core-built
# #49: the genai key lives HERE - a GenAI bump re-runs this stage alone.
ARG ONNXRUNTIME_GENAI_VERSION=v0.15.2
ENV ONNXRUNTIME_GENAI_VERSION="${ONNXRUNTIME_GENAI_VERSION}"
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=locked `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/build-media-core-all.ps1,target=C:\bkmnt\build-media-core-all.ps1 `
    --mount=type=bind,source=windows/scripts/build/build-onnx-genai-from-source.ps1,target=C:\bkmnt\build-onnx-genai-from-source.ps1 `
    --mount=type=bind,source=windows/scripts/build/load-versions.ps1,target=C:\bkmnt\load-versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    & 'C:\bkmnt\build-media-core-all.ps1' -ResumeFrom 'ONNX GenAI' -Until 'ONNX GenAI' -ScriptDir 'C:\bkmnt' -ScrubAfter

# litert: direct solve (bazel — never trips the defect), same mount pattern.
FROM media-litert-env AS media-litert-built
# LiteRT SDK = CMake (sccache mount); LiteRT-LM = bazel (own repository cache
# mount id=bazel-litertlm-winamd64; bazel's output_base stays container-local
# - it is rename-heavy and this cache mount is wcifs rename-hostile). The
# frozen CMake litert-lm fallback (build-litert-lm-from-source.ps1 + export
# bridge + link diag + litert-lm patches/shims) stays bind-mounted so a
# BAZEL_REPO_CACHE-less / fallback run still has it.
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=locked `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=cache,target=C:\bzl-repo-cache,id=bazel-litertlm-winamd64,sharing=locked `
    --mount=type=bind,source=windows/scripts/build/build-litert-all.ps1,target=C:\bkmnt\build-litert-all.ps1 `
    --mount=type=bind,source=windows/scripts/build/build-litert-from-source.ps1,target=C:\bkmnt\build-litert-from-source.ps1 `
    --mount=type=bind,source=windows/scripts/build/build-litert-lm-bazel.ps1,target=C:\bkmnt\build-litert-lm-bazel.ps1 `
    --mount=type=bind,source=windows/scripts/build/build-litert-lm-from-source.ps1,target=C:\bkmnt\build-litert-lm-from-source.ps1 `
    --mount=type=bind,source=windows/scripts/build/litert-lm-export-bridge.ps1,target=C:\bkmnt\litert-lm-export-bridge.ps1 `
    --mount=type=bind,source=windows/scripts/build/debug-litertlm-link.ps1,target=C:\bkmnt\debug-litertlm-link.ps1 `
    --mount=type=bind,source=windows/scripts/build/load-versions.ps1,target=C:\bkmnt\load-versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/shims,target=C:\bkmnt\shims `
    --mount=type=bind,source=windows/scripts/patches/litert-lm,target=C:\bkmnt\patches\litert-lm `
    $env:BAZEL_REPO_CACHE = 'C:\bzl-repo-cache'; & 'C:\bkmnt\build-litert-all.ps1' -ScriptDir 'C:\bkmnt' -ScrubAfter

