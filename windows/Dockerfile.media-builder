# The three media branches; RUNs bind-mount their script closure per file, so never COPY a build script here.

ARG BASE_IMAGE=local/kataglyphis:windows-toolchain
# Handoff images between the chained media-core solves.
ARG MEDIA_CORE_ONNX_IMAGE=docker.io/local/kataglyphis:bk-windows-media-core-onnx
ARG MEDIA_CORE_OPENCV_IMAGE=docker.io/local/kataglyphis:bk-windows-media-core-opencv
ARG MEDIA_CORE_FFMPEG_IMAGE=docker.io/local/kataglyphis:bk-windows-media-core-ffmpeg
ARG MEDIA_CORE_HAILO_IMAGE=docker.io/local/kataglyphis:bk-windows-media-core-hailo

# Common base for all three builders
FROM ${BASE_IMAGE} AS common

# First declared here, not in base/sdk/toolchain, whose cache an ARG would key on every lane switch.
ARG WINDOWS_TARGET_ARCH=amd64
ENV WINDOWS_TARGET_ARCH=${WINDOWS_TARGET_ARCH}
# Build-host settings are ARGs only; see docs/windows-build-resources.md § What the published image carries.
ARG SCCACHE_LOG="warn"

# The disk level is off by default; see docs/windows-build-resources.md § Persistent compile cache (sccache).
ARG SCCACHE_DIR="C:\sccache\v2"

# CACHE_SIZE stays within buildkitd.toml's cache-mount GC cap; without SCCACHE_LOG the error log is never written.
ENV SCCACHE_DIR="${SCCACHE_DIR}" `
    SCCACHE_CACHE_SIZE="15G" `
    SCCACHE_ERROR_LOG="C:\sccache-logs\sccache-error.log" `
    SCCACHE_LOG="${SCCACHE_LOG}" `
    SCCACHE_IDLE_TIMEOUT="0"

SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; $PSNativeCommandUseErrorActionPreference = $false;"]

# No versions.env COPY: pins arrive as build-args, so a script's new key must be listed in Get-MediaBranchVersionArg.

# The shared module closure; mount it with source=/bkmods (see docs/windows-build-invariants.md § In `RUN --mount=...,from=<stage>` the SOURCE path is Unix-style).
FROM ${BASE_IMAGE} AS buildmods
COPY windows\scripts\modules\WindowsSourceBuild.Common.psm1 `
     windows\scripts\modules\WindowsScripts.Shared.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Patches.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Cuda.psm1 `
     windows\scripts\modules\WindowsNative.Common.psm1 `
     windows\scripts\modules\WindowsTargetArch.Common.psm1 `
     C:\bkmods\

# TVM-private closure, so a TVM edit never re-keys ONNX; mount it from media-tvm-built only (ModuleClosure tests enforce it).
FROM buildmods AS tvmmods
COPY windows\scripts\modules\WindowsTvm.Common.psm1 C:\bkmods\

# media-litert version env
FROM common AS media-litert-env

ARG LITERT_VERSION=v2.2.0
ARG LITERT_LM_VERSION=0.17.1
# PROTOC_VERSION must match LiteRT-LM's pinned protobuf runtime, or its headers #error on the gencode.
ARG PROTOC_VERSION=35.1
ARG JRE_VERSION=21
# rocm lane only: Build-LitertLmBazel.ps1 verifies LiteRT-LM's GPU payload against these.
ARG LITERT_LM_WEBGPU_ACCELERATOR_SHA256=8a2c4d5700ac34cfbef96548e1096a4532e9bbe20ee827e80a38439766c81644
ARG LITERT_LM_WEBGPU_SAMPLER_SHA256=5ddbb93b4192efd5aafed2ec23d98091b12e467ea0c0daa65d1abac5f2529532
ARG LITERT_LM_WEBGPU_DAWN_SHA256=4f98d05a333cf980776ae5382c39ce19638cf71d1fd60133d1c849b55551895e
ARG LITERT_LM_DXC_ZIP_SHA256=a1e89031421cf3c1fca6627766ab3020ca4f962ac7e2caa7fab2b33a8436151e

ENV LITERT_VERSION="${LITERT_VERSION}" `
    LITERT_LM_VERSION="${LITERT_LM_VERSION}" `
    PROTOC_VERSION="${PROTOC_VERSION}" `
    JRE_VERSION="${JRE_VERSION}" `
    LITERT_LM_WEBGPU_ACCELERATOR_SHA256="${LITERT_LM_WEBGPU_ACCELERATOR_SHA256}" `
    LITERT_LM_WEBGPU_SAMPLER_SHA256="${LITERT_LM_WEBGPU_SAMPLER_SHA256}" `
    LITERT_LM_WEBGPU_DAWN_SHA256="${LITERT_LM_WEBGPU_DAWN_SHA256}" `
    LITERT_LM_DXC_ZIP_SHA256="${LITERT_LM_DXC_ZIP_SHA256}"

# media-tvm version env
FROM common AS media-tvm-env

ARG TVM_REF=v0.26.0
ARG TVM_COMMIT=994e0216d734bf3e02806d8ebf383dafa80e41b9
ARG IREE_VERSION=v3.11.0
# rocm lane: IREE's rocm target fetches ocml/ockl bitcode; Build-IreeFromSource.ps1 asserts upstream pins this hash.
ARG IREE_ROCM_DEVICE_BC_SHA256=336362416c68fdd8bb80328f65ca7ebaa0c119ea19c95df6df30c832a4df39b9

ENV TVM_REF="${TVM_REF}" `
    TVM_COMMIT="${TVM_COMMIT}" `
    IREE_VERSION="${IREE_VERSION}" `
    IREE_ROCM_DEVICE_BC_SHA256="${IREE_ROCM_DEVICE_BC_SHA256}"

# Each compile stage declares only its own version keys; ENV so CUDA_ARCHITECTURES/PYTHON_VERSION reach the downstream stages.
FROM common AS media-core-built-onnx
ARG ONNXRUNTIME_VERSION=v1.30.0
ARG CUDA_ARCHITECTURES="86;87;89;120"
ARG PYTHON_VERSION=3.14.7
# Declared in every stage that mounts windows/qnn-sdk, or that stage extracts the zip unverified; empty = no EP.
ARG QNN_SDK_ZIP_SHA256="52A5B0CC051EB2896848C9FD46E704612B1DC06E7D2F5D0D9A79FD8BCDD344BB"
ENV ONNXRUNTIME_VERSION="${ONNXRUNTIME_VERSION}" `
    CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" `
    PYTHON_VERSION="${PYTHON_VERSION}" `
    QNN_SDK_ZIP_SHA256="${QNN_SDK_ZIP_SHA256}"
# ARG only: an ENV would leak the value into every downstream stage; see docs/windows-build-resources.md § Persistent compile cache (sccache).
ARG SCCACHE_CUDA_LAUNCHER="1"
ARG SCCACHE_REPRO_CUDA_LLM=""
# Valueless, so the cpu/nvidia RUN env gains nothing; see docs/windows-rocm.md § ONNX Runtime WebGPU EP (rocm lane, spike).
ARG ORT_WEBGPU
ARG ORT_WEBGPU_WINDOWS_DAWN_VERSION
ARG ORT_WEBGPU_WINDOWS_DAWN_SHA256
ARG ORT_WEBGPU_WINDOWS_DXC_VERSION
ARG ORT_WEBGPU_WINDOWS_DXC_ASSET
ARG ORT_WEBGPU_WINDOWS_DXC_SHA256
# Build-host sccache settings: RUN env only, never image ENV (see `common`).
ARG SCCACHE_WEBDAV_ENDPOINT
ARG SCCACHE_MULTILEVEL_CHAIN
ARG SCCACHE_FORCE_LOCAL
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=shared `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/Build-MediaCoreAll.ps1,target=C:\bkmnt\Build-MediaCoreAll.ps1 `
    --mount=type=bind,source=windows/scripts/build/Build-OnnxFromSource.ps1,target=C:\bkmnt\Build-OnnxFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/build/Build-TargetCpython.ps1,target=C:\bkmnt\Build-TargetCpython.ps1 `
    --mount=type=bind,source=windows/scripts/build/cpython-Directory.Build.props,target=C:\bkmnt\cpython-Directory.Build.props `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/patches/onnxruntime,target=C:\bkmnt\patches\onnxruntime `
    --mount=type=bind,source=windows/qnn-sdk,target=C:\temp\qnn-sdk `
    & 'C:\bkmnt\Build-MediaCoreAll.ps1' -Until 'ONNX Runtime' -ScriptDir 'C:\bkmnt' -ScrubAfter

# FFmpeg before OpenCV, whose videoio otherwise falls back to its own prebuilt FFmpeg; every RUN passes -ResumeFrom and -Until.
FROM ${MEDIA_CORE_ONNX_IMAGE} AS media-core-built-ffmpeg
# Redeclared: ARGs do not cross stages, and the amd64 default would silently build x64 against an arm64 parent.
ARG WINDOWS_TARGET_ARCH=amd64
ENV WINDOWS_TARGET_ARCH=${WINDOWS_TARGET_ARCH}
# FFmpeg's keys live here, so a bump never re-runs the ONNX stage.
ARG FFMPEG_VERSION=n9.0.2
ARG PYAV_VERSION=18.1.0
ARG NV_CODEC_HEADERS_REF=n13.1.15.0
# AMF headers: every lane carries the pin, only the rocm lane fetches them (GPU_TYPE=rocm).
ARG AMF_HEADERS_VERSION=v1.5.2
ARG AMF_HEADERS_SHA256=d3c12eb324edf05e214608b6a395a51dd95770ed9d45520185d6c3a206811c99
# FFmpeg's static software codecs (Build-FfmpegCodecs.ps1, amd64); versions.env owns the values.
ARG DAV1D_VERSION=1.4.1
ARG DAV1D_SHA256=8d407dd5fe7986413c937b14e67f36aebd06e1fa5cfec679d10e548476f2d5f8
ARG X264_MESON_BRANCH=164.3108-meson
ARG X264_MESON_COMMIT=ecc833a37945073a779b42b1a9f20c4454a62fbb
ARG X265_VERSION=4.1
ARG X265_SHA256=a31699c6a89806b74b0151e5e6a7df65de4b49050482fe5ebf8a4379d7af8f29
ENV FFMPEG_VERSION="${FFMPEG_VERSION}" `
    PYAV_VERSION="${PYAV_VERSION}" `
    NV_CODEC_HEADERS_REF="${NV_CODEC_HEADERS_REF}" `
    AMF_HEADERS_VERSION="${AMF_HEADERS_VERSION}" `
    AMF_HEADERS_SHA256="${AMF_HEADERS_SHA256}" `
    DAV1D_VERSION="${DAV1D_VERSION}" `
    DAV1D_SHA256="${DAV1D_SHA256}" `
    X264_MESON_BRANCH="${X264_MESON_BRANCH}" `
    X264_MESON_COMMIT="${X264_MESON_COMMIT}" `
    X265_VERSION="${X265_VERSION}" `
    X265_SHA256="${X265_SHA256}"
# Build-host sccache settings: RUN env only, never image ENV (see `common`).
ARG SCCACHE_WEBDAV_ENDPOINT
ARG SCCACHE_MULTILEVEL_CHAIN
ARG SCCACHE_FORCE_LOCAL
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=shared `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/Build-MediaCoreAll.ps1,target=C:\bkmnt\Build-MediaCoreAll.ps1 `
    --mount=type=bind,source=windows/scripts/build/Build-FfmpegFromSource.ps1,target=C:\bkmnt\Build-FfmpegFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/build/Build-FfmpegCodecs.ps1,target=C:\bkmnt\Build-FfmpegCodecs.ps1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsOrtProvenance.Build.psm1,target=C:\bkmnt\ortmods\WindowsOrtProvenance.Build.psm1 `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/patches/ffmpeg,target=C:\bkmnt\patches\ffmpeg `
    & 'C:\bkmnt\Build-MediaCoreAll.ps1' -ResumeFrom 'FFmpeg' -Until 'FFmpeg' -ScriptDir 'C:\bkmnt' -ScrubAfter

FROM ${MEDIA_CORE_FFMPEG_IMAGE} AS media-core-built-opencv
# Target arch, REDECLARED - see the media-core-built-ffmpeg stage above.
ARG WINDOWS_TARGET_ARCH=amd64
ENV WINDOWS_TARGET_ARCH=${WINDOWS_TARGET_ARCH}
# OpenCV links the chain's FFmpeg; declared here, not in `common`, so a flip re-runs only opencv and genai.
ARG OPENCV_LINK_CHAIN_FFMPEG="1"
# Not SCCACHE_CUDA_LAUNCHER: -BuildArg is global, so the shared name would re-key ONNX; mapped inside the RUN only.
ARG OPENCV_CUDA_LAUNCHER="1"
# Experiment knob: no CUDA response files, which sccache passes through uncached.
ARG OPENCV_CUDA_NO_RSP=""
# OpenCV's own version keys.
ARG OPENCV_SOURCE_VERSION=5.0.0
ARG OPENCV_VERSION=5.0.0
ENV OPENCV_LINK_CHAIN_FFMPEG="${OPENCV_LINK_CHAIN_FFMPEG}" `
    OPENCV_SOURCE_VERSION="${OPENCV_SOURCE_VERSION}" `
    OPENCV_VERSION="${OPENCV_VERSION}"
# Build-host sccache settings: RUN env only, never image ENV (see `common`).
ARG SCCACHE_WEBDAV_ENDPOINT
ARG SCCACHE_MULTILEVEL_CHAIN
ARG SCCACHE_FORCE_LOCAL
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=shared `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/Build-MediaCoreAll.ps1,target=C:\bkmnt\Build-MediaCoreAll.ps1 `
    --mount=type=bind,source=windows/scripts/build/Build-OpencvFromSource.ps1,target=C:\bkmnt\Build-OpencvFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsOrtProvenance.Build.psm1,target=C:\bkmnt\ortmods\WindowsOrtProvenance.Build.psm1 `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/patches/opencv,target=C:\bkmnt\patches\opencv `
    --mount=type=bind,source=windows/scripts/patches/opencv_contrib,target=C:\bkmnt\patches\opencv_contrib `
    $env:SCCACHE_CUDA_LAUNCHER = $env:OPENCV_CUDA_LAUNCHER; `
    & 'C:\bkmnt\Build-MediaCoreAll.ps1' -ResumeFrom 'OpenCV' -Until 'OpenCV' -ScriptDir 'C:\bkmnt' -ScrubAfter

# HailoRT, called directly: it shares only the module closure with the other phases; see docs/hailo-support.md.
FROM ${MEDIA_CORE_OPENCV_IMAGE} AS media-core-built-hailo
ARG WINDOWS_TARGET_ARCH=amd64
ENV WINDOWS_TARGET_ARCH=${WINDOWS_TARGET_ARCH}
ARG HAILORT_VERSION=5.4.0
ENV HAILORT_VERSION="${HAILORT_VERSION}"
# Forwarded as ARGs: an older parent's baked versions.env would leave these empty, and the script throws on empty pins.
ARG HAILORT_SOURCE_SHA256=7a0e43df03cad7086643029fd7dc3773a8231b1f6383705fe3036896a70472b0
ARG HAILO_PROTOBUF_VERSION=21.12
ARG HAILO_PROTOBUF_SHA256=22fdaf641b31655d4b2297f9981fa5203b2866f8332d3c6333f6b0107bb320de
# Build-host sccache settings: RUN env only, never image ENV (see `common`).
ARG SCCACHE_WEBDAV_ENDPOINT
ARG SCCACHE_MULTILEVEL_CHAIN
ARG SCCACHE_FORCE_LOCAL
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=shared `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/Build-HailortFromSource.ps1,target=C:\bkmnt\Build-HailortFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/patches/hailo,target=C:\bkmnt\patches\hailo `
    & 'C:\bkmnt\Build-HailortFromSource.ps1' -SourceDir 'C:\temp\hailort-src' -BuildDir 'C:\temp\hailort-build' -InstallDir 'C:\runtime\hailo'

FROM ${MEDIA_CORE_HAILO_IMAGE} AS media-core-built
# Target arch, REDECLARED - see the media-core-built-ffmpeg stage above.
ARG WINDOWS_TARGET_ARCH=amd64
ENV WINDOWS_TARGET_ARCH=${WINDOWS_TARGET_ARCH}
# The genai key lives here, so a GenAI bump re-runs this stage alone.
ARG ONNXRUNTIME_GENAI_VERSION=v0.15.2
ENV ONNXRUNTIME_GENAI_VERSION="${ONNXRUNTIME_GENAI_VERSION}"
# Every stage that mounts windows/qnn-sdk declares this, or Resolve-QnnSdk extracts unverified.
ARG QNN_SDK_ZIP_SHA256="52A5B0CC051EB2896848C9FD46E704612B1DC06E7D2F5D0D9A79FD8BCDD344BB"
ENV QNN_SDK_ZIP_SHA256="${QNN_SDK_ZIP_SHA256}"
# Build-host sccache settings: RUN env only, never image ENV (see `common`).
ARG SCCACHE_WEBDAV_ENDPOINT
ARG SCCACHE_MULTILEVEL_CHAIN
ARG SCCACHE_FORCE_LOCAL
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=shared `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/Build-MediaCoreAll.ps1,target=C:\bkmnt\Build-MediaCoreAll.ps1 `
    --mount=type=bind,source=windows/scripts/build/Build-OnnxGenaiFromSource.ps1,target=C:\bkmnt\Build-OnnxGenaiFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsOrtProvenance.Build.psm1,target=C:\bkmnt\ortmods\WindowsOrtProvenance.Build.psm1 `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/qnn-sdk,target=C:\temp\qnn-sdk `
    & 'C:\bkmnt\Build-MediaCoreAll.ps1' -ResumeFrom 'ONNX GenAI' -Until 'ONNX GenAI' -ScriptDir 'C:\bkmnt' -ScrubAfter

# litert: direct solve (bazel — never trips the defect), same mount pattern.
FROM media-litert-env AS media-litert-built
# Every stage that mounts windows/qnn-sdk declares this, or Resolve-QnnSdk extracts unverified.
ARG QNN_SDK_ZIP_SHA256="52A5B0CC051EB2896848C9FD46E704612B1DC06E7D2F5D0D9A79FD8BCDD344BB"
ENV QNN_SDK_ZIP_SHA256="${QNN_SDK_ZIP_SHA256}"
# Build-host sccache settings: RUN env only, never image ENV (see `common`).
ARG SCCACHE_WEBDAV_ENDPOINT
ARG SCCACHE_MULTILEVEL_CHAIN
ARG SCCACHE_FORCE_LOCAL
# bazel's output_base stays container-local (rename-heavy, and the cache mount is rename-hostile); the CMake fallback stays mounted.
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=shared `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=cache,target=C:\bzl-repo-cache,id=bazel-litertlm-winamd64,sharing=locked `
    --mount=type=bind,source=windows/scripts/build/Build-LitertAll.ps1,target=C:\bkmnt\Build-LitertAll.ps1 `
    --mount=type=bind,source=windows/scripts/build/Build-LitertFromSource.ps1,target=C:\bkmnt\Build-LitertFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/build/Build-LitertLmBazel.ps1,target=C:\bkmnt\Build-LitertLmBazel.ps1 `
    --mount=type=bind,source=windows/scripts/build/Build-LitertLmFromSource.ps1,target=C:\bkmnt\Build-LitertLmFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/build/Export-LitertLmBridge.ps1,target=C:\bkmnt\Export-LitertLmBridge.ps1 `
    --mount=type=bind,source=windows/scripts/build/Debug-LitertlmLink.ps1,target=C:\bkmnt\Debug-LitertlmLink.ps1 `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/qnn-sdk,target=C:\temp\qnn-sdk `
    --mount=type=bind,source=windows/scripts/shims,target=C:\bkmnt\shims `
    --mount=type=bind,source=windows/scripts/patches/litert-lm,target=C:\bkmnt\patches\litert-lm `
    $env:BAZEL_REPO_CACHE = 'C:\bzl-repo-cache'; & 'C:\bkmnt\Build-LitertAll.ps1' -ScriptDir 'C:\bkmnt' -ScrubAfter

# tvm: direct solve, same mount pattern.
FROM media-tvm-env AS media-tvm-built
# Every stage that mounts windows/qnn-sdk declares this, or Resolve-QnnSdk extracts unverified.
ARG QNN_SDK_ZIP_SHA256="52A5B0CC051EB2896848C9FD46E704612B1DC06E7D2F5D0D9A79FD8BCDD344BB"
ENV QNN_SDK_ZIP_SHA256="${QNN_SDK_ZIP_SHA256}"
# ARG only, no ENV: Build-TvmFromSource.ps1 reads it at RUN time and nothing downstream should.
ARG TVM_ROCM=0
# Build-host sccache settings: RUN env only, never image ENV (see `common`).
ARG SCCACHE_WEBDAV_ENDPOINT
ARG SCCACHE_MULTILEVEL_CHAIN
ARG SCCACHE_FORCE_LOCAL
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=shared `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/Build-MediaTvmAll.ps1,target=C:\bkmnt\Build-MediaTvmAll.ps1 `
    --mount=type=bind,source=windows/scripts/build/Build-TargetCpython.ps1,target=C:\bkmnt\Build-TargetCpython.ps1 `
    --mount=type=bind,source=windows/scripts/build/cpython-Directory.Build.props,target=C:\bkmnt\cpython-Directory.Build.props `
    --mount=type=bind,source=windows/scripts/build/Build-TvmFromSource.ps1,target=C:\bkmnt\Build-TvmFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/build/Build-IreeFromSource.ps1,target=C:\bkmnt\Build-IreeFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,from=tvmmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/qnn-sdk,target=C:\temp\qnn-sdk `
    --mount=type=bind,source=windows/scripts/patches/iree,target=C:\bkmnt\patches\iree `
    & 'C:\bkmnt\Build-MediaTvmAll.ps1' -ScriptDir 'C:\bkmnt' -ScrubAfter
