# rocm lane only: AMD MIGraphX from source and AMD's ORT plugin EP (migraphx-ep.dll) on the merged
# rocm media. Lineage: media -> THIS -> llama -> torch. docs/windows-builds.md § ROCm layer.

ARG BASE_IMAGE=docker.io/local/kataglyphis:bk-windows-media-rocm

# The two scripts' module closure, mounted as one directory (the buildmods pattern of the media lane).
FROM ${BASE_IMAGE} AS migraphxmods
COPY windows\scripts\modules\WindowsSourceBuild.Common.psm1 `
     windows\scripts\modules\WindowsScripts.Shared.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Patches.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Cuda.psm1 `
     windows\scripts\modules\WindowsNative.Common.psm1 `
     windows\scripts\modules\WindowsTargetArch.Common.psm1 `
     windows\scripts\modules\WindowsMigraphx.Common.psm1 `
     C:\bkmods\

FROM ${BASE_IMAGE} AS built

SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; $PSNativeCommandUseErrorActionPreference = $false;"]

# The base image bakes the media run's sccache ENV; re-ENV so this run's endpoint wins.
# Same values and reasons as Dockerfile.media-merge-builder's `built` stage.
ARG SCCACHE_WEBDAV_ENDPOINT=""
ARG SCCACHE_LOG="warn"
ARG SCCACHE_MULTILEVEL_CHAIN=""
ARG SCCACHE_DIR="C:\sccache\v2"
ARG SCCACHE_FORCE_LOCAL=""
ENV SCCACHE_WEBDAV_ENDPOINT="${SCCACHE_WEBDAV_ENDPOINT}" `
    SCCACHE_MULTILEVEL_CHAIN="${SCCACHE_MULTILEVEL_CHAIN}" `
    SCCACHE_DIR="${SCCACHE_DIR}" `
    SCCACHE_FORCE_LOCAL="${SCCACHE_FORCE_LOCAL}" `
    SCCACHE_CACHE_SIZE="15G" `
    SCCACHE_ERROR_LOG="C:\sccache-logs\sccache-error.log" `
    SCCACHE_LOG="${SCCACHE_LOG}" `
    SCCACHE_IDLE_TIMEOUT="0"

# Values: versions.env, forwarded by Get-MediaBranchVersionArg -Branch rocm-migraphx. ARG only:
# a RUN sees them as env, and an ENV would bake build pins into every image downstream.
ARG ROCM_WINDOWS_GFX_FAMILY=gfx120X-all
ARG MIGRAPHX_VERSION=2.17.0
ARG MIGRAPHX_WINDOWS_COMMIT=becdb3da862f2297041b746b90bc6130e2b1d1f7
ARG MIGRAPHX_WINDOWS_SOURCE_SHA256=52038e4cd6eadc88e8f66c51b255263c2c58a84f90aeb7c76c322880864bf8b4
ARG MIGRAPHX_WINDOWS_ABSEIL_VERSION=20250512.0
ARG MIGRAPHX_WINDOWS_ABSEIL_SHA256=7262daa7c1711406248c10f41026d685e88223bc92817d16fb93c19adb57f669
ARG MIGRAPHX_WINDOWS_PROTOBUF_VERSION=30.0
ARG MIGRAPHX_WINDOWS_PROTOBUF_SHA256=9df0e9e8ebe39f4fbbb9cf7db3d811287fe3616b2f191eb2bf5eaa12539c881f
ARG MIGRAPHX_WINDOWS_MSGPACK_VERSION=3.3.0
ARG MIGRAPHX_WINDOWS_MSGPACK_SHA256=6e114d12a5ddb8cb11f669f83f32246e484a8addd0ce93f274996f1941c1f07b
ARG MIGRAPHX_WINDOWS_SQLITE_VERSION=3500400
ARG MIGRAPHX_WINDOWS_SQLITE_YEAR=2025
ARG MIGRAPHX_WINDOWS_SQLITE_SHA256=1d3049dd0f830a025a53105fc79fd2ab9431aea99e137809d064d8ee8356b032
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=shared `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/Build-MigraphxFromSource.ps1,target=C:\bkmnt\Build-MigraphxFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,from=migraphxmods,source=/bkmods,target=C:\bkmnt\modules `
    & 'C:\bkmnt\Build-MigraphxFromSource.ps1' -InstallDir 'C:\runtime\lib\migraphx' -WorkDir 'C:\temp\migraphx-work'

# Declared AFTER the MIGraphX RUN, so an EP pin bump never re-runs that compile.
ARG ORT_AMDGPU_EP_COMMIT=99ab5cb43caa421e0b19870fa4ce9323117e5e56
ARG ORT_AMDGPU_EP_SOURCE_SHA256=4012b64328a541089b7c6f034051bc9695b395331e06cd74181e235ee0cb42bd
ARG ORT_AMDGPU_EP_FMT_VERSION=12.1.0
ARG ORT_AMDGPU_EP_FMT_SHA256=695fd197fa5aff8fc67b5f2bbc110490a875cdf7a41686ac8512fb480fa8ada7
ARG ORT_AMDGPU_EP_GSL_VERSION=4.2.1
ARG ORT_AMDGPU_EP_GSL_SHA256=c9291d95f5f6e5c561990d06a589b01d89e553d0f366f0ce723dd1788e7a6076
ARG ORT_AMDGPU_EP_JSON_VERSION=3.12.0
ARG ORT_AMDGPU_EP_JSON_SHA256=42f6e95cad6ec532fd372391373363b62a14af6d771056dbfc86160e6dfff7aa
ARG ORT_AMDGPU_EP_ZLIB_VERSION=1.3.1
ARG ORT_AMDGPU_EP_ZLIB_SHA256=38ef96b8dfe510d42707d9c781877914792541133e1870841463bfa73f883e32
ARG ORT_AMDGPU_EP_PROTOBUF_VERSION=34.1
ARG ORT_AMDGPU_EP_PROTOBUF_SHA256=a79296d3ee43cab5cf72fe702ba8822a607720704c439fad6f285a37f51550b4
ARG ORT_AMDGPU_EP_ABSEIL_VERSION=20250512.1
ARG ORT_AMDGPU_EP_ABSEIL_SHA256=9b7a064305e9fd94d124ffa6cc358592eb42b5da588fb4e07d09254aa40086db
ARG ORT_AMDGPU_EP_ONNX_VERSION=1.21.0
ARG ORT_AMDGPU_EP_ONNX_SHA256=b8b56570d94ecce49fee94e6380db456bb42035722b967015c9dd6459359433e
ARG ORT_AMDGPU_EP_FLATBUFFERS_VERSION=25.12.19
ARG ORT_AMDGPU_EP_FLATBUFFERS_SHA256=f5d4636bfc4d30c622c9ad238ce947848c2b90b10aecd387dc62cdee2584359b
ARG ORT_AMDGPU_EP_RANGE_V3_VERSION=0.12.0
ARG ORT_AMDGPU_EP_RANGE_V3_SHA256=cbcb96beda464e71d293c07dec89ef5c0790ca83d37b0e199890893019441044
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=shared `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/Build-OrtAmdgpuEpFromSource.ps1,target=C:\bkmnt\Build-OrtAmdgpuEpFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,from=migraphxmods,source=/bkmods,target=C:\bkmnt\modules `
    & 'C:\bkmnt\Build-OrtAmdgpuEpFromSource.ps1' -InstallDir 'C:\runtime\lib\onnxruntime-ep-amdgpu' -MigraphxDir 'C:\runtime\lib\migraphx' -WorkDir 'C:\temp\ort-amdgpu-ep-work'

# Where the rocm-checks and users find them; unset means this stage never ran (-NoRocmSpikes).
ENV MIGRAPHX_ROOT="C:\runtime\lib\migraphx" `
    ORT_AMDGPU_EP_ROOT="C:\runtime\lib\onnxruntime-ep-amdgpu"
