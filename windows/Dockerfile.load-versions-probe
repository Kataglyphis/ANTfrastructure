# escape=`
# Proves Import-Versions.ps1 bakes a process-env override to Machine; run via Invoke-DiagnosticProbe.ps1 -Dockerfile.
ARG BASE_IMAGE=local/kataglyphis:bk-windows-toolchain
FROM ${BASE_IMAGE} AS probe

# Layer-cache buster (a CACHED run replays an old verdict).
ARG PROBE_NONCE="0"

# The base's shape: the key is in the process env (ARG there) while Machine is empty.
ENV GIT_VERSION="probe-override-value"

RUN --mount=type=bind,source=windows/scripts,target=C:\bkmnt `
    Write-Host ('machine BEFORE: [' + [Environment]::GetEnvironmentVariable('GIT_VERSION','Machine') + ']'); `
    & C:\bkmnt\build\Import-Versions.ps1 2>&1 | Select-String 'GIT_VERSION|loaded' | ForEach-Object { "$_" }; `
    $m = [Environment]::GetEnvironmentVariable('GIT_VERSION','Machine'); `
    Write-Host ('machine AFTER: [' + $m + ']'); `
    if ($m -ne 'probe-override-value') { throw 'override was NOT baked to Machine env' }; `
    Write-Host ('control SCCACHE_WINDOWS_VERSION machine: [' + [Environment]::GetEnvironmentVariable('SCCACHE_WINDOWS_VERSION','Machine') + ']'); `
    Write-Host 'probe complete'
