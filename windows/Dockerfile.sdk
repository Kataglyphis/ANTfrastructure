# escape=`
# Generic Windows SDK layer (no GPU).
# GPU-specific layers (Dockerfile.nvidia, Dockerfile.amd) build on top of this.
# Downstream layers (media, final) consume the GPU layer for accelerated builds.

ARG BASE_IMAGE=local/kataglyphis:windows-base
FROM ${BASE_IMAGE}

SHELL ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

COPY windows\scripts C:\temp\scripts

# Generic SDK tools (no GPU). GPU layers install their own deps.
