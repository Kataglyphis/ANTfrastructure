# escape=`
# =============================================================================
# Forensic probe: replay ONE real ORT CUDA TU bare vs sccache-wrapped and
# diff symbols (see probe-onnx-tu-replay.ps1). Ships nothing. Run via:
#   run-diagnostic-probe.ps1 -Dockerfile Dockerfile.onnx-tu-replay-probe -BaseImage local/kataglyphis:bk-windows-toolchain
# =============================================================================
ARG BASE_IMAGE=local/kataglyphis:bk-windows-toolchain
FROM ${BASE_IMAGE} AS probe

# Layer-cache buster (a CACHED run replays an old verdict).
ARG PROBE_NONCE="0"
# Which ORT tag to replay (the bug is version-independent; measured on 1.28+1.29).
ARG ORT_REF="v1.28.0"

RUN --mount=type=bind,source=windows/scripts/probe-onnx-tu-replay.ps1,target=C:\bkmnt\probe-onnx-tu-replay.ps1 `
    --mount=type=bind,source=windows/scripts/modules,target=C:\bkmnt\modules `
    & 'C:\bkmnt\probe-onnx-tu-replay.ps1' -Nonce "${PROBE_NONCE}"
