# Cheap CPython checkout here, the compile in the `built` stage; the split is a useful resume boundary.

ARG BASE_IMAGE=local/kataglyphis:windows-sdk
FROM ${BASE_IMAGE} AS builder

ARG PYTHON_VERSION=3.14.7
# Baked as ENV so the `built` stage's compile script sees the canonical version.
ENV PYTHON_VERSION="${PYTHON_VERSION}"

SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; $PSNativeCommandUseErrorActionPreference = $false;"]

# Clone CPython source at the canonical version (cheap, network-bound — fine at 2 CPUs).
RUN if (-not (Test-Path 'C:\temp\cpython')) { git clone --branch v$env:PYTHON_VERSION --depth 1 https://github.com/python/cpython.git C:\temp\cpython 2>&1 | Write-Host }

# A checked-in file, since the frontend strips double quotes from an inline RUN's XML.
COPY windows/scripts/build/cpython-Directory.Build.props C:\temp\cpython\PCbuild\Directory.Build.props
# Downstream media builds find the built CPython via PATH.
ENV PYTHON_BUILD_BIN="C:\temp\cpython\PCbuild\amd64"
ENV PATH=$PYTHON_BUILD_BIN;$PATH

# Inputs are bind mounts, so an edit to them never invalidates this stage's ancestry.
FROM builder AS built
RUN --mount=type=bind,source=windows/scripts/build/Build-ToolchainAll.ps1,target=C:\bkmnt\Build-ToolchainAll.ps1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsScripts.Shared.psm1,target=C:\bkmnt\modules\WindowsScripts.Shared.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsSourceBuild.Common.psm1,target=C:\bkmnt\modules\WindowsSourceBuild.Common.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsTargetArch.Common.psm1,target=C:\bkmnt\modules\WindowsTargetArch.Common.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsSourceBuild.Patches.psm1,target=C:\bkmnt\modules\WindowsSourceBuild.Patches.psm1 `
    --mount=type=bind,source=windows/scripts/patches/cpython,target=C:\bkmnt\patches\cpython `
    --mount=type=bind,source=linux/scripts/01-core/versions.env,target=C:\bkmnt\versions.env `
    & 'C:\bkmnt\Build-ToolchainAll.ps1'

# Pinned LLVM plus llvm#219275/#219276 (the AArch64 aborts), not main, so the provenance gate still passes; -StockLlvm opts out.
FROM built AS patched-llvm
ARG BUILD_PATCHED_LLVM=1
# Build-host settings are ARGs only; see docs/windows-build-resources.md § What the published image carries.
ARG SCCACHE_WEBDAV_ENDPOINT
ARG SCCACHE_MULTILEVEL_CHAIN
ARG SCCACHE_FORCE_LOCAL
ARG SCCACHE_LOG="warn"
ARG SCCACHE_DIR="C:\sccache\v2"
ENV SCCACHE_DIR="${SCCACHE_DIR}" `
    SCCACHE_CACHE_SIZE="15G" `
    SCCACHE_ERROR_LOG="C:\sccache-logs\sccache-error.log" `
    SCCACHE_LOG="${SCCACHE_LOG}" `
    SCCACHE_IDLE_TIMEOUT="0"
# Per-file module mounts: a whole-dir mount would re-key this LLVM compile on every module edit.
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=shared `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/Build-LlvmFromSource.ps1,target=C:\bkmnt\Build-LlvmFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsSourceBuild.Common.psm1,target=C:\bkmnt\modules\WindowsSourceBuild.Common.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsScripts.Shared.psm1,target=C:\bkmnt\modules\WindowsScripts.Shared.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsSourceBuild.Patches.psm1,target=C:\bkmnt\modules\WindowsSourceBuild.Patches.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsSourceBuild.Cuda.psm1,target=C:\bkmnt\modules\WindowsSourceBuild.Cuda.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsNative.Common.psm1,target=C:\bkmnt\modules\WindowsNative.Common.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsTargetArch.Common.psm1,target=C:\bkmnt\modules\WindowsTargetArch.Common.psm1 `
    --mount=type=bind,source=windows/scripts/patches/llvm,target=C:\bkmnt\patches\llvm `
    --mount=type=bind,source=linux/scripts/01-core/versions.env,target=C:\bkmnt\versions.env `
    if ($env:BUILD_PATCHED_LLVM -eq '1') { & 'C:\bkmnt\Build-LlvmFromSource.ps1' -SkipIfPresent } `
    else { Write-Host 'BUILD_PATCHED_LLVM != 1 - keeping the scoop clang-cl' }

# Build scripts call bare clang-cl, so shadowing the scoop shims is the whole integration.
ENV PATH="C:\llvm-patched\bin;$PATH"
