# Thin builder image for the toolchain run+commit path (windows/build.ps1
# Invoke-RunCommitStage). It clones CPython and writes Directory.Build.props — both
# cheap/IO-bound layers that Hyper-V `docker build` commits reliably — but runs NO
# heavy compile. The CPU-bound `PCbuild\build.bat` then runs via:
#   docker run --isolation hyperv --cpu-count N --memory Mg <this image> `
#       pwsh -File C:\temp\scripts\build-toolchain-all.ps1
#   docker commit <container> local/kataglyphis:windows-toolchain
# because `docker build` on this host is capped at 2 CPUs and process isolation
# cannot commit layers (see windows/build.ps1 CPU note). The committed image is a
# drop-in replacement for the old Dockerfile.toolchain output.

ARG BASE_IMAGE=local/kataglyphis:windows-sdk
FROM ${BASE_IMAGE}

ARG PYTHON_VERSION=3.14.6
# Baked as ENV so the run+commit compile script sees the canonical version.
ENV PYTHON_VERSION="${PYTHON_VERSION}"

# Clone CPython source at the canonical version (cheap, network-bound — fine at 2 CPUs).
SHELL ["cmd", "/S", "/C"]
RUN set "PYTHON_VERSION=%PYTHON_VERSION%" && if not exist "C:\temp\cpython\" git clone --branch v%PYTHON_VERSION% --depth 1 https://github.com/python/cpython.git C:\temp\cpython

# Write Directory.Build.props (ClangCL PlatformToolset) via cmd.exe caret-escaped
# echo — the canonical Windows form for a correct XML prolog (PowerShell ASCII
# Set-Content produces XML MSBuild rejects). Mirrors the old Dockerfile.toolchain.
RUN cd /d C:\temp\cpython && `
    echo ^<?xml version="1.0" encoding="utf-8"?^> > PCbuild\Directory.Build.props && `
    echo ^<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003"^> >> PCbuild\Directory.Build.props && `
    echo   ^<PropertyGroup^> >> PCbuild\Directory.Build.props && `
    echo     ^<PlatformToolset^>ClangCL^</PlatformToolset^> >> PCbuild\Directory.Build.props && `
    echo ^</PropertyGroup^> >> PCbuild\Directory.Build.props && `
    echo ^</Project^> >> PCbuild\Directory.Build.props

# The run+commit compile entrypoint (does the heavy build.bat at full --cpu-count).
SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]
# Shared module for build-toolchain-all.ps1's nuget pre-seed (Invoke-DownloadWithRetry).
COPY windows\scripts\modules\WindowsScripts.Shared.psm1 C:\temp\scripts\modules\
COPY windows\scripts\build-toolchain-all.ps1 C:\temp\scripts\

# Expose the (to-be-built) source Python via PATH for downstream media builds.
# Set here so `docker commit` preserves it in the result image (the interpreter is
# produced by the run step, but ENV is metadata and is carried over by the commit).
ENV PYTHON_BUILD_BIN="C:\temp\cpython\PCbuild\amd64"
ENV PATH=$PYTHON_BUILD_BIN;$PATH
