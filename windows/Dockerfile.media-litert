# escape=`
# Copyright (c) 2025 Kataglyphis. All rights reserved.
# SPDX-License-Identifier: Apache-2.0
# Media branch B: LiteRT → LiteRT-LM (independent of the ONNX chain — builds in
# parallel with Dockerfile.media-core / Dockerfile.media-tvm; merged in
# Dockerfile.media). LiteRT-LM depends on LiteRT's install, so the two stay
# sequential inside this branch.

ARG BASE_IMAGE=local/kataglyphis:windows-toolchain
FROM ${BASE_IMAGE}

ARG LITERT_VERSION=v2.1.6
ARG LITERT_LM_VERSION=0.13.1
ARG MEMORY_LIMIT_GB=""
ARG SCCACHE_WEBDAV_ENDPOINT=""

ENV MEMORY_LIMIT_GB="${MEMORY_LIMIT_GB}"
ENV SCCACHE_WEBDAV_ENDPOINT="${SCCACHE_WEBDAV_ENDPOINT}"

SHELL ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

COPY windows\scripts\modules\WindowsScripts.Shared.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Common.psm1 `
     C:\temp\scripts\modules\

# ── LiteRT (TensorFlow Lite runtime, CUDA/GPU auto-detected) ─────────────────
ENV LITERT_VERSION="${LITERT_VERSION}"
COPY windows\scripts\build-litert-from-source.ps1 C:\temp\scripts\
RUN & 'C:\temp\scripts\build-litert-from-source.ps1' -SourceDir 'C:\temp\litert-src' -InstallDir 'C:\runtime'

# ── LiteRT-LM (on-device LLM inference, needs the LiteRT install above) ─────
ENV LITERT_LM_VERSION="${LITERT_LM_VERSION}"
COPY windows\scripts\build-litert-lm-from-source.ps1 C:\temp\scripts\
RUN & 'C:\temp\scripts\build-litert-lm-from-source.ps1' -SourceDir 'C:\temp\litert-lm-src' -InstallDir 'C:\runtime'
