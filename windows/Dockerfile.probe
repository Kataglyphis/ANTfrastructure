# escape=`
# The one probe Dockerfile (Invoke-DiagnosticProbe.ps1 -ProbeScript); whole-dir mounts are fine only because PROBE_NONCE busts the layer.
ARG BASE_IMAGE=local/kataglyphis:bk-windows-toolchain
FROM ${BASE_IMAGE} AS probe

# Layer-cache buster (a CACHED run replays an old verdict).
ARG PROBE_NONCE="0"
ARG PROBE_SCRIPT="Test-OnnxTuReplay.ps1"
# Declared so a -BuildArg ORT_REF override is not silently discarded.
ARG ORT_REF=""

# $env: not ${VAR}: RUN gets no frontend substitution; the exit check and marker keep the probe fail-closed.
RUN --mount=type=bind,source=windows/scripts/diagnostics,target=C:\bkmnt\diagnostics `
    --mount=type=bind,source=windows/scripts/modules,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/patches,target=C:\bkmnt\patches `
    --mount=type=bind,source=linux/scripts/01-core/versions.env,target=C:\bkmnt\versions.env `
    & (Join-Path 'C:\bkmnt\diagnostics' $env:PROBE_SCRIPT) -Nonce $env:PROBE_NONCE; `
    if ($LASTEXITCODE) { exit $LASTEXITCODE }; `
    Write-Host 'probe complete'
