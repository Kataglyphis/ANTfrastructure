# escape=`
# =============================================================================
# What shape are OpenCV's CUDA nvcc commands? (#115 facts). Configure-only.
#   run-diagnostic-probe.ps1 -Dockerfile Dockerfile.opencv-cmdshape-probe -BaseImage local/kataglyphis:bk-windows-toolchain
# =============================================================================
ARG BASE_IMAGE=local/kataglyphis:bk-windows-toolchain
FROM ${BASE_IMAGE} AS probe

# Layer-cache buster (a CACHED run replays an old verdict).
ARG PROBE_NONCE="0"

RUN --mount=type=bind,source=windows/scripts/probe-opencv-cuda-cmdshape.ps1,target=C:\bkmnt\probe-opencv-cuda-cmdshape.ps1 `
    --mount=type=bind,source=windows/scripts/modules,target=C:\bkmnt\modules `
    & 'C:\bkmnt\probe-opencv-cuda-cmdshape.ps1' -Nonce "${PROBE_NONCE}"
