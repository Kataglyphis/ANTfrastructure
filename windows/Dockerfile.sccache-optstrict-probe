# escape=`
# =============================================================================
# Canonical repro: sccache clang-cl -options:strict loses the object (#100).
#   run-diagnostic-probe.ps1 -Dockerfile Dockerfile.sccache-optstrict-probe -BaseImage local/kataglyphis:bk-windows-toolchain
# =============================================================================
ARG BASE_IMAGE=local/kataglyphis:bk-windows-toolchain
FROM ${BASE_IMAGE} AS probe

# Layer-cache buster (a CACHED run replays an old verdict).
ARG PROBE_NONCE="0"

RUN --mount=type=bind,source=windows/scripts/diagnostics/probe-sccache-options-strict.ps1,target=C:\bkmnt\probe-sccache-options-strict.ps1 `
    --mount=type=bind,source=windows/scripts/modules,target=C:\bkmnt\modules `
    & 'C:\bkmnt\probe-sccache-options-strict.ps1' -Nonce "${PROBE_NONCE}"
