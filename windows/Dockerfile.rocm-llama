# escape=`
# Copyright (c) 2025 Kataglyphis
# SPDX-License-Identifier: MIT
# rocm lane only: llama.cpp's HIP backend built from source, the prebuilt Vulkan zip; see docs/windows-rocm.md § llama.cpp HIP and Vulkan (`Dockerfile.rocm-llama`, rocm lane only).

ARG BASE_IMAGE=docker.io/local/kataglyphis:bk-windows-media-migraphx-rocm

# The scripts' module closure, mounted as one directory (the buildmods pattern of the media lane).
FROM ${BASE_IMAGE} AS llamamods
COPY windows\scripts\modules\WindowsSourceBuild.Common.psm1 `
     windows\scripts\modules\WindowsScripts.Shared.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Patches.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Cuda.psm1 `
     windows\scripts\modules\WindowsNative.Common.psm1 `
     windows\scripts\modules\WindowsTargetArch.Common.psm1 `
     windows\scripts\modules\WindowsPythonWheel.Common.psm1 `
     windows\scripts\modules\WindowsMigraphx.Common.psm1 `
     windows\scripts\modules\WindowsContainerImage.Common.psm1 `
     C:\bkmods\

FROM ${BASE_IMAGE} AS built

SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; $PSNativeCommandUseErrorActionPreference = $false;"]

# Build-host settings are ARGs only; see docs/windows-build-resources.md § What the published image carries.
ARG SCCACHE_WEBDAV_ENDPOINT
ARG SCCACHE_LOG="warn"
ARG SCCACHE_MULTILEVEL_CHAIN
ARG SCCACHE_DIR="C:\sccache\v2"
ARG SCCACHE_FORCE_LOCAL
ENV SCCACHE_DIR="${SCCACHE_DIR}" `
    SCCACHE_CACHE_SIZE="15G" `
    SCCACHE_ERROR_LOG="C:\sccache-logs\sccache-error.log" `
    SCCACHE_LOG="${SCCACHE_LOG}" `
    SCCACHE_IDLE_TIMEOUT="0"

# No PATH entry: their ggml*.dll, llama.dll and libomp.dll would shadow every other copy of those names.
ENV LLAMA_CPP_HIP_HOME="C:\runtime\opt\llama.cpp-hip"

# Values: versions.env (the driver forwards them; bump every LLAMA_CPP_* together). ARG only, like the migraphx stage.
ARG ROCM_WINDOWS_GFX_FAMILY=gfx120X-all
ARG LLAMA_CPP_HIP_BUILD=11476
ARG LLAMA_CPP_HIP_COMMIT=988190680d5a89fce97de3c20df2c2813731fd61
ARG LLAMA_CPP_HIP_SOURCE_SHA256=f6a3888e662b7ad9e6a892588c83cc67f18781b884a209ccae1fc30b7510cac0
ARG LLAMA_CPP_CPU_SHA256=a23e548c6b3525c38bcfeceaff919786ae06741857043cb670279b70100e5483
ARG LLAMA_CPP_HIP_LICENSE_SHA256=94f29bbed6a22c35b992c5c6ebf0e7c92f13b836b90f36f461c9cf2f0f1d010d
ENV LLAMA_CPP_HIP_BUILD="${LLAMA_CPP_HIP_BUILD}"

# ggml-hip.dll from source, then the tag's CPU zip beside it; the check runs here so a broken pin fails this stage.
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=shared `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/Build-LlamaCppHipFromSource.ps1,target=C:\bkmnt\Build-LlamaCppHipFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/build/Install-LlamaCpp.ps1,target=C:\bkmnt\Install-LlamaCpp.ps1 `
    --mount=type=bind,source=windows/scripts/build/rocm-checks/LlamaCpp.ps1,target=C:\bkmnt\LlamaCpp.ps1 `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,from=llamamods,source=/bkmods,target=C:\bkmnt\modules `
    & 'C:\bkmnt\Build-LlamaCppHipFromSource.ps1' -OutputDir 'C:\temp\llama-cpp-hip-built' -WorkDir 'C:\temp\llama-cpp-hip-work'; `
    & 'C:\bkmnt\Install-LlamaCpp.ps1' -Backend hip -TempDir $env:TEMP_DIR -InstallDir $env:LLAMA_CPP_HIP_HOME -BuiltDir 'C:\temp\llama-cpp-hip-built'; `
    Remove-Item -LiteralPath 'C:\temp\llama-cpp-hip-built' -Recurse -Force; `
    $findings = @(& 'C:\bkmnt\LlamaCpp.ps1' -Backend hip); `
    if ($findings.Count -gt 0) { throw ('llama.cpp HIP check failed: ' + ($findings -join ' | ')) }

# Declared after the HIP RUN, so a Vulkan pin moves only this layer.
ARG LLAMA_CPP_VULKAN_SHA256=5c71e7b749697da4a8d46e9ee55486845cbba27c9dfbecb4007f31ba6610d523
ENV LLAMA_CPP_VULKAN_HOME="C:\runtime\opt\llama.cpp-vulkan"
RUN --mount=type=bind,source=windows/scripts/build/Install-LlamaCpp.ps1,target=C:\bkmnt\Install-LlamaCpp.ps1 `
    --mount=type=bind,source=windows/scripts/build/rocm-checks/LlamaCpp.ps1,target=C:\bkmnt\LlamaCpp.ps1 `
    --mount=type=bind,from=llamamods,source=/bkmods,target=C:\bkmnt\modules `
    & 'C:\bkmnt\Install-LlamaCpp.ps1' -Backend vulkan -TempDir $env:TEMP_DIR -InstallDir $env:LLAMA_CPP_VULKAN_HOME; `
    $findings = @(& 'C:\bkmnt\LlamaCpp.ps1' -Backend vulkan); `
    if ($findings.Count -gt 0) { throw ('llama.cpp Vulkan check failed: ' + ($findings -join ' | ')) }
