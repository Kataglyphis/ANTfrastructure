#
# Builder image for the media-core run+commit path (windows/build.ps1). It carries
# the toolchain plus every media-core build script/patch and the orchestration
# script build-media-core-all.ps1 — but runs NO heavy compiles itself, so it builds
# with cheap COPY-only layers that Hyper-V `docker build` commits reliably.
#
# The heavy ONNX/GenAI/OpenCV/FFmpeg compiles then run via
#   docker run --isolation hyperv --cpu-count N --memory Mg <this image> \
#       powershell -File C:\temp\scripts\build-media-core-all.ps1
#   docker commit <container> local/kataglyphis:windows-media-core
# because `docker build` on this host is capped at 2 CPUs and process isolation
# cannot commit layers (see windows/build.ps1 CPU note). The committed image is a
# drop-in replacement for the old Dockerfile.media-core output.

ARG BASE_IMAGE=local/kataglyphis:windows-toolchain
FROM ${BASE_IMAGE}

# ARG defaults mirror linux/scripts/01-core/versions.env (single source of truth);
# windows/build.ps1 passes the canonical values as --build-arg. They are baked as
# ENV so the compile chain (run via `docker run`) sees them.
ARG ONNXRUNTIME_VERSION=v1.27.0
ARG ONNXRUNTIME_GENAI_VERSION=v0.14.0
ARG OPENCV_SOURCE_VERSION=5.x
ARG FFMPEG_VERSION=master
# Container --memory cap (GB), forwarded so Get-BuildJobCount scales parallelism to
# the cap. With the run+commit path the container also gets --cpu-count CPUs, so
# jobs = min(cpu-count, MEMORY_LIMIT_GB / MemGBPerJob).
ARG MEMORY_LIMIT_GB=""
# Optional persistent sccache remote (e.g. WebDAV server on the host); empty = off.
ARG SCCACHE_WEBDAV_ENDPOINT=""
# Target CUDA architectures (canonical form; build scripts append -real)
ARG CUDA_ARCHITECTURES=80;86;89;90

ENV ONNXRUNTIME_VERSION="${ONNXRUNTIME_VERSION}"
ENV ONNXRUNTIME_GENAI_VERSION="${ONNXRUNTIME_GENAI_VERSION}"
ENV OPENCV_SOURCE_VERSION="${OPENCV_SOURCE_VERSION}"
ENV FFMPEG_VERSION="${FFMPEG_VERSION}"
ENV MEMORY_LIMIT_GB="${MEMORY_LIMIT_GB}"
ENV SCCACHE_WEBDAV_ENDPOINT="${SCCACHE_WEBDAV_ENDPOINT}"
ENV CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}"

SHELL ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Only the modules the build scripts import (keeps CI-module edits from busting this image).
COPY windows\scripts\modules\WindowsScripts.Shared.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Common.psm1 `
     C:\temp\scripts\modules\

# Per-stage patches (mirrors the COPY steps that Dockerfile.media-core carried).
COPY windows\scripts\patches\onnxruntime     C:\temp\scripts\patches\onnxruntime
COPY windows\scripts\patches\opencv          C:\temp\scripts\patches\opencv
COPY windows\scripts\patches\opencv_contrib  C:\temp\scripts\patches\opencv_contrib
COPY windows\scripts\patches\ffmpeg          C:\temp\scripts\patches\ffmpeg

# The four source-build scripts + the orchestration entrypoint.
COPY windows\scripts\build-onnx-from-source.ps1 `
     windows\scripts\build-onnx-genai-from-source.ps1 `
     windows\scripts\build-opencv-from-source.ps1 `
     windows\scripts\build-ffmpeg-from-source.ps1 `
     windows\scripts\build-media-core-all.ps1 `
     C:\temp\scripts\
