# escape=`
# Copyright (c) 2025 Kataglyphis
# SPDX-License-Identifier: MIT
# Cached Windows toolchain base image.
# Installs non-AI build tooling so CUDA/ONNX/OpenCV can live in a derived layer.
# Build scripts live in the media layer.

ARG WINDOWS_LTSC=2025
# Digest pin (versions.env WINDOWS_BASE_DIGEST): the :ltsc tag floats with
# Microsoft's monthly patch releases; the digest makes a from-base rebuild
# reproducible and base OS revisions deliberate (they matter here — the wcifs
# commit bug is version-skew-sensitive). The digest wins over the tag.
ARG WINDOWS_BASE_DIGEST=sha256:d5bbb83057f6bc2b6aeba5d01ec80a53003aba9bc84a6b1ebe780570cd52558a
FROM mcr.microsoft.com/windows/servercore:ltsc${WINDOWS_LTSC:-2025}@${WINDOWS_BASE_DIGEST}
# PowerShell 7 (pwsh) version — single source of truth is versions.env, forwarded
# by build.ps1 as --build-arg. Installed early so all subsequent layers use pwsh
# as the default container shell instead of Windows PowerShell 5.1.
# The zip's SHA256 rides along as an ARG because this bootstrap runs before any
# shared module (Invoke-DownloadWithRetry) or versions.env baking is available.
ARG PWSH_VERSION=7.6.4
ARG PWSH_ZIP_SHA256=80832551c52809301e6071c8bac977beb5a2f1ec953eb4db9f94deb953333793

# GStreamer version lives in Dockerfile.media (nothing in this stage consumes it).
# TEMP_DIR must sit above the VS layer (the pwsh bootstrap RUN below reads it);
# the maintainer LABEL used to sit here too and cost a full VS rebuild per
# metadata tweak — it now lives at the tail of this file.
ENV TEMP_DIR="C:\temp"

# NOTE: ENV quoting is inconsistent but harmless — Docker strips quotes from simple values
SHELL ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# ── Install PowerShell 7 (pwsh) as the default shell ─────────────────────────
# ZIP install avoids MSI dependency issues in containers. The version is pinned
# via ARG PWSH_VERSION (from versions.env). After this, SHELL is switched to pwsh
# for all subsequent layers.
#
# RETRY (added 2026-08-07): this is the FIRST network fetch of the chain's most
# expensive stage — a transient blip cost the whole base build, so the fetch
# retries three times with backoff + a SHA256 check inside the loop. The logic
# lives in windows/scripts/bootstrap-pwsh.ps1 (backlog #27: was a 1200-char
# single-line RUN). It is BIND-MOUNTED, not COPY'd — no layer, and nothing is
# COPY'd this early in base by design. It runs under Windows PowerShell 5.1
# (the SHELL is not switched to pwsh until below) and cannot use
# Invoke-DownloadWithRetry (no module is mounted yet).
RUN --mount=type=bind,source=windows/scripts/bootstrap-pwsh.ps1,target=C:\bootstrap-pwsh.ps1 & 'C:\bootstrap-pwsh.ps1'

# Ensure pwsh and the base Windows paths are on PATH for the SHELL switch below and all
# subsequent RUN instructions. The base image's PATH is NOT inherited by Docker ENV
# when the escape character is backtick, so WIN_BASE_PATH is set here explicitly.
# This is the ONLY definition (a second one in the big tail ENV block used to
# redefine it with nothing but a trailing-backslash drift — removed 2026-08-03);
# PATH stays a separate instruction because it references both keys.
ENV PWSH_PATH="C:\Program Files\PowerShell\7" `
    WIN_BASE_PATH=C:\Windows\System32;C:\Windows;C:\Windows\System32\Wbem;C:\Windows\System32\WindowsPowerShell\v1.0;C:\Windows\System32\OpenSSH
ENV PATH=$PWSH_PATH;$WIN_BASE_PATH

# Switch the default container shell to pwsh (PowerShell 7) for all subsequent RUN instructions.
# The native-exit-code preference is PSNativeCommandUseErrorActionPreference —
# note the "Use" (backlog #81). Until 2026-08-14 this line set
# $PSNativeCommandErrorActionPreference, which is not a PowerShell variable at
# all: verified against pwsh 7.6.4 (exactly PWSH_VERSION), where
# `Get-Variable PSNative*` returns only PSNativeCommandArgumentPassing and
# PSNativeCommandUseErrorActionPreference. The assignment created an unrelated
# variable and did nothing, so the base believed it had a guard it did not have.
# It was harmless only by luck — the real variable already defaults to False —
# and would have started throwing on every native non-zero exit the day pwsh
# flips that default, which is its stated direction. The repo spells it
# correctly in WindowsFormatting.Common.psm1.
SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; $PSNativeCommandUseErrorActionPreference = $false;"]

# COPY-immediately-before-RUN throughout this file: each input lands in the layer
# right before the step that consumes it, so editing a LATER script (or versions.env)
# can never bust an EARLIER expensive layer. The most expensive layer of the whole
# chain -- VS Build Tools -- therefore depends ONLY on the three modules its script
# imports + setup-vs.ps1 itself. (Copying the full modules directory here would bust
# it on every module edit; the media stage copies its own build modules and the full
# module set ships in the final image (windows/Dockerfile) for in-container CI.)
COPY windows\scripts\modules\WindowsScripts.Shared.psm1 `
     windows\scripts\modules\WindowsContainerImage.Common.psm1 `
     windows\scripts\modules\WindowsInstaller.Common.psm1 `
     C:\temp\scripts\modules\
# setup-vs.ps1 deliberately runs BEFORE load-versions so a versions.env bump cannot
# bust the most expensive layer. Its ONE versioned input -- the Windows SDK component
# build -- therefore arrives as an ARG (build.ps1 passes versions.env's
# WINDOWS_SDK_BUILD as --build-arg; ARG values are env vars during this stage's RUNs,
# which is where setup-vs.ps1's $env:WINDOWS_SDK_BUILD read gets its value). Changing
# the SDK pin SHOULD rebuild the VS layer.
ARG WINDOWS_SDK_BUILD=26100
# Same ARG route for the VS Build Tools major (versions.env VISUAL_STUDIO_VERSION):
# setup-vs.ps1's VsDevCmd sanity check derives its path from it instead of a literal.
ARG VISUAL_STUDIO_VERSION=18
COPY windows\scripts\setup-vs.ps1 C:\temp\scripts\
RUN & 'C:\temp\scripts\setup-vs.ps1' -TempDir $env:TEMP_DIR

# versions.env's COPY moved BELOW the expensive layers (#50, 2026-08-18):
# it is shared by BOTH lanes, so editing a purely Linux key (PANDOC_VERSION,
# ROCM_VERSION, ...) used to re-pay GB-scale scoop + vcpkg + the ~30-min rust
# layer. The keys those layers actually consume arrive as ARGs here instead
# (declared immediately above their consumer, #103 discipline); the COPY +
# load-versions bake now sits after the rust layer, in front of
# verify/finalize, which still read the baked Machine env - as do all later
# stages (FROM this image). NB the consumed-key inventory includes
# helper-reads (Resolve-ContainerImageValue / Get-SourceBuildVersion), not
# just $env: literals - that is exactly how GIT_VERSION hid from the first
# audit.
#
# setup-scoop-tools consumes (git installer URL derived from GIT_VERSION,
# hash-verified; WiX + flutter + the scoop bootstrap pin):
# Git is pinned, but NOT through scoop — the script builds the git-for-windows
# release URL from GIT_VERSION and verifies the installer hash.
# LLVM/ninja/nasm are PINNED (versions.env LLVM_WINDOWS_VERSION /
# NINJA_WINDOWS_VERSION / NASM_WINDOWS_VERSION, 2026-08-07): they produce or
# shape compiled output, and an unpinned clang-cl made the base image — the
# most expensive layer in the chain — unreproducible. versions.env's
# LLVM_RELEASE still pins only the LINUX lane; the two are independent on
# purpose. The remaining scoop tools stay floating (see setup-scoop-tools.ps1).
# The pins are declared HERE (not at the top): every RUN after an ARG
# declaration keys its cache on the ARG's value, so declaring them above the
# VS layer made a Vulkan/CMake/LLVM bump re-pay the VS Build Tools install.
# Declared here they can only invalidate scoop and the tail (their sole
# consumers).
ARG VULKAN_VERSION=1.4.357.1
ARG CMAKE_VERSION=4.4.2
ARG LLVM_WINDOWS_VERSION=22.1.8
ARG NINJA_WINDOWS_VERSION=1.13.2
ARG NASM_WINDOWS_VERSION=3.02
# sccache joined the pinned set 2026-08-08 -- for a FEATURE gate, not output
# determinism: multi-tier caching needs >= v0.16.0 and degrades silently below.
ARG SCCACHE_WINDOWS_VERSION=0.17.0
# #50: these used to arrive via the baked versions.env Machine env; as ARGs
# (auto-env during this stage's RUNs, names match the script reads) a Linux
# key edit no longer re-pays this layer. Defaults mirror versions.env; the
# drivers pass the live values.
ARG GIT_VERSION=2.55.0
ARG GIT_WINDOWS_INSTALLER_SHA256=0c66e4a5875da5a74f9754386de7555ba301503b03bbdcdbafa69dc6464e548d
ARG GIT_INSTALLER_URL=""
ARG SCOOP_INSTALLER_SHA256=48f6ea398b3a3fa26fae0093d37bd85b13e7eaa5d1d4a3e208408768408e35ae
ARG WIX_VERSION=4.0.6
ARG WIX_UI_EXT_VERSION=4.0.6
ARG FLUTTER_VERSION=3.47.0
COPY windows\scripts\setup-scoop-tools.ps1 C:\temp\scripts\
RUN & 'C:\temp\scripts\setup-scoop-tools.ps1' -TempDir $env:TEMP_DIR -VulkanVersion $env:VULKAN_VERSION -CMakeVersion $env:CMAKE_VERSION `
    -LlvmVersion $env:LLVM_WINDOWS_VERSION -NinjaVersion $env:NINJA_WINDOWS_VERSION -NasmVersion $env:NASM_WINDOWS_VERSION `
    -SccacheVersion $env:SCCACHE_WINDOWS_VERSION

# #50: VCPKG_REF as ARG for the same reason (was baked env).
ARG VCPKG_REF=2026.07.29
COPY windows\scripts\setup-vcpkg.ps1 C:\temp\scripts\
RUN & 'C:\temp\scripts\setup-vcpkg.ps1'

# LLVM_GLOBAL_BIN removed 2026-07-14: llvm is a user-scope install and it
# pointed at a never-created C:\ProgramData dir.
#
# SCOOP_GLOBAL_SHIMS was removed in the same pass for the same reason, and
# RESTORED 2026-08-08: flutter IS installed `--global` (setup-scoop-tools.ps1),
# so scoop DOES create C:\ProgramData\scoop\shims. Only FLUTTER_BIN being on
# PATH separately masked the gap -- any future global package would have been
# silently unresolvable. User shims keep priority (listed first below).
ENV SCOOP_HOME=C:\Users\ContainerAdministrator\scoop `
    SCOOP_GLOBAL=C:\ProgramData\scoop `
    SCOOP_USER_SHIMS=C:\Users\ContainerAdministrator\scoop\shims `
    SCOOP_GLOBAL_SHIMS=C:\ProgramData\scoop\shims `
    GIT_CMD="C:\Program Files\Git\cmd" `
    GIT_BIN="C:\Program Files\Git\bin" `
    GIT_USRBIN="C:\Program Files\Git\usr\bin" `
    FLUTTER_BIN=C:\ProgramData\scoop\apps\flutter\current\bin `
    VULKAN_SDK=C:\Users\ContainerAdministrator\scoop\apps\vulkan\current `
    WIX=C:\WiX `
    LLVM_USER_BIN=C:\Users\ContainerAdministrator\scoop\apps\llvm\current\bin `
    CMAKE_BIN=C:\Users\ContainerAdministrator\scoop\apps\cmake\current\bin `
    USERPROFILE=C:\Users\ContainerAdministrator `
    CARGO_HOME=C:\Users\ContainerAdministrator\.cargo `
    CARGO_BIN=C:\Users\ContainerAdministrator\.cargo\bin

# SCOOP_HOME / SCOOP_GLOBAL are scoop's APP ROOTS -- they hold apps\, buckets\
# and shims\ subdirectories but no executables of their own, so they were dead
# weight on PATH (removed 2026-08-08). The shim dirs below are the real entries.
ENV PATH=$PWSH_PATH;$CMAKE_BIN;$CARGO_BIN;$FLUTTER_BIN;$LLVM_USER_BIN;$WIX;$VULKAN_SDK\Bin;$GIT_CMD;$GIT_BIN;$GIT_USRBIN;$SCOOP_USER_SHIMS;$SCOOP_GLOBAL_SHIMS;$WIN_BASE_PATH

# Tail scripts land here (not at the top) so editing them only rebuilds from
# this point — and the EXPENSIVE one (rustup + frb-codegen, ~30 min) sits
# FIRST so edits to the cheap assertion/config scripts below never re-pay it
# (previously verify-toolchain shared the rust COPY+RUN and every tweak to the
# assertion list cost a full rust reinstall).
# #50: SCCACHE_GIT_REV as ARG (was baked env; the script throws if empty).
ARG SCCACHE_GIT_REV=ffac4a596aa50da3540520eb307b7a591984a064
COPY windows\scripts\setup-rust-toolchain.ps1 C:\temp\scripts\
# Local sccache patches (#114): applied on top of SCCACHE_GIT_REV before the
# source build. Deliberately in the SAME layer group as the rust install - a
# patch change must re-pay this layer, because it produces a different
# sccache. An empty/absent patch dir = stock build (auto-retires when the
# upstream PR merges and the .patch files are deleted).
COPY windows\upstream\sccache-nvcc-quote-fix C:\temp\scripts\sccache-patches\
RUN & 'C:\temp\scripts\setup-rust-toolchain.ps1'

# versions.env bake, relocated BELOW the expensive layers (#50): a Linux-key
# edit now invalidates only this cheap RUN + verify/finalize. load-versions
# sets Machine env, which persists in the image regardless of layer position -
# verify/finalize below and every later stage (FROM this image) read it
# exactly as before. Windows keys consumed ABOVE this line ride as ARGs.
COPY windows\scripts\load-versions.ps1 C:\temp\scripts\
COPY linux\scripts\01-core\versions.env C:\temp\
RUN & 'C:\temp\scripts\load-versions.ps1' 2>&1 | Out-Null

# verify-toolchain.ps1 is copied EXPLICITLY (the old `verify-*.ps1` wildcard
# matched exactly this one file, but a future verify-* script would have
# silently busted the layers above). Pure assertion pass + the tiny
# finalize config step share one RUN (125-layer budget); both are seconds.
COPY windows\scripts\verify-toolchain.ps1 `
     windows\scripts\finalize-container.ps1 `
     C:\temp\scripts\
RUN & 'C:\temp\scripts\verify-toolchain.ps1'; & 'C:\temp\scripts\finalize-container.ps1'

# Metadata-only: lives at the tail so a maintainer/label tweak never rebuilds
# anything above it (it used to sit ABOVE the VS Build Tools layer).
LABEL maintainer="contact@jonasheinle.de"
