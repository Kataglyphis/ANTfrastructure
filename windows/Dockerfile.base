# escape=`
# Copyright (c) 2025 Kataglyphis
# SPDX-License-Identifier: MIT
# Cached toolchain base: non-AI build tooling only, so CUDA/ONNX/OpenCV live in derived layers.

ARG WINDOWS_LTSC=2025
# The :ltsc tag floats monthly; the digest makes OS revisions deliberate (the wcifs commit bug is version-skew-sensitive).
ARG WINDOWS_BASE_DIGEST=sha256:e18a49cbc074dfaa8e106296d51cebd62bbf6effb999f134a5c48eed1c2334e1
# The tag is cosmetic: a WINDOWS_LTSC bump without a digest bump changes nothing.
FROM mcr.microsoft.com/windows/servercore:ltsc${WINDOWS_LTSC}@${WINDOWS_BASE_DIGEST}
# The hash rides as an ARG: this bootstrap runs before any module or versions.env bake exists.
ARG PWSH_VERSION=7.6.6
ARG PWSH_ZIP_SHA256=02fe458be20493fbdf43f61ea20610b811ee6c738ab1676c61b9cfcd1a33c860

# TEMP_DIR sits above the VS layer because the pwsh bootstrap RUN reads it.
ENV TEMP_DIR="C:\temp"

SHELL ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Install pwsh 7 (zip, not MSI); bind-mounted so nothing is COPY'd this early, and it runs under PowerShell 5.1.
RUN --mount=type=bind,source=windows/scripts/host/Initialize-Pwsh.ps1,target=C:\Initialize-Pwsh.ps1 & 'C:\Initialize-Pwsh.ps1'

# The base image's PATH is not inherited under the backtick escape, so WIN_BASE_PATH is spelled out once here.
ENV PWSH_PATH="C:\Program Files\PowerShell\7" `
    WIN_BASE_PATH=C:\Windows\System32;C:\Windows;C:\Windows\System32\Wbem;C:\Windows\System32\WindowsPowerShell\v1.0;C:\Windows\System32\OpenSSH
ENV PATH=$PWSH_PATH;$WIN_BASE_PATH

# Note the "Use": PSNativeCommandErrorActionPreference (without it) is not a pwsh variable and silently does nothing.
SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; $PSNativeCommandUseErrorActionPreference = $false;"]

# Each input is COPY'd right before its consumer, so a later edit never busts the VS layer above it.
COPY windows\scripts\modules\WindowsScripts.Shared.psm1 `
     windows\scripts\modules\WindowsContainerImage.Common.psm1 `
     windows\scripts\modules\WindowsInstaller.Common.psm1 `
     C:\temp\scripts\modules\
# Install-Vs.ps1 runs before the versions.env bake, so its versioned inputs arrive as ARGs.
ARG WINDOWS_SDK_BUILD=26100
ARG VISUAL_STUDIO_VERSION=18
COPY windows\scripts\host\Install-Vs.ps1 C:\temp\scripts\
RUN & 'C:\temp\scripts\Install-Vs.ps1' -TempDir $env:TEMP_DIR

# Pins are ARGs declared right above their consumer: every RUN after an ARG keys its cache on it, and a Linux-only versions.env edit must not re-pay these layers.
ARG VULKAN_VERSION=1.4.357.0
ARG CMAKE_VERSION=4.4.4
ARG LLVM_WINDOWS_VERSION=23.1.3
ARG NINJA_WINDOWS_VERSION=1.13.2
ARG NASM_WINDOWS_VERSION=3.02
# Pinned for a feature gate (below v0.16.0 the multilevel chain is silently ignored); see docs/windows-build-resources.md § Persistent compile cache (sccache).
ARG SCCACHE_WINDOWS_VERSION=0.18.0
# Defaults mirror versions.env; the drivers pass the live values.
ARG GIT_VERSION=2.56.0
ARG GIT_WINDOWS_INSTALLER_SHA256=bfe94e7b419b16eee9fecbd1253a98e3d4f49ba8f029630549052278ffe286a6
ARG GIT_INSTALLER_URL=""
ARG SCOOP_INSTALLER_SHA256=94f983b190438311e006b957db7c8422709e0ba62a6c2ac04e278164108f2512
ARG WIX_VERSION=7.0.0
ARG WIX_UI_EXT_VERSION=7.0.0
ARG FLUTTER_VERSION=3.47.4
# sdk.lunarg.com stalls from inside containers, so the driver preseeds the Vulkan SDK exe on the LAN webdav; empty = vendor download.
ARG VULKAN_PRESEED_ENDPOINT=""
# Empty = warn-only, since the base is shared with amd64; see docs/windows-cross-builds.md § Vulkan needs an optional component.
ARG WINDOWS_ARM64_STRICT=""
COPY windows\scripts\host\Install-ScoopTools.ps1 C:\temp\scripts\
RUN & 'C:\temp\scripts\Install-ScoopTools.ps1' -TempDir $env:TEMP_DIR -VulkanVersion $env:VULKAN_VERSION -CMakeVersion $env:CMAKE_VERSION `
    -LlvmVersion $env:LLVM_WINDOWS_VERSION -NinjaVersion $env:NINJA_WINDOWS_VERSION -NasmVersion $env:NASM_WINDOWS_VERSION `
    -WindowsArm64Strict $env:WINDOWS_ARM64_STRICT

ARG VCPKG_REF=2026.07.29
COPY windows\scripts\host\Install-Vcpkg.ps1 C:\temp\scripts\
RUN & 'C:\temp\scripts\Install-Vcpkg.ps1'

# SCOOP_GLOBAL_SHIMS is needed: flutter is a --global scoop install.
ENV SCOOP_HOME=C:\Users\ContainerAdministrator\scoop `
    SCOOP_GLOBAL=C:\ProgramData\scoop `
    SCOOP_USER_SHIMS=C:\Users\ContainerAdministrator\scoop\shims `
    SCOOP_GLOBAL_SHIMS=C:\ProgramData\scoop\shims `
    GIT_CMD="C:\Program Files\Git\cmd" `
    GIT_BIN="C:\Program Files\Git\bin" `
    GIT_USRBIN="C:\Program Files\Git\usr\bin" `
    FLUTTER_BIN=C:\ProgramData\scoop\apps\flutter\current\bin `
    VULKAN_SDK=C:\Users\ContainerAdministrator\scoop\apps\vulkan\current `
    WIX=C:\WiX `
    LLVM_USER_BIN=C:\Users\ContainerAdministrator\scoop\apps\llvm\current\bin `
    CMAKE_BIN=C:\Users\ContainerAdministrator\scoop\apps\cmake\current\bin `
    USERPROFILE=C:\Users\ContainerAdministrator `
    CARGO_HOME=C:\Users\ContainerAdministrator\.cargo `
    CARGO_BIN=C:\Users\ContainerAdministrator\.cargo\bin

# Scoop's app roots hold no executables, so only the shim dirs go on PATH (user shims first).
ENV PATH=$PWSH_PATH;$CMAKE_BIN;$CARGO_BIN;$FLUTTER_BIN;$LLVM_USER_BIN;$WIX;$VULKAN_SDK\Bin;$GIT_CMD;$GIT_BIN;$GIT_USRBIN;$SCOOP_USER_SHIMS;$SCOOP_GLOBAL_SHIMS;$WIN_BASE_PATH

# The expensive rust layer comes first in the tail, so edits to the cheap scripts below never re-pay it.
ARG RUST_VERSION=1.99.0
ARG FLUTTER_RUST_BRIDGE_VERSION=2.13.0
ARG SCCACHE_WINDOWS_ZIP_SHA256=8965c74d5e8a225244f741e18ad2f3f504f48228dc1bac948fc22761a348363d
COPY windows\scripts\host\Install-RustToolchain.ps1 C:\temp\scripts\
RUN & 'C:\temp\scripts\Install-RustToolchain.ps1'

# The versions.env bake sits below the expensive layers, so a Linux-key edit only re-runs the cheap tail.
COPY windows\scripts\build\Import-Versions.ps1 C:\temp\scripts\
COPY linux\scripts\01-core\versions.env C:\temp\
RUN & 'C:\temp\scripts\Import-Versions.ps1' 2>&1 | Out-Null

# Test-Toolchain.ps1 is this module's only base consumer, so it lands here and never busts scoop/vcpkg/rust.
COPY windows\scripts\modules\WindowsTargetArch.Common.psm1 C:\temp\scripts\modules\
COPY windows\scripts\build\Test-Toolchain.ps1 `
     windows\scripts\build\Complete-Container.ps1 `
     C:\temp\scripts\
RUN & 'C:\temp\scripts\Test-Toolchain.ps1'; & 'C:\temp\scripts\Complete-Container.ps1'

# At the tail so a label tweak rebuilds nothing.
LABEL maintainer="contact@jonasheinle.de"
