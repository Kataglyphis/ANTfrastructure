# escape=`
# Copyright (c) 2025 Kataglyphis
# SPDX-License-Identifier: MIT
#
# Windows mirror of linux/Dockerfile.torch: assembles the
# Kataglyphis-Orchestr-ANT-ion app environment as its OWN chain stage between
# media and final (media -> torch -> final; windows/Dockerfile builds FROM this
# image and adds only the cheap dev-image trimmings). An APP_REF bump therefore
# rebuilds torch + final — minutes, network-bound — never the compile chain.
#
# In-chain (default): .\windows\build.ps1        (torch is in the default stages)
# App-only iteration:  .\windows\build.ps1 -Stages torch,final
# On the PUBLISHED image instead of a local chain (any host that can pull it):
#   .\windows\build.ps1 -Stages torch,final -TorchBaseImage ghcr.io/kataglyphis/kataglyphis_beschleuniger:winamd64
#
# The assembly script deletes + reclones C:\opt\Kataglyphis-Orchestr-ANT-ion
# wholesale, so re-running on a base that already carries an older app env
# (e.g. the published image) is safe and total.

ARG BASE_IMAGE=local/kataglyphis:windows-media
FROM ${BASE_IMAGE}

# Kept in sync with versions.env by sync_versions.py; build.ps1 overrides it
# (versions.env pin, or the latest release tag with -LatestApp).
ARG APP_REF=v0.0.27
# Torch BACKEND extra from the app's pyproject: pytorch-cpu (default),
# pytorch-cu130, ... 'none' disables (torch is only declared inside the extras).
ARG PYTORCH_EXTRA=pytorch-cpu

SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Fresh copy from the build context (NOT the baked one): app-assembly fixes must
# reach this leaf without waiting for a full base republish.
# WindowsNative.Common must ride along explicitly: assemble-torch-app imports it
# (Invoke-ShieldedNative), and the BK lane's parent lineage (merge-fanin ->
# toolchain -> base) carries only Shared/ContainerImage/Installer in
# C:\temp\scripts\modules — the merge stage's fuller module COPY is classic-lane
# only, and the final image's whole-modules COPY comes one stage too late.
COPY windows\scripts\modules\WindowsNative.Common.psm1 C:\temp\scripts\modules\
COPY windows\scripts\build\assemble-torch-app.ps1 C:\temp\scripts\
# Wheel download cache (added 2026-08-08). Neither UV_CACHE_DIR nor
# PIP_CACHE_DIR existed anywhere in the Windows lane, so this stage re-downloaded
# its whole wheel set on every run -- and with PYTORCH_EXTRA=pytorch-cu130 that
# is multiple GB of CUDA-flavoured torch over the network, for bytes that never
# change between runs. The comment below already calls this step "minutes-long,
# network-bound"; this is the cache that makes it stop being network-bound.
#
# Low risk by construction, unlike a source-tree cache: uv treats its cache as
# pure content-addressed scratch, so BuildKit cloning the mount under lock (the
# documented caveat) costs at worst a cold re-download, and nothing here renames
# a directory on the mount.
#
# Sized 10G against the tier-0 GC cap for type==exec.cachemount (20GB/168h in
# windows/buildkitd.toml), which the 15G sccache L0 already shares. If either
# grows, raise the cap in the same change or both start getting evicted between
# chains and quietly buy nothing.
# Set INSIDE the RUN, not as ENV: an ENV would bake UV_CACHE_DIR into the
# shipped image, pointing every runtime `uv`/`pip` invocation at a build-only
# mount path that does not exist there. Build-time state belongs in the build
# step, not in the artifact.
RUN --mount=type=cache,target=C:\uvcache,id=uv-wheels-winamd64,sharing=locked `
    $env:UV_CACHE_DIR = 'C:\uvcache'; $env:PIP_CACHE_DIR = 'C:\uvcache\pip'; `
    & 'C:\temp\scripts\assemble-torch-app.ps1' -AppRef $env:APP_REF -PytorchExtra $env:PYTORCH_EXTRA -Mode all

ENV TORCH_APP_DIR="C:\opt\Kataglyphis-Orchestr-ANT-ion"

# Provenance stamps DELIBERATELY declared below the assembly RUN: ARGs enter
# the env (and thus the cache key) of every later instruction, and the drivers
# pass a fresh timestamp on every invocation — declared above the RUN they
# forced the minutes-long, network-bound app assembly to re-execute on every
# chain run even with zero changes. Down here they only re-stamp the LABEL.
ARG BUILD_DATE=""
ARG VCS_REF=""

# Healthcheck: exercise the APP venv's onnxruntime import (mirror of
# linux/Dockerfile.torch's healthcheck). windows/Dockerfile (final) overrides
# this with the broader dev-image probe; this one stands when the torch image
# is run directly. WORKDIR/VOLUME/ENTRYPOINT come from the final stage.
HEALTHCHECK --interval=5m --timeout=30s --start-period=60s --retries=3 `
  CMD ["C:\\opt\\Kataglyphis-Orchestr-ANT-ion\\.venv\\Scripts\\python.exe", "-c", "import onnxruntime"]

LABEL org.opencontainers.image.title="kataglyphis_beschleuniger torch app" `
      org.opencontainers.image.description="Orchestr-ANT-ion app environment on the Windows developer image (ONNX Runtime, GenAI, OpenCV 5, TVM, PyTorch)" `
      org.opencontainers.image.version="${APP_REF}" `
      org.opencontainers.image.revision="${VCS_REF}" `
      org.opencontainers.image.created="${BUILD_DATE}" `
      org.opencontainers.image.authors="Jonas Heinle <jonasheinle@googlemail.com>" `
      org.opencontainers.image.url="https://github.com/Kataglyphis/Kataglyphis-ContainerHub" `
      org.opencontainers.image.source="https://github.com/Kataglyphis/Kataglyphis-ContainerHub" `
      org.opencontainers.image.licenses="MIT"
