# escape=`
# Copyright (c) 2025 Kataglyphis
# SPDX-License-Identifier: MIT
#
# Windows mirror of linux/Dockerfile.torch: assembles the
# OrchestrANT app environment as its OWN chain stage between
# media and final (media -> torch -> final; windows/Dockerfile builds FROM this
# image and adds only the cheap dev-image trimmings). An APP_REF bump therefore
# rebuilds torch + final — minutes, network-bound — never the compile chain.
#
# In-chain (default): .\windows\Build-Buildkit.ps1        (torch is in the default stages)
# App-only iteration:  .\windows\Build-Buildkit.ps1 -Stages torch,final
# Building on the PUBLISHED image is NOT driver-supported: the torch stage's
# BASE_IMAGE is pinned to the local `windows-media` tag. The classic lane's
# -TorchBaseImage went with build.ps1 (deleted 2026-08-31); overriding BASE_IMAGE
# now needs a direct buildctl solve.
#
# The assembly script deletes + reclones C:\opt\OrchestrANT
# wholesale, so re-running on a base that already carries an older app env
# (e.g. the published image) is safe and total.

ARG BASE_IMAGE=local/kataglyphis:windows-media
# '1' on the rocm lane only (Build-Buildkit.ps1): the last FROM then takes rocm-1, else rocm-0 = app.
ARG TORCH_ROCM=0
FROM ${BASE_IMAGE} AS app

# Kept in sync with versions.env by sync_versions.py; Build-Buildkit.ps1 overrides it
# (versions.env pin, or the latest release tag with -LatestApp).
ARG APP_REF=v0.0.28
# Torch BACKEND extra from the app's pyproject: pytorch-cpu (default),
# pytorch-cu130, ... 'none' disables (torch is only declared inside the extras).
ARG PYTORCH_EXTRA=pytorch-cpu

SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; $PSNativeCommandUseErrorActionPreference = $false;"]

# Fresh copy from the build context (NOT the baked one): app-assembly fixes must
# reach this leaf without waiting for a full base republish.
# WindowsNative.Common must ride along explicitly: assemble-torch-app imports it
# (Invoke-ShieldedNative), and the BK lane's parent lineage (merge-fanin ->
# toolchain -> base) carries only Shared/ContainerImage/Installer in
# C:\temp\scripts\modules — the retired classic merge stage was the only place with
# a fuller module COPY, and the final image's whole-modules COPY comes one stage too late.
COPY windows\scripts\modules\WindowsNative.Common.psm1 `
     windows\scripts\modules\WindowsTargetArch.Common.psm1 C:\temp\scripts\modules\
COPY windows\scripts\build\Build-TorchApp.ps1 C:\temp\scripts\
# Wheel download cache (added 2026-08-08). Neither UV_CACHE_DIR nor
# PIP_CACHE_DIR existed anywhere in the Windows lane, so this stage re-downloaded
# its whole wheel set on every run -- and with PYTORCH_EXTRA=pytorch-cu130 that
# is multiple GB of CUDA-flavoured torch over the network, for bytes that never
# change between runs. The comment below already calls this step "minutes-long,
# network-bound"; this is the cache that makes it stop being network-bound.
#
# Low risk by construction, unlike a source-tree cache: uv treats its cache as
# pure content-addressed scratch, so BuildKit cloning the mount under lock (the
# documented caveat) costs at worst a cold re-download, and nothing here renames
# a directory on the mount.
#
# Sized 10G against the tier-0 GC cap for type==exec.cachemount (20GB/168h in
# windows/buildkitd.toml), which the 15G sccache L0 already shares. If either
# grows, raise the cap in the same change or both start getting evicted between
# chains and quietly buy nothing.
# Set INSIDE the RUN, not as ENV: an ENV would bake UV_CACHE_DIR into the
# shipped image, pointing every runtime `uv`/`pip` invocation at a build-only
# mount path that does not exist there. Build-time state belongs in the build
# step, not in the artifact.
RUN --mount=type=cache,target=C:\uvcache,id=uv-wheels-winamd64,sharing=locked `
    $env:UV_CACHE_DIR = 'C:\uvcache'; $env:PIP_CACHE_DIR = 'C:\uvcache\pip'; `
    & 'C:\temp\scripts\Build-TorchApp.ps1' -AppRef $env:APP_REF -PytorchExtra $env:PYTORCH_EXTRA -Mode all

ENV TORCH_APP_DIR="C:\opt\OrchestrANT"

# cpu/nvidia: rocm-0 IS app, byte for byte. rocm-1 swaps the app venv's CPU torch for AMD's
# ROCm torch and re-verifies the app on it. docs/windows-builds.md § ROCm layer.
FROM app AS rocm-0

FROM app AS rocm-1
# Pins: versions.env TORCH_ROCM_WINDOWS_* (self-measured SHA256s: AMD publishes none).
ARG TORCH_ROCM_WINDOWS_TORCH_URL=https://stable.repo.amd.com/rocm/pytorch/whl-next/torch/torch-2.13.0%2Brocm10.0.0-cp314-cp314-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_TORCH_SHA256=9a01e2a7f89ea89383f6cd5ae884ac4875edefa387c4d8c77f207ba6efd178b0
ARG TORCH_ROCM_WINDOWS_TORCHVISION_URL=https://stable.repo.amd.com/rocm/pytorch/whl-next/torchvision/torchvision-0.28.0%2Brocm10.0.0-cp314-cp314-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_TORCHVISION_SHA256=2508a18eead7fb70ba35da6fcbc45bdc9b953d4ba44bb979a7fafebabebaa8b2
ARG TORCH_ROCM_WINDOWS_TORCH_DEVICE_URL=https://stable.repo.amd.com/rocm/pytorch/whl-next/amd-torch-device-gfx1201/amd_torch_device_gfx1201-2.13.0%2Brocm10.0.0-cp314-cp314-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_TORCH_DEVICE_SHA256=22f2de7ce0f50428fa5f7e309418d433cdd4aeb47834ec7bff6840d34dff6fa2
ARG TORCH_ROCM_WINDOWS_TORCH_DEVICE_FAMILY_URL=https://stable.repo.amd.com/rocm/pytorch/whl-next/amd-torch-device-gfx12-0/amd_torch_device_gfx12_0-2.13.0%2Brocm10.0.0-cp314-cp314-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_TORCH_DEVICE_FAMILY_SHA256=d441c197769d657e88c8a122ab87e25a8e47aaa65751c6006cce733f3283d8a9
ARG TORCH_ROCM_WINDOWS_TORCHVISION_DEVICE_URL=https://stable.repo.amd.com/rocm/pytorch/whl-next/amd-torchvision-device-gfx1201/amd_torchvision_device_gfx1201-0.28.0%2Brocm10.0.0-cp314-cp314-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_TORCHVISION_DEVICE_SHA256=f74692cef1e1abeaa651644af7ea192c02d86d4aa2c55c01325cd18be712bf53
ARG TORCH_ROCM_WINDOWS_ROCM_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm/rocm-10.0.0.tar.gz
ARG TORCH_ROCM_WINDOWS_ROCM_SHA256=65b5982249612a310135f5e061b9f28909e8ad718a1ddb3f1abba92298b7216b
ARG TORCH_ROCM_WINDOWS_BOOTSTRAP_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm-bootstrap/rocm_bootstrap-0.1.0-py3-none-any.whl
ARG TORCH_ROCM_WINDOWS_BOOTSTRAP_SHA256=33e3d4dad086b1f0e06bc049a618ca874d4fb72f758fff00676e23d2a644b652
ARG TORCH_ROCM_WINDOWS_SDK_CORE_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm-sdk-core/rocm_sdk_core-10.0.0-py3-none-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_SDK_CORE_SHA256=066195cb0f7df02e6009facb17652dd992d13fae44d87652e5ab928d5b4f0851
ARG TORCH_ROCM_WINDOWS_SDK_LIBRARIES_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm-sdk-libraries/rocm_sdk_libraries-10.0.0-py3-none-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_SDK_LIBRARIES_SHA256=bfc7a1bd3b6050fb4d36d8ac2eea80d3afd70c5604a29142463d6cb890fc73bf
ARG TORCH_ROCM_WINDOWS_SDK_DEVICE_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm-sdk-device-gfx1201/rocm_sdk_device_gfx1201-10.0.0-py3-none-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_SDK_DEVICE_SHA256=c6e4c5a0da941230bed975765e644597570081c9a41654d5a052c277167f4576
ARG TORCH_ROCM_WINDOWS_TORCH_DEVICE_GFX1200_URL=https://stable.repo.amd.com/rocm/pytorch/whl-next/amd-torch-device-gfx1200/amd_torch_device_gfx1200-2.13.0%2Brocm10.0.0-cp314-cp314-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_TORCH_DEVICE_GFX1200_SHA256=4a42e9937c09862bb7c48a2644f9c634ac090970e30d0c240b3aa9cd51fb9421
ARG TORCH_ROCM_WINDOWS_TORCHVISION_DEVICE_GFX1200_URL=https://stable.repo.amd.com/rocm/pytorch/whl-next/amd-torchvision-device-gfx1200/amd_torchvision_device_gfx1200-0.28.0%2Brocm10.0.0-cp314-cp314-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_TORCHVISION_DEVICE_GFX1200_SHA256=f2676ebde675908067fc6709e36098892c34aa687cda38dac3b4ccca6207a2f1
ARG TORCH_ROCM_WINDOWS_SDK_DEVICE_GFX1200_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm-sdk-device-gfx1200/rocm_sdk_device_gfx1200-10.0.0-py3-none-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_SDK_DEVICE_GFX1200_SHA256=f33226078932ee2200f5595c521895edf5d7abf3170975d8c6f72a2a3949f516
# The venv's ai-edge-litert (PyPI, published SHA256), installed --no-deps in the same offline step.
ARG TORCH_ROCM_WINDOWS_AI_EDGE_LITERT_URL=https://files.pythonhosted.org/packages/3c/33/1e7b4ac36d983aa6153b10f1e8686d7f6ff47bda1216d6d8f047a19f3cc6/ai_edge_litert-2.2.0-cp314-cp314-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_AI_EDGE_LITERT_SHA256=4e5e35da364495fdf0abefd6ef32d299133619df4cbab757941b0462066e93bc
# Same uv cache mount as app: the ~2 GB of wheels are cached by SHA256 under C:\uvcache\torch-rocm.
# -TorchRocm 1 is literal: only TORCH_ROCM=1 selects this stage, and an env read could fail open to CPU torch.
RUN --mount=type=cache,target=C:\uvcache,id=uv-wheels-winamd64,sharing=locked `
    --mount=type=bind,source=windows/scripts/build/Install-TorchRocm.ps1,target=C:\bkmnt\Install-TorchRocm.ps1 `
    --mount=type=bind,source=windows/scripts/build/rocm-checks/Torch.ps1,target=C:\bkmnt\rocm-checks\Torch.ps1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsScripts.Shared.psm1,target=C:\bkmnt\modules\WindowsScripts.Shared.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsNative.Common.psm1,target=C:\bkmnt\modules\WindowsNative.Common.psm1 `
    & 'C:\bkmnt\Install-TorchRocm.ps1' -TorchRocm 1 -WheelCache 'C:\uvcache\torch-rocm'; `
    & 'C:\temp\scripts\Build-TorchApp.ps1' -Mode verify

FROM rocm-${TORCH_ROCM}
# ARGs stop at FROM: the LABEL reads APP_REF, so redeclare it (sync_versions.py syncs both).
ARG APP_REF=v0.0.28

# Provenance stamps DELIBERATELY declared below the assembly RUN: ARGs enter
# the env (and thus the cache key) of every later instruction, and the drivers
# pass a fresh timestamp on every invocation — declared above the RUN they
# forced the minutes-long, network-bound app assembly to re-execute on every
# chain run even with zero changes. Down here they only re-stamp the LABEL.
ARG BUILD_DATE=""
ARG VCS_REF=""

# Healthcheck: exercise the APP venv's onnxruntime import (mirror of
# linux/Dockerfile.torch's healthcheck). windows/Dockerfile (final) overrides
# this with the broader dev-image probe; this one stands when the torch image
# is run directly. WORKDIR/VOLUME/ENTRYPOINT come from the final stage.
HEALTHCHECK --interval=5m --timeout=30s --start-period=60s --retries=3 `
  CMD ["C:\\opt\\OrchestrANT\\.venv\\Scripts\\python.exe", "-c", "import onnxruntime"]

LABEL org.opencontainers.image.title="kataglyphis_beschleuniger torch app" `
      org.opencontainers.image.description="OrchestrANT app environment on the Windows developer image (ONNX Runtime, GenAI, OpenCV 5, TVM, PyTorch)" `
      org.opencontainers.image.version="${APP_REF}" `
      org.opencontainers.image.revision="${VCS_REF}" `
      org.opencontainers.image.created="${BUILD_DATE}" `
      org.opencontainers.image.authors="Jonas Heinle <jonasheinle@googlemail.com>" `
      org.opencontainers.image.url="https://github.com/Kataglyphis/ANTfrastructure" `
      org.opencontainers.image.source="https://github.com/Kataglyphis/ANTfrastructure" `
      org.opencontainers.image.licenses="MIT"
