# escape=`
# Copyright (c) 2025 Kataglyphis
# SPDX-License-Identifier: MIT
# The app env as its own stage (media -> torch -> final), so an APP_REF bump never rebuilds the compile chain.

ARG BASE_IMAGE=local/kataglyphis:windows-media
# '1' on the rocm lane only (Build-Buildkit.ps1): the last FROM then takes rocm-1, else rocm-0 = app.
ARG TORCH_ROCM=0
FROM ${BASE_IMAGE} AS app

# Synced by sync_versions.py; Build-Buildkit.ps1 passes the commit the ref points at now.
ARG APP_REF=develop
# The app's torch extra; 'none' disables torch, which is declared only inside the extras.
ARG PYTORCH_EXTRA=pytorch-cpu

SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; $PSNativeCommandUseErrorActionPreference = $false;"]

# Build-TorchApp.ps1 imports these modules, and the parent lineage carries neither.
COPY windows\scripts\modules\WindowsNative.Common.psm1 `
     windows\scripts\modules\WindowsTargetArch.Common.psm1 C:\temp\scripts\modules\
COPY windows\scripts\build\Build-TorchApp.ps1 C:\temp\scripts\
# Wheel cache set inside the RUN, not ENV, which would point the shipped uv at a build-only path; it shares buildkitd.toml's cache-mount GC cap.
RUN --mount=type=cache,target=C:\uvcache,id=uv-wheels-winamd64,sharing=locked `
    $env:UV_CACHE_DIR = 'C:\uvcache'; $env:PIP_CACHE_DIR = 'C:\uvcache\pip'; `
    & 'C:\temp\scripts\Build-TorchApp.ps1' -AppRef $env:APP_REF -PytorchExtra $env:PYTORCH_EXTRA -Mode all

ENV TORCH_APP_DIR="C:\opt\OrchestrANT"

# rocm only, on BASE_IMAGE not app, so an APP_REF move never re-runs it; see docs/windows-rocm.md § PyTorch on the rocm lane (torch stage).
FROM ${BASE_IMAGE} AS torch-rocm-wheels
SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; $PSNativeCommandUseErrorActionPreference = $false;"]
# Build-host settings are ARGs only; see docs/windows-build-resources.md § What the published image carries.
ARG SCCACHE_WEBDAV_ENDPOINT
ARG SCCACHE_LOG="warn"
ARG SCCACHE_MULTILEVEL_CHAIN
ARG SCCACHE_DIR="C:\sccache\v2"
ARG SCCACHE_FORCE_LOCAL
ENV SCCACHE_DIR="${SCCACHE_DIR}" `
    SCCACHE_CACHE_SIZE="15G" `
    SCCACHE_ERROR_LOG="C:\sccache-logs\sccache-error.log" `
    SCCACHE_LOG="${SCCACHE_LOG}" `
    SCCACHE_IDLE_TIMEOUT="0"
# The build venv needs the rocm_sdk trio, because `import torch` runs torch/_rocm_init.py.
ARG ROCM_WINDOWS_GFX_FAMILY=gfx120X-all
ARG PYTORCH_VERSION=v2.14.0
ARG TORCH_ROCM_WINDOWS_PYTORCH_COMMIT=2b3ec34829036a65cd9d1398ea72a0167dc37470
ARG TORCH_ROCM_WINDOWS_ROCM_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm/rocm-10.0.0.tar.gz
ARG TORCH_ROCM_WINDOWS_ROCM_SHA256=65b5982249612a310135f5e061b9f28909e8ad718a1ddb3f1abba92298b7216b
ARG TORCH_ROCM_WINDOWS_SDK_CORE_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm-sdk-core/rocm_sdk_core-10.0.0-py3-none-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_SDK_CORE_SHA256=066195cb0f7df02e6009facb17652dd992d13fae44d87652e5ab928d5b4f0851
ARG TORCH_ROCM_WINDOWS_SDK_LIBRARIES_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm-sdk-libraries/rocm_sdk_libraries-10.0.0-py3-none-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_SDK_LIBRARIES_SHA256=bfc7a1bd3b6050fb4d36d8ac2eea80d3afd70c5604a29142463d6cb890fc73bf
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=shared `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/Build-TorchRocmFromSource.ps1,target=C:\bkmnt\Build-TorchRocmFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsScripts.Shared.psm1,target=C:\bkmnt\modules\WindowsScripts.Shared.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsNative.Common.psm1,target=C:\bkmnt\modules\WindowsNative.Common.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsSourceBuild.Common.psm1,target=C:\bkmnt\modules\WindowsSourceBuild.Common.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsSourceBuild.Patches.psm1,target=C:\bkmnt\modules\WindowsSourceBuild.Patches.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsSourceBuild.Cuda.psm1,target=C:\bkmnt\modules\WindowsSourceBuild.Cuda.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsTargetArch.Common.psm1,target=C:\bkmnt\modules\WindowsTargetArch.Common.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsMigraphx.Common.psm1,target=C:\bkmnt\modules\WindowsMigraphx.Common.psm1 `
    & 'C:\bkmnt\Build-TorchRocmFromSource.ps1' -OutputDir 'C:\torch-rocm-wheels' -WorkDir 'C:\b'
# torchvision in its own RUN, on the venv the torch RUN leaves: its failure, edit or bump never re-runs the compile above.
ARG TORCHVISION_VERSION=v0.29.0
ARG TORCH_ROCM_WINDOWS_TORCHVISION_COMMIT=fc73f5a8567734ffa4c988b24d5432f0d3005974
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=shared `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/Build-TorchRocmFromSource.ps1,target=C:\bkmnt\Build-TorchRocmFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/build/Build-TorchvisionRocmFromSource.ps1,target=C:\bkmnt\Build-TorchvisionRocmFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsScripts.Shared.psm1,target=C:\bkmnt\modules\WindowsScripts.Shared.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsNative.Common.psm1,target=C:\bkmnt\modules\WindowsNative.Common.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsSourceBuild.Common.psm1,target=C:\bkmnt\modules\WindowsSourceBuild.Common.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsSourceBuild.Patches.psm1,target=C:\bkmnt\modules\WindowsSourceBuild.Patches.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsSourceBuild.Cuda.psm1,target=C:\bkmnt\modules\WindowsSourceBuild.Cuda.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsTargetArch.Common.psm1,target=C:\bkmnt\modules\WindowsTargetArch.Common.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsMigraphx.Common.psm1,target=C:\bkmnt\modules\WindowsMigraphx.Common.psm1 `
    & 'C:\bkmnt\Build-TorchvisionRocmFromSource.ps1' -OutputDir 'C:\torch-rocm-wheels' -WorkDir 'C:\b'

# rocm-0 is app byte for byte; rocm-1 swaps in the ROCm torch and re-verifies the app.
FROM app AS rocm-0

FROM app AS rocm-1
# SHA256s are self-measured: AMD publishes none.
ARG TORCH_ROCM_WINDOWS_ROCM_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm/rocm-10.0.0.tar.gz
ARG TORCH_ROCM_WINDOWS_ROCM_SHA256=65b5982249612a310135f5e061b9f28909e8ad718a1ddb3f1abba92298b7216b
ARG TORCH_ROCM_WINDOWS_SDK_CORE_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm-sdk-core/rocm_sdk_core-10.0.0-py3-none-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_SDK_CORE_SHA256=066195cb0f7df02e6009facb17652dd992d13fae44d87652e5ab928d5b4f0851
ARG TORCH_ROCM_WINDOWS_SDK_LIBRARIES_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm-sdk-libraries/rocm_sdk_libraries-10.0.0-py3-none-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_SDK_LIBRARIES_SHA256=bfc7a1bd3b6050fb4d36d8ac2eea80d3afd70c5604a29142463d6cb890fc73bf
ARG TORCH_ROCM_WINDOWS_SDK_DEVICE_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm-sdk-device-gfx1201/rocm_sdk_device_gfx1201-10.0.0-py3-none-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_SDK_DEVICE_SHA256=c6e4c5a0da941230bed975765e644597570081c9a41654d5a052c277167f4576
ARG TORCH_ROCM_WINDOWS_SDK_DEVICE_GFX1200_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm-sdk-device-gfx1200/rocm_sdk_device_gfx1200-10.0.0-py3-none-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_SDK_DEVICE_GFX1200_SHA256=f33226078932ee2200f5595c521895edf5d7abf3170975d8c6f72a2a3949f516
# The venv's ai-edge-litert (PyPI, published SHA256), installed --no-deps in the same offline step.
ARG TORCH_ROCM_WINDOWS_AI_EDGE_LITERT_URL=https://files.pythonhosted.org/packages/3c/33/1e7b4ac36d983aa6153b10f1e8686d7f6ff47bda1216d6d8f047a19f3cc6/ai_edge_litert-2.2.0-cp314-cp314-win_amd64.whl
ARG TORCH_ROCM_WINDOWS_AI_EDGE_LITERT_SHA256=4e5e35da364495fdf0abefd6ef32d299133619df4cbab757941b0462066e93bc
# -TorchRocm 1 is literal: an env read could fail open to CPU torch.
RUN --mount=type=cache,target=C:\uvcache,id=uv-wheels-winamd64,sharing=locked `
    --mount=type=bind,from=torch-rocm-wheels,source=/torch-rocm-wheels,target=C:\bkmnt\torch-rocm-wheels `
    --mount=type=bind,source=windows/scripts/build/Install-TorchRocm.ps1,target=C:\bkmnt\Install-TorchRocm.ps1 `
    --mount=type=bind,source=windows/scripts/build/rocm-checks/Torch.ps1,target=C:\bkmnt\rocm-checks\Torch.ps1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsScripts.Shared.psm1,target=C:\bkmnt\modules\WindowsScripts.Shared.psm1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsNative.Common.psm1,target=C:\bkmnt\modules\WindowsNative.Common.psm1 `
    & 'C:\bkmnt\Install-TorchRocm.ps1' -TorchRocm 1 -WheelDir 'C:\bkmnt\torch-rocm-wheels' -WheelCache 'C:\uvcache\torch-rocm'; `
    & 'C:\temp\scripts\Build-TorchApp.ps1' -Mode verify

FROM rocm-${TORCH_ROCM}
# ARGs stop at FROM: the LABEL reads APP_REF, so redeclare it (sync_versions.py syncs both).
ARG APP_REF=develop

# Below the assembly RUN: a fresh timestamp per run would otherwise re-key it.
ARG BUILD_DATE=""
ARG VCS_REF=""

# Stands when the torch image runs directly; the final image overrides it.
HEALTHCHECK --interval=5m --timeout=30s --start-period=60s --retries=3 `
  CMD ["C:\\opt\\OrchestrANT\\.venv\\Scripts\\python.exe", "-c", "import onnxruntime"]

LABEL org.opencontainers.image.title="kataglyphis_beschleuniger torch app" `
      org.opencontainers.image.description="OrchestrANT app environment on the Windows developer image (ONNX Runtime, GenAI, OpenCV 5, TVM, PyTorch)" `
      org.opencontainers.image.version="${APP_REF}" `
      org.opencontainers.image.revision="${VCS_REF}" `
      org.opencontainers.image.created="${BUILD_DATE}" `
      org.opencontainers.image.authors="Jonas Heinle <jonasheinle@googlemail.com>" `
      org.opencontainers.image.url="https://github.com/Kataglyphis/ANTfrastructure" `
      org.opencontainers.image.source="https://github.com/Kataglyphis/ANTfrastructure" `
      org.opencontainers.image.licenses="MIT"
