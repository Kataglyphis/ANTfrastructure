-            {
-                auto& tensor = field.AsTensorDesc();
-                tensors.push_back(tensor ? const_cast<TensorType*>(&*tensor) : nullptr);
-            }
-            else if (fieldSchema->Type == DML_SCHEMA_FIELD_TYPE_TENSOR_DESC_ARRAY)
