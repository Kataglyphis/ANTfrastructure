+/// Normalize a Windows `nvcc --dryrun` subcommand line for tokenization.
+/// Escaped quotes (`\"`, printed by nvcc for string-valued defines like
+/// `-D "FILE_NAME=\"x.dll\""`) are protected with a sentinel while path
+/// backslashes are flattened, so `shlex` sees the original quote structure.
+fn normalize_windows_dryrun_line(line: &str, host_compiler: &NvccHostCompiler) -> String {
+    let line = line
+        .replace("\\\"", "\u{1}")
+        .replace("\"\"", "\"")
+        .replace(r"\\?\", "")
+        .replace('\\', "/")
+        .replace(r"//?/", "")
+        .replace('\u{1}', "\\\"");
+    match host_compiler {
+        NvccHostCompiler::Msvc => line.replace(" -E ", " -P ").replace(" > ", " -Fi"),
+        _ => line,
+    }
+}
+
 fn remap_generated_filenames(
     args: &[String],
     old_to_new: &mut HashMap<String, String>,
@@ -1564,9 +1572,28 @@ mod test {
         }
     }
 
+    #[test]
+    fn test_normalize_windows_dryrun_line_preserves_escaped_quotes() {
+        // Flattening '\' to '/' before tokenization used to turn \" into /",
+        // collapsing the quote structure (see normalize_windows_dryrun_line).
+        let line = r#"cl -D__CUDACC__ -D "FILE_NAME=\"kernel.dll\"" -D "USE_CUDA=1" -E -x c++ "C:\src\kernel.cu" > "kernel.cpp4.ii""#;
+        let normalized = normalize_windows_dryrun_line(line, &NvccHostCompiler::Msvc);
+        let tokens = shlex::split(&normalized).unwrap();
+        assert!(tokens.iter().any(|t| t == "FILE_NAME=\"kernel.dll\""));
+        assert!(tokens.iter().any(|t| t == "USE_CUDA=1"));
+        assert!(tokens.iter().any(|t| t == "C:/src/kernel.cu"));
+        // The giant-token fingerprint of the collapse must not appear.
+        assert!(tokens.iter().all(|t| !t.contains(" -D ")));
+        // Non-MSVC host compilers keep -E and the redirect untouched.
+        let gcc = normalize_windows_dryrun_line(line, &NvccHostCompiler::Gcc);
+        assert!(gcc.contains(" -E ") && gcc.contains(" > "));
+    }
+
