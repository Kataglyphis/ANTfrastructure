# escape=`
# =============================================================================
# Minimal repro for the #100 sccache relative-fwd-slash -Fo failure. Run via:
#   run-diagnostic-probe.ps1 -Dockerfile Dockerfile.sccache-fo-probe -BaseImage local/kataglyphis:bk-windows-toolchain
# =============================================================================
ARG BASE_IMAGE=local/kataglyphis:bk-windows-toolchain
FROM ${BASE_IMAGE} AS probe

# Layer-cache buster (a CACHED run replays an old verdict).
ARG PROBE_NONCE="0"

RUN --mount=type=bind,source=windows/scripts/probe-sccache-relative-fo.ps1,target=C:\bkmnt\probe-sccache-relative-fo.ps1 `
    --mount=type=bind,source=windows/scripts/modules,target=C:\bkmnt\modules `
    & 'C:\bkmnt\probe-sccache-relative-fo.ps1' -Nonce "${PROBE_NONCE}"
