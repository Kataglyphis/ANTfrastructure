# escape=`
# =============================================================================
# Reproduce mozilla/sccache#2726 and test the 0003 diag fix against it. Run via:
#   run-diagnostic-probe.ps1 -Dockerfile Dockerfile.sccache-2726-probe -BaseImage local/kataglyphis:bk-windows-toolchain
# =============================================================================
ARG BASE_IMAGE=local/kataglyphis:bk-windows-toolchain
FROM ${BASE_IMAGE} AS probe

# Layer-cache buster (a CACHED run replays an old verdict).
ARG PROBE_NONCE="0"

RUN --mount=type=bind,source=windows/scripts/probe-sccache-2726-repro.ps1,target=C:\bkmnt\probe-sccache-2726-repro.ps1 `
    --mount=type=bind,source=windows/scripts/modules,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/upstream/sccache-nvcc-quote-fix,target=C:\bkmnt\patch `
    --mount=type=bind,source=linux/scripts/01-core/versions.env,target=C:\bkmnt\versions.env `
    & 'C:\bkmnt\probe-sccache-2726-repro.ps1' -Nonce "${PROBE_NONCE}"
