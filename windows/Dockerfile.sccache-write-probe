# escape=`
# Diagnostic only: the media builder's sccache env around one compile; mount ids must match the real build byte for byte.
ARG BASE_IMAGE=local/kataglyphis:bk-windows-toolchain
FROM ${BASE_IMAGE} AS probe

# Endpoint and chain are ARGs (RUN env only), like the real stages since 2026-09-23.
ARG SCCACHE_WEBDAV_ENDPOINT
ARG SCCACHE_MULTILEVEL_CHAIN="disk,webdav"
# debug: `Error executing cache write` is logged only at DEBUG level.
ARG SCCACHE_LOG="debug"

ENV SCCACHE_DIR="C:\sccache" `
    SCCACHE_CACHE_SIZE="15G" `
    SCCACHE_ERROR_LOG="C:\sccache-logs\sccache-error.log" `
    SCCACHE_LOG="${SCCACHE_LOG}" `
    SCCACHE_IDLE_TIMEOUT="0"

# Cache buster: a CACHED run replays an old verdict, and --no-cache would empty the cache under inspection.
ARG PROBE_NONCE="0"

# sharing=locked like the real stages, so a live build cannot mutate the mount under the probe.
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=locked `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/diagnostics/Test-SccacheWrite.ps1,target=C:\bkmnt\Test-SccacheWrite.ps1 `
    & 'C:\bkmnt\Test-SccacheWrite.ps1' -Nonce "${PROBE_NONCE}"
