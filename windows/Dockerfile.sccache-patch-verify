# escape=`
# =============================================================================
# Patch-verify probe: build sccache at the pin + the local quote-protection
# patch (windows/upstream/sccache-nvcc-quote-fix), then re-run the single-TU
# replay as regression test. Expected: bare == wrapped symbols. Run via:
#   run-diagnostic-probe.ps1 -Dockerfile Dockerfile.sccache-patch-verify -BaseImage local/kataglyphis:bk-windows-toolchain
# =============================================================================
ARG BASE_IMAGE=local/kataglyphis:bk-windows-toolchain
FROM ${BASE_IMAGE} AS probe

# Layer-cache buster (a CACHED run replays an old verdict).
ARG PROBE_NONCE="0"

RUN --mount=type=bind,source=windows/scripts/probe-sccache-patch-verify.ps1,target=C:\bkmnt\probe-sccache-patch-verify.ps1 `
    --mount=type=bind,source=windows/scripts/probe-onnx-tu-replay.ps1,target=C:\bkmnt\probe-onnx-tu-replay.ps1 `
    --mount=type=bind,source=windows/scripts/modules,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/upstream/sccache-nvcc-quote-fix,target=C:\bkmnt\patch `
    & 'C:\bkmnt\probe-sccache-patch-verify.ps1' -Nonce "${PROBE_NONCE}"; `
    Write-Host 'probe complete'
