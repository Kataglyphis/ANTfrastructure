# escape=`
# Copyright (c) 2025 Kataglyphis. All rights reserved.
# SPDX-License-Identifier: Apache-2.0
# Media merge stage: fan-in of the three parallel media branches, then GStreamer.
#   branch A (Dockerfile.media-core):   ONNX Runtime → GenAI → OpenCV → FFmpeg
#   branch B (Dockerfile.media-litert): LiteRT → LiteRT-LM
#   branch C (Dockerfile.media-tvm):    TVM (+ Python wheel into CPython)
# All branches install into C:\runtime from the same toolchain base, so the trees
# merge cleanly via COPY --from. GStreamer builds last — it auto-detects CUDA,
# OpenCV, ONNX and FFmpeg from the merged C:\runtime.
# windows/build.ps1 builds the branches concurrently and then this file.

ARG BASE_IMAGE=local/kataglyphis:windows-toolchain
ARG CORE_IMAGE=local/kataglyphis:windows-media-core
ARG LITERT_IMAGE=local/kataglyphis:windows-media-litert
ARG TVM_IMAGE=local/kataglyphis:windows-media-tvm

FROM ${CORE_IMAGE} AS media-core
FROM ${LITERT_IMAGE} AS media-litert
FROM ${TVM_IMAGE} AS media-tvm

FROM ${BASE_IMAGE}

ARG GSTREAMER_VERSION=1.29.2
ARG MEMORY_LIMIT_GB=""
# Component versions are consumed by the branch builds; they are re-declared here
# only so the image carries the canonical version env vars (and so that
# docs/scripts/sync_versions.py can verify them against versions.env).
ARG ONNXRUNTIME_VERSION=v1.27.0
ARG ONNXRUNTIME_GENAI_VERSION=v0.14.0
ARG OPENCV_SOURCE_VERSION=5.x
ARG FFMPEG_VERSION=master
ARG LITERT_VERSION=v2.1.5
ARG LITERT_LM_VERSION=0.13.1
ARG TVM_REF=v0.25.0

ENV MEMORY_LIMIT_GB="${MEMORY_LIMIT_GB}"
ENV ONNXRUNTIME_VERSION="${ONNXRUNTIME_VERSION}" `
    ONNXRUNTIME_GENAI_VERSION="${ONNXRUNTIME_GENAI_VERSION}" `
    OPENCV_SOURCE_VERSION="${OPENCV_SOURCE_VERSION}" `
    FFMPEG_VERSION="${FFMPEG_VERSION}" `
    LITERT_VERSION="${LITERT_VERSION}" `
    LITERT_LM_VERSION="${LITERT_LM_VERSION}" `
    TVM_REF="${TVM_REF}"

SHELL ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# ── Fan-in: merge the branch install trees ───────────────────────────────────
# Branch A carries the largest tree (ORT, GenAI, OpenCV, FFmpeg) — copy it first,
# then layer the independent branches' components on top.
COPY --from=media-core C:\runtime C:\runtime
COPY --from=media-litert C:\runtime\lib\litert C:\runtime\lib\litert
COPY --from=media-litert C:\runtime\lib\litert-lm C:\runtime\lib\litert-lm
COPY --from=media-tvm C:\runtime\lib\tvm C:\runtime\lib\tvm
# TVM's Python wheel (plus pip) lives in the branch CPython's site-packages;
# merging it here makes `import tvm` work in this image's CPython. The GStreamer
# script bootstraps pip itself if this copy ever lacks it.
COPY --from=media-tvm C:\temp\cpython\Lib\site-packages C:\temp\cpython\Lib\site-packages

# ── Canonical component layout for downstream consumers and verification ────
ENV GST_VERSION=${GSTREAMER_VERSION}
ENV GSTREAMER_VERSION=${GSTREAMER_VERSION}
ENV GSTREAMER_BIN="C:\runtime\bin"
ENV ONNX_ROOT="C:\runtime\lib\onnxruntime-source"
ENV ONNX_GENAI_ROOT="C:\runtime\lib\onnxruntime-genai-source"

# Canonical version aliases (values propagate from the branch images' ARGs via
# build.ps1 — kept as plain env vars here for verification scripts).
ENV ONNX_VERSION="${ONNXRUNTIME_VERSION}"
ENV ONNX_GENAI_VERSION="${ONNXRUNTIME_GENAI_VERSION}"

# GPU variant: CUDA detected from SDK layer (set by Dockerfile.nvidia; empty = CPU-only)
ENV ONNX_GPU_VARIANT="${GPU_TYPE}"

# LiteRT layout
ENV LITERT_ROOT="C:\runtime\lib\litert"
ENV LITERT_INCLUDE="${LITERT_ROOT}\include"
ENV LITERT_LIB="${LITERT_ROOT}\lib"
ENV LITERT_BIN="${LITERT_ROOT}\bin"

# LiteRT-LM layout
ENV LITERT_LM_ROOT="C:\runtime\lib\litert-lm"
ENV LITERT_LM_INCLUDE="${LITERT_LM_ROOT}\include"
ENV LITERT_LM_LIB="${LITERT_LM_ROOT}\lib"

# OpenCV layout
ENV OPENCV_ROOT="C:\runtime\lib\opencv5"
ENV OPENCV_INCLUDE="${OPENCV_ROOT}\include"
ENV OPENCV_LIB="${OPENCV_ROOT}\lib"
ENV OPENCV_BIN="${OPENCV_ROOT}\bin"

# FFmpeg layout
ENV FFMPEG_ROOT="C:\runtime\ffmpeg"
ENV FFMPEG_BIN="${FFMPEG_ROOT}\bin"
ENV FFMPEG_LIB="${FFMPEG_ROOT}\lib"

# TVM layout — TVM_LIBRARY_PATH lets the installed Python wheel locate tvm.dll
# (the C:\temp\tvm-src build tree is removed after install to keep layers small).
ENV TVM_ROOT="C:\runtime\lib\tvm"
ENV TVM_LIBRARY_PATH="${TVM_ROOT}\lib"

ENV PATH=$GSTREAMER_BIN;$FFMPEG_BIN;$ONNX_ROOT\lib;$ONNX_GENAI_ROOT\lib;$LITERT_BIN;$LITERT_LIB;$OPENCV_BIN;$TVM_LIBRARY_PATH;$PATH

# PKG_CONFIG_PATH for GStreamer to auto-detect FFmpeg, OpenCV, ONNX Runtime.
# LiteRT is excluded (TFLITE_ENABLE_INSTALL=OFF — no .pc files generated).
# GStreamer's own .pc files land at C:\runtime\lib\pkgconfig.
ENV PKG_CONFIG_PATH=$OPENCV_LIB\pkgconfig;$ONNX_ROOT\runtime\lib\pkgconfig;C:\runtime\lib\pkgconfig

# ── GStreamer (auto-detects CUDA, OpenCV, ONNX, FFmpeg from merged C:\runtime) ──
COPY windows\scripts\modules\WindowsScripts.Shared.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Common.psm1 `
     windows\scripts\modules\WindowsInstaller.Common.psm1 `
     C:\temp\scripts\modules\
COPY windows\scripts\build-gstreamer-from-source.ps1 C:\temp\scripts\
COPY windows\scripts\patches\gstreamer C:\temp\scripts\patches\gstreamer

RUN & 'C:\temp\scripts\build-gstreamer-from-source.ps1' -InstallDir 'C:\runtime' -LogDir 'C:\temp\logs'
