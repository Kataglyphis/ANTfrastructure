# escape=`
# Cached Windows media layer.
# Build order: ONNX Runtime/GenAI (git clone) -> OpenCV -> GStreamer
# This allows OpenCV and GStreamer to auto-detect ONNX Runtime.
# Binary install scripts (setup-opencv.ps1, setup-onnx.ps1) exist for
# reference but are NOT used in this Dockerfile (keep scripts - do not delete).
# CUDA/cuDNN from the SDK layer are auto-detected by the build scripts.

ARG BASE_IMAGE=local/kataglyphis:windows-toolchain
FROM ${BASE_IMAGE}

ARG GSTREAMER_VERSION=1.29.1
ARG ONNXRUNTIME_VERSION=1.27.0
ARG ONNXRUNTIME_GENAI_VERSION=0.13.1

ARG OPENCV_SOURCE_VERSION=5.x
ARG LITERT_VERSION=v2.1.5
ARG LITERT_LM_VERSION=0.13.1

SHELL ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Stable scripts (modules + stable build scripts - rarely change)
COPY windows\scripts\modules C:\temp\scripts\modules
COPY windows\scripts\build-onnx-from-source.ps1 C:\temp\scripts\
COPY windows\scripts\build-opencv-from-source.ps1 C:\temp\scripts\
COPY windows\scripts\build-gstreamer-from-source.ps1 C:\temp\scripts\

# ── Stage 1: ONNX Runtime source build via clang-cl (git clone) ─────
# Built before OpenCV so OpenCV can detect it.
ENV ONNXRUNTIME_VERSION="${ONNXRUNTIME_VERSION}"
RUN & 'C:\temp\scripts\build-onnx-from-source.ps1' `
    -SourceDir 'C:\temp\onnx-src' `
    -InstallDir 'C:\gstreamer'

# Volatile scripts (GenAI changes often - separate COPY to preserve ORT cache)
COPY windows\scripts\build-onnx-genai-from-source.ps1 C:\temp\scripts\

# ── Stage 2: ONNX GenAI source build via clang-cl (git clone) ───────
ENV ONNXRUNTIME_GENAI_VERSION="${ONNXRUNTIME_GENAI_VERSION}"
RUN & 'C:\temp\scripts\build-onnx-genai-from-source.ps1' `
    -SourceDir 'C:\temp\onnx-genai-src' `
    -InstallDir 'C:\gstreamer'

# ── Stage 3: OpenCV source build via clang-cl (CUDA auto-detected) ──
# Can now detect ONNX Runtime from Stage 1.
ENV OPENCV_SOURCE_VERSION="${OPENCV_SOURCE_VERSION}"
RUN & 'C:\temp\scripts\build-opencv-from-source.ps1' `
    -SourceDir 'C:\temp\opencv-src' `
    -InstallDir 'C:\gstreamer'

# Volatile scripts for LiteRT/LiteRT-LM (changes often)
COPY windows\scripts\build-litert-from-source.ps1 C:\temp\scripts\
COPY windows\scripts\build-litert-lm-from-source.ps1 C:\temp\scripts\

# ── Stage 4a: LiteRT (TensorFlow Lite runtime, CUDA/GPU auto-detected) ──
ENV LITERT_VERSION="${LITERT_VERSION}"
RUN & 'C:\temp\scripts\build-litert-from-source.ps1' `
    -SourceDir 'C:\temp\litert-src' `
    -InstallDir 'C:\gstreamer'

# ── Stage 4b: LiteRT-LM (on-device LLM inference, CUDA/GPU auto-detected) ──
ENV LITERT_LM_VERSION="${LITERT_LM_VERSION}"
RUN & 'C:\temp\scripts\build-litert-lm-from-source.ps1' `
    -SourceDir 'C:\temp\litert-lm-src' `
    -InstallDir 'C:\gstreamer'

# ── Stage 5: GStreamer (auto-detects CUDA, OpenCV, ONNX, LiteRT libs) ───────
ENV GST_VERSION=$GST_VERSION
ENV GSTREAMER_VERSION=$GST_VERSION
ENV GSTREAMER_BIN="C:\gstreamer\bin"
ENV ONNX_ROOT="C:\gstreamer\lib\onnxruntime-source"
ENV ONNX_GENAI_ROOT="C:\gstreamer\lib\onnxruntime-genai-source"

# Canonical version aliases for downstream consumers and verification scripts
ENV ONNX_VERSION="${ONNXRUNTIME_VERSION}"
ENV ONNX_GENAI_VERSION="${ONNXRUNTIME_GENAI_VERSION}"


# GPU variant: CUDA detected from SDK layer
ENV ONNX_GPU_VARIANT="cuda"

# LiteRT layout
ENV LITERT_ROOT="C:\gstreamer\lib\litert"
ENV LITERT_INCLUDE="${LITERT_ROOT}\include"
ENV LITERT_LIB="${LITERT_ROOT}\lib"
ENV LITERT_BIN="${LITERT_ROOT}\bin"

# LiteRT-LM layout
ENV LITERT_LM_ROOT="C:\gstreamer\lib\litert-lm"
ENV LITERT_LM_INCLUDE="${LITERT_LM_ROOT}\include"
ENV LITERT_LM_LIB="${LITERT_LM_ROOT}\lib"

# OpenCV layout
ENV OPENCV_ROOT="C:\gstreamer\lib\opencv5"
ENV OPENCV_INCLUDE="${OPENCV_ROOT}\include"
ENV OPENCV_LIB="${OPENCV_ROOT}\lib"
ENV OPENCV_BIN="${OPENCV_ROOT}\bin"

ENV PATH=$GSTREAMER_BIN;$ONNX_ROOT\lib;$ONNX_GENAI_ROOT\lib;$LITERT_BIN;$LITERT_LIB;$OPENCV_BIN;$PATH

RUN & 'C:\temp\scripts\build-gstreamer-from-source.ps1' -InstallDir 'C:\gstreamer' -LogDir 'C:\temp\logs'
