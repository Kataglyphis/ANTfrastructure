# Media fan-in: the three branch trees, the env layout, then GStreamer and the bundle gates in `built`.

ARG BASE_IMAGE=local/kataglyphis:windows-toolchain
ARG CORE_IMAGE=local/kataglyphis:windows-media-core
ARG LITERT_IMAGE=local/kataglyphis:windows-media-litert
ARG TVM_IMAGE=local/kataglyphis:windows-media-tvm

FROM ${CORE_IMAGE} AS media-core
FROM ${LITERT_IMAGE} AS media-litert
FROM ${TVM_IMAGE} AS media-tvm

# A script, not a COPY, flattens the spaced, nested CUDA/cuDNN DLL dirs; on BASE_IMAGE so media-core rebuilds never re-run it.
FROM ${BASE_IMAGE} AS cuda-runtime-stage
# Redeclared (ARGs do not cross FROM): the script picks bin\ or bin\arm64 by lane.
ARG WINDOWS_TARGET_ARCH=amd64
ENV WINDOWS_TARGET_ARCH=${WINDOWS_TARGET_ARCH}
COPY windows\scripts\build\Copy-CudaRuntime.ps1 C:\Copy-CudaRuntime.ps1
RUN pwsh -NoProfile -ExecutionPolicy Bypass -File C:\Copy-CudaRuntime.ps1

# The four merge-only leaf modules live here, never in the media buildmods, whose edits would re-run every media compile.
FROM ${BASE_IMAGE} AS buildmods
COPY windows\scripts\modules\WindowsSourceBuild.Common.psm1 `
     windows\scripts\modules\WindowsScripts.Shared.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Patches.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Cuda.psm1 `
     windows\scripts\modules\WindowsNative.Common.psm1 `
     windows\scripts\modules\WindowsTargetArch.Common.psm1 `
     windows\scripts\modules\WindowsInstaller.Common.psm1 `
     windows\scripts\modules\WindowsGstPlugins.Common.psm1 `
     windows\scripts\modules\WindowsMeson.Common.psm1 `
     windows\scripts\modules\WindowsRustToolchain.Common.psm1 `
     C:\bkmods\

# No script COPYs in the fan-in: mounting keeps these layers out of every script's cache key.
FROM ${BASE_IMAGE} AS merge-fanin

ARG WINDOWS_TARGET_ARCH=amd64
ENV WINDOWS_TARGET_ARCH=${WINDOWS_TARGET_ARCH}
# A Dockerfile cannot branch on the arch, and the OPENCV_LIB it feeds wins over GStreamer's arch-aware fallback.
ARG OPENCV_ARCH_DIR=x64
ARG GSTREAMER_VERSION=1.29.2
# Re-declared only so the image carries the canonical version env (sync_versions.py verifies them).
ARG ONNXRUNTIME_VERSION=v1.30.0
ARG ONNXRUNTIME_GENAI_VERSION=v0.15.2
ARG OPENCV_SOURCE_VERSION=5.0.0
ARG FFMPEG_VERSION=n9.0.2
ARG PYAV_VERSION=18.1.0
ARG LITERT_VERSION=v2.2.0
ARG LITERT_LM_VERSION=0.17.1
ARG TVM_REF=v0.26.0
ARG IREE_VERSION=v3.11.0
ARG HAILORT_VERSION=5.4.0

# One ENV for the 125-layer cap; same-instruction ${} refs do not resolve, so paths are literal.
ENV ONNXRUNTIME_VERSION="${ONNXRUNTIME_VERSION}" `
    ONNXRUNTIME_GENAI_VERSION="${ONNXRUNTIME_GENAI_VERSION}" `
    OPENCV_SOURCE_VERSION="${OPENCV_SOURCE_VERSION}" `
    FFMPEG_VERSION="${FFMPEG_VERSION}" `
    PYAV_VERSION="${PYAV_VERSION}" `
    LITERT_VERSION="${LITERT_VERSION}" `
    LITERT_LM_VERSION="${LITERT_LM_VERSION}" `
    TVM_REF="${TVM_REF}" `
    IREE_VERSION="${IREE_VERSION}" `
    GSTREAMER_VERSION="${GSTREAMER_VERSION}" `
    GSTREAMER_BIN="C:\runtime\bin" `
    ONNX_ROOT="C:\runtime\lib\onnxruntime-source" `
    ONNX_GENAI_ROOT="C:\runtime\lib\onnxruntime-genai-source" `
    ONNX_VERSION="${ONNXRUNTIME_VERSION}" `
    ONNX_GENAI_VERSION="${ONNXRUNTIME_GENAI_VERSION}" `
    LITERT_ROOT="C:\runtime\lib\litert" `
    LITERT_INCLUDE="C:\runtime\lib\litert\include" `
    LITERT_LIB="C:\runtime\lib\litert\lib" `
    LITERT_BIN="C:\runtime\lib\litert\bin" `
    LITERT_LM_ROOT="C:\runtime\lib\litert-lm" `
    LITERT_LM_INCLUDE="C:\runtime\lib\litert-lm\include" `
    LITERT_LM_BIN="C:\runtime\lib\litert-lm\bin" `
    # No LITERT_LM_LIB: the bazel build ships an executable and no library set.
    OPENCV_ROOT="C:\runtime\lib\opencv5" `
    OPENCV_INCLUDE="C:\runtime\lib\opencv5\include" `
    OPENCV_LIB="C:\runtime\lib\opencv5\${OPENCV_ARCH_DIR}\vc18\lib" `
    OPENCV_BIN="C:\runtime\lib\opencv5\${OPENCV_ARCH_DIR}\vc18\bin" `
    FFMPEG_ROOT="C:\runtime\ffmpeg" `
    FFMPEG_BIN="C:\runtime\ffmpeg\bin" `
    FFMPEG_LIB="C:\runtime\ffmpeg\lib" `
    TVM_ROOT="C:\runtime\lib\tvm" `
    TVM_LIBRARY_PATH="C:\runtime\lib\tvm\lib" `
    IREE_ROOT="C:\runtime\iree" `
    IREE_BIN="C:\runtime\iree\bin" `
    HAILORT_VERSION="${HAILORT_VERSION}" `
    HAILO_ROOT="C:\runtime\hailo" `
    HAILO_BIN="C:\runtime\hailo\bin" `
    PYTHON_WHEELS="C:\runtime\wheels"

SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; $PSNativeCommandUseErrorActionPreference = $false;"]

# Fan-in, largest branch tree first
COPY --from=media-core C:\runtime C:\runtime
# The CUDA-built libs link cudnn/cudart, which live outside C:\runtime; without this they fail to load with Win32 126.
COPY --from=cuda-runtime-stage C:\cuda-rt C:\runtime\cuda-runtime\bin
# Host CPython bindings; the cross lane's aarch64 ones live in C:\runtime\python and C:\runtime\wheels.
COPY --from=media-core C:\temp\cpython\Lib\site-packages C:\temp\cpython\Lib\site-packages
COPY --from=media-litert C:\runtime\lib\litert C:\runtime\lib\litert
COPY --from=media-litert C:\runtime\lib\litert-lm C:\runtime\lib\litert-lm
COPY --from=media-tvm C:\runtime\lib\tvm C:\runtime\lib\tvm
# IREE native tools + libs (iree-compile, iree-run-module) from the same branch.
COPY --from=media-tvm C:\runtime\iree C:\runtime\iree
# tvm/iree wheels merge over media-core's; the filenames are distinct.
COPY --from=media-tvm C:\runtime\wheels C:\runtime\wheels
# Makes `import tvm` work in this image's CPython.
COPY --from=media-tvm C:\temp\cpython\Lib\site-packages C:\temp\cpython\Lib\site-packages

# PKG_CONFIG_PATH lets GStreamer auto-detect FFmpeg (gst-libav) and OpenCV.
ENV PATH=C:\runtime\cuda-runtime\bin;$GSTREAMER_BIN;$FFMPEG_BIN;$ONNX_ROOT\bin;$ONNX_ROOT\lib;$ONNX_GENAI_ROOT\bin;$ONNX_GENAI_ROOT\lib;$LITERT_BIN;$LITERT_LIB;$OPENCV_BIN;$TVM_LIBRARY_PATH;$IREE_BIN;$HAILO_BIN;$PATH `
    PKG_CONFIG_PATH=$FFMPEG_LIB\pkgconfig;$OPENCV_LIB\pkgconfig;C:\runtime\lib\pkgconfig

# Re-COPY: the base bakes a stale versions.env, and the build scripts re-read it at run time.
COPY linux\scripts\01-core\versions.env C:\temp\versions.env

# Declared globally so the driver's --build-arg binds, then redeclared in `built`, whose RUN reads them.
ARG DEPS_MIN_BUNDLE_WHEELS=0
ARG DEPS_MIN_FIRST_TOUCH_REQS=0

# GStreamer builds and exports in one plain RUN.
FROM merge-fanin AS built
# ENV'd above the RUN that reads them, so a drop in wheel count fails the gate.
ARG DEPS_MIN_BUNDLE_WHEELS=0
ARG DEPS_MIN_FIRST_TOUCH_REQS=0
ENV DEPS_MIN_BUNDLE_WHEELS=${DEPS_MIN_BUNDLE_WHEELS} `
    DEPS_MIN_FIRST_TOUCH_REQS=${DEPS_MIN_FIRST_TOUCH_REQS}
# Build-host settings are ARGs only; see docs/windows-build-resources.md § What the published image carries.
ARG SCCACHE_WEBDAV_ENDPOINT
# Overridable for a one-stage debug re-run: -BuildArg SCCACHE_LOG=debug.
ARG SCCACHE_LOG="warn"
# Unset (remote-only) like media-builder's `common`; change both together, see docs/windows-build-resources.md § Persistent compile cache (sccache).
ARG SCCACHE_MULTILEVEL_CHAIN
# Kept identical to media-builder's sccache block.
ARG SCCACHE_DIR="C:\sccache\v2"
ARG SCCACHE_FORCE_LOCAL
ENV SCCACHE_DIR="${SCCACHE_DIR}" `
    SCCACHE_CACHE_SIZE="15G" `
    SCCACHE_ERROR_LOG="C:\sccache-logs\sccache-error.log" `
    SCCACHE_LOG="${SCCACHE_LOG}" `
    SCCACHE_IDLE_TIMEOUT="0"
# Same cache id as the media builder: the same clang-cl TUs make a shared L0 a hit, not a conflict.
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=shared `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/Build-GstreamerFromSource.ps1,target=C:\bkmnt\Build-GstreamerFromSource.ps1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsOrtProvenance.Build.psm1,target=C:\bkmnt\ortmods\WindowsOrtProvenance.Build.psm1 `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/patches/gstreamer,target=C:\bkmnt\patches\gstreamer `
    & 'C:\bkmnt\Build-GstreamerFromSource.ps1' -InstallDir 'C:\runtime' -LogDir 'C:\temp\logs' -ScrubAfter

# OpenCV's standalone GStreamer videoio plugin, after GStreamer exists; getBuildInformation() still says NO, hasBackend() is the truth.
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=shared `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build/Build-OpencvGstreamerPlugin.ps1,target=C:\bkmnt\Build-OpencvGstreamerPlugin.ps1 `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    & 'C:\bkmnt\Build-OpencvGstreamerPlugin.ps1' -InstallDir 'C:\runtime'

# The cp313 win-arm64 torch stack for the wheel store; before the manifest so its wheel list counts them.
RUN --mount=type=bind,source=windows/scripts/build/Copy-Arm64TorchWheels.ps1,target=C:\bkmnt\Copy-Arm64TorchWheels.ps1 `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    & 'C:\bkmnt\Copy-Arm64TorchWheels.ps1' -ScriptDir 'C:\bkmnt'

# Mesa's lavapipe: the CPU Vulkan ICD the goldens run on (CON50); before the manifest so BUNDLE-ENV/README name it.
RUN --mount=type=bind,source=windows/scripts/host/Install-Lavapipe.ps1,target=C:\bkmnt\Install-Lavapipe.ps1 `
    --mount=type=bind,source=windows/scripts/build/Import-Versions.ps1,target=C:\bkmnt\Import-Versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    & 'C:\bkmnt\Install-Lavapipe.ps1' -ScriptDir 'C:\bkmnt'
# Mesa 26.2's BVH sort needs 8-lane subgroups; arm64's native 128 bits give 4 and SEGV (CON44).
ENV LP_NATIVE_VECTOR_WIDTH=256

# The bundle describes itself (BUNDLE-ENV, BUNDLE-README); text files, invisible to the arch gate.
RUN --mount=type=bind,source=windows/scripts/build/Write-BundleManifest.ps1,target=C:\bkmnt\Write-BundleManifest.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    & 'C:\bkmnt\Write-BundleManifest.ps1' -ScriptDir 'C:\bkmnt'
# Before the arch gate, so the staged target-tag deps are machine-checked and import-walked too.
RUN --mount=type=bind,source=windows/scripts/build/Copy-TargetPythonDeps.ps1,target=C:\bkmnt\Copy-TargetPythonDeps.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    & 'C:\bkmnt\Copy-TargetPythonDeps.ps1' -ScriptDir 'C:\bkmnt' `
        -MinBundleWheels ([int]$env:DEPS_MIN_BUNDLE_WHEELS) `
        -MinFirstTouchRequirements ([int]$env:DEPS_MIN_FIRST_TOUCH_REQS)

# The cross bundle carries the VS-toolset runtimes it links (ASan + OpenMP); the arch gate below machine-checks them.
RUN --mount=type=bind,source=windows/scripts/build/Copy-Arm64VsRuntime.ps1,target=C:\bkmnt\Copy-Arm64VsRuntime.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    & 'C:\bkmnt\Copy-Arm64VsRuntime.ps1' -ScriptDir 'C:\bkmnt'

# Arch gate: on a cross lane the PE machine type is the only correctness signal; the floor fails a run that inspected nothing.
ARG ARCH_GATE_MIN_INSPECTED=10
ARG ARCH_GATE_HOST_TOOLS="protoc\.exe|flatc\.exe|\\_deps\\|\\distlib\\[tw](32|64)[^\\]*\.exe|\\setuptools\\(cli|gui)[^\\]*\.exe"
# One module mounted, not the closure, so an undeclared new import fails the gate loudly.
RUN --mount=type=bind,source=windows/scripts/build/Test-TargetArch.ps1,target=C:\bkmnt\Test-TargetArch.ps1 `
    --mount=type=bind,source=windows/scripts/modules/WindowsTargetArch.Common.psm1,target=C:\bkmnt\modules\WindowsTargetArch.Common.psm1 `
    & 'C:\bkmnt\Test-TargetArch.ps1' -Path @('C:\runtime', 'C:\temp\cpython\Lib\site-packages') -Arch $env:WINDOWS_TARGET_ARCH `
        -MinInspected ([int]$env:ARCH_GATE_MIN_INSPECTED) -HostToolPattern $env:ARCH_GATE_HOST_TOOLS -IncludeArchives -ImportWalk
