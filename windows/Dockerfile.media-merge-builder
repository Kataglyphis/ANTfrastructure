# Thin builder image for the media-merge run+commit path (windows/build.ps1
# Invoke-RunCommitStage). It performs the fan-in (COPY --from of the three media
# branch trees) and sets the canonical env layout + GStreamer scripts, but does NOT
# run the GStreamer compile. The fan-in MUST be a `docker build` (docker run cannot
# COPY --from) and is only IO, so 2 CPUs is fine. The CPU-bound GStreamer build then
# runs via:
#   docker run --isolation hyperv --cpu-count N --memory Mg <this image> `
#       pwsh -File C:\temp\scripts\build-gstreamer-from-source.ps1 -InstallDir C:\runtime -LogDir C:\temp\logs
#   docker commit <container> local/kataglyphis:windows-media
# `docker commit` preserves the ENV set below. This file IS the former
# Dockerfile.media (since removed) minus the final GStreamer RUN, which moved to
# the run+commit step above.

ARG BASE_IMAGE=local/kataglyphis:windows-toolchain
ARG CORE_IMAGE=local/kataglyphis:windows-media-core
ARG LITERT_IMAGE=local/kataglyphis:windows-media-litert
ARG TVM_IMAGE=local/kataglyphis:windows-media-tvm

FROM ${CORE_IMAGE} AS media-core
FROM ${LITERT_IMAGE} AS media-litert
FROM ${TVM_IMAGE} AS media-tvm

# Flatten the CUDA/cuDNN runtime DLLs into one dir the merge image can put on
# PATH. Derived from media-core (built on the nvidia base -> carries CUDA_ROOT /
# CUDNN_ROOT + the actual DLLs). A COPY cannot do this: the sources are under
# "C:\Program Files\..." (spaces) and cuDNN 9 buries its DLLs in a CUDA-major
# subdir under bin\, so a recursive script is needed. See stage-cuda-runtime.ps1.
FROM ${CORE_IMAGE} AS cuda-runtime-stage
COPY windows\scripts\stage-cuda-runtime.ps1 C:\stage-cuda-runtime.ps1
RUN pwsh -NoProfile -ExecutionPolicy Bypass -File C:\stage-cuda-runtime.ps1

# ── Mount source for the BK lane's module closure ────────────────────────────
# Same pattern (and same reasoning) as Dockerfile.media-builder's `buildmods`:
# one stage holding exactly the in-container module closure, mounted as a single
# --mount line instead of six that had to be kept in lockstep by hand. This
# closure carries Installer.Common and GstPlugins.Common on top of the
# media-builder five — GStreamer's script is the only consumer of both.
# GstPlugins.Common (the mandatory-plugin contract + the pkg-config emitter)
# exists as its OWN module precisely so it can live here and NOT in the
# media-builder's five: those five are mounted into all six media compile RUNs,
# so putting the plugin contract in Shared/SourceBuild.Common would make every
# edit to it re-run ONNX (~75 min), OpenCV, FFmpeg, GenAI, litert and tvm — for
# code none of them call. Parent is BASE_IMAGE so the fan-in COPYs (and
# therefore the three branch images) never key into it.
FROM ${BASE_IMAGE} AS buildmods
COPY windows\scripts\modules\WindowsSourceBuild.Common.psm1 `
     windows\scripts\modules\WindowsScripts.Shared.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Patches.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Cuda.psm1 `
     windows\scripts\modules\WindowsNative.Common.psm1 `
     windows\scripts\modules\WindowsInstaller.Common.psm1 `
     windows\scripts\modules\WindowsGstPlugins.Common.psm1 `
     C:\bkmods\

# Fan-in WITHOUT the script COPYs: the BK warm/built stages chain from here so
# a GStreamer script edit re-runs only the RUN that bind-mounts it, never the
# fan-in COPY layers. The classic `merge` target (fan-in + baked scripts for
# the run+commit step) builds on top below.
FROM ${BASE_IMAGE} AS merge-fanin

ARG GSTREAMER_VERSION=1.29.2
ARG MEMORY_LIMIT_GB=""
# Component versions are consumed by the branch builds; re-declared here only so the
# image carries the canonical version env vars (sync_versions.py verifies them).
ARG ONNXRUNTIME_VERSION=v1.28.0
ARG ONNXRUNTIME_GENAI_VERSION=v0.15.2
ARG OPENCV_SOURCE_VERSION=5.0.0
ARG FFMPEG_VERSION=n9.0
ARG PYAV_VERSION=18.0.0
ARG LITERT_VERSION=v2.1.6
ARG LITERT_LM_VERSION=0.15.0
ARG TVM_REF=v0.25.0
ARG IREE_VERSION=v3.11.0

# ONE ENV instruction for everything below PATH: the classic builder emits a
# layer PER INSTRUCTION (even metadata), and windows-torch hit Docker's hard
# 125-layer cap on 2026-08-03 ("max depth exceeded" in the final stage) with
# ~28 separate ENV lines here as the main cost. Same-instruction ${} refs don't
# resolve, so derived paths are written out literally (layouts documented below).
ENV MEMORY_LIMIT_GB="${MEMORY_LIMIT_GB}" `
    ONNXRUNTIME_VERSION="${ONNXRUNTIME_VERSION}" `
    ONNXRUNTIME_GENAI_VERSION="${ONNXRUNTIME_GENAI_VERSION}" `
    OPENCV_SOURCE_VERSION="${OPENCV_SOURCE_VERSION}" `
    FFMPEG_VERSION="${FFMPEG_VERSION}" `
    PYAV_VERSION="${PYAV_VERSION}" `
    LITERT_VERSION="${LITERT_VERSION}" `
    LITERT_LM_VERSION="${LITERT_LM_VERSION}" `
    TVM_REF="${TVM_REF}" `
    IREE_VERSION="${IREE_VERSION}" `
    GSTREAMER_VERSION="${GSTREAMER_VERSION}" `
    GSTREAMER_BIN="C:\runtime\bin" `
    ONNX_ROOT="C:\runtime\lib\onnxruntime-source" `
    ONNX_GENAI_ROOT="C:\runtime\lib\onnxruntime-genai-source" `
    ONNX_VERSION="${ONNXRUNTIME_VERSION}" `
    ONNX_GENAI_VERSION="${ONNXRUNTIME_GENAI_VERSION}" `
    ONNX_GPU_VARIANT="${GPU_TYPE}" `
    LITERT_ROOT="C:\runtime\lib\litert" `
    LITERT_INCLUDE="C:\runtime\lib\litert\include" `
    LITERT_LIB="C:\runtime\lib\litert\lib" `
    LITERT_BIN="C:\runtime\lib\litert\bin" `
    LITERT_LM_ROOT="C:\runtime\lib\litert-lm" `
    LITERT_LM_INCLUDE="C:\runtime\lib\litert-lm\include" `
    LITERT_LM_LIB="C:\runtime\lib\litert-lm\lib" `
    OPENCV_ROOT="C:\runtime\lib\opencv5" `
    OPENCV_INCLUDE="C:\runtime\lib\opencv5\include" `
    OPENCV_LIB="C:\runtime\lib\opencv5\x64\vc18\lib" `
    OPENCV_BIN="C:\runtime\lib\opencv5\x64\vc18\bin" `
    FFMPEG_ROOT="C:\runtime\ffmpeg" `
    FFMPEG_BIN="C:\runtime\ffmpeg\bin" `
    FFMPEG_LIB="C:\runtime\ffmpeg\lib" `
    TVM_ROOT="C:\runtime\lib\tvm" `
    TVM_LIBRARY_PATH="C:\runtime\lib\tvm\lib" `
    IREE_ROOT="C:\runtime\iree" `
    IREE_BIN="C:\runtime\iree\bin" `
    PYTHON_WHEELS="C:\runtime\wheels"

SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# ── Fan-in: merge the branch install trees ───────────────────────────────────
# Branch A carries the largest tree (ORT, GenAI, OpenCV, FFmpeg) — copy it first,
# then layer the independent branches' components on top.
COPY --from=media-core C:\runtime C:\runtime
# CUDA/cuDNN RUNTIME DLLs. The CUDA-built libs fanned in above (OpenCV with
# WITH_CUDA/WITH_CUDNN, onnxruntime's CUDA EP, TVM's CUDA backend) hard- or
# delay-link cudnn64_9.dll + cudart/cublas, which live in the nvidia base's
# NVIDIA install dirs -- NOT under C:\runtime, so the fan-in above missed them
# and gst-plugins-bad's opencv plugin (and any GPU code path) failed to LOAD
# with Win32 126 "The specified module could not be found". Stage the runtime
# DLLs from media-core (built on the nvidia base, so it carries them) into a
# stable dir that the ENV PATH below exposes.
# The CUDA/cuDNN runtime DLLs, pre-flattened into one dir by cuda-runtime-stage
# (see the stage above): a plain COPY of a no-space, single-level dir -- so it
# lands cudnn64_9.dll + cudart/cublas directly on the PATH set below.
COPY --from=cuda-runtime-stage C:\cuda-rt C:\runtime\cuda-runtime\bin
# media-core's CPython site-packages carry the installed python bindings
# (onnxruntime + onnxruntime-genai wheels, cv2 from cmake --install) plus their
# pypi deps (numpy, ...) and the win-amd64 platform-tag sitecustomize shim —
# fan them in so `import onnxruntime/cv2` works in this image's CPython.
COPY --from=media-core C:\temp\cpython\Lib\site-packages C:\temp\cpython\Lib\site-packages
COPY --from=media-litert C:\runtime\lib\litert C:\runtime\lib\litert
COPY --from=media-litert C:\runtime\lib\litert-lm C:\runtime\lib\litert-lm
COPY --from=media-tvm C:\runtime\lib\tvm C:\runtime\lib\tvm
# IREE native tools + libs (iree-compile, iree-run-module) from the same branch.
COPY --from=media-tvm C:\runtime\iree C:\runtime\iree
# media-tvm's wheel store entries (tvm/iree wheels) merge over media-core's
# (distinct filenames; C:\runtime\wheels is the central store, see PYTHON_WHEELS).
COPY --from=media-tvm C:\runtime\wheels C:\runtime\wheels
# TVM's Python wheel (plus pip) lives in the branch CPython's site-packages;
# merging it here makes `import tvm` work in this image's CPython. The GStreamer
# script bootstraps pip itself if this copy ever lacks it.
COPY --from=media-tvm C:\temp\cpython\Lib\site-packages C:\temp\cpython\Lib\site-packages

# ── Canonical component layout: see the single consolidated ENV above ────────
# (GSTREAMER/ONNX/LITERT/LITERT_LM/OPENCV/FFMPEG/TVM/IREE roots + version
# aliases + PYTHON_WHEELS all live there; OpenCV bin/lib deliberately point at
# the MSVC-style x64\vc18 subtree its Windows install emits.)
#
# PATH references the vars above, and PKG_CONFIG_PATH lets GStreamer auto-detect
# FFmpeg + OpenCV (libav*.pc enables gst-libav; LiteRT and ONNX Runtime ship no
# .pc files). GStreamer's own .pc files land at C:\runtime\lib\pkgconfig.
ENV PATH=C:\runtime\cuda-runtime\bin;$GSTREAMER_BIN;$FFMPEG_BIN;$ONNX_ROOT\bin;$ONNX_ROOT\lib;$ONNX_GENAI_ROOT\bin;$ONNX_GENAI_ROOT\lib;$LITERT_BIN;$LITERT_LIB;$OPENCV_BIN;$TVM_LIBRARY_PATH;$IREE_BIN;$PATH `
    PKG_CONFIG_PATH=$FFMPEG_LIB\pkgconfig;$OPENCV_LIB\pkgconfig;C:\runtime\lib\pkgconfig

# Re-COPY versions.env (base bakes a stale copy — build scripts re-read this at run time).
# See the identical pattern in Dockerfile.media-builder (common stage).
COPY linux\scripts\01-core\versions.env C:\temp\versions.env

# ── Classic run+commit target: fan-in + baked GStreamer scripts ──────────────
# (the compile itself runs in the run+commit step, NOT here; the BK lane's
# warm/built stages chain from merge-fanin and bind-mount the scripts instead)
FROM merge-fanin AS merge
COPY windows\scripts\modules\WindowsScripts.Shared.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Common.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Patches.psm1 `
     windows\scripts\modules\WindowsSourceBuild.Cuda.psm1 `
     windows\scripts\modules\WindowsInstaller.Common.psm1 `
     windows\scripts\modules\WindowsNative.Common.psm1 `
     windows\scripts\modules\WindowsGstPlugins.Common.psm1 `
     C:\temp\scripts\modules\
COPY windows\scripts\build-gstreamer-from-source.ps1 C:\temp\scripts\
COPY windows\scripts\patches\gstreamer C:\temp\scripts\patches\gstreamer

# ── BuildKit lane (direct solve, de-warmed 2026-08-06 round 2) ──────────────
# GStreamer builds AND exports in one plain RUN. The former warm/materialize
# pair existed for the ExportLayer-0x3 defect — root cause was the runhcs
# shim's hardcoded 30s tearDownTimeout killing the minutes-long heavy-churn
# silo teardown; fixed by the patched shim in Stevedore\bin (see
# Dockerfile.media-builder's BK header + docs/windows-builds.md § roadmap
# "DEFECT SOLVED"). The classic docker lane always passes --target merge
# (build.ps1) and never executes this RUN.
FROM merge-fanin AS built
# ARGs do not cross stage boundaries — redeclare for sccache.
ARG SCCACHE_WEBDAV_ENDPOINT=""
# Two-tier sccache, same reasoning and same caveats as Dockerfile.media-builder's
# `common` stage (read the block there before changing either). This stage is not
# a descendant of it, so the variables have to be repeated -- ENV does not cross a
# FROM boundary any more than ARG does.
ENV SCCACHE_WEBDAV_ENDPOINT="${SCCACHE_WEBDAV_ENDPOINT}" `
    SCCACHE_MULTILEVEL_CHAIN="disk,webdav" `
    SCCACHE_DIR="C:\sccache" `
    SCCACHE_CACHE_SIZE="15G" `
    SCCACHE_ERROR_LOG="C:\sccache-logs\sccache-error.log" `
    SCCACHE_LOG="warn" `
    SCCACHE_IDLE_TIMEOUT="0"
# Same cache id as the media builder on purpose: GStreamer compiles the same
# clang-cl TUs against the same headers, so a shared L0 is a hit, not a conflict.
RUN --mount=type=cache,target=C:\sccache,id=sccache-winamd64-2,sharing=locked `
    --mount=type=cache,target=C:\sccache-logs,id=sccache-logs-winamd64,sharing=shared `
    --mount=type=bind,source=windows/scripts/build-gstreamer-from-source.ps1,target=C:\bkmnt\build-gstreamer-from-source.ps1 `
    --mount=type=bind,source=windows/scripts/load-versions.ps1,target=C:\bkmnt\load-versions.ps1 `
    --mount=type=bind,from=buildmods,source=/bkmods,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/patches/gstreamer,target=C:\bkmnt\patches\gstreamer `
    & 'C:\bkmnt\build-gstreamer-from-source.ps1' -InstallDir 'C:\runtime' -LogDir 'C:\temp\logs' -ScrubAfter
