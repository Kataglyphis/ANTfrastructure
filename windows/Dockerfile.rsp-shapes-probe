# escape=`
# =============================================================================
# Which nvcc --options-file shapes does sccache cache? (#115). Ships nothing.
#   run-diagnostic-probe.ps1 -Dockerfile Dockerfile.rsp-shapes-probe -BaseImage local/kataglyphis:bk-windows-toolchain
# =============================================================================
ARG BASE_IMAGE=local/kataglyphis:bk-windows-toolchain
FROM ${BASE_IMAGE} AS probe

# Layer-cache buster (a CACHED run replays an old verdict).
ARG PROBE_NONCE="0"

RUN --mount=type=bind,source=windows/scripts/diagnostics/probe-sccache-rsp-shapes.ps1,target=C:\bkmnt\probe-sccache-rsp-shapes.ps1 `
    --mount=type=bind,source=windows/scripts/modules,target=C:\bkmnt\modules `
    & 'C:\bkmnt\probe-sccache-rsp-shapes.ps1' -Nonce "${PROBE_NONCE}"
