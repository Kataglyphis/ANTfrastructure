# escape=`
# Copyright (c) 2025 Kataglyphis
# SPDX-License-Identifier: MIT
# Smoke-tests a built image in a buildctl solve, because nerdctl run needs admin and the driver runs non-admin.

ARG BASE_IMAGE=local/kataglyphis:winamd64
FROM ${BASE_IMAGE}

SHELL ["pwsh", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; $PSNativeCommandUseErrorActionPreference = $false;"]

# Coverage floors make a fully skipped run fail; ARGs so a lane with fewer sections lowers them explicitly.
ARG MIN_PASSED=40
ARG MAX_SKIPPED=24
ARG EXPECT_GPU=0
# 1 on the rocm variant: Test-RocmImage.ps1 runs after the main suite, through the same entrypoint.
ARG EXPECT_ROCM=0
# No default: other lanes' RUN env stays untouched, and an unset value fails the rocm gate.
ARG EXPECT_ROCM_SPIKES

# Live scripts mounted whole (no rebuild, no layer), run through the entrypoint, which loads VsDevCmd and the ASAN PATH.
RUN --mount=type=bind,source=windows/scripts,target=C:\gate\scripts `
    $cmdline = 'pwsh -NoProfile -ExecutionPolicy Bypass -File C:\gate\scripts\build\Test-Container.ps1 -MinPassed ' + $env:MIN_PASSED + ' -MaxSkipped ' + $env:MAX_SKIPPED; `
    if ($env:EXPECT_GPU -eq '1') { $cmdline = $cmdline + ' -ExpectGpu' }; `
    & cmd /S /C ('C:\temp\scripts\entrypoint.cmd ' + $cmdline); `
    if ($LASTEXITCODE -ne 0) { throw ('smoke gate FAILED (exit ' + $LASTEXITCODE + ') - see the assertion output above') }; `
    if ($env:EXPECT_ROCM -eq '1') { `
        & cmd /S /C 'C:\temp\scripts\entrypoint.cmd pwsh -NoProfile -ExecutionPolicy Bypass -File C:\gate\scripts\build\Test-RocmImage.ps1'; `
        if ($LASTEXITCODE -ne 0) { throw ('ROCm smoke checks FAILED (exit ' + $LASTEXITCODE + ') - see the output above') } `
    }

# No marker RUN: the solve is -NoOutput, so the smoke RUN's exit code is the verdict.
