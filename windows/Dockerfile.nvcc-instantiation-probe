# escape=`
# =============================================================================
# Forensic probe: does sccache's nvcc decomposition drop guarded explicit
# instantiations on a SINGLE synthetic TU? (2026-08-18 miscompile verdict;
# mozilla/sccache#2808 family.) Ships nothing. Run via:
#   run-diagnostic-probe.ps1 -Dockerfile Dockerfile.nvcc-instantiation-probe -BaseImage local/kataglyphis:bk-windows-toolchain -VerdictPattern '\[ OK \]|\[FAIL\]|MISSING|plan\|'
# Compile-only: no GPU required. Uses a private local cache dir + own server -
# never touches the production WebDAV backend or the sccache cache mount.
# =============================================================================
ARG BASE_IMAGE=local/kataglyphis:bk-windows-toolchain
FROM ${BASE_IMAGE} AS probe

# Layer-cache buster (a CACHED run replays an old verdict).
ARG PROBE_NONCE="0"

RUN --mount=type=bind,source=windows/scripts/probe-sccache-nvcc-instantiation.ps1,target=C:\bkmnt\probe-sccache-nvcc-instantiation.ps1 `
    --mount=type=bind,source=windows/scripts/modules,target=C:\bkmnt\modules `
    & 'C:\bkmnt\probe-sccache-nvcc-instantiation.ps1' -Nonce "${PROBE_NONCE}"
