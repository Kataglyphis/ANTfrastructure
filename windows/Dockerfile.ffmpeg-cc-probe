# escape=`
# =============================================================================
# #100 round 2: capture ffmpeg's exact compile recipe and replay through
# sccache (serial + parallel) to name the crash trigger. Run via:
#   run-diagnostic-probe.ps1 -Dockerfile Dockerfile.ffmpeg-cc-probe -BaseImage local/kataglyphis:bk-windows-toolchain
# =============================================================================
ARG BASE_IMAGE=local/kataglyphis:bk-windows-toolchain
FROM ${BASE_IMAGE} AS probe

# Layer-cache buster (a CACHED run replays an old verdict).
ARG PROBE_NONCE="0"

RUN --mount=type=bind,source=windows/scripts/diagnostics/probe-ffmpeg-cc-shape.ps1,target=C:\bkmnt\probe-ffmpeg-cc-shape.ps1 `
    --mount=type=bind,source=windows/scripts/modules,target=C:\bkmnt\modules `
    --mount=type=bind,source=windows/scripts/patches/ffmpeg,target=C:\bkmnt\patches\ffmpeg `
    & 'C:\bkmnt\probe-ffmpeg-cc-shape.ps1' -Nonce "${PROBE_NONCE}"
