# Files COPY'd into images are layer-cache keys: no EOL conversion, so a checkout cannot bust cached layers.
*.ps1 -text
*.psm1 -text
*.env -text
*.patch -text
# extensionless shell scripts shipped into images (MSYS sh chokes on CRLF)
makedef -text eol=lf
# Bash reads these in images and through Windows bind mounts, so they stay LF even under core.autocrlf=true.
*.sh text eol=lf
*.bash text eol=lf
# Patches, shims and entrypoint.cmd reach Windows images too: same layer-cache-key reason.
*.cmake -text
*.cc -text
*.h -text
*.cmd -text
# Configs Sync-SharedConfig.ps1 copies to consumers: LF so a Windows -Write cannot drift them; kept before the path rules, which must win.
.clang-format text eol=lf
.clang-tidy text eol=lf
.cmake-format.yaml text eol=lf
.pre-commit-config.yaml text eol=lf
gcovr.cfg text eol=lf
# Last so they win: every file under these trees reaches a Windows image, whatever its extension (and would override eol=lf on a .sh).
windows/scripts/** -text
windows/downloads/** -text

# Extensionless bash entry points; same reason as *.sh.
linux/host-config/git-hooks/* text eol=lf
linux/nextcloud-aio/custom-bin/* text eol=lf
shared/linux/templates/git-hooks/* text eol=lf
# Preflight gates read these with awk/grep; LF so a Windows checkout grades the bytes CI does.
linux/Dockerfile* text eol=lf
linux/docker-compose.yml text eol=lf
linux/**/*.txt text eol=lf
linux/**/*.allow text eol=lf
# The shell suites mutate these gates with `sed '/…$/'`, which never matches a CRLF line.
.claude/**/*.py text eol=lf
docs/**/*.py text eol=lf
linux/**/*.py text eol=lf
# /gateway/info reports the sha256 of these files, so every checkout must mount the same bytes.
linux/llm-stack/gateway/** text eol=lf
