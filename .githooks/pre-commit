#!/usr/bin/env bash
# pre-commit — run CI-consistent checks before each commit.
# Activate with: git config core.hooksPath .githooks
#
# Windows note (resolved 2026-08-08): the Python-based checks used to run under
# plain `python3`, which on Windows hosts is usually the Microsoft Store stub —
# it prints an install hint and exits non-zero under Git Bash, so those checks
# failed for reasons unrelated to the commit. That is precisely why this hook
# was never activated on the primary dev clone, and why an unresolved merge
# conflict reached main. preflight.sh now PROBES for an interpreter that can
# actually run code and skips the stub; PREFLIGHT_PYTHON still overrides.
set -euo pipefail

GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

pass() { printf "${GREEN}✓${NC} %s\n" "$1"; }
fail() { printf "${RED}✗${NC} %s\n" "$1"; exit 1; }

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"

cd "$REPO_ROOT"

# Collect staged files once, NUL-delimited so paths with spaces (or other
# shell metacharacters) survive as single array elements — an unquoted
# $STAGED word-split used to break on them.
STAGED_SH=()
STAGED_DF=()
STAGED_ALL=()
while IFS= read -r -d '' f; do
  STAGED_ALL+=("$f")
  # Extension-less files with a shell shebang count as shell scripts, so a
  # staged git hook (this file included) reaches the syntax + shellcheck gates.
  # lint-shell.sh applies the same rule; the basename is what gets tested,
  # because a directory component may carry a dot (".githooks/").
  case "${f##*/}" in
    *.sh) STAGED_SH+=("$f") ;;
    *.*)  ;;
    *)
      # Read the STAGED blob, not the worktree file: with partial staging
      # (git add -p) or a worktree edit after staging, the two differ — and the
      # gate's contract is "what is being committed". `git show :path` is the
      # index content; fall back to the worktree only if the index read fails
      # (should not happen for an ACMR-listed path).
      case "$( { git show ":$f" 2>/dev/null || cat "$f" 2>/dev/null; } | head -c 128 | head -n 1)" in
        '#!'*ash|'#!'*ash\ *|'#!/bin/sh'|'#!/bin/sh '*|'#!'*env\ sh) STAGED_SH+=("$f") ;;
      esac
      ;;
  esac
  case "${f##*/}" in
    Dockerfile*) STAGED_DF+=("$f") ;;
  esac
# ACMR: rename detection is on by default, and a rename-with-edits (R<100)
# previously bypassed every gate (--name-only lists the destination path).
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

# 0. Unresolved merge-conflict markers in the STAGED content.
#    Added 2026-08-08 after docs/refactoring-backlog.md was committed with a
#    live conflict (<<<<<<< / ======= / >>>>>>>) that survived several commits:
#    two sections were appended concurrently and the merge was never finished.
#    Markdown and shell lint both passed it, because a conflict marker is
#    perfectly valid text.
#    Deliberately matching ONLY the '<<<<<<< ' and '>>>>>>> ' forms: a bare
#    '=======' line is a legitimate setext H1 underline in Markdown, and every
#    real conflict carries the other two anyway.
#    --cached searches the index, i.e. exactly what is about to be committed,
#    not the working tree. -I skips binaries.
echo "=== merge-conflict markers (staged content) ==="
if [ "${#STAGED_ALL[@]}" -gt 0 ]; then
  # `|| _cm_rc=$?`: rc=1 (no match) is the healthy case and must not trip the
  # hook's set -e; rc>1 is a real git failure and fails the gate loudly below.
  _cm_rc=0
  CONFLICTED=$(git grep --cached -lIE '^(<{7}|>{7}) ' -- "${STAGED_ALL[@]}" 2>/dev/null) || _cm_rc=$?
  if [ "${_cm_rc}" -gt 1 ]; then
    fail "git grep failed (rc=${_cm_rc}) — conflict-marker gate could not run"
  elif [ "${_cm_rc}" -eq 0 ] && [ -n "$CONFLICTED" ]; then
    echo "$CONFLICTED" | sed 's/^/  /'
    fail "unresolved merge-conflict markers in staged files (listed above)"
  else
    pass "no conflict markers in staged files"
  fi
else
  pass "nothing staged to check for conflict markers"
fi

# 1. Fast subset of the canonical gate list in linux/scripts/preflight.sh
#    (version snapshot, ARG consistency, critical fixes, script COPY coverage,
#    plus the two docs gates). The shellcheck gate below runs on staged files
#    only; the full gate runs in CI. (Do not start this comment with the word
#    "shellcheck" — ShellCheck parses `# shellcheck …` as a directive and
#    SC1072/SC1073 then abort the parse of this whole file, which is how it
#    stayed unlinted until 2026-08-08: lint-shell.sh only matches *.sh, and this
#    file has no extension.)
#
#    doc-links and doc-dupes belong HERE and not only in CI: both were added on
#    2026-08-25 after a restructure that moved ~5,000 lines, and both catch
#    edits — a renamed heading, a passage pasted into a second page — whose cost
#    is a stale reference nobody notices for weeks. They run in ~2 s together,
#    so there is no reason to defer them to a pipeline round trip.
echo "=== preflight subset ==="
PREFLIGHT_ONLY=version-snapshot,arg-consistency,critical-fixes,copy-coverage,doc-links,doc-dupes \
  bash linux/scripts/preflight.sh && pass "preflight subset" || fail "preflight subset failed"

# 2. Shell syntax + shellcheck gate on changed .sh files
echo ""
echo "=== shell syntax (staged .sh files) ==="
if [ "${#STAGED_SH[@]}" -gt 0 ]; then
  bash -n "${STAGED_SH[@]}" && pass "staged shell scripts parse OK" || fail "shell syntax error in staged .sh files"
  echo ""
  echo "=== shellcheck -S error (staged .sh files) ==="
  bash linux/scripts/lint-shell.sh "${STAGED_SH[@]}" && pass "staged shellcheck gate" || fail "shellcheck -S error findings in staged .sh files"
else
  pass "no staged .sh files to check"
fi

# 3. Dockerfile lint on staged Dockerfiles (skips silently if the bootstrap
#    cannot run, matching the sphinx block's tolerance below).
echo ""
echo "=== dockerfile lint (staged Dockerfiles) ==="
if [ "${#STAGED_DF[@]}" -gt 0 ]; then
  bash linux/scripts/lint-dockerfiles.sh "${STAGED_DF[@]}" && pass "staged Dockerfile lint" || fail "hadolint findings in staged Dockerfiles"
else
  pass "no staged Dockerfiles to check"
fi

# 4. Sphinx docs build (if deps are installed)
echo ""
echo "=== sphinx-build ==="
if [ -f "${REPO_ROOT}/.venv/bin/python" ]; then
  . "${REPO_ROOT}/.venv/bin/activate"
  if python -c "import sphinx_kataglyphis" 2>/dev/null; then
    cd "${REPO_ROOT}/docs"
    # Sphinx root is docs/ ITSELF (docs/conf.py; docs/Makefile SOURCEDIR=.) —
    # there is no docs/source/, so the old "source" arg failed on every commit
    # of a hook-enabled clone, with the real error swallowed by >/dev/null.
    python -m sphinx -W -E -b html . _build/html > /dev/null 2>&1 \
      && pass "sphinx docs build" \
      || fail "sphinx build failed (run 'make html' in docs/)"
  else
    pass "sphinx_kataglyphis not in .venv (skipping docs build)"
  fi
else
  pass "no .venv found (skipping sphinx docs build)"
fi

exit 0
