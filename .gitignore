docs/_build/*
*.log
logs/**/*
out/**/*
__pycache__/
*.pyc
# resource-monitor.sh writes to the repo root when run without --log-dir.
resources-*.csv
resources-*.summary.txt
*.deb
windows/downloads/*
# Keeps the directory in a fresh clone: Dockerfile.nvidia's COPY of it fails when it is absent.
!windows/downloads/README.md
linux/llm-stack/ollama-binary.tar.zst
linux/llm-stack/.env
linux/nextcloud-aio/.env
# Built in another repository; the image takes it through a named build context (linux/webserver/README.md).
linux/webserver/dist/
# Per-run chain state, rewritten at every stage by build-cross-chain.sh.
/chain-status.json
/chain-status-*.json
.claude/*
# ...except the safety gate, which must survive a fresh clone; settings.local.json is personal.
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/guard-destructive-deletes.ps1
# The Linux port too; without this negation `git add` silently skips it.
!.claude/hooks/guard-destructive-deletes.py

# Dev-only litert-lm fast-rebuild harness.
.cxxtest.Dockerfile

# Login-gated, EULA-bound SDK drops staged by hand; only the READMEs are committed.
windows/qnn-sdk/*
!windows/qnn-sdk/README.md
linux/qnn-sdk/*
!linux/qnn-sdk/README.md
linux/hailo-sdk/*
!linux/hailo-sdk/README.md

# Scratch: no tracked root file is a script, so root-level scripts never reach a commit; a reused helper moves to linux/scripts/.
/.scratch/
/*.py
/*.sh
/*.ps1
/*.psm1
/*.tmp
/*.bak

# An external tool run from Git Bash takes this cmd placeholder literally and leaves the tree here.
/%SystemDrive%/

# A hand clone here would be one `git add -A` from an unintended gitlink.
/external/

# pytest leaves this behind when a suite is run by hand; the doc/code gates scan the tree.
.pytest_cache/

# Binaries stay out of git; a deliberate one needs `git add -f` and a line in docs/project-info.md#repository-size-and-large-files
*.7z
*.dll
*.dylib
*.iso
*.msi
*.msix
*.pdb
*.pfx
*.so
*.so.*
*.wasm
*.whl
*.xz
*.zst
# ...except the two small tracked images the README and the docs render with.
!images/*.png

# Generated from shared/agentic-loop/system-prompts plus the project overlay; edit the overlay.
.opencode/agents/

# Agent scratch: transient patch/probe files, never part of the repo.
.agentout/

