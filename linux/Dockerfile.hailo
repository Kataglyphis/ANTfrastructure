# syntax=docker/dockerfile:1.27.0
#
# ==============================================================================
# Dockerfile.hailo — the opt-in Hailo variant image
#
#   :cross-android-<arch>  ->  hailo-build (this)  ->  copied into :latest-cross-<arch>
#
# HailoRT (libhailort, hailortcli, the hailonet GStreamer element) is built
# against the media image's GStreamer and copied into the published runtime
# image, so the variant IS the runtime plus /opt/hailo. The standard chain is
# unchanged; this is an additional tag, like :nvidia / :amd.
#
# The PCIe kernel driver is NOT here — it is GPL-2.0, out-of-tree and host-only.
# Run with --device=/dev/hailo0 on a host that loaded hailo_pci.
# Plan and upstream matrix: docs/hailo-support.md § What exists (2026-09-20).
#
# Build (per arch, after the runtime lane published :latest-cross-<arch>):
#   nerdctl build -f linux/Dockerfile.hailo \
#     --build-arg TARGETARCH=amd64 \
#     --build-arg HAILORT_VERSION=... (see docs/linux-accelerator-images.md)
#     -t ghcr.io/kataglyphis/kataglyphis_beschleuniger:hailo-amd64 .
# ==============================================================================

ARG TARGETARCH
ARG BUILDER_IMAGE=ghcr.io/kataglyphis/kataglyphis_beschleuniger:cross-android-${TARGETARCH:-amd64}
ARG BASE_IMAGE=ghcr.io/kataglyphis/kataglyphis_beschleuniger:latest-cross-${TARGETARCH:-amd64}

# ------------------------------------------------------------------------------
# Stage 1: build HailoRT against the media GStreamer
# ------------------------------------------------------------------------------
FROM ${BUILDER_IMAGE} AS hailo-build

ARG TARGETARCH
ARG HAILORT_VERSION=4.24.0
ARG HAILORT_SOURCE_SHA256=af399b64e59453cb71a6054e71b98e2cb06147701219531ecf780c4584c6ef70
ARG HAILO_PROTOBUF_VERSION=21.12
ARG HAILO_PROTOBUF_SHA256=22fdaf641b31655d4b2297f9981fa5203b2866f8332d3c6333f6b0107bb320de
ARG HAILO_GRPC_VERSION=1.54.0
ARG HAILO_GRPC_COMMIT=6847e05dbb8088a918f06e2231a405942b5c002d
ARG HAILO_PREFIX=/opt/hailo
ARG GSTREAMER_PREFIX=/opt/gstreamer

# The build script bootstraps through 03-media/core/common.sh, which resolves
# the 01-core module framework at /opt/scripts/core (the in-image path).
COPY --chmod=755 linux/scripts/01-core/ /opt/scripts/core/
COPY --chmod=755 linux/scripts/03-media/core/ /opt/scripts/03-media/core/
COPY --chmod=755 linux/scripts/03-media/build/hailo/ /opt/scripts/03-media/build/hailo/

RUN --mount=type=cache,target=/var/cache/hailo-build,id=hailo-build-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    TARGET_ARCH="${TARGETARCH}" \
    HAILORT_VERSION="${HAILORT_VERSION}" \
    HAILORT_SOURCE_SHA256="${HAILORT_SOURCE_SHA256}" \
    HAILO_PROTOBUF_VERSION="${HAILO_PROTOBUF_VERSION}" \
    HAILO_PROTOBUF_SHA256="${HAILO_PROTOBUF_SHA256}" \
    HAILO_GRPC_VERSION="${HAILO_GRPC_VERSION}" \
    HAILO_GRPC_COMMIT="${HAILO_GRPC_COMMIT}" \
    HAILO_PREFIX="${HAILO_PREFIX}" \
    GSTREAMER_PREFIX="${GSTREAMER_PREFIX}" \
    bash /opt/scripts/03-media/build/hailo/build-hailort.sh

# ------------------------------------------------------------------------------
# Stage 2: the runtime image + the Hailo payload
# ------------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS hailo

ARG TARGETARCH
ARG HAILO_PREFIX=/opt/hailo
ARG GSTREAMER_PREFIX=/opt/gstreamer

COPY --from=hailo-build ${HAILO_PREFIX} ${HAILO_PREFIX}

# No ENV surgery: the base image's GST_PLUGIN_PATH already covers
# ${GSTREAMER_PREFIX}/lib/multiarch/gstreamer-1.0, and /usr/local/lib is already
# on its LD_LIBRARY_PATH. Putting the plugin and libhailort there keeps the
# variant's environment identical to :latest-cross — the consumer contract stays
# one image shape. The copies are cheap and make ldconfig the only resolution
# mechanism the plugin needs.
RUN set -euo pipefail; \
    cp -a "${HAILO_PREFIX}/lib/gstreamer-1.0/gsthailo.so" \
          "${GSTREAMER_PREFIX}/lib/multiarch/gstreamer-1.0/gsthailo.so"; \
    cp -a "${HAILO_PREFIX}"/lib/libhailort.so* /usr/local/lib/; \
    ldconfig; \
    test -x "${HAILO_PREFIX}/bin/hailortcli"; \
    gst-inspect-1.0 hailonet >/dev/null

ENV HAILO_PREFIX=${HAILO_PREFIX}
