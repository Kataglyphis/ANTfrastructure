# syntax=docker/dockerfile:1.27.1

ARG BASE_IMAGE=local/kataglyphis:base
FROM ${BASE_IMAGE}

SHELL ["bash", "-lc"]

# Heavy RUNs bind-mount only their entrypoint's source closure: mount content is in the cache key.

ARG LLVM_RELEASE=23.1.1
ARG GCC_VERSION=16.2.0
ARG TARGETARCH
ARG TARGETPLATFORM
ARG BUILDARCH
ARG BUILDPLATFORM
ARG BUILD_MODE=native
# Divides usable RAM so --parallel-archs builds don't collectively overcommit the host.
ARG BUILD_MEM_DIVISOR=1
ARG CROSS_TARGETS=amd64,arm64,riscv64
ARG PYTHON_VERSION=3.14.7
# Must reach the Python RUN, or build_python.sh downloads CPython unverified.
ARG PYTHON_TGZ_SHA256=62859805f6fdf25e2bcbf3fa3217801e1996887ca33e6a2af80674bdfa2dbe07
ARG GCC_CANADIAN_CROSS_SKIP_ON_LINK_FAILURE=0
ARG GCC_HOST_BOOTSTRAP=0
# Opt-in concurrent per-target GCC builds; stage-defs.sh forwards it from the host env.
ARG GCC_PARALLEL_TARGETS=0
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL

ENV BUILD_MODE=${BUILD_MODE} \
    BUILD_MEM_DIVISOR=${BUILD_MEM_DIVISOR} \
    GCC_CANADIAN_CROSS_SKIP_ON_LINK_FAILURE=${GCC_CANADIAN_CROSS_SKIP_ON_LINK_FAILURE} \
    GCC_HOST_BOOTSTRAP=${GCC_HOST_BOOTSTRAP} \
    GCC_PARALLEL_TARGETS=${GCC_PARALLEL_TARGETS} \
    BUILDARCH=${BUILDARCH} \
    BUILDPLATFORM=${BUILDPLATFORM} \
    CROSS_TARGETS=${CROSS_TARGETS} \
    GCC_VERSION=${GCC_VERSION} \
    GCC_PREFIX=/opt/gcc-${GCC_VERSION} \
    LLVM_RELEASE=${LLVM_RELEASE} \
    PYTHON_VERSION=${PYTHON_VERSION} \
    PATH="/usr/local/cargo/bin:${PATH}" \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    RUSTC_WRAPPER="" \
    PKG_CONFIG_ALLOW_CROSS=1

# GCC: no llvm/vulkan file is mounted, since setup-dependencies.sh sources llvm.sh lazily; the LLVM RUN's list differs on purpose.
RUN     --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=bind,source=linux/scripts/01-core/arch-mapping.sh,target=/opt/scripts/core/arch-mapping.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/build-helpers.sh,target=/opt/scripts/core/build-helpers.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/common.sh,target=/opt/scripts/core/common.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-apt.sh,target=/opt/scripts/core/cross-apt.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-env.sh,target=/opt/scripts/core/cross-env.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-gcc.sh,target=/opt/scripts/core/cross-gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-meson.sh,target=/opt/scripts/core/cross-meson.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-python.sh,target=/opt/scripts/core/cross-python.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/downloads.sh,target=/opt/scripts/core/downloads.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/load-versions-env.sh,target=/opt/scripts/core/load-versions-env.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/logging.sh,target=/opt/scripts/core/logging.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/meson-rust-wrapper.sh,target=/opt/scripts/core/meson-rust-wrapper.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/modules.sh,target=/opt/scripts/core/modules.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/parallelism.sh,target=/opt/scripts/core/parallelism.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/platform.sh,target=/opt/scripts/core/platform.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/repos.sh,target=/opt/scripts/core/repos.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/sccache-launcher.sh,target=/opt/scripts/core/sccache-launcher.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/ubuntu-mirror.sh,target=/opt/scripts/core/ubuntu-mirror.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/verify.sh,target=/opt/scripts/core/verify.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/versions.env,target=/opt/scripts/core/versions.env,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/bootstrap.sh,target=/opt/scripts/toolchain/bootstrap.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/build-gcc.sh,target=/opt/scripts/toolchain/build-gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/configure-gcc-env.sh,target=/opt/scripts/toolchain/configure-gcc-env.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/core.sh,target=/opt/scripts/toolchain/core.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/gcc.sh,target=/opt/scripts/toolchain/gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/setup-dependencies.sh,target=/opt/scripts/toolchain/setup-dependencies.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/verify-gcc.sh,target=/opt/scripts/toolchain/verify-gcc.sh,ro \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/var/tmp \
    set -euo pipefail; \
    SETUP_DEPENDENCIES_SKIP_CORE_TOOLS=true \
    bash /opt/scripts/toolchain/setup-dependencies.sh dockerfile-gcc

# Later RUNs use the new GCC without sourcing /etc/environment.
ENV PATH="/opt/gcc-${GCC_VERSION}/bin:${PATH}" \
    PKG_CONFIG_PATH="${GCC_PREFIX}/lib64/pkgconfig:${GCC_PREFIX}/lib/pkgconfig" \
    LD_LIBRARY_PATH="${GCC_PREFIX}/lib64:${GCC_PREFIX}/lib" \
    LIBRARY_PATH="${GCC_PREFIX}/lib64:${GCC_PREFIX}/lib"

# LLVM: one superset build yields /opt/llvm-cross and /opt/llvm-target per arch; binutils-dev is hard so LLVMgold always builds.
RUN     --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=bind,source=linux/scripts/01-core/arch-mapping.sh,target=/opt/scripts/core/arch-mapping.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/build-helpers.sh,target=/opt/scripts/core/build-helpers.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/common.sh,target=/opt/scripts/core/common.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-apt.sh,target=/opt/scripts/core/cross-apt.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-env.sh,target=/opt/scripts/core/cross-env.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-gcc.sh,target=/opt/scripts/core/cross-gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-meson.sh,target=/opt/scripts/core/cross-meson.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-python.sh,target=/opt/scripts/core/cross-python.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/downloads.sh,target=/opt/scripts/core/downloads.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/load-versions-env.sh,target=/opt/scripts/core/load-versions-env.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/logging.sh,target=/opt/scripts/core/logging.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/meson-rust-wrapper.sh,target=/opt/scripts/core/meson-rust-wrapper.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/modules.sh,target=/opt/scripts/core/modules.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/parallelism.sh,target=/opt/scripts/core/parallelism.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/platform.sh,target=/opt/scripts/core/platform.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/repos.sh,target=/opt/scripts/core/repos.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/sccache-launcher.sh,target=/opt/scripts/core/sccache-launcher.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/ubuntu-mirror.sh,target=/opt/scripts/core/ubuntu-mirror.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/verify.sh,target=/opt/scripts/core/verify.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/versions.env,target=/opt/scripts/core/versions.env,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/bootstrap.sh,target=/opt/scripts/toolchain/bootstrap.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/build-clang.sh,target=/opt/scripts/toolchain/build-clang.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/build-gcc.sh,target=/opt/scripts/toolchain/build-gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/configure-gcc-env.sh,target=/opt/scripts/toolchain/configure-gcc-env.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/core.sh,target=/opt/scripts/toolchain/core.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/gcc.sh,target=/opt/scripts/toolchain/gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/llvm-cross.sh,target=/opt/scripts/toolchain/llvm-cross.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/llvm-validate.sh,target=/opt/scripts/toolchain/llvm-validate.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/llvm.sh,target=/opt/scripts/toolchain/llvm.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/setup-dependencies.sh,target=/opt/scripts/toolchain/setup-dependencies.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/verify-gcc.sh,target=/opt/scripts/toolchain/verify-gcc.sh,ro \
    --mount=type=cache,target=/var/cache/llvm-src,id=llvm-src-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/var/tmp \
    set -euo pipefail; \
    apt-get update -qq && \
    apt-get install -y --no-install-recommends binutils-dev; \
    SETUP_DEPENDENCIES_SKIP_CORE_TOOLS=true \
    LLVM_CROSS_SOURCE_ROOT=/var/cache/llvm-src \
    bash /opt/scripts/toolchain/setup-dependencies.sh dockerfile-llvm

# Installs under /usr/lib/llvm-*/bin are not always the top alternative, so clang is pinned to LLVM_RELEASE.
RUN --mount=type=bind,source=linux/scripts/02-toolchain/register-llvm-alternatives.sh,target=/tmp/register-llvm-alternatives.sh,ro \
    set -euo pipefail; LLVM_RELEASE="${LLVM_RELEASE}" bash /tmp/register-llvm-alternatives.sh

# Toolchain contract
RUN --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain,target=/opt/scripts/toolchain,ro \
    set -euo pipefail; \
    bash /opt/scripts/toolchain/setup-dependencies.sh verify

# Rust: host toolchain plus the cross target stdlibs
ARG RUST_VERSION=1.98.1
ARG CARGO_C_VERSION=0.10.25
ARG RUST_NIGHTLY_TOOLCHAIN=nightly-2026-06-28
# versions.env is mounted for RUSTUP_INIT_SHA256, a noforward key that never arrives as a build arg.
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-${TARGETARCH} \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git-${TARGETARCH} \
    --mount=type=bind,source=linux/scripts/01-core/cross-apt.sh,target=/opt/scripts/core/cross-apt.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-env.sh,target=/opt/scripts/core/cross-env.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-gcc.sh,target=/opt/scripts/core/cross-gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-meson.sh,target=/opt/scripts/core/cross-meson.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-python.sh,target=/opt/scripts/core/cross-python.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/meson-rust-wrapper.sh,target=/opt/scripts/core/meson-rust-wrapper.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/platform.sh,target=/opt/scripts/core/platform.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/ubuntu-mirror.sh,target=/opt/scripts/core/ubuntu-mirror.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/versions.env,target=/opt/scripts/core/versions.env,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/install-rust.sh,target=/opt/scripts/toolchain/install-rust.sh,ro \
    --mount=type=cache,target=/root/.cache/rustup,id=rustup-cache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    bash /opt/scripts/toolchain/install-rust.sh

# Source-built CPython, shared by every downstream venv
RUN --mount=type=bind,source=linux/scripts/01-core/cross-apt.sh,target=/opt/scripts/core/cross-apt.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-env.sh,target=/opt/scripts/core/cross-env.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-gcc.sh,target=/opt/scripts/core/cross-gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-meson.sh,target=/opt/scripts/core/cross-meson.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-python.sh,target=/opt/scripts/core/cross-python.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cpython-dev-packages.sh,target=/opt/scripts/core/cpython-dev-packages.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/downloads.sh,target=/opt/scripts/core/downloads.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/logging.sh,target=/opt/scripts/core/logging.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/meson-rust-wrapper.sh,target=/opt/scripts/core/meson-rust-wrapper.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/modules.sh,target=/opt/scripts/core/modules.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/parallelism.sh,target=/opt/scripts/core/parallelism.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/platform.sh,target=/opt/scripts/core/platform.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/ubuntu-mirror.sh,target=/opt/scripts/core/ubuntu-mirror.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/python/build_python.sh,target=/opt/scripts/python/build_python.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/python/fix-staged-python-pc.sh,target=/opt/scripts/python/fix-staged-python-pc.sh,ro \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    PYTHON_CROSS_STAGE_ROOT=/opt/python-cross \
    PYTHON_CROSS_ACTIVE_ROOT=/opt/python-target \
    PYTHON_TGZ_SHA256="${PYTHON_TGZ_SHA256}" \
    bash /opt/scripts/python/build_python.sh "${PYTHON_VERSION}"

# Path only: every downstream stage creates its own venv, so one made here would be discarded.
ENV VIRTUAL_ENV=/opt/python/.venv \
    PATH=/opt/python/.venv/bin:${PATH} \
    UV_PYTHON=/opt/python/.venv/bin/python \
    MEDIA_HOST_PYTHON=/opt/python/.venv/bin/python

# Script bundle as plain COPYs, content-keyed, so no manual cache-buster is needed.
COPY --chmod=755 linux/scripts/01-core/ /opt/scripts/core/
COPY --chmod=755 linux/scripts/02-toolchain/ /opt/scripts/toolchain/
COPY --chmod=755 linux/scripts/02-toolchain/python/build_python.sh \
                 linux/scripts/02-toolchain/python/fix-staged-python-pc.sh \
                 /opt/scripts/python/
COPY --chmod=755 linux/scripts/06-packaging/smoke-common.sh \
                 linux/scripts/06-packaging/smoke-toolchain.sh \
                 linux/scripts/06-packaging/smoke-cross-all-arches.sh \
                 /opt/scripts/packaging/

RUN set -euo pipefail; \
    find /opt/scripts -name '*.sh' -type f -print0 | while IFS= read -r -d '' f; do bash -n "$f"; done; \
    bash /opt/scripts/toolchain/setup-dependencies.sh --help >/dev/null; \
    bash /opt/scripts/python/fix-staged-python-pc.sh

# A broken compiler stage fails here, not hours later in a downstream build.
RUN set -euo pipefail; \
    bash /opt/scripts/packaging/smoke-toolchain.sh

# sudo-rs mishandles --preserve-env*, so this pass-through strips it and runs the command.
RUN cat > /usr/local/bin/sudo <<'SUDO_WRAPPER' && chmod +x /usr/local/bin/sudo
#!/bin/bash
args=()
stripped=0
while [ $# -gt 0 ]; do
  case "$1" in
    --preserve-env*)
      [ "$stripped" -eq 0 ] && echo "sudo-wrapper: stripping $1" >&2
      stripped=1
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
if [ "${#args[@]}" -eq 0 ]; then
  echo "sudo-wrapper: no command to execute after stripping flags" >&2
  exit 1
fi
exec "${args[@]}"
SUDO_WRAPPER

LABEL org.opencontainers.image.title="Kataglyphis Compiler" \
      org.opencontainers.image.description="Compiler toolchain with GCC and LLVM/Clang"
