# syntax=docker/dockerfile:1.24.0

ARG BASE_IMAGE=local/kataglyphis:base
FROM ${BASE_IMAGE}

SHELL ["bash", "-lc"]

# NOTE: Build scripts for the heavy compiler RUNs are bind-mounted
# (--mount=type=bind) rather than COPYed. Unlike COPY, a bind mount does NOT
# create an image layer — but its CONTENT still enters the RUN's cache key, so
# mounting the whole 01-core/02-toolchain trees would let ANY of ~100 script
# edits (including host-only orchestrator modules) invalidate the multi-hour
# GCC/LLVM/Rust/Python layers. The heavy RUNs below therefore bind-mount ONLY
# the per-file transitive source-closure of their entrypoint script (traced via
# verify-script-copy-coverage.py --report-core-usage plus manual source/exec
# tracing): editing an unmounted script leaves the compiler layers cached, while
# editing a mounted file rebuilds exactly the RUNs that consume it. Cheap RUNs
# (3b/3c) keep whole-dir mounts. The /opt/scripts bundle at the END of this file
# is plain COPY (content-keyed, cheap tail), so downstream stages still see the
# full script set without touching the compiler layers.

ARG LLVM_RELEASE=22.1.8
ARG GCC_VERSION=16.2.0
ARG TARGETARCH
ARG TARGETPLATFORM
ARG BUILDARCH
ARG BUILDPLATFORM
ARG BUILD_MODE=native
# Divide usable RAM by this in parallelism.sh so N concurrent per-arch builds
# (--parallel-archs) don't collectively overcommit the host. 1 = serial default.
ARG BUILD_MEM_DIVISOR=1
ARG CROSS_TARGETS=amd64,arm64,riscv64
ARG PYTHON_VERSION=3.14.7
# SHA-256 of the CPython source tarball, mirrored from versions.env (enforced by
# verify-arg-consistency.sh). MUST be declared + forwarded to the Python RUN
# below, else build_python.sh sees it empty and downloads CPython UNVERIFIED.
ARG PYTHON_TGZ_SHA256=62859805f6fdf25e2bcbf3fa3217801e1996887ca33e6a2af80674bdfa2dbe07
ARG GCC_CANADIAN_CROSS_SKIP_ON_LINK_FAILURE=0
ARG GCC_HOST_BOOTSTRAP=1
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL

ENV BUILD_MODE=${BUILD_MODE} \
    BUILD_MEM_DIVISOR=${BUILD_MEM_DIVISOR} \
    GCC_CANADIAN_CROSS_SKIP_ON_LINK_FAILURE=${GCC_CANADIAN_CROSS_SKIP_ON_LINK_FAILURE} \
    GCC_HOST_BOOTSTRAP=${GCC_HOST_BOOTSTRAP} \
    BUILDARCH=${BUILDARCH} \
    BUILDPLATFORM=${BUILDPLATFORM} \
    CROSS_TARGETS=${CROSS_TARGETS} \
    GCC_VERSION=${GCC_VERSION} \
    GCC_PREFIX=/opt/gcc-${GCC_VERSION} \
    LLVM_RELEASE=${LLVM_RELEASE} \
    PYTHON_VERSION=${PYTHON_VERSION} \
    PATH="/usr/local/cargo/bin:${PATH}" \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    RUSTC_WRAPPER="" \
    PKG_CONFIG_ALLOW_CROSS=1

# ------------------------------------------------------------------------------
# Toolchain setup
# ------------------------------------------------------------------------------
# 1. GCC (Heavy Layer)
# If this succeeds, it is cached forever unless GCC_VERSION changes.
# Per-file bind mounts = the transitive source-closure of the dockerfile-gcc
# path ONLY (TG1-residual 2026-08-24): llvm.sh is now sourced lazily in the
# llvm-needing dispatch arms (see the header note in setup-dependencies.sh),
# so this RUN mounts NO llvm file — audit: every function defined in
# llvm.sh/llvm-cross.sh/llvm-validate.sh grepped against the eager closure
# has exactly 3 consumers (install_llvm_clang, install_target_clang_toolchain,
# verify_cross_llvm_targets), none reachable from dockerfile-gcc; build-clang.sh
# is only exec'd via llvm.sh's llvm_build_script; vulkan-env.sh is sourced only
# by vulkan.sh (not mounted here since TG1-bounded). An llvm/vulkan-family edit
# therefore no longer invalidates this multi-hour layer. The LLVM RUN below
# keeps the llvm family — the two lists deliberately DIFFER now.
# versions.env is mounted because common.sh load_versions_env()-reads it
# at runtime (env/ARG values still win; the file is only the fallback).
RUN     --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=bind,source=linux/scripts/01-core/arch-mapping.sh,target=/opt/scripts/core/arch-mapping.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/build-helpers.sh,target=/opt/scripts/core/build-helpers.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/common.sh,target=/opt/scripts/core/common.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-apt.sh,target=/opt/scripts/core/cross-apt.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-env.sh,target=/opt/scripts/core/cross-env.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-gcc.sh,target=/opt/scripts/core/cross-gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-meson.sh,target=/opt/scripts/core/cross-meson.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-python.sh,target=/opt/scripts/core/cross-python.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/downloads.sh,target=/opt/scripts/core/downloads.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/load-versions-env.sh,target=/opt/scripts/core/load-versions-env.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/logging.sh,target=/opt/scripts/core/logging.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/meson-rust-wrapper.sh,target=/opt/scripts/core/meson-rust-wrapper.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/modules.sh,target=/opt/scripts/core/modules.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/parallelism.sh,target=/opt/scripts/core/parallelism.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/platform.sh,target=/opt/scripts/core/platform.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/repos.sh,target=/opt/scripts/core/repos.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/ubuntu-mirror.sh,target=/opt/scripts/core/ubuntu-mirror.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/verify.sh,target=/opt/scripts/core/verify.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/versions.env,target=/opt/scripts/core/versions.env,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/bootstrap.sh,target=/opt/scripts/toolchain/bootstrap.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/build-gcc.sh,target=/opt/scripts/toolchain/build-gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/configure-gcc-env.sh,target=/opt/scripts/toolchain/configure-gcc-env.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/core.sh,target=/opt/scripts/toolchain/core.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/gcc.sh,target=/opt/scripts/toolchain/gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/setup-dependencies.sh,target=/opt/scripts/toolchain/setup-dependencies.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/verify-gcc.sh,target=/opt/scripts/toolchain/verify-gcc.sh,ro \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/var/tmp \
    set -euo pipefail; \
    SETUP_DEPENDENCIES_SKIP_CORE_TOOLS=true \
    bash /opt/scripts/toolchain/setup-dependencies.sh dockerfile-gcc

# 2. ENVIRONMENT CONFIGURATION
# We apply ENV vars here so subsequent RUN instructions (LLVM/Vulkan)
# automatically use the new GCC without needing to source /etc/environment.
# LIBRARY_PATH is needed at link time (for the linker to find libgcc_s, etc.)
# LD_LIBRARY_PATH is needed at runtime (for the dynamic loader)
ENV PATH="/opt/gcc-${GCC_VERSION}/bin:${PATH}" \
    PKG_CONFIG_PATH="${GCC_PREFIX}/lib64/pkgconfig:${GCC_PREFIX}/lib/pkgconfig" \
    LD_LIBRARY_PATH="${GCC_PREFIX}/lib64:${GCC_PREFIX}/lib" \
    LIBRARY_PATH="${GCC_PREFIX}/lib64:${GCC_PREFIX}/lib"

# 3. LLVM / CLANG (Heavy Layer)
# If this fails, Docker restores the image state at 'Step 2' instantly.
# Per-file bind mounts = the GCC RUN's closure PLUS the llvm family
# (llvm.sh -> llvm-cross.sh + llvm-validate.sh, sourced by the
# dockerfile-llvm dispatch arm; build-clang.sh is exec'd by
# llvm_build_script on the source-build fallback path). vulkan-env.sh is
# NOT mounted: its only consumer is vulkan.sh, which this RUN never sources
# (TG1-residual audit — see setup-dependencies.sh header).
#
# This RUN's unified superset build (TG3, llvm-cross.sh) produces BOTH
# /opt/llvm-cross/<triplet> AND /opt/llvm-target-<arch> per cross arch —
# the former dedicated target-clang RUN (3d) is deleted (TG3-residual
# 2026-08-24): since the TG3 unification, `mode` selects nothing but a log
# string in llvm-cross.sh (grep '_r\[mode\]\|${mode}' — one log line), so
# 3d could only ever early-return or redo the IDENTICAL build. Its
# early-return probe (`clang --version` on a foreign-arch ELF) failed in
# practice, forcing a full ccache-absorbed recompile (~97s) AND baking the
# multi-GB /var/tmp build tree into the 3d layer (3d had no /var/tmp
# tmpfs). The trees 3d re-verified stay gated: RUN 3's post-build hooks
# die on a missing clang/cmake package, RUN 3c runs the qemu llvm-config +
# CMake link smoke, and sdk's materialize-llvm-target.sh asserts the ELF
# arch of /opt/llvm-target-<arch>/bin/clang.
#
# binutils-dev is installed HARD here (hoisted from the deleted RUN 3d):
# the superset build links LLVMgold against /usr/include/plugin-api.h, and
# the in-script _llvm_cross_ensure_host_binutils_dev helper is
# best-effort/WARN-only — without this line a transient apt failure would
# silently ship a target clang without the gold plugin.
RUN     --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=bind,source=linux/scripts/01-core/arch-mapping.sh,target=/opt/scripts/core/arch-mapping.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/build-helpers.sh,target=/opt/scripts/core/build-helpers.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/common.sh,target=/opt/scripts/core/common.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-apt.sh,target=/opt/scripts/core/cross-apt.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-env.sh,target=/opt/scripts/core/cross-env.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-gcc.sh,target=/opt/scripts/core/cross-gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-meson.sh,target=/opt/scripts/core/cross-meson.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-python.sh,target=/opt/scripts/core/cross-python.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/downloads.sh,target=/opt/scripts/core/downloads.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/load-versions-env.sh,target=/opt/scripts/core/load-versions-env.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/logging.sh,target=/opt/scripts/core/logging.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/meson-rust-wrapper.sh,target=/opt/scripts/core/meson-rust-wrapper.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/modules.sh,target=/opt/scripts/core/modules.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/parallelism.sh,target=/opt/scripts/core/parallelism.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/platform.sh,target=/opt/scripts/core/platform.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/repos.sh,target=/opt/scripts/core/repos.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/ubuntu-mirror.sh,target=/opt/scripts/core/ubuntu-mirror.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/verify.sh,target=/opt/scripts/core/verify.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/versions.env,target=/opt/scripts/core/versions.env,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/bootstrap.sh,target=/opt/scripts/toolchain/bootstrap.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/build-clang.sh,target=/opt/scripts/toolchain/build-clang.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/build-gcc.sh,target=/opt/scripts/toolchain/build-gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/configure-gcc-env.sh,target=/opt/scripts/toolchain/configure-gcc-env.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/core.sh,target=/opt/scripts/toolchain/core.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/gcc.sh,target=/opt/scripts/toolchain/gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/llvm-cross.sh,target=/opt/scripts/toolchain/llvm-cross.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/llvm-validate.sh,target=/opt/scripts/toolchain/llvm-validate.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/llvm.sh,target=/opt/scripts/toolchain/llvm.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/setup-dependencies.sh,target=/opt/scripts/toolchain/setup-dependencies.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/verify-gcc.sh,target=/opt/scripts/toolchain/verify-gcc.sh,ro \
    --mount=type=cache,target=/var/cache/llvm-src,id=llvm-src-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=tmpfs,target=/var/tmp \
    set -euo pipefail; \
    apt-get update -qq && \
    apt-get install -y --no-install-recommends binutils-dev; \
    SETUP_DEPENDENCIES_SKIP_CORE_TOOLS=true \
    LLVM_CROSS_SOURCE_ROOT=/var/cache/llvm-src \
    bash /opt/scripts/toolchain/setup-dependencies.sh dockerfile-llvm

# 3b. ENSURE LLVM 22 IS THE SYSTEM DEFAULT
# apt.llvm.org or source-build may install binaries at /usr/lib/llvm-*/bin/
# without always registering them as the highest-priority alternatives.
# Explicit update-alternatives here guarantees clang/clang++ resolve to the
# requested major version for CMake presets and downstream builds.
# Uses the bind-mounted copy to avoid cache invalidation on script-only changes.
RUN --mount=type=bind,source=linux/scripts/02-toolchain/register-llvm-alternatives.sh,target=/tmp/register-llvm-alternatives.sh,ro \
    set -euo pipefail; LLVM_RELEASE="${LLVM_RELEASE}" bash /tmp/register-llvm-alternatives.sh

# 3c. VERIFY TOOLCHAIN CONTRACT
RUN --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain,target=/opt/scripts/toolchain,ro \
    set -euo pipefail; \
    bash /opt/scripts/toolchain/setup-dependencies.sh verify

# (RUN 3d deleted — TG3-residual 2026-08-24. The unified superset build in
# RUN 3 already installs /opt/llvm-target-<arch> for every cross arch; see
# the RUN 3 comment above for the full rationale and the gates that still
# verify those trees.)

# 4. RUST / CARGO
# Install the host Rust toolchain in the compiler layer and add the target stdlibs
# plus Cargo linker hints needed by the amd64-hosted cross build lane.
# Pins from versions.env (auto-forwarded as build args by the orchestrator).
ARG RUST_VERSION=1.98.0
ARG CARGO_C_VERSION=0.10.25
ARG RUST_NIGHTLY_TOOLCHAIN=nightly-2026-06-28
# Per-file bind mounts = the transitive source-closure of install-rust.sh
# (platform.sh + cross-env.sh and the cross-* modules cross-env.sh pulls in).
# versions.env is mounted so install-rust.sh can pick up the optional
# RUSTUP_INIT_SHA256 pin (noforward key, so it never arrives as a build arg).
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-${TARGETARCH} \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git-${TARGETARCH} \
    --mount=type=bind,source=linux/scripts/01-core/cross-apt.sh,target=/opt/scripts/core/cross-apt.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-env.sh,target=/opt/scripts/core/cross-env.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-gcc.sh,target=/opt/scripts/core/cross-gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-meson.sh,target=/opt/scripts/core/cross-meson.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-python.sh,target=/opt/scripts/core/cross-python.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/meson-rust-wrapper.sh,target=/opt/scripts/core/meson-rust-wrapper.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/platform.sh,target=/opt/scripts/core/platform.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/ubuntu-mirror.sh,target=/opt/scripts/core/ubuntu-mirror.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/versions.env,target=/opt/scripts/core/versions.env,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/install-rust.sh,target=/opt/scripts/toolchain/install-rust.sh,ro \
    --mount=type=cache,target=/root/.cache/rustup,id=rustup-cache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    bash /opt/scripts/toolchain/install-rust.sh

# 5. PYTHON (Source-Built Interpreter)
# Keep the interpreter in the shared compiler layer so downstream images only
# create their own venvs on top of a single source-built CPython install.
# Per-file bind mounts = the transitive source-closure of build_python.sh
# (modules.sh bootstrap + the source_module'd 01-core leaves).
RUN --mount=type=bind,source=linux/scripts/01-core/cross-apt.sh,target=/opt/scripts/core/cross-apt.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-env.sh,target=/opt/scripts/core/cross-env.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-gcc.sh,target=/opt/scripts/core/cross-gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-meson.sh,target=/opt/scripts/core/cross-meson.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-python.sh,target=/opt/scripts/core/cross-python.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cpython-dev-packages.sh,target=/opt/scripts/core/cpython-dev-packages.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/downloads.sh,target=/opt/scripts/core/downloads.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/logging.sh,target=/opt/scripts/core/logging.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/meson-rust-wrapper.sh,target=/opt/scripts/core/meson-rust-wrapper.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/modules.sh,target=/opt/scripts/core/modules.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/parallelism.sh,target=/opt/scripts/core/parallelism.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/platform.sh,target=/opt/scripts/core/platform.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/ubuntu-mirror.sh,target=/opt/scripts/core/ubuntu-mirror.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/python/build_python.sh,target=/opt/scripts/python/build_python.sh,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain/python/fix-staged-python-pc.sh,target=/opt/scripts/python/fix-staged-python-pc.sh,ro \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    PYTHON_CROSS_STAGE_ROOT=/opt/python-cross \
    PYTHON_CROSS_ACTIVE_ROOT=/opt/python-target \
    PYTHON_TGZ_SHA256="${PYTHON_TGZ_SHA256}" \
    bash /opt/scripts/python/build_python.sh "${PYTHON_VERSION}"

# Canonical venv path/env for downstream stages. The venv itself is deliberately
# NOT created here: Dockerfile.media's base stage recreates it from scratch
# (`uv venv --clear`) with its own package set, its `FROM base AS tvm` stage
# builds in a throwaway venv of its own (tvm-python.sh `uv venv --seed
# $tvm_dir/.venv`), and the package image builds its own via
# setup-package-image.sh — a toolchain-level pre-create was always discarded
# downstream. (This used to cite "sdk's TVM build"; that stage was deleted on
# 2026-08-12 — see the "NO sdk-stage TVM build" note in Dockerfile.sdk, backlog
# BS2 — so only the address changed, not the reason. Named, not line-numbered:
# comment anchors rot, and this one already had.)
ENV VIRTUAL_ENV=/opt/python/.venv \
    PATH=/opt/python/.venv/bin:${PATH} \
    UV_PYTHON=/opt/python/.venv/bin/python \
    MEDIA_HOST_PYTHON=/opt/python/.venv/bin/python

# Script bundle for downstream stages, as plain COPYs: each layer's cache key
# is the CONTENT of exactly the paths it copies, so an unrelated linux/scripts
# edit no longer invalidates the bundle and the old manual `echo "bundle vN"`
# cache-buster is obsolete (bump-forgetting was a real foot-gun). The compiler
# layers above are untouched either way.
COPY --chmod=755 linux/scripts/01-core/ /opt/scripts/core/
COPY --chmod=755 linux/scripts/02-toolchain/ /opt/scripts/toolchain/
COPY --chmod=755 linux/scripts/02-toolchain/python/build_python.sh \
                 linux/scripts/02-toolchain/python/fix-staged-python-pc.sh \
                 /opt/scripts/python/
COPY --chmod=755 linux/scripts/06-packaging/smoke-common.sh \
                 linux/scripts/06-packaging/smoke-toolchain.sh \
                 linux/scripts/06-packaging/smoke-cross-all-arches.sh \
                 /opt/scripts/packaging/

# Same validation the old bundle RUN performed: every script parses, the
# toolchain installer answers --help, and the staged-python .pc fixup runs.
RUN set -euo pipefail; \
    find /opt/scripts -name '*.sh' -type f -print0 | while IFS= read -r -d '' f; do bash -n "$f"; done; \
    bash /opt/scripts/toolchain/setup-dependencies.sh --help >/dev/null; \
    bash /opt/scripts/python/fix-staged-python-pc.sh

# Execute the toolchain smoke (GCC/LLVM/Rust/Python + every cross-linker's ELF
# output) right after the bundle, so a broken compiler stage fails HERE instead
# of hours later in a downstream media/package build. Hard-fail via smoke_summary.
RUN set -euo pipefail; \
    bash /opt/scripts/packaging/smoke-toolchain.sh

# sudo pass-through wrapper: avoids sudo-rs env filtering issues in container.
# Strips --preserve-env* flags (which sudo-rs mis-handles) and executes the
# remaining command directly.  Warns on stderr when stripping flags and
# errors when no command remains after stripping.
RUN cat > /usr/local/bin/sudo <<'SUDO_WRAPPER' && chmod +x /usr/local/bin/sudo
#!/bin/bash
args=()
stripped=0
while [ $# -gt 0 ]; do
  case "$1" in
    --preserve-env*)
      [ "$stripped" -eq 0 ] && echo "sudo-wrapper: stripping $1" >&2
      stripped=1
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
if [ "${#args[@]}" -eq 0 ]; then
  echo "sudo-wrapper: no command to execute after stripping flags" >&2
  exit 1
fi
exec "${args[@]}"
SUDO_WRAPPER

LABEL org.opencontainers.image.title="Kataglyphis Compiler" \
      org.opencontainers.image.description="Compiler toolchain with GCC and LLVM/Clang"
