# syntax=docker/dockerfile:1.19

ARG BASE_IMAGE=local/kataglyphis:base
FROM ${BASE_IMAGE}

ARG LLVM_WANTED=22
ARG CLANG_WANTED=22
ARG LLVM_RELEASE=22.1.4
ARG GCC_WANTED=16
ARG GCC_VERSION=16.1.0
ARG TARGETARCH
ARG TARGETPLATFORM
ARG BUILDARCH
ARG BUILDPLATFORM
ARG BUILD_MODE=native
ARG CROSS_TARGETS=amd64,arm64,riscv64
ARG PYTHON_VERSION=3.14.4
ARG PYTHON_MAJOR_MINOR=3.14
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=http://de.archive.ubuntu.com/ubuntu/


SHELL ["bash", "-lc"]

RUN --mount=type=bind,source=linux/scripts/01-core/use-fast-ubuntu-mirror.sh,target=/tmp/use-fast-ubuntu-mirror.sh,ro \
    USE_FAST_UBUNTU_MIRROR="${USE_FAST_UBUNTU_MIRROR}" \
    FAST_UBUNTU_MIRROR_URL="${FAST_UBUNTU_MIRROR_URL}" \
    bash /tmp/use-fast-ubuntu-mirror.sh

ENV BUILD_MODE=${BUILD_MODE} \
    BUILDARCH=${BUILDARCH} \
    BUILDPLATFORM=${BUILDPLATFORM} \
    CROSS_TARGETS=${CROSS_TARGETS} \
    PYTHON_VERSION=${PYTHON_VERSION} \
    PYTHON_MAJOR_MINOR=${PYTHON_MAJOR_MINOR} \
    PATH="/usr/local/cargo/bin:${PATH}" \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    RUSTC_WRAPPER="" \
    PKG_CONFIG_ALLOW_CROSS=1 \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_GNU_LINKER=riscv64-linux-gnu-gcc \
    CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc \
    CXX_x86_64_unknown_linux_gnu=x86_64-linux-gnu-g++ \
    AR_x86_64_unknown_linux_gnu=x86_64-linux-gnu-ar \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar \
    CC_riscv64gc_unknown_linux_gnu=riscv64-linux-gnu-gcc \
    CXX_riscv64gc_unknown_linux_gnu=riscv64-linux-gnu-g++ \
    AR_riscv64gc_unknown_linux_gnu=riscv64-linux-gnu-ar

# ------------------------------------------------------------------------------
# Toolchain setup
# ------------------------------------------------------------------------------
COPY linux/scripts/01-core/ /opt/scripts/core/
COPY linux/scripts/02-toolchain/ /opt/scripts/toolchain/

# 1. BASE DEPENDENCIES & CMAKE
# Symlink core scripts and install basic build tools (CMake, Extras)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,id=apt-lib-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -eux; \
    for f in /opt/scripts/core/*.sh; do \
        dst="/opt/scripts/toolchain/$(basename \"$f\")"; \
        [ -f "$dst" ] || ln -s "$f" "$dst"; \
    done; \
    bash /opt/scripts/toolchain/setup-dependencies.sh cmake; \
    bash /opt/scripts/toolchain/setup-dependencies.sh extras; \
    bash /opt/scripts/toolchain/packaging-deps.sh

# 2. GCC (Heavy Layer)
# If this succeeds, it is cached forever unless GCC_WANTED changes.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,id=apt-lib-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -eux; \
    bash /opt/scripts/toolchain/setup-dependencies.sh --gcc "${GCC_WANTED}" gcc

# 3. ENVIRONMENT CONFIGURATION
# We apply ENV vars here so subsequent RUN instructions (LLVM/Vulkan)
# automatically use the new GCC without needing to source /etc/environment.
# LIBRARY_PATH is needed at link time (for the linker to find libgcc_s, etc.)
# LD_LIBRARY_PATH is needed at runtime (for the dynamic loader)
ENV PATH="/opt/gcc-${GCC_VERSION}/bin:${PATH}" \
    PKG_CONFIG_PATH="/opt/gcc-${GCC_VERSION}/lib64/pkgconfig:/opt/gcc-${GCC_VERSION}/lib/pkgconfig" \
    LD_LIBRARY_PATH="/opt/gcc-${GCC_VERSION}/lib64:/opt/gcc-${GCC_VERSION}/lib" \
    LIBRARY_PATH="/opt/gcc-${GCC_VERSION}/lib64:/opt/gcc-${GCC_VERSION}/lib"

# 4. LLVM / CLANG (Heavy Layer)
# If this fails, Docker restores the image state at 'Step 3' instantly.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,id=apt-lib-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -eux; \
    if [ "${BUILD_MODE}" = "cross" ]; then \
        echo "NOTICE: BUILD_MODE=cross; installing host LLVM/Clang for cross-targets ${CROSS_TARGETS}" >&2; \
        bash /opt/scripts/toolchain/setup-dependencies.sh --llvm "${LLVM_WANTED}" --clang "${CLANG_WANTED}" llvm; \
    elif [ "${TARGETARCH:-$(dpkg --print-architecture)}" = "riscv64" ]; then \
        echo "NOTICE: Detected riscv64 architecture." >&2; \
        echo "apt.llvm.org does not provide prebuilt LLVM/Clang packages for riscv64." >&2; \
        export LD_LIBRARY_PATH=/opt/gcc-${GCC_VERSION}/lib64:/opt/gcc-${GCC_VERSION}/lib:$LD_LIBRARY_PATH; \
        export LIBRARY_PATH=/opt/gcc-${GCC_VERSION}/lib64:/opt/gcc-${GCC_VERSION}/lib:${LIBRARY_PATH:-}; \
        bash /opt/scripts/toolchain/build-clang.sh --version "${LLVM_WANTED}" --release "${LLVM_RELEASE}"; \
    else \
        bash /opt/scripts/toolchain/setup-dependencies.sh --llvm "${LLVM_WANTED}" --clang "${CLANG_WANTED}" llvm; \
    fi

# 5. RUST / CARGO
# Install the host Rust toolchain in the compiler layer and add the target stdlibs
# plus Cargo linker hints needed by the amd64-hosted cross build lane.
RUN --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-${TARGETARCH} \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/rustup,id=rustup-cache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -eux; \
    host_arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "${host_arch}" in \
        amd64|x86_64) host_rust_target="x86_64-unknown-linux-gnu" ;; \
        arm64|aarch64) host_rust_target="aarch64-unknown-linux-gnu" ;; \
        riscv64) host_rust_target="riscv64gc-unknown-linux-gnu" ;; \
        *) echo "Unsupported Rust host architecture: ${host_arch}" >&2; exit 1 ;; \
    esac; \
    if [ "${BUILD_MODE}" = "cross" ]; then \
        rust_targets="${CROSS_TARGETS}"; \
    else \
        rust_targets="${host_arch}"; \
    fi; \
    curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal; \
    rustc --version; \
    cargo --version; \
    cargo install --locked cargo-c; \
    rustup component add clippy || true; \
    nightly_toolchain="nightly-${host_rust_target}"; \
    rustup toolchain install "${nightly_toolchain}" || true; \
    rustup component add rust-src --toolchain "${nightly_toolchain}" || true; \
    rustup target add wasm32-unknown-unknown --toolchain "${nightly_toolchain}" || true; \
     for target in ${rust_targets//,/ }; do \
         case "${target}" in \
             amd64|x86_64) rust_target="x86_64-unknown-linux-gnu" ;; \
            arm64|aarch64) rust_target="aarch64-unknown-linux-gnu" ;; \
            riscv64) rust_target="riscv64gc-unknown-linux-gnu" ;; \
            *) echo "Unsupported Rust target: ${target}" >&2; exit 1 ;; \
         esac; \
         rustup target add "${rust_target}"; \
         rustup target add --toolchain "${nightly_toolchain}" "${rust_target}" || true; \
     done

# 6. PYTHON (Source-Built Interpreter)
# Keep the interpreter in the shared compiler layer so downstream images only
# create their own venvs on top of a single source-built CPython install.
COPY --chmod=755 linux/scripts/python/build_python.sh /opt/scripts/python/build_python.sh

RUN set -eux; \
    python_mm="$(printf '%s' "${PYTHON_VERSION}" | cut -d. -f1,2)"; \
    [ "${PYTHON_MAJOR_MINOR}" = "${python_mm}" ] || { \
        echo "PYTHON_MAJOR_MINOR=${PYTHON_MAJOR_MINOR} does not match PYTHON_VERSION=${PYTHON_VERSION}" >&2; \
        exit 1; \
    }; \
    bash /opt/scripts/python/build_python.sh "${PYTHON_VERSION}"

LABEL org.opencontainers.image.title="Kataglyphis Compiler"
LABEL org.opencontainers.image.description="Compiler toolchain with GCC and LLVM/Clang"
