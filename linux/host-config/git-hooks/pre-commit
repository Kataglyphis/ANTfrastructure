#!/usr/bin/env bash
# pre-commit — the gates that cost SECONDS, run on every commit.
#
# Deliberately not the full suite. `make preflight` runs all 33 checks and takes
# minutes (the secret scan alone is ~170s, the mutation gate ~6 min); CI runs it on
# every push (.github/workflows/ubuntu24.04.yml). A hook that slow teaches people
# to type --no-verify, which is worse than having no hook. So this one runs the
# ~4s whole-tree gates, plus shellcheck, the warning ratchet and the mutation
# gate scoped to the STAGED files only.
#
# Install: make hooks    (sets core.hooksPath, so the hook is version-controlled)
# Bypass:  git commit --no-verify   — then run `make preflight` before pushing.
set -euo pipefail

_root="$(git rev-parse --show-toplevel)"
cd "${_root}"

# Whole-tree gates that are cheap. Measured 2026-09-04: 17 slugs, 4.2s combined.
# doc-links is here, not in the docs-only block: code carries docs/ pointers too.
# The warning ratchet slug is NOT here: its whole-tree run is 22s, so the hook
# runs it on the staged files only (0.2s each), below. (A comment must not START
# with the tool's name -- that parses as a directive and errors out.)
_FAST_SLUGS="crlf-guard,stdout-returns,copy-coverage,patch-integrity,code-dupes,\
arg-consistency,masked-decls,comment-size,code-size,code-complexity,dead-functions,\
artifact-parity,advert-keys,stage-graph,env-knobs,\
doc-links,gate-registry"

echo "pre-commit: fast preflight gates…"
PREFLIGHT_ONLY="${_FAST_SLUGS}" bash linux/scripts/preflight.sh || {
  echo "pre-commit: FAILED — fix the gate above, or 'git commit --no-verify' if you know why" >&2
  exit 1
}

# Lint only what is being committed: the whole tree costs 105s in shellcheck, a
# handful of files costs nothing. (Do not start this comment with the tool's
# name -- shellcheck parses such a line as a directive and errors out.)
_staged_sh="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.sh$' || true)"
if [ -n "${_staged_sh}" ]; then
  echo "pre-commit: shellcheck on staged shell files…"
  _sc_bin="$(bash linux/scripts/lint-shell.sh --print-bin)" || {
    echo "pre-commit: no pinned shellcheck — see lint-shell.sh --print-bin" >&2
    exit 1
  }
  # shellcheck disable=SC2086
  "${_sc_bin}" -S error ${_staged_sh} || {
    echo "pre-commit: shellcheck FAILED on staged files" >&2
    exit 1
  }
  # shellcheck disable=SC2086
  python3 linux/scripts/verify_shellcheck_warnings.py --files ${_staged_sh} || {
    echo "pre-commit: shellcheck warning ratchet FAILED on staged files" >&2
    exit 1
  }
fi

# Doc duplication only when docs move — sub-second.
_staged_md="$(git diff --cached --name-only --diff-filter=ACM | grep -E '^docs/.*\.md$' || true)"
if [ -n "${_staged_md}" ]; then
  echo "pre-commit: doc duplication gate…"
  python3 docs/scripts/verify_doc_dupes.py >/dev/null || { echo "pre-commit: doc duplication FAILED" >&2; exit 1; }
fi

# Mutation gate, scoped to what is being committed: all 180 entries cost ~6 min,
# the handful whose target you just touched cost seconds. It answers the one
# question reading a test cannot -- can it fail?
_staged_any="$(git diff --cached --name-only --diff-filter=ACM || true)"
if [ -n "${_staged_any}" ]; then
  if python3 docs/scripts/verify_mutations.py --changed >/dev/null 2>&1; then
    :
  else
    echo "pre-commit: a recorded mutation SURVIVED -- a test here cannot fail" >&2
    python3 docs/scripts/verify_mutations.py --changed >&2 || true
    exit 1
  fi
fi

echo "pre-commit: OK"
