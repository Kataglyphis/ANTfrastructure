#!/usr/bin/env bash
# pre-commit — the gates that cost SECONDS, run on every commit.
#
# Deliberately not the full suite: `make preflight` runs all 34 checks in minutes,
# and this hook's own mutation step measured 5m26s on a 43-file commit until it
# was capped, so it SAMPLES. The gate shards its own run since 2026-09-04 (one
# mirror per job), which is what pays for a sample of 16 rather than 6 in the
# same seconds. docs/code-quality-tooling.md#the-pre-commit-hooks-cost-budget
#
# Install: make hooks    (sets core.hooksPath, so the hook is version-controlled)
# Bypass:  git commit --no-verify   — then run `make preflight` before pushing.
set -euo pipefail

# `git commit -a` and `git commit <path>` build this commit's index in a lock file the plain index does not show yet.
_index="${GIT_INDEX_FILE:-}"

# Git exports GIT_DIR (and may export GIT_WORK_TREE/GIT_INDEX_FILE/GIT_PREFIX) to
# hooks. Test fixtures that shell out to git then operate on the superproject
# instead of their own temp repo -- measured 2026-09-12: every renovate mutation
# baseline failed under `git commit` and passed standalone. No fixture may be
# asked to defend against the caller's environment; clear it here.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

# One owner for "is there a working Python here?", shared with preflight.sh and
# the lint aggregator: plain `python3` on a Windows Git Bash host is the
# Microsoft Store stub, which prints an install hint and exits non-zero -- every
# gate below would then fail for a reason that has nothing to do with the commit.
# Resolved from THIS file's path, not from the working directory: the
# --print-mutation-plan entry point runs before the cd to the toplevel.
# docs/shared-script-libraries.md#python-interpreter-probe-01-corepython-probesh
_hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../../scripts/01-core/python-probe.sh
. "${_hook_dir}/../../scripts/01-core/python-probe.sh"
preflight_python_require pre-commit || exit 1
# Expanded UNQUOTED at every call site: the value may be a command line
# ("uv run --no-project python"), which is the hint the probe's failure gives.
_PY="${PREFLIGHT_PYTHON}"

_MUTATION_CAP="${PRECOMMIT_MUTATION_CAP:-16}"
_MUTATION_MANIFEST="${PRECOMMIT_MUTATION_MANIFEST:-docs/scripts/mutations.json}"

# <cap> <manifest> <file listing staged paths> -> "plan <run> <matched>" then the
# ids to run: entries whose target is staged, newest first (the manifest is
# appended to), cut to <cap>; 0 = uncapped. git passes no arguments to a
# pre-commit hook, so --print-mutation-plan is a test entry point only.
# docs/code-quality-tooling.md#the-pre-commit-hooks-cost-budget
_mutation_plan() {
  # A Windows python prints CRLF; a kept \r makes every id unknown to verify_mutations.py.
  # shellcheck disable=SC2086  # a multi-word PREFLIGHT_PYTHON is a command line
  ${_PY} - "$1" "$2" "$3" <<'PY' | tr -d '\r'
import json
import sys

cap, manifest, staged_list = int(sys.argv[1]), sys.argv[2], sys.argv[3]
with open(staged_list, encoding="utf-8") as fh:
    staged = {line.strip() for line in fh if line.strip()}
with open(manifest, encoding="utf-8") as fh:
    matched = [e["id"] for e in json.load(fh) if e["target"] in staged]
matched.reverse()
run = matched[:cap] if cap > 0 else matched
print(f"plan {len(run)} {len(matched)}")
for mid in run:
    print(mid)
PY
}

# <run> <matched> -> the one line the mutation step prints about its own coverage.
# A sample must never read as full coverage.
# docs/code-quality-tooling.md#the-pre-commit-hooks-cost-budget
_mutation_notice() {
  if [ "$1" -lt "$2" ]; then
    echo "pre-commit: mutation gate — SAMPLED $1 of $2 entries (newest first), NOT full coverage; PRECOMMIT_MUTATION_CAP=0 or 'make preflight' runs the rest"
  else
    echo "pre-commit: mutation gate — all $2 entries for the staged files…"
  fi
}

if [ "${1:-}" = "--print-mutation-plan" ]; then
  _mutation_plan "${2:-0}" "${3:-${_MUTATION_MANIFEST}}" "${4:-/dev/null}"
  exit 0
fi

_root="$(git rev-parse --show-toplevel)"
cd "${_root}"

# For this one call: an exported index would reach every git call a gate or a fixture makes.
_staged_paths() {
  if [ -n "${_index}" ]; then
    GIT_INDEX_FILE="${_index}" git diff --cached --name-only --diff-filter=ACM
  else
    git diff --cached --name-only --diff-filter=ACM
  fi
}
# A list that cannot be read must stop the commit: an empty one skips every staged check below.
_staged_any="$(_staged_paths)" || {
  echo "pre-commit: FAILED — cannot read this commit's staged files" >&2
  exit 1
}

# Whole-tree gates that are cheap. Measured 2026-09-04: 18 slugs, 6.4s combined.
# doc-links is here, not in the docs-only block: code carries docs/ pointers too.
# The warning ratchet slug is NOT here: its whole-tree run is 22s, so the hook
# runs it on the staged files only (0.2s each), below. (A comment must not START
# with the tool's name -- that parses as a directive and errors out.)
_FAST_SLUGS="crlf-guard,stdout-returns,copy-coverage,patch-integrity,code-dupes,\
arg-consistency,masked-decls,comment-size,code-size,code-complexity,dead-functions,large-files,\
artifact-parity,advert-keys,stage-graph,env-knobs,trailing-conditional,knob-order,\
doc-links,gate-registry,readme-length"

echo "pre-commit: fast preflight gates…"
PREFLIGHT_ONLY="${_FAST_SLUGS}" bash linux/scripts/preflight.sh || {
  echo "pre-commit: FAILED — fix the gate above, or 'git commit --no-verify' if you know why" >&2
  exit 1
}

# Lint only what is being committed: the whole tree costs 105s in shellcheck, a
# handful of files costs nothing. (Do not start this comment with the tool's
# name -- shellcheck parses such a line as a directive and errors out.)
_staged_sh="$(printf '%s\n' "${_staged_any}" | grep -E '\.sh$' || true)"
if [ -n "${_staged_sh}" ]; then
  echo "pre-commit: shellcheck on staged shell files…"
  _sc_bin="$(bash linux/scripts/lint-shell.sh --print-bin)" || {
    echo "pre-commit: no pinned shellcheck — see lint-shell.sh --print-bin" >&2
    exit 1
  }
  # shellcheck disable=SC2086
  "${_sc_bin}" -S error ${_staged_sh} || {
    echo "pre-commit: shellcheck FAILED on staged files" >&2
    exit 1
  }
  # shellcheck disable=SC2086
  ${_PY} linux/scripts/verify_shellcheck_warnings.py --files ${_staged_sh} || {
    echo "pre-commit: shellcheck warning ratchet FAILED on staged files" >&2
    exit 1
  }
fi

# Doc duplication only when docs move — sub-second.
_staged_md="$(printf '%s\n' "${_staged_any}" | grep -E '^docs/.*\.md$' || true)"
if [ -n "${_staged_md}" ]; then
  echo "pre-commit: doc duplication gate…"
  # shellcheck disable=SC2086
  ${_PY} docs/scripts/verify_doc_dupes.py >/dev/null || { echo "pre-commit: doc duplication FAILED" >&2; exit 1; }
fi

# Derived doc numbers only when one of their inputs is staged. Most gate commits
# append to the manifest, and its quoted total once went stale while this hook
# said OK (CI run 36022089345). The digits are rewritten by --update, never typed.
_staged_dn="$(printf '%s\n' "${_staged_any}" \
  | grep -E '^(docs/scripts/mutations\.json|linux/host-config/git-hooks/pre-commit|docs/code-quality-tooling\.md|docs/cross-build-verification\.md|AGENTS\.md)$' || true)"
if [ -n "${_staged_dn}" ]; then
  echo "pre-commit: derived doc numbers…"
  bash linux/scripts/tests/test-doc-numbers.sh >/dev/null 2>&1 || {
    echo "pre-commit: derived doc numbers are STALE -- run: bash linux/scripts/tests/test-doc-numbers.sh --update" >&2
    exit 1
  }
fi

# Mutation gate, SAMPLED. Scope is the STAGED files, not `--changed` (which also
# selects everything committed since origin/main, so every commit of a batch
# re-paid for the ones before it: 132 entries / 5m22s for this session's 43-file
# commit). Newest entries first, capped, and it PRINTS the sample size -- green
# here never means full coverage. It answers the one question reading a test
# cannot: can it fail? docs/code-quality-tooling.md#the-pre-commit-hooks-cost-budget
# <log>: the ids whose test was red before any mutation, when they are all that failed; nothing otherwise.
# Such a test says nothing about a mutation here (Debian 13's bash 5.2 against the image's 5.3), so the image decides.
_host_red_ids() {
  local vac failed
  vac="$(sed -n 's/^\(\[[0-9]*\/[0-9]*\] \)\{0,1\}FAIL: \([^ ]*\) -- baseline test already fails unmutated.*/\2/p' "$1" | tr -d '\r' | sort -u | tr '\n' ' ')"
  failed="$(sed -n 's/^FAILED: [0-9]* of [0-9]* entr(ies), in manifest order: //p' "$1" | tr -d ',\r' | tr ' ' '\n' | sed '/^$/d' | sort -u | tr '\n' ' ')"
  if [ -n "${vac}" ] && [ "${vac}" = "${failed}" ]; then
    echo "pre-commit: ${vac}fail unmutated on this host; proven again in the image" >&2
    printf '%s' "${vac}"
  fi
}

if [ -n "${_staged_any}" ]; then
  _staged_list="$(mktemp)"
  printf '%s\n' "${_staged_any}" > "${_staged_list}"
  _plan="$(_mutation_plan "${_MUTATION_CAP}" "${_MUTATION_MANIFEST}" "${_staged_list}")"
  rm -f "${_staged_list}"
  _run="$(printf '%s\n' "${_plan}" | sed -n '1s/^plan \([0-9]*\) [0-9]*$/\1/p')"
  _matched="$(printf '%s\n' "${_plan}" | sed -n '1s/^plan [0-9]* \([0-9]*\)$/\1/p')"
  _only=()
  while IFS= read -r _id; do
    if [ -n "${_id}" ]; then _only+=(--only "${_id}"); fi
  done < <(printf '%s\n' "${_plan}" | tail -n +2)
  if [ "${#_only[@]}" -gt 0 ]; then
    _mutation_notice "${_run:-0}" "${_matched:-0}"
    _mlog="$(mktemp)"
    set +e
    # shellcheck disable=SC2086
    ${_PY} docs/scripts/verify_mutations.py "${_only[@]}" 2>&1 | tee "${_mlog}"
    _mrc="${PIPESTATUS[0]}"
    set -e
    # A host without the pwsh or bash a mutant must parse with proves the sample in the image (CON279), as pre-push does (CON277).
    _runner="$(git config --get kataglyphis.imageRunner || true)"
    if [ "${_mrc}" -ne 0 ] && [ -n "${_runner}" ] && grep -q "is not on PATH, so" "${_mlog}"; then
      _again=("${_only[@]}")
      _ps="$(sed -n 's/^FAIL: pwsh is not on PATH, so [0-9]* selected test(s) cannot run here: //p' "${_mlog}" | tr -d '\r,')"
      _mrc=0
      if [ -n "${_ps}" ]; then
        # Only the tests that start pwsh go to the image; the rest stay on the host they were written for.
        echo "pre-commit: ${_ps} need pwsh; the rest here, those in the image through '${_runner}'"
        _again=()
        for _id in ${_ps}; do _again+=(--only "${_id}"); done
        ${_PY} docs/scripts/verify_mutations.py "${_only[@]}" --delegate-chrome </dev/null > "${_mlog}" 2>&1 || _mrc=$?
        cat "${_mlog}"
        _vac="$(_host_red_ids "${_mlog}")"
        if [ "${_mrc}" -ne 0 ] && [ -n "${_vac}" ]; then
          _mrc=0
          for _id in ${_vac}; do _again+=(--only "${_id}"); done
        fi
      else
        echo "pre-commit: this host lacks a parser the sample needs; the sample again in the image through '${_runner}'"
      fi
      # The image has its say either way; a survivor on the host still stops the commit.
      # shellcheck disable=SC2086 # the runner is a command line of its own, split on purpose
      ${_runner} "python3 docs/scripts/verify_mutations.py ${_again[*]}" </dev/null || _mrc=$?
    elif [ "${_mrc}" -ne 0 ] && [ -n "${_runner}" ] && _vac="$(_host_red_ids "${_mlog}")" && [ -n "${_vac}" ]; then
      _again=()
      for _id in ${_vac}; do _again+=(--only "${_id}"); done
      _mrc=0
      # shellcheck disable=SC2086 # the runner is a command line of its own, split on purpose
      ${_runner} "python3 docs/scripts/verify_mutations.py ${_again[*]}" </dev/null || _mrc=$?
    fi
    rm -f "${_mlog}"
    if [ "${_mrc}" -ne 0 ]; then
      echo "pre-commit: a recorded mutation SURVIVED -- a test here cannot fail" >&2
      exit 1
    fi
  fi
fi

echo "pre-commit: OK"
