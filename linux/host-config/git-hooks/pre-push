#!/usr/bin/env bash
# pre-push — the mutation coverage a per-commit sample cannot pay for.
#
# pre-commit proves at most PRECOMMIT_MUTATION_CAP entries of the STAGED files and
# CI proves all of them; between the two there was nothing. Staleness over the
# whole manifest costs one read per target, and `--changed` is push scope by
# definition. docs/code-quality-tooling.md#the-pre-push-hook
set -euo pipefail

# Git exports GIT_DIR (and friends) to hooks, so a fixture's `git -C <tmp> init` would
# re-init THIS repository as bare. Same clear as pre-commit; docs/failure-modes.md.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

# One owner for "is there a working Python here?", shared with preflight.sh and
# the lint aggregator: plain `python3` on a Windows Git Bash host is the
# Microsoft Store stub, which prints an install hint and exits non-zero -- every
# gate below would then fail for a reason that has nothing to do with the commit.
# Resolved from THIS file's path, not from the working directory: the
# --print-mutation-plan entry point runs before the cd to the toplevel.
# docs/shared-script-libraries.md#python-interpreter-probe-01-corepython-probesh
_hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../../scripts/01-core/python-probe.sh
. "${_hook_dir}/../../scripts/01-core/python-probe.sh"
preflight_python_require pre-push || exit 1
# Expanded UNQUOTED at every call site: the value may be a command line
# ("uv run --no-project python"), which is the hint the probe's failure gives.
_PY="${PREFLIGHT_PYTHON}"

_root="$(git rev-parse --show-toplevel)"
cd "${_root}"

echo "pre-push: mutation staleness over the whole manifest…"
# shellcheck disable=SC2086
${_PY} docs/scripts/verify_mutations.py --stale-check || {
  echo "pre-push: a recorded mutation no longer applies — re-point or delete it, or 'git push --no-verify'" >&2
  exit 1
}

echo "pre-push: mutation gate over everything since origin/main…"
# shellcheck disable=SC2086
${_PY} docs/scripts/verify_mutations.py --changed --jobs "${PREPUSH_MUTATION_JOBS:-4}" || {
  echo "pre-push: a recorded mutation SURVIVED — a test here cannot fail" >&2
  exit 1
}

echo "pre-push: OK"
