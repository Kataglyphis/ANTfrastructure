# syntax=docker/dockerfile:1.24.0

ARG BASE_IMAGE=local/kataglyphis:media

# ==============================================================================
# android-sdk — shared base with Android SDK/NDK installed
# ==============================================================================
FROM ${BASE_IMAGE} AS android-sdk

SHELL ["bash", "-lc"]

ARG BUILD_MODE=native
ARG TARGET_ARCH
ARG TARGETARCH
ARG TARGETPLATFORM
ARG BUILDARCH
ARG BUILDPLATFORM
ARG ENABLE_NVIDIA=false
ARG ENABLE_AMD=false

ARG ANDROID_SDK_VERSION=14742923
ARG ANDROID_NDK_VERSION=29.0.14206865
ARG ANDROID_COMPILE_SDK=36
ARG ANDROID_BUILD_TOOLS=35.0.0
ARG ANDROID_CMAKE_VERSION=4.1.2
ARG ANDROID_API_LEVEL=34
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_SDK_VERSION=${ANDROID_SDK_VERSION} \
    ANDROID_NDK_VERSION=${ANDROID_NDK_VERSION} \
    ANDROID_COMPILE_SDK=${ANDROID_COMPILE_SDK} \
    ANDROID_BUILD_TOOLS=${ANDROID_BUILD_TOOLS} \
    ANDROID_CMAKE_VERSION=${ANDROID_CMAKE_VERSION} \
    ANDROID_API_LEVEL=${ANDROID_API_LEVEL} \
    ANDROID_NDK_HOME=/opt/android-sdk/ndk/${ANDROID_NDK_VERSION} \
    ANDROID_NDK_ROOT=/opt/android-sdk/ndk/${ANDROID_NDK_VERSION} \
    GSTREAMER_ROOT_ANDROID=/opt/android/gstreamer \
    ONNXRUNTIME_ROOT_ANDROID=/opt/android/onnxruntime \
    LITERT_ROOT_ANDROID=/opt/android/litert \
    OPENCV_ROOT_ANDROID=/opt/android/opencv \
    BUILD_MODE=${BUILD_MODE} \
    TARGET_ARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETPLATFORM=${TARGETPLATFORM} \
    BUILDARCH=${BUILDARCH} \
    BUILDPLATFORM=${BUILDPLATFORM} \
    PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${ANDROID_HOME}/build-tools/${ANDROID_BUILD_TOOLS}:${ANDROID_NDK_HOME}:${PATH}"

COPY --chmod=755 \
    linux/scripts/setup-android-sdk-ndk.sh /opt/scripts/setup-android-sdk-ndk.sh \
    linux/scripts/01-core/platform.sh /opt/scripts/core/platform.sh

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; /opt/scripts/setup-android-sdk-ndk.sh && \
    mkdir -p /opt/android-sdk /opt/android && \
    mkdir -p /opt/android/gstreamer /opt/android/onnxruntime /opt/android/litert /opt/android/opencv

# ==============================================================================
# android-gstreamer — GStreamer Android build (parallel with android-libs)
# ==============================================================================
FROM android-sdk AS android-gstreamer

ARG TARGET_ARCH
ARG TARGETARCH

COPY --chmod=755 \
    linux/scripts/03-media/gstreamer/android/ /opt/scripts/media/gstreamer/android/ \
    linux/scripts/03-media/android-build-preamble.sh /opt/scripts/media/android-build-preamble.sh

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
        /opt/scripts/media/gstreamer/android/build-gstreamer.sh

# ==============================================================================
# android-libs — ONNX + LiteRT + OpenCV Android builds (parallel with android-gstreamer)
# ==============================================================================
FROM android-sdk AS android-libs

ARG TARGET_ARCH
ARG TARGETARCH

COPY --chmod=755 \
    linux/scripts/03-media/onnxruntime/android/ /opt/scripts/media/onnxruntime/android/ \
    linux/scripts/03-media/litert/android/ /opt/scripts/media/litert/android/ \
    linux/scripts/03-media/opencv/android/ /opt/scripts/media/opencv/android/ \
    linux/scripts/03-media/android-build-preamble.sh /opt/scripts/media/android-build-preamble.sh

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
        /opt/scripts/media/onnxruntime/android/build-android.sh && \
        /opt/scripts/media/litert/android/build-android.sh && \
        /opt/scripts/media/opencv/android/build-android.sh

# ==============================================================================
# Final stage — aggregate parallel stage outputs + native GCC swap
# ==============================================================================
FROM android-sdk AS final

ARG TARGET_ARCH
ARG TARGETARCH
ARG BUILD_MODE
ARG GCC_VERSION=16.1.0

COPY --from=android-gstreamer /opt/android/gstreamer /opt/android/gstreamer
COPY --from=android-libs /opt/android/onnxruntime /opt/android/onnxruntime
COPY --from=android-libs /opt/android/litert /opt/android/litert
COPY --from=android-libs /opt/android/opencv /opt/android/opencv

# Preserve the cross-compiled Python staging tree from the base image and swap
# the amd64-hosted GCC with the target-native GCC for non-amd64 architectures.
COPY --chmod=755 linux/scripts/06-packaging/swap-native-gcc.sh /opt/scripts/packaging/swap-native-gcc.sh
RUN set -euo pipefail; \
    if [ -d /opt/python-cross ] && [ ! -f /opt/python-cross/.keep ]; then \
        touch /opt/python-cross/.keep; fi; \
    TARGET_ARCH="${TARGET_ARCH:-${TARGETARCH}}" \
    GCC_VERSION="${GCC_VERSION}" \
    BUILD_MODE="${BUILD_MODE}" \
    bash /opt/scripts/packaging/swap-native-gcc.sh

LABEL org.opencontainers.image.title="Kataglyphis Android" \
      org.opencontainers.image.description="Android SDK/NDK and cross-compiled Android artifacts layer"
