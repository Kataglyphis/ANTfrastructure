# syntax=docker/dockerfile:1.27.0

ARG BASE_IMAGE=local/kataglyphis:media

# android-sdk: shared base with the Android SDK/NDK
FROM ${BASE_IMAGE} AS android-sdk

SHELL ["bash", "-lc"]

ARG BUILD_MODE=native
# parallelism.sh divides usable RAM by this so concurrent per-arch builds do not overcommit the host.
ARG BUILD_MEM_DIVISOR=1
ARG TARGET_ARCH
ARG TARGETARCH
ARG TARGETPLATFORM
ARG BUILDARCH
ARG BUILDPLATFORM
ARG ENABLE_NVIDIA=false
ARG ENABLE_AMD=false

ARG ANDROID_SDK_VERSION=15859902
ARG ANDROID_NDK_VERSION=29.0.14206865
ARG ANDROID_COMPILE_SDK=36
ARG ANDROID_BUILD_TOOLS=36.0.0
ARG ANDROID_EXTRA_COMPILE_SDK=37.0
ARG ANDROID_EXTRA_BUILD_TOOLS=37.0.0
ARG ANDROID_CMAKE_VERSION=4.1.2
ARG ANDROID_API_LEVEL=34
ARG ANDROID_TARGET_ABI=arm64-v8a
# Undeclared build args are dropped; no defaults, so an unpassed version expands empty and the scripts' `:?` guards fail.
ARG ONNXRUNTIME_VERSION
ARG LITERT_VERSION
ARG IREE_VERSION
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_SDK_VERSION=${ANDROID_SDK_VERSION} \
    ANDROID_NDK_VERSION=${ANDROID_NDK_VERSION} \
    ANDROID_COMPILE_SDK=${ANDROID_COMPILE_SDK} \
    ANDROID_BUILD_TOOLS=${ANDROID_BUILD_TOOLS} \
    ANDROID_EXTRA_COMPILE_SDK=${ANDROID_EXTRA_COMPILE_SDK} \
    ANDROID_EXTRA_BUILD_TOOLS=${ANDROID_EXTRA_BUILD_TOOLS} \
    ANDROID_CMAKE_VERSION=${ANDROID_CMAKE_VERSION} \
    ANDROID_API_LEVEL=${ANDROID_API_LEVEL} \
    ANDROID_TARGET_ABI=${ANDROID_TARGET_ABI} \
    ONNXRUNTIME_VERSION=${ONNXRUNTIME_VERSION} \
    LITERT_VERSION=${LITERT_VERSION} \
    IREE_VERSION=${IREE_VERSION} \
    ANDROID_NDK_HOME=/opt/android-sdk/ndk/${ANDROID_NDK_VERSION} \
    ANDROID_NDK_ROOT=/opt/android-sdk/ndk/${ANDROID_NDK_VERSION} \
    GSTREAMER_ROOT_ANDROID=/opt/android/gstreamer \
    ONNXRUNTIME_ROOT_ANDROID=/opt/android/onnxruntime \
    LITERT_ROOT_ANDROID=/opt/android/litert \
    OPENCV_ROOT_ANDROID=/opt/android/opencv \
    IREE_ROOT_ANDROID=/opt/android/iree \
    BUILD_MODE=${BUILD_MODE} \
    BUILD_MEM_DIVISOR=${BUILD_MEM_DIVISOR} \
    TARGET_ARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETPLATFORM=${TARGETPLATFORM} \
    BUILDARCH=${BUILDARCH} \
    BUILDPLATFORM=${BUILDPLATFORM}

# Its own instruction, since an ENV reads ${VAR} from before itself: docs/code-quality-tooling.md#env-instruction-ordering-dockerfile-lint
ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${ANDROID_HOME}/build-tools/${ANDROID_BUILD_TOOLS}:${ANDROID_NDK_HOME}:${PATH}"

COPY --chmod=755 linux/scripts/02-toolchain/android-sdk.sh /opt/scripts/android-sdk.sh
COPY --chmod=755 linux/scripts/01-core/platform.sh /opt/scripts/core/platform.sh
# The base's 01-core is older; cross-apt.sh needs this ubuntu-mirror.sh too: docs/failure-modes.md#apt-libc6i386-install-is-unsatisfiable-after-an-archiveports-drift
COPY --chmod=755 linux/scripts/01-core/cross-apt.sh /opt/scripts/core/cross-apt.sh
COPY --chmod=755 linux/scripts/01-core/ubuntu-mirror.sh /opt/scripts/core/ubuntu-mirror.sh
# Every android-* stage derives from this one, so one COPY covers them all.
COPY --chmod=755 linux/scripts/01-core/downloads.sh /opt/scripts/core/downloads.sh
# Without the canonical resolver, IREE took the custom cross GCC on PATH as its host compiler.
COPY --chmod=755 linux/scripts/01-core/compiler-resolution.sh /opt/scripts/core/compiler-resolution.sh

# Arch-independent payload, so no arch key; the id names every android-sdk.sh pin (test-android-sdk-cache-key.sh).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH} \
    --mount=type=cache,target=/var/cache/android-sdk-shared,id=android-sdk-shared-${ANDROID_SDK_VERSION}-${ANDROID_NDK_VERSION}-${ANDROID_COMPILE_SDK}-${ANDROID_BUILD_TOOLS}-${ANDROID_EXTRA_COMPILE_SDK}-${ANDROID_EXTRA_BUILD_TOOLS}-${ANDROID_CMAKE_VERSION},sharing=locked \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; ANDROID_SDK_CACHE_DIR=/var/cache/android-sdk-shared /opt/scripts/android-sdk.sh && \
    mkdir -p /opt/android-sdk /opt/android && \
    mkdir -p /opt/android/gstreamer /opt/android/onnxruntime /opt/android/litert /opt/android/opencv /opt/android/iree

# Hoisted into the parent so each library stage COPYs only its own dir.
COPY --chmod=755 linux/scripts/03-media/android-build-preamble.sh /opt/scripts/03-media/android-build-preamble.sh
COPY --chmod=755 linux/scripts/03-media/android-dispatch.sh /opt/scripts/03-media/android-dispatch.sh

# android-gstreamer (parallel with the other library stages)
FROM android-sdk AS android-gstreamer

ARG TARGET_ARCH
ARG TARGETARCH
ARG ANDROID_LIB=gstreamer

COPY --chmod=755 linux/scripts/03-media/build/${ANDROID_LIB}/android/ /opt/scripts/03-media/${ANDROID_LIB}/android/

# cerbero state on a cachemount so a failed attempt resumes; every id key matters. See docs/build-cache-tiers.md § 1.1 The cerbero state cachemount (CERB-CACHE)
RUN --mount=type=bind,source=linux/scripts/01-core/apply-patch.sh,target=/opt/scripts/core/apply-patch.sh,ro \
    --mount=type=bind,source=linux/scripts/patches,target=/opt/scripts/patches,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/cerbero,sharing=locked,id=cerbero-state-${TARGET_ARCH}-abi${ANDROID_TARGET_ABI}-${ANDROID_LIB}-gst${GSTREAMER_VERSION}-ndk${ANDROID_NDK_VERSION}-api${ANDROID_API_LEVEL} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
        /opt/scripts/03-media/android-dispatch.sh "${ANDROID_LIB}"

# android-onnx (parallel with gstreamer, litert, opencv)
FROM android-sdk AS android-onnx

ARG TARGET_ARCH
ARG TARGETARCH
ARG ANDROID_LIB=onnxruntime

COPY --chmod=755 linux/scripts/03-media/build/${ANDROID_LIB}/android/ /opt/scripts/03-media/${ANDROID_LIB}/android/

# The cerbero mount is inert here; it keeps the five library stages identical for verify-android-stage-parity.sh.
RUN --mount=type=bind,source=linux/scripts/01-core/apply-patch.sh,target=/opt/scripts/core/apply-patch.sh,ro \
    --mount=type=bind,source=linux/scripts/patches,target=/opt/scripts/patches,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/cerbero,sharing=locked,id=cerbero-state-${TARGET_ARCH}-abi${ANDROID_TARGET_ABI}-${ANDROID_LIB}-gst${GSTREAMER_VERSION}-ndk${ANDROID_NDK_VERSION}-api${ANDROID_API_LEVEL} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
        /opt/scripts/03-media/android-dispatch.sh "${ANDROID_LIB}"

# android-litert (parallel with gstreamer, onnx, opencv)
FROM android-sdk AS android-litert

ARG TARGET_ARCH
ARG TARGETARCH
ARG ANDROID_LIB=litert

COPY --chmod=755 linux/scripts/03-media/build/${ANDROID_LIB}/android/ /opt/scripts/03-media/${ANDROID_LIB}/android/

# The cerbero mount is inert here; it keeps the five library stages identical for verify-android-stage-parity.sh.
RUN --mount=type=bind,source=linux/scripts/01-core/apply-patch.sh,target=/opt/scripts/core/apply-patch.sh,ro \
    --mount=type=bind,source=linux/scripts/patches,target=/opt/scripts/patches,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/cerbero,sharing=locked,id=cerbero-state-${TARGET_ARCH}-abi${ANDROID_TARGET_ABI}-${ANDROID_LIB}-gst${GSTREAMER_VERSION}-ndk${ANDROID_NDK_VERSION}-api${ANDROID_API_LEVEL} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
        /opt/scripts/03-media/android-dispatch.sh "${ANDROID_LIB}"

# android-opencv (parallel with gstreamer, onnx, litert)
FROM android-sdk AS android-opencv

ARG TARGET_ARCH
ARG TARGETARCH
ARG ANDROID_LIB=opencv

COPY --chmod=755 linux/scripts/03-media/build/${ANDROID_LIB}/android/ /opt/scripts/03-media/${ANDROID_LIB}/android/

# The cerbero mount is inert here; it keeps the five library stages identical for verify-android-stage-parity.sh.
RUN --mount=type=bind,source=linux/scripts/01-core/apply-patch.sh,target=/opt/scripts/core/apply-patch.sh,ro \
    --mount=type=bind,source=linux/scripts/patches,target=/opt/scripts/patches,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/cerbero,sharing=locked,id=cerbero-state-${TARGET_ARCH}-abi${ANDROID_TARGET_ABI}-${ANDROID_LIB}-gst${GSTREAMER_VERSION}-ndk${ANDROID_NDK_VERSION}-api${ANDROID_API_LEVEL} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
        /opt/scripts/03-media/android-dispatch.sh "${ANDROID_LIB}"

# android-iree: best-effort, a failure leaves /opt/android/iree empty instead of breaking the image
FROM android-sdk AS android-iree

ARG TARGET_ARCH
ARG TARGETARCH
ARG ANDROID_LIB=iree

COPY --chmod=755 linux/scripts/03-media/build/${ANDROID_LIB}/android/ /opt/scripts/03-media/${ANDROID_LIB}/android/

# The cerbero mount is inert here; it keeps the five library stages identical for verify-android-stage-parity.sh.
RUN --mount=type=bind,source=linux/scripts/01-core/apply-patch.sh,target=/opt/scripts/core/apply-patch.sh,ro \
    --mount=type=bind,source=linux/scripts/patches,target=/opt/scripts/patches,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/cerbero,sharing=locked,id=cerbero-state-${TARGET_ARCH}-abi${ANDROID_TARGET_ABI}-${ANDROID_LIB}-gst${GSTREAMER_VERSION}-ndk${ANDROID_NDK_VERSION}-api${ANDROID_API_LEVEL} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
        /opt/scripts/03-media/android-dispatch.sh "${ANDROID_LIB}"

# web-lane-tools: needs the amd64-hosted cross GCC, gone after final's swap. See docs/consumer-image-contract.md#building-the-web-lane-tools-from-source
FROM android-sdk AS web-lane-tools

ARG TARGET_ARCH
# The pins are part of the key, so the package stage refuses a producer that built others.
ARG WASM_PACK_VERSION=0.15.0
ARG FLUTTER_RUST_BRIDGE_VERSION=2.13.0
ARG WEB_LANE_TOOLS_CROSS_ARCHES=riscv64

# 01-core per file (WLT_CORE_FILES): android-sdk's /opt/scripts/core is an older copy.
RUN --mount=type=bind,source=linux/scripts/06-packaging/web-lane-tools.sh,target=/tmp/wlt/06-packaging/web-lane-tools.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-env.sh,target=/tmp/wlt/01-core/cross-env.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/platform.sh,target=/tmp/wlt/01-core/platform.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/ubuntu-mirror.sh,target=/tmp/wlt/01-core/ubuntu-mirror.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-gcc.sh,target=/tmp/wlt/01-core/cross-gcc.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-python.sh,target=/tmp/wlt/01-core/cross-python.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-apt.sh,target=/tmp/wlt/01-core/cross-apt.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/cross-meson.sh,target=/tmp/wlt/01-core/cross-meson.sh,ro \
    --mount=type=cache,target=/root/.cache/web-lane-tools,id=web-lane-tools-cross-${TARGET_ARCH},sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-web-lane-tools-${TARGET_ARCH},sharing=locked \
    --mount=type=tmpfs,target=/tmp/wlt-build \
    set -euo pipefail; \
    TMPDIR=/tmp/wlt-build bash /tmp/wlt/06-packaging/web-lane-tools.sh produce /opt/web-lane-tools

# final: aggregate the parallel stage outputs and swap in the native GCC
FROM android-sdk AS final

ARG TARGET_ARCH
ARG TARGETARCH
ARG BUILD_MODE
ARG GCC_VERSION=16.2.0

COPY --link --from=android-gstreamer /opt/android/gstreamer /opt/android/gstreamer
COPY --link --from=android-onnx /opt/android/onnxruntime /opt/android/onnxruntime
COPY --link --from=android-litert /opt/android/litert /opt/android/litert
COPY --link --from=android-opencv /opt/android/opencv /opt/android/opencv
COPY --link --from=android-iree /opt/android/iree /opt/android/iree

# Keep the cross Python staging tree; non-amd64 lanes swap in the target-native GCC.
COPY --chmod=755 linux/scripts/06-packaging/smoke-common.sh /opt/scripts/packaging/smoke-common.sh
COPY --chmod=755 linux/scripts/06-packaging/smoke-android.sh /opt/scripts/packaging/smoke-android.sh
COPY --chmod=755 linux/scripts/06-packaging/swap-native-gcc.sh /opt/scripts/packaging/swap-native-gcc.sh
RUN set -euo pipefail; \
    if [ -d /opt/python-cross ] && [ ! -f /opt/python-cross/.keep ]; then \
        touch /opt/python-cross/.keep; fi; \
    TARGET_ARCH="${TARGET_ARCH:-${TARGETARCH}}" \
    GCC_VERSION="${GCC_VERSION}" \
    BUILD_MODE="${BUILD_MODE}" \
    bash /opt/scripts/packaging/swap-native-gcc.sh

# A broken SDK/NDK fails the build here; the Vulkan smoke is not run, as no build stage has the full Vulkan SDK.
RUN set -euo pipefail; \
    bash /opt/scripts/packaging/smoke-android.sh

# Ensure /opt/llvm-target exists for downstream stages (package build expects it)
RUN mkdir -p /opt/llvm-target

# Last: above the GCC swap, a changed producer output would re-run that prefix-sized copy.
COPY --link --from=web-lane-tools /opt/web-lane-tools /opt/web-lane-tools

LABEL org.opencontainers.image.title="Kataglyphis Android" \
      org.opencontainers.image.description="Android SDK/NDK and cross-compiled Android artifacts layer"
