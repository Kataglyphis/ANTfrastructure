# syntax=docker/dockerfile:1.24.0

ARG BASE_IMAGE=local/kataglyphis:media
FROM ${BASE_IMAGE}

ARG BUILD_MODE=native
ARG TARGET_ARCH
ARG TARGETARCH
ARG TARGETPLATFORM
ARG BUILDARCH
ARG BUILDPLATFORM
ARG ENABLE_NVIDIA=false
ARG ENABLE_AMD=false

ARG ANDROID_SDK_VERSION=14742923
ARG ANDROID_NDK_VERSION=29.0.14206865
ARG ANDROID_COMPILE_SDK=36
ARG ANDROID_BUILD_TOOLS=35.0.0
ARG ANDROID_CMAKE_VERSION=4.1.2
ARG ANDROID_API_LEVEL=34
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_SDK_VERSION=${ANDROID_SDK_VERSION} \
    ANDROID_NDK_VERSION=${ANDROID_NDK_VERSION} \
    ANDROID_COMPILE_SDK=${ANDROID_COMPILE_SDK} \
    ANDROID_BUILD_TOOLS=${ANDROID_BUILD_TOOLS} \
    ANDROID_CMAKE_VERSION=${ANDROID_CMAKE_VERSION} \
    ANDROID_API_LEVEL=${ANDROID_API_LEVEL} \
    ANDROID_NDK_HOME=/opt/android-sdk/ndk/${ANDROID_NDK_VERSION} \
    ANDROID_NDK_ROOT=/opt/android-sdk/ndk/${ANDROID_NDK_VERSION} \
    GSTREAMER_ROOT_ANDROID=/opt/android/gstreamer \
    ONNXRUNTIME_ROOT_ANDROID=/opt/android/onnxruntime \
    LITERT_ROOT_ANDROID=/opt/android/litert \
    OPENCV_ROOT_ANDROID=/opt/android/opencv \
    BUILD_MODE=${BUILD_MODE} \
    TARGET_ARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETPLATFORM=${TARGETPLATFORM} \
    BUILDARCH=${BUILDARCH} \
    BUILDPLATFORM=${BUILDPLATFORM}

ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${ANDROID_HOME}/build-tools/${ANDROID_BUILD_TOOLS}:${ANDROID_NDK_HOME}:${PATH}"

COPY --chmod=755 linux/scripts/setup-android-sdk-ndk.sh /opt/scripts/setup-android-sdk-ndk.sh
COPY --chmod=755 linux/scripts/01-core/platform.sh /opt/scripts/core/platform.sh
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    bash /tmp/core-scripts/use-fast-ubuntu-mirror.sh
RUN set -eux; /opt/scripts/setup-android-sdk-ndk.sh

# Ensure the directories expected by downstream stages exist even when
# the Android SDK/NDK is skipped (non-amd64 host or no network).
RUN set -eux; \
    mkdir -p /opt/android-sdk /opt/android && \
    mkdir -p /opt/android/gstreamer /opt/android/onnxruntime /opt/android/litert /opt/android/opencv

COPY --chmod=755 linux/scripts/03-media/gstreamer/android /opt/scripts/media/gstreamer/android
COPY --chmod=755 linux/scripts/03-media/onnxruntime/android /opt/scripts/media/onnxruntime/android
COPY --chmod=755 linux/scripts/03-media/litert/android /opt/scripts/media/litert/android
COPY --chmod=755 linux/scripts/03-media/opencv/android /opt/scripts/media/opencv/android

RUN set -eux; \
        /opt/scripts/media/gstreamer/android/build-gstreamer.sh

RUN set -eux; \
        /opt/scripts/media/onnxruntime/android/build-android.sh && \
        /opt/scripts/media/litert/android/build-android.sh && \
        /opt/scripts/media/opencv/android/build-android.sh

# Preserve the cross-compiled Python staging tree from the base image.
# Without this, Dockerfile.package fails at COPY --from=artifact-source /opt/python-cross.
RUN if [ -d /opt/python-cross ] && [ ! -f /opt/python-cross/.keep ]; then \
        touch /opt/python-cross/.keep; \
    fi; \
    echo "android-cross ready"

# Swap the amd64-hosted GCC with the target-native GCC for non-amd64
# architectures. The native GCC was cross-compiled from source during the
# compiler image build (Canadian cross) and stored at /opt/gcc-*-native-<arch>/.
# This ensures /usr/bin/cc in the final runtime image is a native binary for
# every architecture, not an amd64 cross-compiler host binary.
ARG GCC_VERSION=16.1.0
RUN set -eux; \
    elf_machine_pattern() { \
        case "$1" in \
            amd64) printf '%s' "X86-64" ;; \
            arm64) printf '%s' "AArch64" ;; \
            riscv64) printf '%s' "RISC-V" ;; \
            386) printf '%s' "Intel 80386" ;; \
            *) return 1 ;; \
        esac; \
    }; \
    assert_elf_arch() { \
        local bin="$1" arch="$2" pat machine; \
        pat="$(elf_machine_pattern "${arch}")" || { echo "WARN: no ELF pattern for ${arch}; skipping" >&2; return 0; }; \
        command -v readelf >/dev/null 2>&1 || { echo "WARN: readelf missing; skipping ELF check" >&2; return 0; }; \
        machine="$(readelf -h "${bin}" 2>/dev/null | sed -n 's/^[[:space:]]*Machine:[[:space:]]*//p' | head -n1)"; \
        [ -n "${machine}" ] || { echo "ERROR: cannot read ELF machine of ${bin}" >&2; exit 1; }; \
        case "${machine}" in \
            *"${pat}"*) echo "ELF arch OK: ${bin} Machine='${machine}' matches ${arch}" ;; \
            *) echo "ERROR: ELF arch MISMATCH ${bin} Machine='${machine}' expected '${pat}' for ${arch}" >&2; exit 1 ;; \
        esac; \
    }; \
    if [ "${TARGET_ARCH}" != "amd64" ] && [ "${BUILD_MODE}" = "cross" ]; then \
        native_gcc="/opt/gcc-${GCC_VERSION}-native-${TARGET_ARCH}"; \
        if [ -d "${native_gcc}" ]; then \
            assert_elf_arch "${native_gcc}/bin/gcc" "${TARGET_ARCH}"; \
            assert_elf_arch "${native_gcc}/bin/g++" "${TARGET_ARCH}"; \
            rm -rf "/opt/gcc-${GCC_VERSION}"; \
            cp -a "${native_gcc}" "/opt/gcc-${GCC_VERSION}"; \
            assert_elf_arch "/opt/gcc-${GCC_VERSION}/bin/gcc" "${TARGET_ARCH}"; \
            echo "Replaced host GCC with target-native ${TARGET_ARCH} GCC at /opt/gcc-${GCC_VERSION}"; \
            case "${TARGET_ARCH}" in \
              arm64) gcc_target_triplet="aarch64-linux-gnu" ;; \
              riscv64) gcc_target_triplet="riscv64-linux-gnu" ;; \
              *) gcc_target_triplet="" ;; \
            esac; \
            if [ -n "${gcc_target_triplet}" ]; then \
              gcc_target_lib="/opt/gcc-${GCC_VERSION}/${gcc_target_triplet}/lib"; \
              system_multiarch_lib="/usr/lib/${gcc_target_triplet}"; \
              if [ ! -d "${gcc_target_lib}" ] || [ -z "$(ls -A ${gcc_target_lib} 2>/dev/null)" ]; then \
                rm -rf "${gcc_target_lib}"; \
                mkdir -p "$(dirname "${gcc_target_lib}")"; \
                ln -sf "${system_multiarch_lib}" "${gcc_target_lib}"; \
                echo "Linked GCC target lib ${gcc_target_lib} -> ${system_multiarch_lib}"; \
              fi; \
              gcc_target_include="/opt/gcc-${GCC_VERSION}/${gcc_target_triplet}/include"; \
              system_multiarch_include="/usr/include/${gcc_target_triplet}"; \
              if [ ! -e "${gcc_target_include}" ]; then \
                mkdir -p "$(dirname "${gcc_target_include}")"; \
                ln -sf "${system_multiarch_include}" "${gcc_target_include}"; \
                echo "Linked GCC target include ${gcc_target_include} -> ${system_multiarch_include}"; \
              fi; \
            fi; \
            echo "int main(){}" > /tmp/gcc_smoke.c; \
            if /opt/gcc-${GCC_VERSION}/bin/gcc /tmp/gcc_smoke.c -o /tmp/gcc_smoke 2>/tmp/gcc_smoke.err; then \
              file /tmp/gcc_smoke; \
              echo "GCC compile smoke test PASSED"; \
            else \
              echo "WARNING: native GCC cannot compile trivial program (cross-build host limitation)"; \
              cat /tmp/gcc_smoke.err 2>/dev/null || true; \
            fi; \
            rm -f /tmp/gcc_smoke.c /tmp/gcc_smoke /tmp/gcc_smoke.err; \
        else \
            echo "ERROR: expected target-native GCC at ${native_gcc} but not found" >&2; \
            echo "ERROR: Rebuild the toolchain image (build-cross-compiler.sh) to produce" >&2; \
            echo "ERROR: the Canadian cross GCC, then rebuild this android image." >&2; \
            exit 1; \
        fi; \
    elif [ "${TARGET_ARCH}" = "amd64" ]; then \
        assert_elf_arch "/opt/gcc-${GCC_VERSION}/bin/gcc" "amd64"; \
        echo "Using host-native amd64 GCC at /opt/gcc-${GCC_VERSION}"; \
    fi
