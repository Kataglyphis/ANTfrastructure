# =============================================================================
# Nextcloud AIO — .env example
# Copy this file to .env and fill in your values BEFORE starting.
#   cp .env.example .env
# =============================================================================

# ── Secrets & Passwords (generate with: openssl rand -base64 32) ────────────
DATABASE_PASSWORD=changeme
FULLTEXTSEARCH_PASSWORD=changeme
IMAGINARY_SECRET=changeme
NEXTCLOUD_PASSWORD=changeme           # Admin user "admin"
ONLYOFFICE_SECRET=changeme
RECORDING_SECRET=changeme
REDIS_PASSWORD=changeme
SIGNALING_SECRET=changeme
TALK_INTERNAL_SECRET=changeme
TURN_SECRET=changeme
WHITEBOARD_SECRET=changeme

# ── Domain ───────────────────────────────────────────────────────────────────
NC_DOMAIN=192.168.1.100               # ⚠  Change to your IP or domain

# ── Timezone ─────────────────────────────────────────────────────────────────
TIMEZONE=Europe/Berlin

# ── Optional Services (enable with "yes") ────────────────────────────────────
CLAMAV_ENABLED="no"
COLLABORA_ENABLED="no"
FULLTEXTSEARCH_ENABLED="no"
IMAGINARY_ENABLED="yes"
ONLYOFFICE_ENABLED="no"
TALK_ENABLED="yes"
TALK_RECORDING_ENABLED="no"
WHITEBOARD_ENABLED="no"

# ── Apache / Network ─────────────────────────────────────────────────────────
APACHE_IP_BINDING=0.0.0.0
APACHE_PORT=443
APACHE_MAX_SIZE=17179869184

# ── Nextcloud Container ──────────────────────────────────────────────────────
NEXTCLOUD_UPLOAD_LIMIT=16G
NEXTCLOUD_MAX_TIME=3600
NEXTCLOUD_MEMORY_LIMIT=512M
NEXTCLOUD_DATADIR=nextcloud_aio_nextcloud_data
NEXTCLOUD_MOUNT=/mnt/

NEXTCLOUD_STARTUP_APPS="deck twofactor_totp tasks calendar contacts notes"
NEXTCLOUD_ADDITIONAL_APKS=imagemagick
NEXTCLOUD_ADDITIONAL_PHP_EXTENSIONS=imagick

# ── Updates & Maintenance ────────────────────────────────────────────────────
UPDATE_NEXTCLOUD_APPS="yes"
REMOVE_DISABLED_APPS=yes
INSTALL_LATEST_MAJOR=no

# ── Talk (TURN/STUN) ─────────────────────────────────────────────────────────
TALK_PORT=3478

# ── Collabora ────────────────────────────────────────────────────────────────
COLLABORA_DICTIONARIES="de_DE en_GB en_US es_ES fr_FR it nl pt_BR pt_PT ru"
COLLABORA_SECCOMP_POLICY=--o:security.seccomp=true

# ── Full-Text Search ─────────────────────────────────────────────────────────
FULLTEXTSEARCH_JAVA_OPTIONS="-Xms512M -Xmx512M"

# ── Trusted CA certificates ──────────────────────────────────────────────────
NEXTCLOUD_TRUSTED_CACERTS_DIR=./ca-certs

# ── Logging ──────────────────────────────────────────────────────────────────
AIO_LOG_LEVEL=warn
