CROSS_CACHE_MAX_GB
CROSS_LAYER_COMPRESSION  # PUSH1: zstd (default) | gzip — layer encoding for pushed cross-stage images
PAR_INTRA_STEP_BUDGET    # PAR4: assumed concurrent heavy steps per build under --parallel-archs (default 2; multiplies BUILD_MEM_DIVISOR)
CROSS_TARGET_ARCH
CTEST_EXCLUDE_DEFAULT
CTEST_RUN_DEFAULT_BUILD_DIR
CTEST_RUN_DEFAULT_BUILD_TYPE
CTEST_RUN_DEFAULT_EXCLUDE
CTEST_RUN_USAGE_INTRO
DEB_BUILD_MULTIARCH
DEFAULT_MB_PER_JOB
DESKTOP_FILE
DOCS_BUILD_DOCS_DIR
DOCS_BUILD_GENERATOR_SCRIPT
DOCS_BUILD_PROJECT_ROOT
DOCS_BUILD_PYTHON
DOCS_BUILD_SOURCE_DIR
