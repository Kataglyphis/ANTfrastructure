FFMPEG_HOST_TOOLCHAIN_DIR
FLATPAK_MANIFEST
GCC_BUILD_MB_PER_JOB
GCC_CROSS_SCRATCH_ROOT
GCC_GPG_KEYS
GCC_VERSION_ENV
GITHUB_ENV
GITHUB_OUTPUT
