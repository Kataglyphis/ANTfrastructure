# lint-env-knobs.allow — the OPERATOR-KNOB REGISTRY (A1).
# Knobs consumed via ${VAR:-default} that are intentionally set ONLY by an
# operator/CI environment (never assigned in-repo). One per line.
# Inventoried 2026-08-17 from the live tree; curate on review: a knob that is
# neither documented usage NOR a real operator switch should be FIXED at its
# reader, not kept here. New unowned knobs fail the gate (KNOB_GATE=1) until
# either owned in-repo or added here WITH this file's review.
# Eleven rows are REDUNDANT rather than stale -- APP_UV_LOCK, ARTIFACT_CONTEXT_MODE,
# ARTIFACT_CONTEXT_ROOT, BUILDKIT_CACHE_DIR, CROSS_CONTEXT_ROOT, CROSS_DISK_GUARD_GB,
# CROSS_LOCAL_CONTEXT_HANDOFF, CROSS_NO_PUSH_FORCE, NO_COLOR, SHELLCHECK_CACHE_DIR,
# UBUNTU_SOURCES_ROOT are each consumed AND assigned in-repo, so the gate is green with
# or without them. Reviewed 2026-09-04 and KEPT: for most of them the in-repo assignment
# is a TEST FIXTURE setting the knob for one case, which documents nothing about the
# operator switch and vanishes with the fixture.
ACTIONLINT_CACHE_DIR
AGENTIC_EXECUTOR_MODEL
AGENTIC_PLANNER_MODEL
ANDROID_GSTREAMER_PER_JOB_MB
APPDATA_FILE
APP_ID
APP_RUNNER_ENABLE_SHADER_CLEAN
APP_RUNNER_SHADER_CLEAN_DIR
APP_RUNNER_SHADER_COMPILE_SCRIPT
APP_RUNNER_USAGE_INTRO
APP_UV_LOCK
ARCHITECTURES
ARCHIVE_DIR
ARCHIVE_NAME
ARTIFACT_CONTEXT_MODE
ARTIFACT_CONTEXT_ROOT
BASE_PARENT_IMAGE
BINARY
BINARY_FILE
BINARY_PATH
BINFMT_QEMU_DIR
BUILDKIT_CACHE_DIR
BUILDKIT_HOST
BUILD_DIR_DEFAULT
BUILD_TYPE_DEFAULT
CI_TESTS_LOG_FILE
CLANG_BUILD_MB_PER_JOB
CLANG_NUM_JOBS
CMAKE_BUILD_DEFAULT_ALLOW_PREBUILD_FAILURE
CMAKE_BUILD_DEFAULT_BUILD_DIR
CMAKE_BUILD_DEFAULT_CLEAN_BUILD_DIR
CMAKE_BUILD_DEFAULT_MB_PER_JOB
CMAKE_BUILD_DEFAULT_PRESET
CMAKE_BUILD_DEFAULT_SKIP_CONFIGURE
CMAKE_BUILD_DEFAULT_VULKAN_SETUP_SCRIPT
CMAKE_BUILD_USAGE_INTRO
CODE_QUALITY_CLANG_TIDY_FIX
CODE_QUALITY_CMAKE_SEARCH_ROOT
CODE_QUALITY_GCC_TOOLCHAIN_PROBE_DIR
CODE_QUALITY_PROJECT_ROOT
CODE_QUALITY_UV_INSTALL_REQUIREMENTS_SCRIPT
CODE_QUALITY_UV_VENV_CREATE_SCRIPT
CODE_QUALITY_VENV_DIR
COVERAGE_GCOVR_OUTPUT
COVERAGE_LLVM_HTML_DIR
CPP_HEAVY_MB_PER_JOB
