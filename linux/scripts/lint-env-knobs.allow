WORKSPACE
# Age threshold (hours, default 24) for _runtime_sweep_orphaned_contexts in
# 01-core/context-management.sh. Stage-context trees are only reclaimed once
# they are older than this, so a concurrent chain's young workdir is never
# robbed. Added 2026-08-27 after a 3.3 GB orphan from 2026-07-25 was found
# still on disk after 33 days.
RUNTIME_CONTEXT_KEEP_HOURS
# HarfBuzz source-build version for the OpenCV media deps
# (03-media/build/opencv/install-deps.sh). Not in versions.env because it is a
# build-local fallback, not a shipped pin.
HARFBUZZ_VERSION
# Compiler-cache size cap for the IREE build only
# (05-frameworks/torch/build-app-wheelhouse.sh). Named *_CCACHE_* for history;
# it now feeds SCCACHE_CACHE_SIZE. Default 64G — the LLVM rebuild is one-time.
IREE_CCACHE_MAXSIZE
# sccache log level for the IREE build only, kept from the 2026-08-26 ENOENT
# hunt. Default sccache=info. See SCC-DIAG-LEFTOVERS — this default should go
# back to quiet in the next no-build window.
IREE_SCCACHE_LOG
# mlc-z3-static wheel version for TVM's optional Z3 dependency
# (05-frameworks/tvm-python.sh). Cross builds force USE_Z3=OFF regardless.
PY_MLC_Z3_STATIC_VERSION
# Path to the sccache config baked into the base image (Dockerfile.base,
# 01-core/base-image.sh). Set once at image build; operators do not override it.
SCCACHE_CONF
# Advisory gate added 2026-08-27 with verify-manifest-freshness.sh: set to 0 to
# skip the post-create_manifest freshness assertion (index children == per-arch
# tags, one shared run-id). Read in build-runtime-manifest.sh.
MANIFEST_FRESHNESS_GATE
# Opt-in SLSA provenance + SBOM as OCI referrers on pushed cross-stage images
# (01-core/cross-stage-build.sh). Off by default — the SBOM scanner adds time.
BUILD_ATTEST
# Disk-space guard threshold in GB (build-cross-chain.sh). When free space in
# the buildcache dir drops below this after a stage, the guard LRU-prunes old
# cache exports. Default 40; set 0 to disable.
CROSS_DISK_GUARD_GB
# Override the --no-push multi-stage refusal (build-cross-chain.sh). Set to 1 to
# accept the stale-parent risk that BuildKit's OCI worker resolves FROM against
# the registry on local-only builds.
CROSS_NO_PUSH_FORCE
# --no-push OCI-layout handoff switch (01-core/cross-stage-build.sh, backlog C).
# Default 1: every stage built locally is exported and served to the child via
# --build-context <parent-tag>=oci-layout://<dir>, so FROM never hits the
# registry. Set 0 to revert to the pre-2026-08-30 refusal.
CROSS_LOCAL_CONTEXT_HANDOFF
# Age (hours) after which orphaned cross-flow.* workdirs are reclaimed at the
# next chain start (01-core/cross-stage-build.sh). Default 24; mirrors the
# runtime lane's RUNTIME_CONTEXT_KEEP_HOURS.
CROSS_CONTEXT_KEEP_HOURS
# Root for the per-run cross stage-context workdirs (01-core/cross-stage-
# build.sh). Default ${XDG_CACHE_HOME:-$HOME/.cache}/opencode/cross-stage-
# contexts. Transient: reclaimed at chain exit and on the age sweep.
CROSS_CONTEXT_ROOT
# Skip the inline registry cache-from/cache-to on push (01-core/cross-stage-
# build.sh). Set by the chain disk-guard when pruning could not clear the
# threshold — stops writing new inline cache, keeps reading what survived.
NO_CACHE_EXPORT

# Override the QNN SDK extraction directory (resolve_qnn_sdk in the ORT build
# lib, backlog QNN-LINUX). Default /tmp/qnn-sdk-extract; useful for testing
# with a persistent extract dir.
QNN_SDK_EXTRACT_DIR

# D4 preflight cache-export trim (build-cross-chain.sh / disk-guard.sh).
# CROSS_PREFLIGHT_TRIM=0 restores the pre-2026-08-31 behaviour (hint + abort).
CROSS_PREFLIGHT_TRIM
# Newest N cache-export slugs the trim must never remove. Default 3; the byte
# budget alone does NOT bound the trim. docs/build-cache-tiers.md
CROSS_TRIM_KEEP_SLUGS

# riscv64 venv parity: the docs-extra fallback fails the assemble step by
# default; APP_EXTRAS_REQUIRED=0 downgrades it to a warning.
APP_EXTRAS_REQUIRED
# In-stage disk watchdog sampling interval, seconds (build-cross-chain.sh).
CROSS_DISK_WATCH_SECS

# Not an operator switch: set by sourcing /etc/os-release inside the image, read
# by the smoke's UBUNTU_VERSION probe (06-packaging/smoke-runtime-image.sh).
VERSION_ID

# Optional override for the cargo version the toolchain smoke pins; defaults to
# RUST_VERSION, because cargo ships with the Rust toolchain and tracks it.
CARGO_VERSION

# --- 2026-09-04: re-homed when the OWNERS scan stopped counting comments ---
# Fifteen landed here; thirteen were given a `: "${NAME:=default}"` at their
# reader in the 2026-09-04 build window and their rows deleted with them. The
# two below are what is left.
# 1 skips the csound GStreamer dependency (03-media gstreamer pre-setup.sh /
# install-deps.sh, default 0; forced on for arm64+riscv64 anyway).
MEDIA_SKIP_CSOUND

# --- 2026-09-04: re-homed when the OWNER scan stopped counting quoted text ---
# All 45 were "owned" only by a NAME=value that sits inside an echo/err message,
# a usage line or a test-fixture argument. Each is a real ${NAME:-default}
# reader with no assignment anywhere in the repo.
# 1 ships the venv even though ffmpeg has unresolved libraries
# (06-packaging/setup-torch-venv.sh, default 0).
ALLOW_BROKEN_FFMPEG
# 1 accepts an empty wheelhouse — a deliberately wheel-less riscv64 image
# (03-media/runtime/verify-media-artifacts.sh, default 0).
ALLOW_EMPTY_APP_WHEELS
# 1 continues after a failed IREE build instead of failing the stage
# (05-frameworks/torch/build-app-wheelhouse.sh, default 0).
ALLOW_IREE_BUILD_FAIL
# 1 knowingly ships an image without torch; a sentinel is written and the smoke
# accepts it (06-packaging/setup-torch-venv.sh + smoke-runtime-image.sh, 0).
ALLOW_TORCHLESS_RUNTIME
# 0 downgrades the parent-digest ancestry refusal to a warning
# (01-core/runtime-build-fns.sh, default 1).
ANCESTRY_STAMP_ENFORCE
# Not ours: ccache's own variable, inherited from the image environment.
# lib/cmake-build.sh only sanity-checks it for a URL and unsets it otherwise.
CCACHE_SECONDARY_STORAGE
# 0 disables the in-stage disk watchdog (build-cross-chain.sh, default 1).
CROSS_DISK_WATCH
# DISK1: 0 disables the guard's filtered buildkit-store fallback
# (01-core/disk-guard.sh, default 1).
CROSS_BUILDKIT_PRUNE
# DISK1: GB of type==regular layer cache the fallback keeps (default 120; a
# non-zero value under the 100 GB churn floor is raised, 0 prunes all of it).
CROSS_BUILDKIT_KEEP_GB
# GB the runtime-lane disk gate demands per concurrent wrapper build
# (build-cross-chain.sh, default 120; 0 disables the gate).
CROSS_RUNTIME_LANE_GB
# 1 makes an incomplete CUDA stack fatal instead of advisory
# (01-core/verify-cuda-stack.sh, default 0).
CUDA_STACK_STRICT
# 0 skips the fail-fast disk preflight (build-cross-chain.sh, default 1).
DISK_PREFLIGHT
# 1 downgrades both disk gates to warnings and keeps the warm cache
# (build-cross-chain.sh, default 0).
FORCE_LOW_DISK
# 1 rebuilds a media component already installed in the image (gstreamer,
# ffmpeg, opencv, litert; default 0).
FORCE_REBUILD
# 1 accepts a GCC tarball whose SHA512 could not be fetched
# (02-toolchain/build-gcc.sh, default 0).
GCC_ALLOW_UNVERIFIED_TARBALL
# 1 refuses to build GCC without GPG verification (build-gcc.sh, default 0).
GCC_REQUIRE_GPG
# Memory budget per GStreamer compile job, MB (build-gstreamer-monorepo.sh,
# default 2500) — feeds the mem-capped JOBS computation.
GSTREAMER_MB_PER_JOB
# true (default) attempts every gst-plugins-rs plugin, including the Rust
# cross-builds on riscv64.
GST_RS_BUILD_ALL
# 1 keeps the LiteRT source tree after the build
# (03-media/build/litert/build-litert.sh, default 0).
KEEP_SOURCES
# 1 keeps /opt/wheels in the final torch image (setup-torch-venv.sh, default 0).
KEEP_WHEELHOUSE
# 1 makes the post-create_manifest freshness check fatal
# (build-runtime-manifest.sh, default 0 = advisory).
MANIFEST_FRESHNESS_STRICT
# 0 downgrades the core ELF-architecture gate to a warning
# (03-media/runtime/validate-media-runtime.sh, default 1).
MEDIA_ELF_MISMATCH_FATAL
# 1 accepts a PNG-less riscv64 OpenCV (WITH_PNG=OFF) instead of failing
# (03-media/build/opencv/build-opencv.sh, default 0).
OPENCV_ALLOW_NO_PNG
# 1 restores the hard fail on a failed onnxruntime-web/WASM build
# (03-media/build/onnxruntime/build/*, default 0 = best-effort).
ORT_WEB_REQUIRED
# true skips the apt packaging prerequisites
# (02-toolchain/packaging-deps.sh, default false).
PACKAGING_DEPS_SKIP_APT_INSTALL
# 1 makes probe-sccache.sh exit non-zero when any compiler probe failed
# (02-toolchain/probe-sccache.sh, default 0 = report only).
PROBE_STRICT
# 0 disables the CPU/RAM/disk sampler both orchestrators start
# (lib-orchestrator.sh, default 1).
RESOURCE_MONITOR
# 0 skips the functional half of the runtime-image smoke
# (06-packaging/smoke-runtime-image.sh, default 1).
RUNTIME_FUNCTIONAL_SMOKE
# 0 disables the manifest one-generation coherence gate
# (build-runtime-manifest.sh, default 1).
RUNTIME_MANIFEST_COHERENCE
# 0 disables the manifest completeness gate that refuses to shrink a published
# index (build-runtime-manifest.sh, default 1).
RUNTIME_MANIFEST_COMPLETENESS
# 0 skips the QEMU binfmt registration before the foreign-arch wrapper builds
# (build-runtime-manifest.sh, default 1).
RUNTIME_REGISTER_BINFMT
# 0 disables salvaging local cache exports after a failed stage
# (01-core/cross-stage-build.sh, default 1).
SALVAGE_CACHE_EXPORT
# true skips install_core_tools; the LLVM RUN layer builds with it set
# (02-toolchain/setup-dependencies.sh, default false).
SETUP_DEPENDENCIES_SKIP_CORE_TOOLS
# 1 makes a missing /opt/venv interpreter fatal for stages where the venv is
# mandatory (06-packaging/smoke-torch-venv.sh, default 0).
STV_REQUIRE_VENV
# 1 restricts validate-compilers.sh to ELF checks, for a target-native cc that
# cannot execute on the build host (default 0).
VALIDATE_CC_STATIC_ONLY
# 0 skips the venv byte-compile (06-packaging/setup-torch-venv.sh, default 1).
VENV_COMPILE
# 1 promotes a wrong-SOABI native extension in a wheel to fatal
# (03-media/runtime/verify-wheels.sh, default 0 = warn).
WHEEL_SOABI_STRICT
# 0 makes every verify-shipped-wrapper.sh content mismatch advisory (default 1).
WRAPPER_CONTENT_GATE
# Not operator switches — fixture knobs read by the stub functions that
# test-cross-stage-build-cmd.sh injects; its helpers pass them as NAME=value
# words (build return code, disk verdict, pinned-base verdict, transient-push
# verdict).
BUILD_RC
DISK_OK
HAS_PINNED_BASE
TRANSIENT
# Not an operator switch: the sentinel test-module-resolution.sh printf-writes
# into a fixture lib/common.sh to prove the wrong module was sourced.
MODRES_POISON_SOURCED
# Not operator switches: generated probe scripts injected into the smoke
# container as -e NAME="$(...)" by 06-packaging/smoke-runtime-image.sh and read
# by the in-container bash -lc probe.
RT_PROBE_SH
RT_TREE_PY
SMOKE_ONNX_PY
# Not an operator switch: set on the in-container command line by
# smoke-runtime-image.sh (bash -lc 'STV_ASSERT_ONLY=1 ...') to run only the
# version-pin assertion of smoke-torch-venv.sh.
STV_ASSERT_ONLY
# The release version CI exports: 02-toolchain/rust/version_util.sh writes it to
# $GITHUB_ENV/$GITHUB_OUTPUT, 06-packaging/package_archive.sh reads it.
VERSION
