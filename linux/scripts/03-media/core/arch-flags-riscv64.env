# linux/scripts/03-media/core/arch-flags-riscv64.env
#
# Per-target-arch media build skip flags for riscv64 CROSS builds.
# Loaded by media_load_arch_flags() in 03-media/core/common.sh.
# Format: KEY=value lines only (shell-safe; the file is sourced by bash).
# 1 = skip, 0/unset = do not skip.

# Ubuntu Ports cannot satisfy the GLib helper dependency chain for the target
# libcairo2-dev / libpango1.0-dev / libgdk-pixbuf-2.0-dev packages on riscv64.
MEDIA_SKIP_CAIRO_PANGO_PIXBUF=1

# Ubuntu Ports has broken dependencies for libc++-21-dev, so the target
# libc++-dev / libc++abi-dev packages cannot be installed on riscv64.
MEDIA_SKIP_LIBCXX_DEV=1

# Ubuntu Ports cannot satisfy the helper dependency chain for the target
# GLib/GTK/introspection/cairo dev packages (libcairo2-dev, libglib2.0-dev,
# libgirepository1.0-dev, gir1.2-gstreamer-1.0, libjson-glib-dev,
# libgtk-4-dev). This flag also gates the matching GTK/json-glib RUNTIME
# packages in the final image: the riscv64 GStreamer build skips the
# GTK/json-glib dependent plugins, so installing the runtime packages there
# only adds target-side postinst noise without enabling shipped functionality.
MEDIA_SKIP_GLIB_STACK=1

# Ubuntu Ports cannot satisfy the GLib helper dependency chain for the target
# GTK dev packages (libgtk-3-dev / libgtk-4-dev) on riscv64.
MEDIA_SKIP_GTK_DEV=1

# RETIRED 2026-09-01: libgudev-1.0-dev resolves and really installs on resolute
# riscv64; the skip cost the uvch264/uvcgadget plugins. The install is `|| true`,
# so a regression degrades to today's behaviour. docs/refactoring-backlog.md
MEDIA_SKIP_GUDEV=0

# The GStreamer build disables/excludes the Csound plugin on RISC-V cross
# targets, so target Csound packages (and the csound.pc stub) are skipped.
# NOTE: not a package-availability problem — libcsound64-dev resolves and
# installs on resolute riscv64. See build-gstreamer-monorepo.sh.
MEDIA_SKIP_CSOUND=1
