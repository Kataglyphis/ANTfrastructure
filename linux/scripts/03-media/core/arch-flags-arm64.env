# linux/scripts/03-media/core/arch-flags-arm64.env
#
# Per-target-arch media build skip flags for arm64 CROSS builds.
# Loaded by media_load_arch_flags() in 03-media/core/common.sh.
# Format: KEY=value lines only (shell-safe; the file is sourced by bash).
# 1 = skip, 0/unset = do not skip.

# arm64 Ubuntu Ports can satisfy the GLib/GTK/cairo helper dependency chains,
# so none of the package-stack skips that riscv64 needs apply here.
MEDIA_SKIP_CAIRO_PANGO_PIXBUF=0
MEDIA_SKIP_LIBCXX_DEV=0
MEDIA_SKIP_GLIB_STACK=0
MEDIA_SKIP_GTK_DEV=0
MEDIA_SKIP_GUDEV=0

# The GStreamer build disables/excludes the Csound plugin on ARM cross
# targets, so target Csound packages (and the csound.pc stub) are skipped.
MEDIA_SKIP_CSOUND=1
