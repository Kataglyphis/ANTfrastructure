# Frozen 2026-09-03: shell functions the scanner sees no caller for. Two-way:
# a frozen function that gains a caller in the corpus, or is deleted, is STALE.
# Each group names the dispatch the scanner cannot see. Format: <file>\t<function>.
# docs/code-quality-tooling.md#dead-shell-functions-dead-functions

# Library API. linux/scripts/lib/*.sh are sourced by wrapper scripts in the
# consumer repos (docs/shared-script-libraries.md); the callers are not in this
# tree. run/init/complete_agentic_loop are called from
# shared/agentic-loop/templates/Run-AgenticLoop.sh (outside the corpus);
# get_matrix_entry_name is the documented backward-compatible entry
# (docs/agentic-loop-build-matrix.md).
linux/scripts/lib/agentic-loop.sh	complete_agentic_loop
linux/scripts/lib/agentic-loop.sh	get_matrix_entry_name
linux/scripts/lib/agentic-loop.sh	init_agentic_loop
linux/scripts/lib/app-runner.sh	app_runner_main
linux/scripts/lib/cmake-build.sh	cmake_build_main
linux/scripts/lib/code-quality.sh	code_quality_check_clang_format
linux/scripts/lib/code-quality.sh	code_quality_cleanup_compile_db
linux/scripts/lib/code-quality.sh	code_quality_ensure_cmake_format
linux/scripts/lib/code-quality.sh	code_quality_find_clang_tidy_files
linux/scripts/lib/code-quality.sh	code_quality_find_cmake_files
linux/scripts/lib/code-quality.sh	code_quality_find_cpp_files
linux/scripts/lib/code-quality.sh	code_quality_prepare_compile_db
linux/scripts/lib/code-quality.sh	code_quality_run_clang_format
linux/scripts/lib/code-quality.sh	code_quality_run_clang_tidy
linux/scripts/lib/code-quality.sh	code_quality_run_cmake_format
linux/scripts/lib/coverage.sh	coverage_llvm_generate_profile
linux/scripts/lib/coverage.sh	coverage_llvm_report
linux/scripts/lib/coverage.sh	coverage_run_gcovr
linux/scripts/lib/ctest-run.sh	ctest_run_main
linux/scripts/lib/docs-build.sh	docs_build_main
linux/scripts/lib/rust-toolchain.sh	ensure_wasm32_target
linux/scripts/lib/wasm-opt.sh	wasm_opt_optimize

# uv primitive for the downstream Python CI drivers (docs/python-ci.md, Trap 2
# names it as an entry point next to uv_sync_project); callers are consumer repos.
linux/scripts/01-core/python_uv.sh	uv_pip_install_requirements

# Dynamic dispatch: verify-parity.sh runs "check_${check_name}" over CHECK_LIST.
# check_python joined its five siblings on 2026-09-05: smoke-toolchain.sh defines a
# check_python of its own, so the name table read this one as used until the
# unlinked-definer arm proved the two files never meet (backlog GH6).
linux/scripts/06-packaging/verify-parity.sh	check_files
linux/scripts/06-packaging/verify-parity.sh	check_imports
linux/scripts/06-packaging/verify-parity.sh	check_libs
linux/scripts/06-packaging/verify-parity.sh	check_packages
linux/scripts/06-packaging/verify-parity.sh	check_python
linux/scripts/06-packaging/verify-parity.sh	check_versions

# bash hook: bash itself calls it when a command is not found.
linux/scripts/tests/test-harness.sh	command_not_found_handle
