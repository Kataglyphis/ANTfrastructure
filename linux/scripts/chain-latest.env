# chain-latest.sh settings. Each value can be overridden from the environment (:= keeps the caller's value).
: "${CHAIN_UNIT:=chain-latest-3arch}"
: "${CHAIN_ARCHES:=amd64,arm64,riscv64}"
# base = the full chain (base, package, runtime). runtime = the runtime lane alone, on the existing layer cache.
: "${CHAIN_FROM_STAGE:=base}"
: "${CHAIN_REF:=origin/develop}"
: "${CHAIN_RUNTIME_MAX:=14h}"
# A floor to start: the runtime lane gate asks ~415G for three fresh arches at its entry and trims toward it there.
: "${CHAIN_MIN_FREE_GB:=150}"
# MemAvailable at start. The run's memory is sampled into <log>.mem.tsv, so the next profile can be sized from it.
: "${CHAIN_MIN_MEM_GB:=20}"
# One arch per process. The build host has 32 cores and 60 GB RAM. The job pools of the concurrent builds
# share that RAM through BUILD_MEM_DIVISOR = min(arches, MAX_PARALLEL_ARCHS) x PAR_INTRA_STEP_BUDGET (PAR4).
: "${MAX_PARALLEL_ARCHS:=3}"
: "${PAR_INTRA_STEP_BUDGET:=6}"
: "${PUSH_MAX_ATTEMPTS:=8}"
: "${RUNTIME_GATE_JOBS:=3}"
