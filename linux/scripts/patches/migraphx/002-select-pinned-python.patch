+        OUTPUT_VARIABLE _config_suffix RESULT_VARIABLE _config_suffix_result)
+    execute_process(COMMAND "${_selected_python_config}" --includes
+        OUTPUT_VARIABLE _config_includes RESULT_VARIABLE _config_includes_result)
