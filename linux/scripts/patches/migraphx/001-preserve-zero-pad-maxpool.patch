Preserve explicit zero padding before MaxPool on negative inputs

Zero is not the identity of max pooling; folding it into implicit padding
changes boundary values. Keep that Pad explicit, preserving convolution,
im2col and the existing other-pooling policies.

Upstream source: ROCm/AMDMIGraphX 95672916ed289d4be9d230a9be732e1bbad97e8c.
This patch retains the upstream MIT-licensed source and its notice.

The upstream structural expectation keeps the Pad for MaxPool, and a negative
input regression checks actual evaluated boundary values. The reusable pass
probe compiles original and patched source with the same updated test object;
backend, GPU and finished-package acceptance remain separate.

--- a/src/eliminate_pad.cpp
+++ b/src/eliminate_pad.cpp
@@ -68,7 +68,7 @@
 static void update_pooling(const instruction_ref& input, const instruction_ref& ins, module& m)
 {
     auto op = any_cast<op::pooling>(ins->get_operator());
-    if(op.mode == op::pooling_mode::average)
+    if(op.mode == op::pooling_mode::average or op.mode == op::pooling_mode::max)
     {
         return;
     }
--- a/test/eliminate_pad_test.cpp
+++ b/test/eliminate_pad_test.cpp
@@ -95,9 +95,10 @@

     EXPECT(op0["padding"].to_vector<std::size_t>() == std::vector<std::size_t>{1, 1, 1, 1});
     EXPECT(om1["padding"].to_vector<std::size_t>() == std::vector<std::size_t>{1, 1, 1, 1});
-    EXPECT(om2["padding"].to_vector<std::size_t>() == std::vector<std::size_t>{1, 1, 1, 1});
-
-    EXPECT(std::none_of(
+    EXPECT(om2["padding"].to_vector<std::size_t>() == std::vector<std::size_t>{0, 0, 0, 0});
+    EXPECT(l2->inputs().front() == padded_img);
+
+    EXPECT(std::any_of(
         m.begin(), m.end(), [](const migraphx::instruction& ins) { return ins.name() == "pad"; }));
 }

@@ -127,6 +128,24 @@
     run_pass(m);
     EXPECT(std::none_of(
         m.begin(), m.end(), [](const migraphx::instruction& ins) { return ins.name() == "pad"; }));
+}
+
+TEST_CASE(eliminate_pad_zero_max_negative)
+{
+    migraphx::module m;
+    migraphx::shape shape{migraphx::shape::float_type, {1, 1, 2, 2}};
+    std::vector<float> input{-1.0f, -2.0f, -3.0f, -4.0f};
+    auto image = m.add_literal(migraphx::literal{shape, input});
+    auto padded = m.add_instruction(
+        migraphx::make_op("pad", {{"pads", {0, 0, 0, 0, 0, 0, 1, 1}}}), image);
+    auto output = m.add_instruction(
+        migraphx::make_op("pooling", {{"mode", migraphx::op::pooling_mode::max},
+                                    {"lengths", {2, 2}}, {"stride", {1, 1}}}), padded);
+    m.add_return({output});
+    run_pass(m);
+    std::vector<float> results;
+    output->eval().visit([&](auto values) { results.assign(values.begin(), values.end()); });
+    EXPECT(results == std::vector<float>{-1.0f, 0.0f, 0.0f, 0.0f});
 }

 TEST_CASE(eliminate_pad_nonzero_pad)
