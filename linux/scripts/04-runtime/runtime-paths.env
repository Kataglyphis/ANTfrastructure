# runtime-paths.env - Canonical runtime path settings for the package/wrapper image.
# These should match the ENV blocks in Dockerfile.package (package stage) and
# Dockerfile.media (final stage).  When adding a new library, add its paths here
# AND in both Dockerfiles.
#
# Sourced by verify-runtime-paths.sh for consistency checking.

# Library output directories (must match versions.env)
GCC_PREFIX=/opt/gcc-\${GCC_VERSION:-16.2.0}
OPENCV_PREFIX=\${OPENCV_OUTPUT_DIR:-/opt/opencv5}
GSTREAMER_PREFIX=\${GSTREAMER_PREFIX:-/opt/gstreamer}
FFMPEG_PREFIX=/opt/ffmpeg
LIBCAMERA_PREFIX=/opt/libcamera
VULKAN_SDK=/opt/vulkan/active

# PATH components (order matters - earlier wins)
PATH_VULKAN=/opt/vulkan/active/bin
PATH_GSTREAMER=/opt/gstreamer/bin
PATH_OPENCV=/opt/opencv5/bin
PATH_LIBCAMERA=/opt/libcamera/bin
PATH_FFMPEG=/opt/ffmpeg/bin
PATH_UV_VENV=/opt/python/.venv/bin
PATH_GCC=/opt/gcc-\${GCC_VERSION:-16.2.0}/bin
PATH_CARGO=/usr/local/cargo/bin
# RP6: /root/.local/bin intentionally NOT in the shipped runtime PATH — the
# final image runs as uid-1001 (kataglyphis) and /root is 0700, so this entry
# was always dead AND a PATH-hijack precondition if /root perms ever loosened.
# Base (Dockerfile.base) keeps it: base builds run as root and install there.

# LD_LIBRARY_PATH components
LD_VULKAN=/opt/vulkan/active/lib
LD_USR_LOCAL=/usr/local/lib
LD_GSTREAMER_LIB=/opt/gstreamer/lib/multiarch
LD_GSTREAMER=/opt/gstreamer/lib
LD_OPENCV_LIB=/opt/opencv5/lib
LD_OPENCV_LIB64=/opt/opencv5/lib64
LD_LIBCAMERA_LIB=/opt/libcamera/lib
LD_LIBCAMERA_LIB64=/opt/libcamera/lib64
LD_FFMPEG_LIB=/opt/ffmpeg/lib
LD_FFMPEG_LIB64=/opt/ffmpeg/lib64
LD_GCC_LIB64=/opt/gcc-\${GCC_VERSION:-16.2.0}/lib64
LD_GCC_LIB=/opt/gcc-\${GCC_VERSION:-16.2.0}/lib

# PKG_CONFIG_PATH components
PC_USR_LOCAL=/usr/local/lib/pkgconfig
PC_GSTREAMER=/opt/gstreamer/lib/multiarch/pkgconfig
PC_OPENCV=/opt/opencv5/lib/pkgconfig
PC_LIBCAMERA_LIB=/opt/libcamera/lib/pkgconfig
PC_LIBCAMERA_LIB64=/opt/libcamera/lib64/pkgconfig
PC_FFMPEG=/opt/ffmpeg/lib/pkgconfig

# GStreamer plugin paths
GST_PLUGIN_PATH_MAIN=/opt/gstreamer/lib/multiarch/gstreamer-1.0
GST_PLUGIN_PATH_LIBCAMERA=/opt/libcamera/lib/gstreamer-1.0

# GObject introspection
GI_TYPELIB_PATH=/opt/gstreamer/lib/multiarch/girepository-1.0

# Library search path (linker)
LIBRARY_PATH_GCC_LIB64=/opt/gcc-\${GCC_VERSION:-16.2.0}/lib64
LIBRARY_PATH_GCC_LIB=/opt/gcc-\${GCC_VERSION:-16.2.0}/lib

# Other
GDK_BACKEND=x11
VK_LAYER_PATH=/opt/vulkan/active/etc/vulkan/explicit_layer.d
