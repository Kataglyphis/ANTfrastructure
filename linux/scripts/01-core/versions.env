# noforward
CUDA_KEYRING_DEB_SHA256_SBSA=bf74da243be6737d338a8e6f03469eb983825bba7b6dbd0b6d6a6f60229cbb6e
# AMD ROCm apt signing key (TheRock distribution, stable.repo.amd.com):
#   curl -fL https://stable.repo.amd.com/rocm/gpg/packages.gpg | sha256sum
