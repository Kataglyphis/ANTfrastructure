# --- ruff (python lint gate) ---
# Bootstrapped on demand by linux/scripts/lint-python.sh via `uvx ruff@PIN`
# when ruff is not already on PATH; no image installs it, hence noforward.
# C4 rider (2026-08-24). The hub side is ONE place, closed for real on
# 2026-09-09. The 2026-08-26 pass replaced lint-python.sh's RUFF_PIN="0.14.4"
# literal with RUFF_PIN="${RUFF_VERSION:-0.16.4}" and called it closed — but a
# `:-` fallback IS a second literal, and the only thing holding it to this key
# was verify-arg-consistency.sh's script-default scan, which announces itself
# "(advisory)" and exits 0 (29 WARN drift lines on this tree, measured
# 2026-09-09, none of them RUFF because the two numbers happened to agree). The
# fallback is gone: lint-python.sh reads this key through the safe loader and
# refuses to run when it is missing, the same `:?` contract SYFT_VERSION below
# got the same day.
#
# It is still THREE places family-wide, and the other two are outside this
# repo: a Python consumer repeats the pin in its own pyproject.toml
# (`"ruff==..."`) and .pre-commit-config.yaml (`rev:`), because neither
# uv nor pre-commit can read a versions.env. That hand-sync HAS drifted —
# OrchestrANT sat on 0.15.21 while the Linux lane graded with 0.16.4, so the
# same tree passed locally and failed in CI on rules that moved in between.
# Those two ARE detected now, and by something that runs: sync_versions.py's
# consumer-pin check (CONSUMER_PIN_ROWS) reads both files out of a NAMED
# consumer checkout, and run-lint-gates.sh calls it with `--consumer-pins` as
# its own gate — so it runs on every push and PR of a consumer that uses the
# fleet's lint lane, over that consumer's tree. It does NOT run in this repo's
# own preflight, which has no consumer around it and says "NOT CHECKED" rather
# than passing. It cannot REPAIR them either — this repo does not own a
# consumer's files — so a bump here is still a two-repo commit, which is also
# why bump_versions.py keeps this key REPORT-only.
# The SOURCE OF TRUTH had no annotation until 2026-09-10, so Renovate saw
# the CONSUMER copies and not this key: it reported "ruff ==0.16.4 ->
# ==0.16.6" against OrchestrANT's pyproject.toml and said nothing about
# the pin that file is REQUIRED to match. pypi, not github-tags: this key
# carries the bare 0.16.4 that PyPI and the consumer's `ruff==` pin both
# use, while astral-sh/ruff tags it v0.16.4.
# renovate: datasource=pypi depName=ruff
# noforward
RUFF_VERSION=0.16.8

# --- gitleaks (secret-scan gate) ---
# Bootstrapped on demand by linux/scripts/lint-secrets.sh when gitleaks is not
# already on PATH; no image installs it, hence noforward. Bump the version and
# BOTH checksums together. The SHA256s are GitHub's server-computed per-asset
# digests, cross-checked against the release's own checksums file:
#   curl -fL https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_checksums.txt
# Upstream names the x86_64 asset "x64" and the aarch64 one "arm64"; the key
# names below mirror the asset names so a bump is a mechanical substitution.
# renovate: datasource=github-releases depName=gitleaks/gitleaks extractVersion=^v(?<version>.*)$
# noforward
GITLEAKS_VERSION=8.30.1
# noforward
GITLEAKS_LINUX_X64_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
# noforward
GITLEAKS_LINUX_ARM64_SHA256=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080

# --- syft (SBOM scanner; linux/scripts/scan-image-sbom.sh) ---
# Bootstrapped on demand through anchore's install.sh when syft is not already
# on PATH; no image installs it, hence noforward.
# This value lived as a `SYFT_VERSION="v1.20.0"` literal inside that script
# until 2026-09-09 — in a file whose own header says the tag it scans is
# "pinned in ONE place: versions.env" — so the one tool that decides WHAT WE
# SAY WE SHIP was the one pin no `# renovate:` annotation could reach and no
# bump sweep could see. The literal is carried over unchanged: this moves where
# the pin lives, not which syft runs. Keep the leading `v`; upstream tags carry
# it and install.sh is handed this string verbatim.
# renovate: datasource=github-releases depName=anchore/syft
# noforward
SYFT_VERSION=v1.52.0

# --- appimagetool (AppImage packaging; packaging-deps.sh ensure_appimagetool) ---
# TS1: pinned to an IMMUTABLE release tag — never `continuous`, which
# re-uploads its assets in place (upstream drift once presented as a
# tamper-shaped checksum mismatch; see the 2026-08-15 note in
# packaging-deps.sh). SHA256s are GitHub's server-computed per-asset digests
# for the 1.9.1 assets, one per supported host arch. Bump the version and ALL
# FOUR SHAs together (bump_versions.py spec_appimagetool refreshes them).
# TS1 rider (2026-08-24): packaging-deps.sh still carries these same values as
# case-arm literals and reads only APPIMAGETOOL_VERSION from its env — and the
# version key IS live there (its RUNs bind-mount 01-core incl. this file;
# common.sh load_versions_env exports it), so bumping the version WITHOUT the
# consumer's sha literals makes ensure_appimagetool download the new asset and
# fail its checksum verify LOUDLY. Keep all five values equal to the
# packaging-deps.sh literals until the consumer reads the *_SHA256 keys (see
# the pin-bump report); report-tier in bump_versions.py until then.
# renovate: datasource=github-releases depName=appimage/appimagetool extractVersion=^(?<version>\d+\.\d+\.\d+)$
APPIMAGETOOL_VERSION=1.9.1
APPIMAGETOOL_X86_64_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
APPIMAGETOOL_AARCH64_SHA256=f0837e7448a0c1e4e650a93bb3e85802546e60654ef287576f46c71c126a9158
APPIMAGETOOL_ARMHF_SHA256=42b61cba5495d8aaf418a5c9a015a49b85ad92efabcbd3c341f1540440e4e23d
APPIMAGETOOL_I686_SHA256=7ad9ff47c203aae0149b18f6df9e3018b2e2f470ea644a0413e3ded39e9e3bdb

# --- curl|sh installer pins (rustup, uv) ---
# install-rust.sh downloads https://sh.rustup.rs to a file and, when this key
# is non-empty, verifies its sha256 before executing it. Upstream rotates the
# script without notice, so empty = skip verification (the default). To pin
# deliberately: download, review, then record the hash:
#   curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sha256sum
# noforward
# Rotated 2026-09-01 (rustup-init 1.29.0 -> 1.29.1). Verified before bumping:
# the script sh.rustup.rs serves is byte-identical to rust-lang/rustup's own
# rustup-init.sh except for ONE line, the version banner (929/930 lines match).
# Re-do that comparison on the next rotation; never bump this on 'it looks ok'.
RUSTUP_INIT_SHA256=7d0ea0f8eba7fa1ebfe998091cd7ec4501e33ec5ca6b884eb4d894d7da5170af
# Same optional pin for the uv installer executed by 01-core/python_uv.sh
# (uv_ensure_installed). Empty = skip (upstream rotates the script with each
# uv release):
#   curl --proto '=https' --tlsv1.2 -fsSL https://astral.sh/uv/install.sh | sha256sum
# noforward
UV_INSTALL_SH_SHA256=a7e3924ea1cd06bf1518c577d635c624ae2e2db030e0fc8ff8cf426224384e17

# --- Flutter web: sqlite3.wasm ---
# drift/sqlite3.dart ships the WASM build as a release asset, and a Flutter web
# app that uses sqlite cannot start without it. Two consumers had copied the
# same 16-line fetcher and already disagreed on the version (OmniAccelerANT
# 3.3.1, jotrockenmitlocken 3.2.0), and NEITHER verified what it downloaded --
# an unauthenticated binary that then runs in every visitor's browser. The
# newer of the two is pinned here; the SHA256 is of the asset itself, measured
# 2026-09-08. Consumer entry point:
# linux/scripts/05-frameworks/flutter/setup-sqlite3-wasm.sh <consumer-root>
SQLITE3_WASM_VERSION=3.3.1
SQLITE3_WASM_SHA256=3c616bf0d51380daaed7871b3110a634a17c703c22d82cba7a2a73216769e680

# --- WebDavClient -----------------------------------------------------------
# The owner's own WebDAV client, installed from git (it is not on PyPI) by both
# halves of the downloader: 01-core/webdav-download.sh on Linux and
# WindowsWebDav.Common.psm1 on Windows. Pinned because an unpinned
# `git+https://.../WebDavClient` installs whatever the default branch was that
# day, which makes "which client did this run use" unanswerable -- and one
# consumer had already pinned it privately while the hub's two call sites had
# not, so the three could disagree. This is the commit that consumer pinned.
WEBDAVCLIENT_REF=4f3f116d9ce7d1e223894513b4dc7a90b5085a9f

# --- Renovate, run LOCALLY as a CLI (linux/scripts/renovate-local.sh) --------
# The owner directive of 2026-09-09: dependency upgrades across the family are
# driven by Renovate run locally, not by the hosted GitHub App. The App is still
# not installed anywhere; these two pins are what makes the local route
# reproducible instead of "whatever npm resolved that day".
#
# A SECOND node pin, deliberately NOT the canonical NODE_VERSION above. Renovate
# 44.71.0 declares engines.node "^24.11.0" -- major 24 only -- while the images
# ship 26.8.1, so one name cannot serve both. Naming this one NODE_VERSION would
# also mean the last assignment in this file won for every script that sources it.
# It dies on Node 22 with `TypeError: RegExp.escape is not a function`, an error
# that names nothing relevant, so the pin is load-bearing rather than hygiene.
# The old text follows:
# Node is pinned because Renovate 44 declares "node": "^24.11.0" and dies on
# Node 22 with `TypeError: RegExp.escape is not a function` -- an error that
# says nothing about the real cause, so the pin is load-bearing, not hygiene.
# Bootstrapped on demand into a version-keyed cache; no image installs either,
# hence noforward. Checksums are upstream's own, from:
#   curl -fL https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt
# renovate: datasource=node-version depName=node
# noforward
RENOVATE_NODE_VERSION=24.21.0
# noforward
RENOVATE_NODE_LINUX_X64_SHA256=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6
# noforward
RENOVATE_NODE_LINUX_ARM64_SHA256=6ad1325edbdb5649c379b75a237147a666c95d4f9ae8d340fef2d1575d289ad2
# renovate: datasource=npm depName=renovate
# noforward
RENOVATE_VERSION=44.82.0
