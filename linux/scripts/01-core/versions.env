# noforward
GSTREAMER_ANDROID_UNIVERSAL_SHA256=86e647c6b7c4e7fa0e7814008749cc8401716ff45c5724e029b1baf953bbd96c
# NVIDIA CUDA apt keyring deb — the apt TRUST ANCHOR for the whole -Gpu lane.
# The filename is version-frozen (1.1-1). Fetch:
# The repo path is the Ubuntu VERSION DIGITS (ubuntu${UBUNTU_VERSION//./}), not the
# codename -- keep these in lockstep with UBUNTU_VERSION above. Both values below
# were the ubuntu2404 files while UBUNTU_VERSION was already 26.04, so correcting
# setup-cuda-repo.sh's URL alone would have traded a 404 for a checksum failure.
#   curl -fL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2604/<x86_64|sbsa>/cuda-keyring_1.1-1_all.deb | sha256sum
