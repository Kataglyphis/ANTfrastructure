# ==============================================================================
# Canonical version defaults for the entire Linux container build pipeline.
#
# This file is the SINGLE SOURCE OF TRUTH for every version number in the project.
# Dockerfiles, orchestrator scripts, and build helpers all consume these values.
#
# Update this file when bumping versions — do NOT scatter version changes across
# individual Dockerfiles.  The old per-Dockerfile ARG defaults are kept as safety
# nets and are now ENFORCED to match these values by sync_versions.py (a drift is
# a checker failure, not merely discouraged).
#
# After changing versions:
#   1. Run `python3 docs/scripts/sync_versions.py --write`
#   2. Update docs/linux-cross-builds.md, docs/linux-build-basics.md, AGENTS.md
# ==============================================================================

# --- Base image tooling ---
# renovate: datasource=docker depName=ubuntu
UBUNTU_VERSION=26.04
# Multi-arch manifest-LIST digest for ubuntu:${UBUNTU_VERSION} (pins the only
# floating external base). Refresh together with UBUNTU_VERSION. Fetch with:
#   curl -s "https://auth.docker.io/token?service=registry.docker.io&scope=repository:library/ubuntu:pull" | jq -r .token
#   curl -sI -H "Authorization: Bearer <tok>" -H "Accept: application/vnd.oci.image.index.v1+json" \
#     https://registry-1.docker.io/v2/library/ubuntu/manifests/${UBUNTU_VERSION} | grep -i docker-content-digest
# renovate: datasource=docker depName=ubuntu tag=26.04
UBUNTU_DIGEST=sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7
# Ubuntu codename for the version above (used by NVIDIA TensorRT repo paths).
UBUNTU_CODENAME=resolute
# renovate: datasource=github-releases depName=Kitware/CMake extractVersion=^v(?<version>.*)$
CMAKE_VERSION=4.4.4
# Per-arch truth. riscv64 has no upstream artifact for either: Kitware
# publishes no riscv64 CMake archive and Node.js no riscv64 tarball, so both
# come from the Ubuntu archive and the image must advertise what it HAS.
# Verified in the shipped riscv64 image 2026-09-04; the shipped-truth probe
# fails the build if the archive moves. docs/cross-build-verification.md#per-arch-version-truth
# noforward
CMAKE_VERSION_RISCV64=4.4.2
# noforward
NODE_VERSION_RISCV64=22.22.1
# Minimum CMake policy version for legacy projects that still set
# cmake_minimum_required(VERSION 3.5). The floor keeps moving (CMake 4.0
# removed support for compatibility with < 3.10), and 8 call sites hardcode
# "3.5" as a literal — LOG16. Bump this when the floor moves.
CMAKE_POLICY_VERSION_MINIMUM=3.5
# 26.8.1, not 26.8.0 (2026-08-27). The OFFICIAL v26.8.0 tarball self-reports
# `26.8.0-alpha.0.0.0`, and its bundled npm 11.19.0 then refuses it: semver
# treats a prerelease as outside `^20.17.0 || >=22.9.0`, so every npm call in
# the shipped image warned. Verified on the shipped amd64 bytes and against
# upstream: v26.8.1 reports a clean `v26.8.1`. Upstream stamping bug, fixed one
# patch later.
# renovate: datasource=node-version depName=node
NODE_VERSION=26.9.0
# renovate: datasource=github-releases depName=astral-sh/uv
UV_VERSION=0.12.23

# --- Compiler toolchain ---
# BUMPED 2026-08-26 (owner: "bump up everything"): 22.1.8 -> 23.1.0, a MAJOR
# compiler bump taken deliberately in the same window as the ccache->sccache
# switch, because that switch makes every lane cold anyway so the marginal
# rebuild cost of a heavy pin is at its lowest. bump_versions.py classes LLVM
# REPORT-ONLY (source patches + multi-hour entanglement), so this is a hand
# edit, not a sweep result. WATCH IN THE REBUILD, in this order -- these are
# the places a major LLVM lands on in this chain:
#   1. (MOVED 2026-08-27 -- this is a GCC concern, not an LLVM one. The
#      -nostdinc++ libstdc++ c++23 patch lives in GCC's src/c++23/Makefile.in
#      and is watched at the GCC_VERSION pin below, not here. It ran clean in
#      the 2026-08-27 build's GCC stage. Listing it under LLVM sent readers
#      looking in the wrong stage.)
#   2. Dawn/WebGPU already fails on GCC 16.1.0; a new LLVM moves that ground.
#   3. IREE is UNAFFECTED either way -- it pins its own llvm-project fork.
# renovate: datasource=github-tags depName=llvm/llvm-project extractVersion=^llvmorg-(?<version>.*)$
LLVM_RELEASE=23.1.3
# OPT-IN immutable pin for the llvm-project clone, mirroring TVM_COMMIT below:
# tags are movable and LLVM is a compiler whose output ships, so a 40-hex SHA
# here is meant to WIN over the llvmorg-${LLVM_RELEASE} tag (empty = keep
# tracking the tag). WIRED 2026-09-10: build-clang.sh and llvm-cross.sh now
# verify the checkout against this SHA and die on a mismatch. It matters because
# apt.llvm.org's per-major suite tracks the release BRANCH HEAD, so LLVM_RELEASE
# alone never said which compiler shipped. Peeled ^{} SHAs via `git ls-remote`:
#   llvmorg-22.1.8 (2026-08-24) = ca7933e47d3a3451d81e72ac174dcb5aa28b59d1
#   llvmorg-23.1.0 (2026-09-10) = ea7d852a70e8bdfaf601d6626a760f9771b2c4b4
#   llvmorg-23.1.1 (2026-09-17) = 6dfe1677ab8dffbc6ec13d53a1e0215d75147689
#   llvmorg-23.1.3 (2026-10-06) = 0d261d1ca552c95a8f007e061c787ac7132fbcbc
LLVM_COMMIT=0d261d1ca552c95a8f007e061c787ac7132fbcbc
# WATCH at every GCC bump: the -nostdinc++ libstdc++ c++23 patch in
# src/c++23/Makefile.in (docs/upstream-libstdcxx-c++23-nostdinc++.md). It
# cures the Canadian-cross 'fenv_t has not been declared' contamination and
# is re-applied per GCC release; upstream took the c++17 fix but not c++23.
# Moved here 2026-08-27 from the LLVM block, where it did not belong.
# renovate: datasource=github-tags depName=gcc-mirror/gcc extractVersion=^releases/gcc-(?<version>.*)$
GCC_VERSION=16.2.0

# --- Python (source-built interpreter) ---
# Single source of truth. The major.minor form (formerly PYTHON_MAJOR_MINOR /
# DEFAULT_PYTHON_VERSION) is DERIVED from this: common.sh derives it for shell
# consumers; Dockerfiles derive ARG defaults via ${PYTHON_VERSION%.*}.
# renovate: datasource=python-version depName=python
PYTHON_VERSION=3.14.8
# Canonical venv location. Documentation only: the path is hardcoded as the
# literal /opt/python/.venv across the Dockerfiles/scripts, and the VENV_PATH
# *variable* is read nowhere, so there is nothing to forward.
# noforward
VENV_PATH=/opt/python/.venv

# --- Vulkan SDK ---
# 2026-08-19: 1.4.357.1 WITHDRAWN by LunarG (404 on sdk.lunarg.com, killed the
# base ride at scoop's vulkan install); latest served was .0 - LunarG pulls
# point releases, so a 404 here means re-query
# https://vulkan.lunarg.com/sdk/latest/windows.json, never assume a mirror.
# 2026-08-24: LunarG RE-published 1.4.357.1 (latest/linux.txt says .1 again;
# linux tarball HEAD-verified HTTP 200, 329 551 856 B, last-modified
# 2026-08-07) — bumped back to .1, VULKAN_SDK_SHA256 re-derived from the live
# tarball by bump_versions.py (BT1 stream-hash).
# VULKAN BUMP BLOCKED (2026-08-24, adversarial review): LunarG re-published
# 1.4.357.1 for LINUX ONLY — latest/windows.txt still answers 1.4.357.0
# (verified live). This key is SHARED with the Windows lane
# (windows/Build-Buildkit.ps1 Get-Ver 'VULKAN_VERSION'), so bumping it here 404s the
# Windows SDK download. Stay on .0 until EITHER Windows publishes .1 OR the
# key is split per-lane (that split is Windows-backlog work).
# renovate: datasource=custom.vulkan depName=vulkan
VULKAN_VERSION=1.4.357.0

# --- WiX Toolset (Windows-only installer authoring) ---
# Single source of truth for both the install (Install-ScoopTools.ps1) and the assert
# (Test-Toolchain.ps1); surfaced as $env:* by Import-Versions.ps1 in Dockerfile.base.
# renovate: datasource=nuget depName=wix
WIX_VERSION=7.0.0
# renovate: datasource=nuget depName=WixToolset.UI.wixext
WIX_UI_EXT_VERSION=7.0.0
# The final stage installs it (windows/Dockerfile), so a bump rebuilds one stage, not the chain.
# renovate: datasource=nuget depName=WixToolset.Firewall.wixext
WIX_FIREWALL_EXT_VERSION=7.0.0

# --- Git for Windows (Windows-only; Install-ScoopTools.ps1 derives the installer URL:
# v<GIT_VERSION>.windows.1 tag / Git-<GIT_VERSION>-64-bit.exe) ---
# renovate: datasource=github-releases depName=git-for-windows/git extractVersion=^v(?<version>\d+\.\d+\.\d+)\.windows\.\d+$
GIT_VERSION=2.56.0

# --- Rust toolchain (install-rust.sh and the Windows Install-RustToolchain.ps1; pinned to the shipped images) ---
# renovate: datasource=github-tags depName=rust-lang/rust
RUST_VERSION=1.99.0
# renovate: datasource=github-tags depName=lu-zero/cargo-c extractVersion=^v(?<version>.*)$
CARGO_C_VERSION=0.10.25
RUST_NIGHTLY_TOOLCHAIN=nightly-2026-06-28

# --- Rust CI tooling (02-toolchain/rust/cargo_security_checks.sh, cargo_coverage.sh) ---
# The package stage installs all three from these pins on amd64 and arm64
# (CON65, docs/consumer-image-contract.md#the-cargo-qa-tools), reading this
# file rather than a build-arg, hence noforward; the scripts build one only
# when the pinned version is not on PATH (a bare host, or riscv64).
# Until 2026-09-09 all three were a BARE `cargo install <crate>` with no
# --version at all. Every gate BINARY in this file is pinned to a byte; the
# three tools whose verdict decides whether a Rust lane is red were the ones
# resolving to whatever crates.io served that minute, so a new advisory-db
# schema, a new default lint or a tarpaulin engine change could turn a lane red
# with no commit behind it and nothing to bisect.
# Values are crates.io's max_stable_version on 2026-09-09 — i.e. what the bare
# `cargo install` would have resolved to that day, so the pin records today's
# behaviour instead of changing it. Their MSRVs (1.88, 1.88, none declared) all
# sit under RUST_VERSION=1.98.0 above.
# renovate: datasource=crate depName=cargo-audit
# noforward
CARGO_AUDIT_VERSION=0.22.2
# renovate: datasource=crate depName=cargo-deny
# noforward
CARGO_DENY_VERSION=0.20.2
# renovate: datasource=crate depName=cargo-tarpaulin
# noforward
CARGO_TARPAULIN_VERSION=0.37.5
# Their upstream release binaries, x86_64 and aarch64 (none for riscv64), measured
# 2026-10-06; cargo-deny's equal its published .sha256 files. Bump these WITH the
# three versions above:
#   curl -fL https://github.com/rustsec/rustsec/releases/download/cargo-audit%2Fv${CARGO_AUDIT_VERSION}/cargo-audit-x86_64-unknown-linux-musl-v${CARGO_AUDIT_VERSION}.tgz | sha256sum
#   (aarch64: cargo-audit-aarch64-unknown-linux-gnu-v<ver>.tgz, a glibc build)
#   curl -fL https://github.com/EmbarkStudios/cargo-deny/releases/download/${CARGO_DENY_VERSION}/cargo-deny-${CARGO_DENY_VERSION}-x86_64-unknown-linux-musl.tar.gz | sha256sum
#   curl -fL https://github.com/xd009642/tarpaulin/releases/download/${CARGO_TARPAULIN_VERSION}/cargo-tarpaulin-x86_64-unknown-linux-musl.tar.gz | sha256sum
# noforward
CARGO_AUDIT_LINUX_X86_64_SHA256=7fb9497f8594b389e5fce5ef9b92db08432996895b2e0c5a0167a69ed445c428
# noforward
CARGO_AUDIT_LINUX_AARCH64_SHA256=c6603814ddaa45e51263dafd31c0ac98808f688d26f7395804f9670b0fd599dd
# noforward
CARGO_DENY_LINUX_X86_64_SHA256=9f12ed4c49936e09b48bf862b595cde2fe64fcbd9d74dfacac6131ca824c8d5f
# noforward
CARGO_DENY_LINUX_AARCH64_SHA256=995c82be0defc7a025cae49a2aa2644ce8245c9a3318fc4103907c6a285e8c7d
# noforward
CARGO_TARPAULIN_LINUX_X86_64_SHA256=edd214e46aedd1692bf8601f9754da5c6ade83da78f73d291f5dd611c940b590
# noforward
CARGO_TARPAULIN_LINUX_AARCH64_SHA256=e74a781283a3843185d93370c8af9be224a4edaab0aa5ed421e1c973d751bc8f

# --- SDK frameworks ---
# renovate: datasource=github-tags depName=apache/tvm
TVM_REF=v0.26.0
# OPT-IN immutable pin for the TVM clone (tvm.sh; commit wins over the tag —
# tags are movable and TVM is a compiler whose output ships). v0.26.0 resolved
# 2026-08-18:
#   TVM_COMMIT=c7b458e946bc4266915da582457476bdcd9705ae
# PINNED 2026-08-27 past the LLVM 23 break. TVM v0.26.0 does not compile
# against LLVM_RELEASE=23.1.0: Intrinsic::matchIntrinsicSignature and the
# MatchIntrinsicTypes_* enum are gone, SubtargetSubTypeKV/SubtargetFeatureKV
# ::Key became key(), getMCSubtargetInfo() returns a reference, and the ORC
# JIT lambda signature changed -- three files, measured on a real arm64 build.
# amd64 escaped it only because it links the DISTRO llvm-config-21.
# Upstream main carries TVM_LLVM_VERSION >= 230 guards for all of it and NO
# release does (v0.26.0 is still the newest tag), so this pins the commit
# rather than reproducing an upstream port by hand.
# WATCH: drop this back to empty the moment a TVM RELEASE ships the 230
# guards. Until then TVM_COMMIT is the ONLY thing keeping TVM buildable on
# the cross arches -- the hand-patch alternative was tried, measured, and
# removed (see the note where patch_tvm_for_llvm_23 used to live in tvm.sh).
TVM_COMMIT=994e0216d734bf3e02806d8ebf383dafa80e41b9
# IREE (iree.dev) MLIR compiler + runtime.
# CORRECTED 2026-08-27 -- this used to say "amd64/arm64 install the PyPI
# compiler+runtime", which stopped being true when f266634 made the CROSS target
# runtime-only. cross_build_is_active covers arm64 as well as riscv64, so today:
#   amd64    both wheels built natively from source.
#   arm64    RUNTIME source-built into /opt/wheels; COMPILER from PyPI.
#   riscv64  RUNTIME source-built; no compiler at all (no PyPI riscv64 wheel),
#            recorded as a _parity_exempt arm in smoke-runtime-image.sh.
# The arm64 mix looks like a version skew in `pip list` and is NOT one:
# `git ls-remote iree-org/iree refs/tags/v3.11.0^{}` resolves to
# e4a3b0405d7d23554da26403658d0e8c3c5ecf25, i.e. the source-built
# 3.11.0.dev0+e4a3b04 runtime and the PyPI 3.11.0 compiler are the SAME COMMIT
# -- .dev0+<sha> is only IREE's stamp for a non-release build. Do not "fix" it
# with a version-equality assert; that would fail on a cosmetic difference.
# Keep the leading v: the GitHub release tag is v3.11.0, the PyPI version 3.11.0.
# renovate: datasource=github-tags depName=iree-org/iree
IREE_VERSION=v3.11.0
# Windows rocm lane: IREE's rocm target downloads ocml/ockl device bitcode at configure time
# (shark-infra/amdgpu-device-libs v20231101) and hash-pins it in its own CMake; this is that pin,
# and Build-IreeFromSource.ps1 refuses a build where the two differ. Measured 2026-09-23, equal to
# the release's .sha256sum asset and to compiler/plugins/target/ROCM/CMakeLists.txt at v3.11.0.
# bump:hold slaved to IREE_VERSION: re-derive it from that CMakeLists.txt when IREE moves.
IREE_ROCM_DEVICE_BC_SHA256=336362416c68fdd8bb80328f65ca7ebaa0c119ea19c95df6df30c832a4df39b9

# --- Media libraries ---
# github-tags and not github-releases, and no extractVersion: upstream tags
# are v1.9.1-shaped and this key carries the tag verbatim, leading v and
# all (measured 2026-09-10). Same reason bump_versions.py reads it with
# gh_latest(strip_v=False), which is ls-remote over tags.
# renovate: datasource=github-tags depName=microsoft/onnxruntime
ONNXRUNTIME_VERSION=v1.30.0
# Windows rocm lane, WebGPU EP spike (Build-OnnxFromSource.ps1, ORT_WEBGPU=1): the Dawn tag ORT's
# cmake/deps.txt fetches, SHA1-pinned only there. The build refuses a deps.txt that names another tag.
ORT_WEBGPU_WINDOWS_DAWN_VERSION=v20260818.211311
# SHA256 of that GitHub archive, self-measured 2026-09-23 (its SHA1 equals deps.txt's 10e42c94...).
# bump:hold slaved to ONNXRUNTIME_VERSION: re-derive both from deps.txt's dawn line when ORT moves.
ORT_WEBGPU_WINDOWS_DAWN_SHA256=1be7cfe31af3bc3e99bfbb98b845fc523fff8f5807f20f3372d33a8626b0fdda
# The DXC release whose x64 dxcompiler.dll + dxil.dll ship beside that ORT (Dawn's own DXC build needs
# ATL, absent from the image). SHA256 = the release asset's digest; bump_versions.py spec_ort_webgpu_dxc.
ORT_WEBGPU_WINDOWS_DXC_VERSION=v1.9.2607
ORT_WEBGPU_WINDOWS_DXC_ASSET=dxc_2026_07_29.zip
ORT_WEBGPU_WINDOWS_DXC_SHA256=a1dfb116ba3eeae6a1582291b53a8e7bf65ad760676bd3194685c8f7367cd241
# OrchestrANT pins `onnxruntime-genai==0.15.2` in its pyproject.toml with a
# comment saying "keep in sync with ANTfrastructure ONNXRUNTIME_GENAI_VERSION"
# -- so Renovate watched the copy and not the key it must equal.
# renovate: datasource=github-tags depName=microsoft/onnxruntime-genai
ONNXRUNTIME_GENAI_VERSION=v0.15.2
# GEN1: riscv64 onnxruntime-genai lane — toggle, not a version pin; WIRED but
# UNVALIDATED; Dockerfile.media ARG must match. docs/gen1-riscv64-genai.md
GENAI_ALLOW_RISCV64=true
# Feature toggles (true/false), not version pins: WebGPU (Dawn) execution provider
# for ONNX Runtime. ORT_ENABLE_WEBGPU is the master switch — CURRENTLY ON (=true
# below; set to false to drop the Dawn dependency). Dawn is validated on amd64
# native; cross-compiling it to arm64/riscv64 is unproven, so it lights up there
# only when ORT_WEBGPU_ALLOW_CROSS=true is also set (also true below). Forwarded to
# Dockerfile.media's onnxruntime stage (build lib/common.sh reads the env).
# LINUX lane only: no Windows build (either arch) consumes these two toggles.
# NB (LOG2, 2026-08-28): the WASM asyncify/jspi flavors ARE built now
# (40-build-wasm.sh passes 4+5, gated by ORT_WASM_WEBGPU_FLAVORS=true in
# lib/common.sh). 50-build-js.sh emits the ort.webgpu*/ort.jspi* JS bundles
# when the .asyncify/.jspi WASM artifacts are present. Watch: a real build
# must confirm the artifacts ship on all arches.
ORT_ENABLE_WEBGPU=true
ORT_WEBGPU_ALLOW_CROSS=true
# AP6 decision (2026-08-24): ONNX Runtime link-time optimization for the
# CPU/AMD builds — OFF on ALL arches for the coming validating rebuild, so its
# timings stay comparable with wave 4/5 (LTO would confound every ORT stage
# measurement, and cross-arch LTO under GCC 16 is unproven here). This is a
# feature toggle (true/false), not a version pin. The value here IS live: the
# ORT build RUNs bind-mount the whole 01-core dir, and onnxruntime lib/
# common.sh -> media_common_init -> 01-core common.sh load_versions_env's this
# file, so append_onnx_optional_lto_webgpu_args sees it and appends
# --enable_lto when it reads true (its own default is false, making today's
# value behavior-identical to the never-set state). Measuring knob: flip to
# true for a deliberate measuring run — that flips ALL arches at once; there
# is no per-arch gate yet (a split would mirror onnx_webgpu_enabled_for_target
# / ORT_WEBGPU_ALLOW_CROSS above — consumer change, see pin-bump report). The
# nvidia lane is unaffected either way: 30-build-native-nvidia.sh passes
# --enable_lto unconditionally.
ORT_ENABLE_LTO=false
# renovate: datasource=github-tags depName=google-ai-edge/LiteRT
LITERT_VERSION=v2.2.0
# v0.14.0's OSS export shipped stale CMake (references the removed constrained_decoding
# + the now-header-only preprocessor without its CMakeLists). The Windows build script
# writes condition-gated INTERFACE stubs post-clone ([LiteRTLM-winfix export-stubs] in
# Build-LitertLmFromSource.ps1); they self-retire once upstream exports are complete
# — verify whether v0.15.0 retires them on the next Windows build.
# protoc coupling re-verified for 0.17.0 (protobuf.cmake GIT_TAG v35.1, whose
# version.json maps to protoc 35.1 / Python 7.35.1), so PROTOC_VERSION=35.1 /
# PROTOBUF_VERSION=7.35.1 stay.
# renovate: datasource=github-tags depName=google-ai-edge/LiteRT-LM extractVersion=^v(?<version>.*)$
LITERT_LM_VERSION=0.17.1
# Windows rocm lane only (Build-LitertLmBazel.ps1): LiteRT-LM's WebGPU/D3D12 GPU runtime.
# Slaved to LITERT_LM_VERSION, refreshed with it by bump_versions.py spec_litert_lm:
# the three DLL pins are the git-LFS oids of prebuilt/windows_x86_64/*.dll at that tag,
# the DXC pin is the zip its WORKSPACE fetches (= microsoft/DirectXShaderCompiler
# v1.9.2602's GitHub release digest for dxc_2026_02_20.zip, checked 2026-09-23).
LITERT_LM_WEBGPU_ACCELERATOR_SHA256=8a2c4d5700ac34cfbef96548e1096a4532e9bbe20ee827e80a38439766c81644
LITERT_LM_WEBGPU_SAMPLER_SHA256=5ddbb93b4192efd5aafed2ec23d98091b12e467ea0c0daa65d1abac5f2529532
LITERT_LM_WEBGPU_DAWN_SHA256=4f98d05a333cf980776ae5382c39ce19638cf71d1fd60133d1c849b55551895e
LITERT_LM_DXC_ZIP_SHA256=a1e89031421cf3c1fca6627766ab3020ca4f962ac7e2caa7fab2b33a8436151e
# LiteRT for the web (prebuilt npm packages, WASM/JS — vendored, not compiled;
# https://developers.google.com/edge/litert/web). Arch-independent: the same
# assets ship to amd64/arm64/riscv64.
#   LITERTJS_VERSION       -> @litertjs/core (+ tfjs-interop, wasm-utils)  (LiteRT.js)
#   MEDIAPIPE_GENAI_VERSION -> @mediapipe/tasks-genai (LiteRT-LM's web LLM runtime)
# renovate: datasource=npm depName=@litertjs/core
LITERTJS_VERSION=2.5.3
# renovate: datasource=npm depName=@mediapipe/tasks-genai
MEDIAPIPE_GENAI_VERSION=0.10.29
# 5.0.0 is a released tag since 2026-06 — pinned to it (was: live branch 5.x,
# the last non-reproducible media pin). The *_COMMIT freeze pins below remain
# as an additional opt-in.
# renovate: datasource=github-tags depName=opencv/opencv
OPENCV_VERSION=5.0.0
# renovate: datasource=github-tags depName=GStreamer/gstreamer
GSTREAMER_VERSION=1.29.2
# renovate: datasource=github-tags depName=FFmpeg/FFmpeg versioning=regex:^n(?<major>\d+)\.(?<minor>\d+)(?:\.(?<patch>\d+))?$
FFMPEG_VERSION=n9.0.2
# renovate: datasource=github-tags depName=PyAV-Org/PyAV extractVersion=^v(?<version>.*)$
PYAV_VERSION=18.1.0
# Feature toggle (0/1), not a version pin: enable libx265 HEVC encoding in FFmpeg.
# libx265-dev is installed on all arches; historically disabled over a source-x265
# compile break, now ENABLED by default (=1 below — ships HEVC on all arches) and
# still probe-gated so a future break degrades gracefully. Forwarded as a
# --build-arg to Dockerfile.media's ffmpeg stage (build-ffmpeg.sh reads the env).
FFMPEG_ENABLE_X265=1
# Feature toggle (0/1), not a version pin: enable FFmpeg's TensorFlow DNN
# backend (--enable-libtensorflow). OFF by default: it is one OPTIONAL DNN
# backend most users never touch, yet its C SDK drags ~500 MB into every
# amd64 media+runtime image (libtensorflow.so ~447 MB + libtensorflow_framework
# ~50 MB, bundled into /opt/ffmpeg/lib). The ONNX Runtime DNN backend stays
# ALWAYS-ON regardless — this toggle gates ONLY TensorFlow. When off, the TF C
# SDK download, the --enable-libtensorflow configure flag, and the runtime-lib
# bundling are ALL skipped (the ~500 MB never enters the image). To enable, set
# to 1 (amd64 only; upstream ships no arm64/riscv64 libtensorflow C build).
# Forwarded as a --build-arg to Dockerfile.media's ffmpeg stage (build-ffmpeg.sh
# reads the env), exactly like FFMPEG_ENABLE_X265 above.
FFMPEG_ENABLE_TF=0
# Reproducibility pins (OPT-IN). OPENCV_VERSION above is now the released 5.0.0
# TAG (reproducible; it previously tracked the live 5.x branch); FFMPEG_VERSION is
# a release TAG since 2026-08-04 (n9.0 — it previously tracked master, which by
# then WAS the 9.0 dev line).
# To freeze a build to an immutable commit, set the matching *_COMMIT to a
# 40-hex SHA (empty = keep tracking branch/tag). build-opencv.sh /
# build-ffmpeg.sh / clone_or_update_repo consume these. Known-good HEADs
# captured 2026-07-08:
#   OPENCV_COMMIT=4ce2389a624ebfb846f06d055026723e3a0a564a
#   OPENCV_CONTRIB_COMMIT=755e50675d97db9b7d449d8bd6b09888646f6c6e
#   FFMPEG_COMMIT=c29d710cd5d0f80bbb56f7ec1f35d5fb7ed44d05
OPENCV_COMMIT=
OPENCV_CONTRIB_COMMIT=
FFMPEG_COMMIT=
# renovate: datasource=github-tags depName=fraunhoferhhi/vvdec
VVDEC_VERSION=v3.2.0
# libcamera (git.libcamera.org, GitHub mirror libcamera-org/libcamera). Was the
# ONLY media library cloned UNPINNED (upstream master, non-reproducible) until
# 2026-08-08; the generated Python wheel also carried a hardcoded stale version.
# Tag, branch, or 40-hex commit SHA (clone_or_update_repo handles all three).
# renovate: datasource=github-tags depName=libcamera-org/libcamera
LIBCAMERA_VERSION=v0.7.2
# FFmpeg DNN-backend SDKs (build-ffmpeg.sh reads these as env defaults).
# 2.18.0 is the LAST libtensorflow C build upstream ever published (verified
# 2026-08-08: GitHub releases >=2.19 carry zero assets; the GCS mirror at
# storage.googleapis.com/tensorflow/versions/ ends at 2.18.0, x86_64 only).
# Do NOT bump past it until upstream resumes C-library builds.
# TENSORFLOW_C: 2.18.1 is the LAST version with a published libtensorflow C
# tarball (2.19+ return 404 on storage.googleapis.com — upstream stopped
# shipping the C archive; verified 2026-08-19). Do NOT bump past it until the
# ffmpeg TF backend gains another source. bump_versions reports the git tag,
# which is NOT the artifact.
TENSORFLOW_C_VERSION=2.18.1
# sha256 of libtensorflow-cpu-linux-x86_64.tar.gz from the GCS mirror. Fetch:
#   curl -fL https://storage.googleapis.com/tensorflow/versions/${TENSORFLOW_C_VERSION}/libtensorflow-cpu-linux-x86_64.tar.gz | sha256sum
# noforward
# bump:hold — F6: frozen with TENSORFLOW_C_VERSION above (2.18.0 is the LAST
# libtensorflow C build upstream published; there is nothing newer to bump to,
# so this SHA is intentionally static, not an un-triaged stray).
TENSORFLOW_C_SHA256=b692795f3ad198c531b02aeb2bc8146568d24aaf6a5dbf5faa43907c4028fd73
# renovate: datasource=github-tags depName=openvinotoolkit/openvino
OPENVINO_VERSION=2026.4.0
# ArmNN + Arm Compute Library (arm64 media stage) and librice (gstreamer
# webrtcbin2 C library) — build scripts read these as env defaults.
# renovate: datasource=github-tags depName=ARM-software/armnn versioning=loose
ARMNN_VERSION=v26.07
# renovate: datasource=github-tags depName=ARM-software/ComputeLibrary
ACL_VERSION=v53.3.0
# renovate: datasource=github-tags depName=ystreet/librice
RICE_VERSION=v0.4.3

# --- Library build dependencies (cross-compile fallbacks / header tarballs) ---
# renovate: datasource=github-tags depName=abseil/abseil-cpp
ABSEIL_VERSION=20260817.0
# Immutable pins for the abseil header tarball (abseil-headers.sh): the
# /archive/<commit>.tar.gz form is byte-stable, the tag form is not. Both
# refresh together with ABSEIL_VERSION (git ls-remote tag → commit; then
#   curl -fL https://github.com/abseil/abseil-cpp/archive/${ABSEIL_COMMIT}.tar.gz | sha256sum
# noforward
ABSEIL_COMMIT=2065f4ded0558c6f89fee67c8e5228feb4eb960e
# F6 DONE 2026-08-27: this is now the DECOMPRESSED-STREAM hash, not the archive
# bytes. GitHub pledges codeload byte-stability for "no less than a year", not
# forever — the gzip container may be re-encoded — while the decompressed stream
# is stable for as long as the commit exists. Both sides were switched together,
# as the previous note demanded: download_verified_file() grew a "stream" mode
# and abseil-headers.sh passes it. Refresh with
#   curl -fL https://github.com/abseil/abseil-cpp/archive/${ABSEIL_COMMIT}.tar.gz | gunzip -c | sha256sum
# (re-verified independently 2026-08-27: file form 7f4240fe…, stream ec28d875…).
# noforward
ABSEIL_TARBALL_STREAM_SHA256=ec28d8752044aea8da68b9f2b6079006f8a45f5899a6f94cf895dc971da1b8c8
# renovate: datasource=github-tags depName=freetype/freetype versioning=regex:^(?:VER-)?(?<major>\d+)[-.](?<minor>\d+)[-.](?<patch>\d+)$
FREETYPE_VERSION=2.14.3
# libpng cross-compile fallback for riscv64 OpenCV: OpenCV 5.x's vendored libpng
# fails its RISC-V Vector configure probe under GCC 16.1.0, and Ubuntu Ports'
# libpng-dev:riscv64 dep set is frequently broken, so the riscv64 OpenCV build
# links an external libpng that install-deps.sh cross-compiles from this tag.
# renovate: datasource=github-tags depName=pnggroup/libpng extractVersion=^v(?<version>.*)$
LIBPNG_VERSION=1.6.58
# renovate: datasource=github-tags depName=GNOME/gobject-introspection versioning=regex:^(?:GOBJECT_INTROSPECTION_)?(?<major>\d+)[._](?<minor>\d+)[._](?<patch>\d+)$
GOBJECT_INTROSPECTION_VERSION=1.86.0
# nv-codec-headers (ffnvcodec) — FFmpeg NVENC/NVDEC/CUVID headers. Must be a REAL upstream tag:
# the repo's tags are 4-part (n12.2.72.0, n13.0.19.0, ...); the old n12.2.1 does not exist, so the
# clone 404'd and NVENC was silently skipped on both lanes. n12.2.72.0 satisfies FFmpeg master's
# `ffnvcodec >= 12.1` requirement and is broadly driver-compatible.
# renovate: datasource=github-tags depName=FFmpeg/nv-codec-headers versioning=regex:^n?(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)\.(?<build>\d+)$
NV_CODEC_HEADERS_REF=n13.1.15.0
# AMD AMF SDK public headers (MIT) for FFmpeg's *_amf codecs/filters -- Windows rocm lane only.
# The release's 84 KB header asset, never the 1.2 GB repo; FFmpeg n9.0.2 needs >= v1.5.2.
# Bump both lines together (the SHA equals the release asset's GitHub digest):
#   curl -fL https://github.com/GPUOpen-LibrariesAndSDKs/AMF/releases/download/${AMF_HEADERS_VERSION}/AMF-headers-${AMF_HEADERS_VERSION}.tar.gz | sha256sum
# renovate: datasource=github-releases depName=GPUOpen-LibrariesAndSDKs/AMF
AMF_HEADERS_VERSION=v1.5.2
AMF_HEADERS_SHA256=d3c12eb324edf05e214608b6a395a51dd95770ed9d45520185d6c3a206811c99
# FFmpeg's software codecs on Windows amd64 (windows/scripts/build/Build-FfmpegCodecs.ps1): static
# dav1d (AV1 decode), x264 and x265 (H.264/HEVC encode), linked into FFmpeg's DLLs. dav1d and x264
# are the exact sources GStreamer's wraps build (subprojects/dav1d.wrap, x264.wrap at
# GSTREAMER_VERSION), so the image carries one version of each: bump them WITH GStreamer.
# x264's wrap names a branch, so the commit pins it. x265 has no GStreamer wrap. Linux lanes use
# the distro's codecs and do not read these.
DAV1D_VERSION=1.4.1
DAV1D_SHA256=8d407dd5fe7986413c937b14e67f36aebd06e1fa5cfec679d10e548476f2d5f8
X264_MESON_BRANCH=164.3108-meson
X264_MESON_COMMIT=ecc833a37945073a779b42b1a9f20c4454a62fbb
X265_VERSION=4.1
X265_SHA256=a31699c6a89806b74b0151e5e6a7df65de4b49050482fe5ebf8a4379d7af8f29

# --- PyTorch / TorchVision (riscv64 cross wheel builds) ---
# OrchestrANT pins `torch==2.13.0` AND `torch @ git+...@v2.13.0` in its
# pyproject.toml; both were visible to Renovate and this key was not.
# renovate: datasource=github-tags depName=pytorch/pytorch
PYTORCH_VERSION=v2.14.0
# ...and `torchvision==0.28.0` beside it, from pytorch/vision, whose tags
# are v0.28.0-shaped.
# bump:hold slaved to PYTORCH_VERSION: pytorch/vision's compatibility table
# pairs torch 2.14 with torchvision 0.29 (the offset is +15 on the minor).
# Renovate tracks the tag alone and once bumped torchvision by itself — the
# runtime version-pin assertion caught it (see CHANGELOG 2026-09-20). Bump
# both keys together, and re-derive from the table.
# renovate: datasource=github-tags depName=pytorch/vision
TORCHVISION_VERSION=v0.29.0
# All THREE arches carry this pair. amd64/arm64 get upstream cp314 wheels and the
# runtime force-installs the pinned pair; riscv64 has no upstream wheels, so the
# media stage's app-wheelhouse SOURCE-BUILDS the same refs (its Dockerfile.media
# ARG wiring is what makes that true).

# --- AMD GPU ---
# Migrated to ROCm 10.0 (TheRock distribution, 2026-08-28). The new apt repo is
# stable.repo.amd.com (not repo.radeon.com), uses deb822 .sources format with
# suite "stable", and splits MIGraphX into a separate repo path under
# /rocm/migraphx/packages/. Package names are prefixed amdrocm-* (e.g.
# amdrocm-core-dev10.0, amdrocm-migraphx). Ubuntu 26.04 (resolute) is natively
# supported — no more noble fallback.
# renovate: datasource=github-tags depName=ROCm/TheRock extractVersion=^therock-(?<version>.*)$
ROCM_VERSION=10.0
MIGRAPHX_VERSION=2.17.0
# The download.pytorch.org wheel line the ROCm image's torch comes from. The app's
# `pytorch-rocm10` extra (OrchestrANT since 2026-09-29) reads the same line, and
# assemble-torch-app.sh re-installs the PYTORCH_VERSION pair from THIS one should
# the two drift (with deps, so triton-rocm moves with it). There is no rocm10 line:
# this is the newest that carries torch 2.14.0 for cp314 (measured 2026-09-22).
# Bump it with ROCM_VERSION / PYTORCH_VERSION, never on its own.
PYTORCH_ROCM_INDEX=rocm7.14
# Windows ROCm (windows/Dockerfile.rocm): the same TheRock release as ROCM_VERSION,
# as AMD's tarball (stable.repo.amd.com/rocm/core/tarball/). AMD publishes NO
# checksum, so the SHA256 is self-measured, like ROCM_GPG_KEY_SHA256 below:
#   curl -fL https://stable.repo.amd.com/rocm/core/tarball/therock-dist-windows-<FAMILY>-<RELEASE>.tar.gz | sha256sum
# gfx120X-all = RDNA4 (RX 9070 XT, gfx1201), 2,282,922,923 bytes, measured 2026-09-22.
# Bump all three together, and with ROCM_VERSION.
ROCM_WINDOWS_RELEASE=10.0.0
ROCM_WINDOWS_GFX_FAMILY=gfx120X-all
ROCM_WINDOWS_TARBALL_SHA256=75da73c483cbc0456d9008f2079b333f4f9d3b7744705378ff8007e502ca38c5
# PyTorch on Windows ROCm (rocm lane only): torch + torchvision are BUILT FROM SOURCE in
# windows/Dockerfile.torch's torch-rocm-wheels stage (Build-TorchRocmFromSource.ps1), at
# PYTORCH_VERSION / TORCHVISION_VERSION, against the SDK above. The two commits are those tags'
# (git verifies every object); bump them WITH the version keys:
#   git ls-remote https://github.com/pytorch/pytorch.git refs/tags/<PYTORCH_VERSION>
#   git ls-remote https://github.com/pytorch/vision.git refs/tags/<TORCHVISION_VERSION>
TORCH_ROCM_WINDOWS_PYTORCH_COMMIT=2b3ec34829036a65cd9d1398ea72a0167dc37470
TORCH_ROCM_WINDOWS_TORCHVISION_COMMIT=fc73f5a8567734ffa4c988b24d5432f0d3005974
# The wheels load ROCm like AMD's: rocm[libraries] from these pins, plus device wheels per GPU
# (gfx1201 unsuffixed, gfx1200 as *_GFX1200), installed by rocm-1 (Install-TorchRocm.ps1). AMD
# publishes no hashes, so each SHA256 is self-measured (curl -fL <url> | sha256sum), 2026-09-23.
# Every URL carries ROCM_WINDOWS_RELEASE (asserted at build time): bump the whole block with it.
TORCH_ROCM_WINDOWS_ROCM_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm/rocm-10.0.0.tar.gz
TORCH_ROCM_WINDOWS_ROCM_SHA256=65b5982249612a310135f5e061b9f28909e8ad718a1ddb3f1abba92298b7216b
TORCH_ROCM_WINDOWS_SDK_CORE_URL=https://stable.repo.amd.com/rocm/core/whl-next/rocm-sdk-core/rocm_sdk_core-10.0.0-py3-none-win_amd64.whl
