# noforward
FLUTTER_SDK_SHA256=5b45f0ceda99b9bebdc873e7e69f6450aeb4c30f454b505e2e62fc9255a907d3

# --- Cross-build defaults ---
# `# noforward` marks the variable on the NEXT line as orchestrator/host-only:
# version-forwarding.sh forwards every other variable in this file as a
# --build-arg to nerdctl build.
# noforward
CROSS_DEFAULT_ARCHES=amd64,arm64,riscv64
# noforward
FAST_UBUNTU_MIRROR_URL_DEFAULT=https://archive.ubuntu.com/ubuntu/

# --- Image registry ---
# noforward
IMAGE_REGISTRY_PREFIX=ghcr.io/kataglyphis/kataglyphis_beschleuniger

# The two tags EVERY CI lane in the family runs in, across every repository.
# The convention: `${IMAGE_REGISTRY_PREFIX}:${CI_IMAGE_LINUX_TAG}` for Linux,
# `${IMAGE_REGISTRY_PREFIX}:${CI_IMAGE_WINDOWS_TAG}` for Windows. Before these
# existed the tag was a string literal re-typed in every caller of the four
# container composite actions - nine lanes across five repositories - which is
# where fleet drift enters: a lane pinned to an arch-suffixed or a stale tag
# looks identical to a correct one in review.
#
# YAML cannot read this file, so the four composite actions carry the composed
# ref as their `image:` input DEFAULT and callers omit the input. Those copies
# are not trusted: linux/scripts/verify_ci_image_refs.py (run by
# lint-workflows.sh, preflight slug `workflow-lint`) asserts each default equals
# the value composed here and rejects any non-canonical tag anywhere under
# .github/ - in this repo and, through the linter's consumer-root argument, in
# the consumer repositories too.
#
# The Linux tag was `latest-cross` until 2026-09-22 (a leftover from when the
# cross chain was one lane among several). The old `:latest`, whose children the
# ghcr-cleanup bug had deleted (fixed in b70d3f4), was gone by then and the tag
# was re-created from the live 3-arch index. `:latest-cross` was published as a
# deprecated alias for one day and RETIRED on 2026-09-22 (owner decision): the
# tags are deleted and nothing publishes them again.
# noforward
CI_IMAGE_LINUX_TAG=latest
# noforward
CI_IMAGE_WINDOWS_TAG=winamd64

# --- Documentation image (third_party/DocumANTation/Dockerfile) ---
# The `pandoc_all` image that builds the book, dissertation, slides and CV. It
# is standalone rather than part of the cross chain, so its pins are marked
# noforward -- nothing passes them as --build-arg to the Linux images. They live
# here anyway so a version still changes in exactly one place, and
# sync_versions.py keeps that Dockerfile's ARG defaults equal to these.
# renovate: datasource=github-releases depName=jgm/pandoc
# noforward
PANDOC_VERSION=3.11

