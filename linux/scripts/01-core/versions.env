# ==============================================================================
# Canonical version defaults for the entire Linux container build pipeline.
#
# This file is the SINGLE SOURCE OF TRUTH for every version number in the project.
# Dockerfiles, orchestrator scripts, and build helpers all consume these values.
#
# Update this file when bumping versions — do NOT scatter version changes across
# individual Dockerfiles.  The old per-Dockerfile ARG defaults are kept as safety
# nets and are now ENFORCED to match these values by sync_versions.py (a drift is
# a checker failure, not merely discouraged).
#
# After changing versions:
#   1. Run `python3 docs/scripts/sync_versions.py --write`
#   2. Update docs/linux-cross-builds.md, docs/linux-build-basics.md, AGENTS.md
# ==============================================================================

# --- Base image tooling ---
UBUNTU_VERSION=26.04
# Multi-arch manifest-LIST digest for ubuntu:${UBUNTU_VERSION} (pins the only
# floating external base). Refresh together with UBUNTU_VERSION. Fetch with:
#   curl -s "https://auth.docker.io/token?service=registry.docker.io&scope=repository:library/ubuntu:pull" | jq -r .token
#   curl -sI -H "Authorization: Bearer <tok>" -H "Accept: application/vnd.oci.image.index.v1+json" \
#     https://registry-1.docker.io/v2/library/ubuntu/manifests/${UBUNTU_VERSION} | grep -i docker-content-digest
UBUNTU_DIGEST=sha256:678c6550cc43645e08669028bc177f50be4e7c5b8cca677067b1914d4afc7a03
# Ubuntu codename for the version above (used by NVIDIA TensorRT repo paths).
UBUNTU_CODENAME=resolute
CMAKE_VERSION=4.4.2
NODE_VERSION=26.7.0
UV_VERSION=0.12.5

# --- Compiler toolchain ---
LLVM_RELEASE=22.1.8
GCC_VERSION=16.2.0

# --- Python (source-built interpreter) ---
# Single source of truth. The major.minor form (formerly PYTHON_MAJOR_MINOR /
# DEFAULT_PYTHON_VERSION) is DERIVED from this: common.sh derives it for shell
# consumers; Dockerfiles derive ARG defaults via ${PYTHON_VERSION%.*}.
PYTHON_VERSION=3.14.7
# Canonical venv location. Documentation only: the path is hardcoded as the
# literal /opt/python/.venv across the Dockerfiles/scripts, and the VENV_PATH
# *variable* is read nowhere, so there is nothing to forward.
# noforward
VENV_PATH=/opt/python/.venv

# --- Vulkan SDK ---
VULKAN_VERSION=1.4.357.1

# --- WiX Toolset (Windows-only installer authoring) ---
# Single source of truth for both the install (setup-scoop-tools.ps1) and the assert
# (verify-toolchain.ps1); surfaced as $env:* by load-versions.ps1 in Dockerfile.base.
WIX_VERSION=4.0.6
WIX_UI_EXT_VERSION=4.0.6

# --- Git for Windows (Windows-only; setup-scoop-tools.ps1 derives the installer URL:
# v<GIT_VERSION>.windows.1 tag / Git-<GIT_VERSION>-64-bit.exe) ---
GIT_VERSION=2.55.0

# --- Rust toolchain (install-rust.sh; pinned to the shipped images) ---
RUST_VERSION=1.97.1
CARGO_C_VERSION=0.10.24
RUST_NIGHTLY_TOOLCHAIN=nightly-2026-06-28

# --- SDK frameworks ---
TVM_REF=v0.26.0
# OPT-IN immutable pin for the TVM clone (tvm.sh; commit wins over the tag —
# tags are movable and TVM is a compiler whose output ships). v0.26.0 resolved
# 2026-08-18:
#   TVM_COMMIT=c7b458e946bc4266915da582457476bdcd9705ae
TVM_COMMIT=
# IREE (iree.dev) MLIR compiler + runtime. amd64/arm64 install the PyPI
# iree-base-{compiler,runtime} cp312-abi3 wheels (abi3 => valid on Python 3.14);
# riscv64 has no PyPI wheel, so build-app-wheelhouse.sh source-builds the runtime
# wheel (+ best-effort compiler) at this tag into /opt/wheels. Keep the leading
# v: the GitHub release tag is v3.11.0, the wheel/PyPI version is 3.11.0.
IREE_VERSION=v3.11.0

# --- Media libraries ---
ONNXRUNTIME_VERSION=v1.29.0
ONNXRUNTIME_GENAI_VERSION=v0.15.2
# Feature toggles (true/false), not version pins: WebGPU (Dawn) execution provider
# for ONNX Runtime. ORT_ENABLE_WEBGPU is the master switch — CURRENTLY ON (=true
# below; set to false to drop the Dawn dependency). Dawn is validated on amd64
# native; cross-compiling it to arm64/riscv64 is unproven, so it lights up there
# only when ORT_WEBGPU_ALLOW_CROSS=true is also set (also true below). Forwarded to
# Dockerfile.media's onnxruntime stage (build lib/common.sh reads the env).
# NB (LOG2, 2026-08-17): this toggle covers the NATIVE WebGPU EP only. The
# onnxruntime-WEB (WASM/JS) bundle ships WITHOUT its webgpu/jspi backends —
# 50-build-js.sh skips them because the asyncify/jspi WASM build flavors are
# not built ("Skipping ort.webgpu JS outputs"). Known + accepted for now;
# building those flavors is the open half of backlog LOG2.
ORT_ENABLE_WEBGPU=true
ORT_WEBGPU_ALLOW_CROSS=true
LITERT_VERSION=v2.2.0
# v0.14.0's OSS export shipped stale CMake (references the removed constrained_decoding
# + the now-header-only preprocessor without its CMakeLists). The Windows build script
# writes condition-gated INTERFACE stubs post-clone ([LiteRTLM-winfix export-stubs] in
# build-litert-lm-from-source.ps1); they self-retire once upstream exports are complete
# — verify whether v0.15.0 retires them on the next Windows build.
# protoc coupling re-verified for 0.16.1 (bump_versions slaved-pin derive 2026-08-18):
# upstream protobuf.cmake still pins v6.31.1, so PROTOC_VERSION=31.1 /
# PROTOBUF_VERSION=6.31.1 stay.
LITERT_LM_VERSION=0.16.1
# LiteRT for the web (prebuilt npm packages, WASM/JS — vendored, not compiled;
# https://developers.google.com/edge/litert/web). Arch-independent: the same
# assets ship to amd64/arm64/riscv64.
#   LITERTJS_VERSION       -> @litertjs/core (+ tfjs-interop, wasm-utils)  (LiteRT.js)
#   MEDIAPIPE_GENAI_VERSION -> @mediapipe/tasks-genai (LiteRT-LM's web LLM runtime)
LITERTJS_VERSION=2.5.3
MEDIAPIPE_GENAI_VERSION=0.10.29
# 5.0.0 is a released tag since 2026-06 — pinned to it (was: live branch 5.x,
# the last non-reproducible media pin). The *_COMMIT freeze pins below remain
# as an additional opt-in.
OPENCV_VERSION=5.0.0
GSTREAMER_VERSION=1.29.2
FFMPEG_VERSION=n9.0
PYAV_VERSION=18.1.0
# Feature toggle (0/1), not a version pin: enable libx265 HEVC encoding in FFmpeg.
# libx265-dev is installed on all arches; historically disabled over a source-x265
# compile break, now ENABLED by default (=1 below — ships HEVC on all arches) and
# still probe-gated so a future break degrades gracefully. Forwarded as a
# --build-arg to Dockerfile.media's ffmpeg stage (build-ffmpeg.sh reads the env).
FFMPEG_ENABLE_X265=1
# Feature toggle (0/1), not a version pin: enable FFmpeg's TensorFlow DNN
# backend (--enable-libtensorflow). OFF by default: it is one OPTIONAL DNN
# backend most users never touch, yet its C SDK drags ~500 MB into every
# amd64 media+runtime image (libtensorflow.so ~447 MB + libtensorflow_framework
# ~50 MB, bundled into /opt/ffmpeg/lib). The ONNX Runtime DNN backend stays
# ALWAYS-ON regardless — this toggle gates ONLY TensorFlow. When off, the TF C
# SDK download, the --enable-libtensorflow configure flag, and the runtime-lib
# bundling are ALL skipped (the ~500 MB never enters the image). To enable, set
# to 1 (amd64 only; upstream ships no arm64/riscv64 libtensorflow C build).
# Forwarded as a --build-arg to Dockerfile.media's ffmpeg stage (build-ffmpeg.sh
# reads the env), exactly like FFMPEG_ENABLE_X265 above.
FFMPEG_ENABLE_TF=0
# Reproducibility pins (OPT-IN). OPENCV_VERSION above is now the released 5.0.0
# TAG (reproducible; it previously tracked the live 5.x branch); FFMPEG_VERSION is
# a release TAG since 2026-08-04 (n9.0 — it previously tracked master, which by
# then WAS the 9.0 dev line).
# To freeze a build to an immutable commit, set the matching *_COMMIT to a
# 40-hex SHA (empty = keep tracking branch/tag). build-opencv.sh /
# build-ffmpeg.sh / clone_or_update_repo consume these. Known-good HEADs
# captured 2026-07-08:
#   OPENCV_COMMIT=4ce2389a624ebfb846f06d055026723e3a0a564a
#   OPENCV_CONTRIB_COMMIT=755e50675d97db9b7d449d8bd6b09888646f6c6e
#   FFMPEG_COMMIT=c29d710cd5d0f80bbb56f7ec1f35d5fb7ed44d05
OPENCV_COMMIT=
OPENCV_CONTRIB_COMMIT=
FFMPEG_COMMIT=
VVDEC_VERSION=v3.2.0
# libcamera (git.libcamera.org, GitHub mirror libcamera-org/libcamera). Was the
# ONLY media library cloned UNPINNED (upstream master, non-reproducible) until
# 2026-08-08; the generated Python wheel also carried a hardcoded stale version.
# Tag, branch, or 40-hex commit SHA (clone_or_update_repo handles all three).
LIBCAMERA_VERSION=v0.7.2
# FFmpeg DNN-backend SDKs (build-ffmpeg.sh reads these as env defaults).
# 2.18.0 is the LAST libtensorflow C build upstream ever published (verified
# 2026-08-08: GitHub releases >=2.19 carry zero assets; the GCS mirror at
# storage.googleapis.com/tensorflow/versions/ ends at 2.18.0, x86_64 only).
# Do NOT bump past it until upstream resumes C-library builds.
# TENSORFLOW_C: 2.18.1 is the LAST version with a published libtensorflow C
# tarball (2.19+ return 404 on storage.googleapis.com — upstream stopped
# shipping the C archive; verified 2026-08-19). Do NOT bump past it until the
# ffmpeg TF backend gains another source. bump_versions reports the git tag,
# which is NOT the artifact.
TENSORFLOW_C_VERSION=2.18.1
# sha256 of libtensorflow-cpu-linux-x86_64.tar.gz from the GCS mirror. Fetch:
#   curl -fL https://storage.googleapis.com/tensorflow/versions/${TENSORFLOW_C_VERSION}/libtensorflow-cpu-linux-x86_64.tar.gz | sha256sum
# noforward
# bump:hold — F6: frozen with TENSORFLOW_C_VERSION above (2.18.0 is the LAST
# libtensorflow C build upstream published; there is nothing newer to bump to,
# so this SHA is intentionally static, not an un-triaged stray).
TENSORFLOW_C_SHA256=b692795f3ad198c531b02aeb2bc8146568d24aaf6a5dbf5faa43907c4028fd73
OPENVINO_VERSION=2026.3.0
# ArmNN + Arm Compute Library (arm64 media stage) and librice (gstreamer
# webrtcbin2 C library) — build scripts read these as env defaults.
ARMNN_VERSION=v26.07
ACL_VERSION=v53.2.0
RICE_VERSION=v0.4.3

# --- Library build dependencies (cross-compile fallbacks / header tarballs) ---
ABSEIL_VERSION=20260817.0
# Immutable pins for the abseil header tarball (abseil-headers.sh): the
# /archive/<commit>.tar.gz form is byte-stable, the tag form is not. Both
# refresh together with ABSEIL_VERSION (git ls-remote tag → commit; then
#   curl -fL https://github.com/abseil/abseil-cpp/archive/${ABSEIL_COMMIT}.tar.gz | sha256sum
# noforward
ABSEIL_COMMIT=2065f4ded0558c6f89fee67c8e5228feb4eb960e
# noforward
ABSEIL_TARBALL_SHA256=7f4240fe135c0b0dcdd2efa664f1393b1da7e25031e17560515f452182aa0c5e
FREETYPE_VERSION=2.14.3
# libpng cross-compile fallback for riscv64 OpenCV: OpenCV 5.x's vendored libpng
# fails its RISC-V Vector configure probe under GCC 16.1.0, and Ubuntu Ports'
# libpng-dev:riscv64 dep set is frequently broken, so the riscv64 OpenCV build
# links an external libpng that install-deps.sh cross-compiles from this tag.
LIBPNG_VERSION=1.6.58
GOBJECT_INTROSPECTION_VERSION=1.86.0
# nv-codec-headers (ffnvcodec) — FFmpeg NVENC/NVDEC/CUVID headers. Must be a REAL upstream tag:
# the repo's tags are 4-part (n12.2.72.0, n13.0.19.0, ...); the old n12.2.1 does not exist, so the
# clone 404'd and NVENC was silently skipped on both lanes. n12.2.72.0 satisfies FFmpeg master's
# `ffnvcodec >= 12.1` requirement and is broadly driver-compatible.
NV_CODEC_HEADERS_REF=n13.1.15.0

# --- PyTorch / TorchVision (riscv64 cross wheel builds) ---
PYTORCH_VERSION=v2.13.0
TORCHVISION_VERSION=v0.28.0

# --- AMD GPU ---
# HELD at 7.2.4 deliberately (2026-08-08): upstream is at 7.14.0 under AMD's
# new "TheRock" modular release system, but repo.radeon.com/rocm/apt/7.14[.0]/
# returns 404 — the old apt path setup-rocm-repo.sh consumes does not carry the
# new releases. Bumping requires migrating setup-rocm-repo.sh to the new
# distribution first; MIGRAPHX_VERSION moves together with it.
ROCM_VERSION=7.2.4
MIGRAPHX_VERSION=2.14.0

# --- Flutter SDK ---
FLUTTER_VERSION=3.47.0

# --- Flatpak runtime/SDK (packaging-deps.sh, app packaging lane) ---
FLATPAK_RUNTIME_VERSION=24.08

# --- Runtime orchestrator ---
APP_REF=v0.0.27

# --- LLM stack (Ollama) ---
# renovate: datasource=github-releases depName=ollama/ollama extractVersion=^v(?<version>.*)$
OLLAMA_VERSION=0.32.14

# --- Android SDK / NDK ---
ANDROID_SDK_VERSION=15859902
ANDROID_NDK_VERSION=29.0.14206865
ANDROID_COMPILE_SDK=36
ANDROID_BUILD_TOOLS=36.0.0
ANDROID_CMAKE_VERSION=4.1.2
ANDROID_API_LEVEL=34

# --- NVIDIA GPU (single source for BOTH Windows and Linux) ---
# Full semvers pinning the SAME release on both platforms. Each consumer
# derives its platform form:
#   Linux (Dockerfile.nvidia):  13.3.0 → 13-3 apt package suffix; cuDNN major
#                               (9) for apt package names; exact-version apt
#                               pins from the full semvers where available.
#   Windows (build.ps1):        full semvers consumed directly by the CUDA
#                               installer / cuDNN download / TensorRT zip;
#                               dotted major.minor (13.3) derived in build.ps1.
CUDA_VERSION=13.3.1
CUDNN_VERSION=9.25.0.15
# TensorRT (Windows): OPTIONAL — place the TensorRT-*.zip in windows/downloads/
# (EULA-gated manual download) to include it. Without the zip the -Gpu lane
# builds fine: setup-tensorrt.ps1 warns and skips, CUDA + cuDNN still work and
# ORT auto-disables the TensorRT EP (the smoke test's TENSORRT_ROOT pointer
# passes on the guaranteed-empty C:\tensorrt). A 2026-08-04 fail-fast variant
# broke the zip-less lane and was reverted 2026-08-05.
# ONE pin for BOTH lanes (owner decision 2026-08-08; a brief per-lane split was
# reverted the same day). Both consume it, differently:
#
#   Windows — MUST MATCH THE DIRECTORY NAME INSIDE the zip staged in
#     windows/downloads/. It is not merely a download coordinate:
#     windows/Dockerfile.nvidia builds the runtime PATH out of it
#       ENV PATH=…;$TENSORRT_ROOT\TensorRT-$TENSORRT_VERSION\lib;$PATH
#     while setup-tensorrt.ps1 extracts whatever the archive contains. An
#     11.2.1.2 zip against a 11.1.0.106 pin put a NONEXISTENT directory on
#     PATH: DLLs on disk but unreachable, ORT dropping the TensorRT EP at
#     runtime with no error and a build log still reading "installation
#     complete". Bump this WITH the staged zip, never alone.
#
#   Linux — install-tensorrt.sh asks apt for `tensorrt-dev=${VERSION}*`. NVIDIA
#     Enterprise builds are NOT in the public apt repo, so this value can be
#     unservable there. That is tolerated (the script falls back to the newest
#     available) but is NO LONGER SILENT: the fallback prints a WARNING banner
#     naming both versions, so an unpinned Linux TensorRT is visible in the log
#     instead of one `echo` among thousands.
# OWNER DIRECTIVE 2026-08-14: ALWAYS TRACK THE NEWEST TENSORRT RELEASE.
# Never resolve a pin-vs-staged-zip mismatch by pinning BACKWARDS — stage the
# newer zip into windows/downloads/ instead, recompute TENSORRT_ZIP_SHA256, and
# DELETE the superseded zip (two zips present means the extract picks one of
# them; it version-sorts descending now, but the dead ~2 GB still bloats the
# `COPY downloads` layer). The zip is an EULA-gated manual NVIDIA download, so
# CI cannot fetch it.
TENSORRT_VERSION=11.2.1.2
# Target GPU architectures for all CUDA source builds (ONNX Runtime, OpenCV).
# Consumers decorate per build system: Windows clang-cl builds append `-real`;
# the Linux ONNX build maps the trailing 90 -> 90a (Hopper arch-specific kernels).
# Tip: set to just your local GPU's arch (e.g. 86) to roughly quarter CUDA build time.
CUDA_ARCHITECTURES=80;86;89;90

# --- Windows build image ---
# LTSC version for the Windows Server Core base image FROM tag
WINDOWS_LTSC=2025
# PowerShell 7 (pwsh) version installed as the default shell in the Windows
# container base image. Downloaded as ZIP from GitHub releases.
PWSH_VERSION=7.6.4
# Windows SDK build (VS component Microsoft.VisualStudio.Component.Windows11SDK.<build>).
# Reaches setup-vs.ps1 as a --build-arg via build.ps1 + Dockerfile.base ARG -- NOT via
# load-versions.ps1, which deliberately runs after the VS install. 26100 = Win 11 24H2 SDK.
WINDOWS_SDK_BUILD=26100
# Visual Studio major (setup-vs.ps1 installs the latest stable; this pins the
# expected major for smoke-test-container.ps1 path assertions).
VISUAL_STUDIO_VERSION=18
# --- Windows scoop toolchain pins (setup-scoop-tools.ps1) --------------------
# These three produce or shape COMPILED OUTPUT, so they are pinned like every
# other build input. Everything else scoop installs there (7zip, nano, cppcheck,
# sccache, nsis, uv, nuget, zlib, openssl, pkg-config, make, gawk) is a tool the
# build only *invokes*, and stays on scoop's current manifest deliberately.
#
# LLVM (clang-cl + lld-link) is THE compiler for the whole Windows media chain,
# and five of the patches in windows/scripts/patches/ are clang-cl-version-
# shaped (softmax keywords, opencv cmake compat, cudev LLP64, iree /EHsc, the
# litert-lm winfixes). Unpinned, a base rebuild months from now silently swaps
# the compiler and the breakage surfaces ~2 h into media-core with no way to
# reproduce the image that worked. Pinned 2026-08-07 to the version scoop's
# manifest served that day, i.e. the pin is a no-op for the next rebuild and a
# guarantee for every one after it. Bump DELIBERATELY, then re-verify the
# patches above (Test-PatchesApplyClean.ps1) on the rebuilt base.
LLVM_WINDOWS_VERSION=22.1.8
# ninja: build-graph executor for every CMake source build in the chain.
NINJA_WINDOWS_VERSION=1.13.2
# nasm: assembles FFmpeg's hand-written x86 SIMD -- a version bump changes the
# generated object code in the shipped ffmpeg/libav* binaries.
NASM_WINDOWS_VERSION=3.02
# sccache: PINNED 2026-08-08, and the reason differs from the three above --
# it shapes no output at all, it gates a FEATURE. Multi-tier caching
# (SCCACHE_MULTILEVEL_CHAIN, an ARG in Dockerfile.media-builder) landed in
# v0.16.0 (2026-06-19, PR #2581). On anything older the chain variable is
# ignored SILENTLY: the local L0 tier simply does not exist, every compile
# goes back to a WebDAV round-trip, and nothing anywhere reports it.
# NOTE 2026-08-16: the chain is currently DEFAULTED OFF (WebDAV only) because
# BuildKit's Windows cache mounts lose writes into an inherited directory --
# see docs/windows-builds.md #99. The pin stays: the feature is wanted back as
# soon as WCOW cache mounts are proven, and dropping to a pre-0.16 sccache
# would then re-introduce the silent-ignore failure this comment is about. That is
# the failure shape this repo spends its gates eliminating, so the version the
# feature needs is pinned rather than hoped for. verify-toolchain.ps1 asserts
# it at base-build time. 0.17.0 = what scoop served on 2026-08-08, measured
# from the chain's own log.
SCCACHE_WINDOWS_VERSION=0.17.0
# sccache is BUILT FROM SOURCE at this commit on Windows, and the released
# 0.17.0 above is only the scoop baseline it overwrites on PATH.
#
# Why: wrapping nvcc with released sccache BREAKS this build outright —
#   fatbinary fatal : Could not open input file 'activations_impl.compute_80.cubin'
# sccache decomposes nvcc by parsing `nvcc --dryrun`, and with CUDA 13.3.33
# `cicc` dryrun output places `--simt-only` AFTER the input file. sccache's
# positional parser then took `--simt-only` as the input, mis-grouped the cicc
# and ptxas device steps, and the per-arch .cubin files were never produced —
# upstream's own words in mozilla/sccache#2722, which is exactly our failure.
#
# That PR merged 2026-08-04. v0.17.0 shipped 2026-07-29, FIVE DAYS EARLIER, so
# no released sccache can do this yet. Pinned to the merge commit rather than a
# branch so the base stays reproducible; drop this and the source build once a
# release contains the fix (check: does v0.18.0+ include #2722?).
#
# 2026-08-10 addendum (measured on the winamd64 chain, runs 6+7): even AT this
# commit the nvcc decomposition is not chain-safe - the sccache server dies
# deterministically on the ONNX fused_moe_gemm generated launchers (~4910 s
# into the compile, clients get `os error 10054`), and the identical
# run-over-run timeline suggested a ~zero CUDA hit-rate at this commit
# (now measurable: build-onnx emits sccache stats to stderr after the build).
# The Windows ONNX build scopes a BARE nvcc onto the crash source only
# (patch 006: onnxruntime_providers_cuda_llm's CUDA_COMPILER_LAUNCHER
# property) - every other CUDA target stays wrapped and cacheable. Before
# re-wrapping cuda_llm, a candidate sccache must pass BOTH
# windows\diagnosticserify-cuda-cache.ps1 AND an ONNX canary through the
# fused_moe launchers.
#
# NB `cargo install` here is not version-pinnable as a check: main still reports
# package version 0.17.0, so `sccache --version` CANNOT distinguish the fixed
# build from the broken one. verify-toolchain.ps1 therefore asserts that the
# resolved sccache comes from CARGO_BIN, not from the scoop shims.
SCCACHE_GIT_REV=e9b15a35f7240a7edd1b9644583edb388c6cb5f9
# vcpkg toolchain ref (pinned release tag; setup-vcpkg.ps1 downloads this).
# MUST be >= 2026.06: older snapshots pin a vcpkg-tool that predates VS 18 and
# rejects its v145 toolset with a misleading "Unable to find a valid Visual
# Studio instance" (2026-07-12 base-build failure; VS itself was fine). 2026.06.24
# matches the verified windows-base snapshot (tool 2026-05-27, protobuf 6.33.4).
VCPKG_REF=2026.07.29
# Host protoc for LiteRT-LM codegen. NOT independent software: it must match the
# protobuf runtime pinned INSIDE LiteRT-LM's cmake/packages/protobuf/protobuf.cmake
# (v0.14.0 pins v6.31.1 -> protoc 31.1). Auto-bumping to latest protoc emits gencode
# the pinned runtime headers #error on (bit us 2026-08-03: 35.1 vs 6.31.1). Re-derive
# from upstream's protobuf.cmake whenever LITERT_LM_VERSION moves.
# bump:hold slaved to LiteRT-LM's internal protobuf pin, not a standalone tool
PROTOC_VERSION=31.1
# Protobuf runtime built by LiteRT-LM's protobuf_external (informational;
# matched to PROTOC_VERSION above).
# bump:hold slaved to LiteRT-LM's internal protobuf pin (see PROTOC_VERSION)
PROTOBUF_VERSION=6.31.1
# Temurin JRE major (ANTLR codegen in LiteRT-LM; fetched via adoptium API).
JRE_VERSION=21
# ANTLR version (fetched by LiteRT-LM's CMake; documentary).
ANTLR_VERSION=4.13.2
# libffi meson-port version (GStreamer wrap pre-extract).
LIBFFI_MESON_VERSION=3.2.9999.4

# --- Python build-executor pins (supply-chain audit #18) ---
# These packages EXECUTE code at build time (code generators / build
# frontends). They were installed unpinned from PyPI at ~20 sites — the
# single largest non-reproducibility surface: the same commit built
# differently every day, and a malicious release of any of them executes
# arbitrary code in the build. Frozen 2026-08-08 to the versions the builds
# were already resolving; bump deliberately, all together, with a real build.
# noforward
PY_MESON_VERSION=1.12.0
# noforward
PY_NINJA_VERSION=1.13.0
# noforward
PY_CYTHON_VERSION=3.2.9
# noforward
PY_PYBIND11_VERSION=3.1.0
# noforward
PY_SETUPTOOLS_VERSION=84.0.0
# The torch wheelhouse constrains setuptools<82 (torch build compat) — its
# pinned value within that constraint:
# noforward
PY_SETUPTOOLS_LT82_VERSION=81.0.0
# noforward
PY_WHEEL_VERSION=0.48.0
# noforward
PY_SCIKIT_BUILD_CORE_VERSION=1.0.3
# noforward
PY_SETUPTOOLS_SCM_VERSION=10.2.1
# auditwheel/patchelf REWRITE shipped wheel binaries (RPATH grafting) — the
# most binary-shaping executors of all:
# noforward
PY_AUDITWHEEL_VERSION=6.8.1
# noforward
PY_PATCHELF_VERSION=0.19.1.0

# --- Supply-chain pins (audit round 3): trust anchors + build-time toolchains ---
# Vulkan SDK tarball (sdk.lunarg.com; ships glslang/spirv-tools used at build
# time). Bump together with VULKAN_VERSION:
#   curl -fL https://sdk.lunarg.com/sdk/download/${VULKAN_VERSION}/linux/vulkansdk-linux-x86_64-${VULKAN_VERSION}.tar.xz | sha256sum
# noforward
VULKAN_SDK_SHA256=4b41e3b30e8aedaa5dac7c136561ab463eb316a25a54e2c6245f2c299ea1fb85
# Prebuilt GStreamer Android universal tarball (fallback path of the android
# gstreamer build). Bump together with GSTREAMER_VERSION:
#   curl -fL https://gstreamer.freedesktop.org/data/pkg/android/${GSTREAMER_VERSION}/gstreamer-1.0-android-universal-${GSTREAMER_VERSION}.tar.xz | sha256sum
# noforward
GSTREAMER_ANDROID_UNIVERSAL_SHA256=86e647c6b7c4e7fa0e7814008749cc8401716ff45c5724e029b1baf953bbd96c
# NVIDIA CUDA apt keyring deb — the apt TRUST ANCHOR for the whole -Gpu lane.
# The filename is version-frozen (1.1-1). Fetch:
#   curl -fL https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/<x86_64|sbsa>/cuda-keyring_1.1-1_all.deb | sha256sum
# noforward
CUDA_KEYRING_DEB_SHA256_X86_64=d2a6b11c096396d868758b86dab1823b25e14d70333f1dfa74da5ddaf6a06dba
# noforward
CUDA_KEYRING_DEB_SHA256_SBSA=6ea7d2737648936820e85677177957a0f6521b840d98eb0bbae0a4f003fa7249
# AMD ROCm apt signing key (repo.radeon.com/rocm/rocm.gpg.key):
# noforward
# bump:hold — F6: a GPG SIGNING KEY, not a version. It changes only when AMD
# rotates the key (rare, manual); there is no version to bump it in step with,
# so it is intentionally static, not an un-triaged stray. Refresh by hand from
# the URL above if repo.radeon.com signature verification ever starts failing.
ROCM_GPG_KEY_SHA256=2de99e2354646a90d9903e2a669fc4e36b02c1bbff7075c481e12d7edab2c88b
# Android commandlinetools zip (dl.google.com; sdkmanager bootstraps the NDK
# cross compiler from it). Bump together with ANDROID_SDK_VERSION:
#   curl -fL https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_SDK_VERSION}_latest.zip | sha256sum
# noforward
ANDROID_CMDLINE_TOOLS_SHA256=4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583
# Flutter SDK tarball — official sha256 from releases_linux.json (stable
# channel entry for ${FLUTTER_VERSION}). One value: the Linux archive is
# x86_64-only (arm64 hosts run the same tooling under emulation).
# noforward
FLUTTER_SDK_SHA256=26cd99d3d94b1367e6b50535a18aeef0282c10a535bbe3ec493534dcdab75296

# --- Cross-build defaults ---
# `# noforward` marks the variable on the NEXT line as orchestrator/host-only:
# version-forwarding.sh forwards every other variable in this file as a
# --build-arg to nerdctl build.
# noforward
CROSS_DEFAULT_ARCHES=amd64,arm64,riscv64
# noforward
FAST_UBUNTU_MIRROR_URL_DEFAULT=https://archive.ubuntu.com/ubuntu/

# --- Image registry ---
# noforward
IMAGE_REGISTRY_PREFIX=ghcr.io/kataglyphis/kataglyphis_beschleuniger

# --- Documentation image (external/Kataglyphis-DocumANTation/Dockerfile) ---
# The `pandoc_all` image that builds the book, dissertation, slides and CV. It
# is standalone rather than part of the cross chain, so its pins are marked
# noforward -- nothing passes them as --build-arg to the Linux images. They live
# here anyway so a version still changes in exactly one place, and
# sync_versions.py keeps that Dockerfile's ARG defaults equal to these.
# renovate: datasource=github-releases depName=jgm/pandoc
# noforward
PANDOC_VERSION=3.10.2

# --- binaryen / wasm-opt (WebAssembly size optimisation) ---
# Bootstrapped on demand by linux/scripts/lib/wasm-opt.sh and
# windows/scripts/modules/WindowsWasmOpt.Common.psm1 when wasm-opt is not
# already on PATH; no image installs it, hence noforward. Both the bash and the
# PowerShell side read the version AND the checksums from this file, so the pin
# lives in exactly one place across the two languages. Bump the version and BOTH
# checksums together. Fetch with:
#   curl -fL https://github.com/WebAssembly/binaryen/releases/download/${BINARYEN_VERSION}/binaryen-${BINARYEN_VERSION}-x86_64-<linux|windows>.tar.gz | sha256sum
# renovate: datasource=github-releases depName=WebAssembly/binaryen
# noforward
BINARYEN_VERSION=version_132
# noforward
BINARYEN_LINUX_X86_64_SHA256=195ddc94f9bc89f45abdabb0b9eea86023d727ba90eac8b35b80f2544fc30572
# aarch64 pin was MISSING while wasm-opt.sh built the aarch64 asset name — on
# an arm64 host the download died "No pinned binaryen SHA256" (orphan-sweep 2a).
# noforward
BINARYEN_LINUX_AARCH64_SHA256=c58562417836c5d0493d89bdefc434933bdc097db641b483df86bcfa557a107f
# noforward
BINARYEN_WINDOWS_X86_64_SHA256=2089428ec98c899b45ee5d00636ddd6e2da8636cc473ef50b165cc25793ef7cb

# --- hadolint (Dockerfile lint gate) ---
# Bootstrapped on demand by linux/scripts/lint-dockerfiles.sh when hadolint is
# not already on PATH; no image installs it, hence noforward. Bump the version
# and ALL checksums together. Fetch with:
#   curl -fL https://github.com/hadolint/hadolint/releases/download/${HADOLINT_VERSION}/hadolint-<linux-x86_64|linux-arm64|windows-x86_64.exe> | sha256sum
# renovate: datasource=github-releases depName=hadolint/hadolint
# noforward
HADOLINT_VERSION=v2.15.1
# noforward
HADOLINT_LINUX_X86_64_SHA256=c7187db94eeeeca956519a6af171adc31453941a1e777961f6e680f697c8c507
# noforward
HADOLINT_LINUX_ARM64_SHA256=f6198ef8090f404dbb771abfee086eb8c48ac177f30da7fd3510aca35b344b5d
# noforward
HADOLINT_WINDOWS_X86_64_SHA256=01d927294962b5387f9ead4f18679158452be4f17c765ad0bdffe5264b9c7b0a

# --- actionlint (GitHub workflow/composite-action lint gate) ---
# Bootstrapped on demand by linux/scripts/lint-workflows.sh. Bump the version
# and ALL checksums together. Fetch with:
#   curl -fL https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_<linux_amd64.tar.gz|linux_arm64.tar.gz|windows_amd64.zip> | sha256sum
# renovate: datasource=github-releases depName=rhysd/actionlint extractVersion=^v(?<version>.*)$
# noforward
ACTIONLINT_VERSION=1.7.12
# noforward
ACTIONLINT_LINUX_AMD64_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
# noforward
ACTIONLINT_LINUX_ARM64_SHA256=325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6
# noforward
ACTIONLINT_WINDOWS_AMD64_SHA256=6e7241b51e6817ea6a047693d8e6fed13b31819c9a0dd6c5a726e1592d22f6e9

# servercore base image digest: pins the exact monthly-patched Windows base the
# chain builds FROM (a floating :ltsc2025 tag silently moves on patch Tuesday,
# and base-image build revisions genuinely matter on this lane — see the wcifs
# commit-bug diagnosis). Bump deliberately together with a from-base rebuild:
#   curl -sI -H "Accept: application/vnd.docker.distribution.manifest.list.v2+json" https://mcr.microsoft.com/v2/windows/servercore/manifests/ltsc${WINDOWS_LTSC} | grep -i docker-content-digest
# noforward
WINDOWS_BASE_DIGEST=sha256:d5bbb83057f6bc2b6aeba5d01ec80a53003aba9bc84a6b1ebe780570cd52558a

# --- Windows toolchain download checksums ---
# Consumed inside the Windows images: as baked env (load-versions.ps1) for the
# setup scripts, and as the PWSH_ZIP_SHA256 ARG in windows/Dockerfile.base for
# the pwsh bootstrap that runs before any module is available. Update together
# with the corresponding *_VERSION key. Windows-only, hence noforward.
# pwsh zip + git installer: GitHub publishes per-asset sha256 digests
# (https://api.github.com/repos/<owner>/<repo>/releases/tags/<tag>, assets[].digest).
# noforward
PWSH_ZIP_SHA256=80832551c52809301e6071c8bac977beb5a2f1ec953eb4db9f94deb953333793
# noforward
GIT_WINDOWS_INSTALLER_SHA256=0c66e4a5875da5a74f9754386de7555ba301503b03bbdcdbafa69dc6464e548d
# nuget.exe: versioned dist URL (https://dist.nuget.org/tools.json lists releases).
#   curl -fL https://dist.nuget.org/win-x86-commandline/v${NUGET_VERSION}/nuget.exe | sha256sum
# noforward
NUGET_VERSION=7.6.0
# noforward
NUGET_EXE_SHA256=751ee5e79481626a428c1241dc7f94bca2739b32588e669715bc5fb54d8fb8a2
# CUDA full local installer (cuda_${CUDA_VERSION}_windows.exe): NVIDIA publishes
# only MD5 (docs/sidebar/md5sum.txt); this SHA256 was computed from a download
# whose MD5 matched the published value. cuDNN: sha256 straight from NVIDIA's
# redist manifest (compute/cudnn/redist/redistrib_${CUDNN_VERSION%.*}.json).
# noforward
CUDA_INSTALLER_SHA256=d68839fcce644576f0a1c6b066e0c5bc146a62db2fcac9fc6b4e6418e7ec533f
# noforward
CUDNN_ZIP_SHA256=1ee69c966cfd43d883d7e00e10b6e3052112a7b2abd2a9b0ef293eea1eae5f1e
# get.scoop.sh installer script: hash-pinned so the code we execute is the code
# we reviewed. Scoop revs this file occasionally — a mismatch is the gate doing
# its job: re-download, review, and bump this hash deliberately.
#   curl -fL https://get.scoop.sh | sha256sum
# noforward
SCOOP_INSTALLER_SHA256=48f6ea398b3a3fa26fae0093d37bd85b13e7eaa5d1d4a3e208408768408e35ae
# TensorRT zip is an EULA-gated manual download whose exact file varies per
# user; empty = skip verification. Set to the sha256 of YOUR downloaded zip to
# pin it (Get-FileHash windows\downloads\TensorRT-*.zip).
# Set 2026-08-14 for TensorRT-Enterprise-11.2.1.2-Windows-amd64-cuda-13.3-Release-external.zip
# (1,988,242,024 bytes). It was EMPTY before, so ~2 GB of EULA-gated payload
# entered the image unverified. RE-COMPUTE THIS WHENEVER THE ZIP IS RESTAGED —
# a stale hash fails the build loudly, which is the intended behaviour.
# noforward
TENSORRT_ZIP_SHA256=9cdb433f0f3803bc854d4b13eb7bd42a4aef1962749349be62d97c0f64c8f9b6

# Ollama release tarballs (host-side download by llm-stack/scripts/download-ollama.sh;
# per-asset sha256 digests published on the GitHub release API). Bump with OLLAMA_VERSION.
# noforward
OLLAMA_AMD64_SHA256=c620917a71e146ab3a7f893084f066069c4c65d144ef8379a91c3cbe8b27de8f
# noforward
OLLAMA_ARM64_SHA256=7802b739fbdc74df556600f1619f86457b69dce913301cf2d91f7f9d7f7a41b8

# --- Download verification checksums (update when bumping versions) ---
NODE_AMD64_SHA256=982aa24dd8be4c889c6a8ab337ddff3b0896645b20f4239356e80552c16277ee
NODE_ARM64_SHA256=afc7a004018485092ac8985b817b0d5684472bd9472e0b57d2ab88737e50090d
