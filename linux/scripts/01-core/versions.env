# llama.cpp's Windows ROCm zip (windows/Dockerfile.rocm-llama); its rocm-X.Y must match ROCM_WINDOWS_RELEASE. Bump all five
# LLAMA_CPP_* together (bump_versions.py): SHA256 = the asset's digest (b11115: 256,736,867 B, 2026-09-22), LICENSE_SHA256 = the tag's LICENSE.
#   gh api repos/ggml-org/llama.cpp/releases/tags/b<BUILD> --jq '.assets[] | select(.name=="<ASSET>").digest'
# renovate: datasource=github-tags depName=ggml-org/llama.cpp extractVersion=^b(?<version>\d+)$ versioning=regex:^(?<major>\d+)$
LLAMA_CPP_HIP_BUILD=11115
LLAMA_CPP_HIP_ASSET=llama-b11115-bin-win-rocm-10.0-x64.zip
LLAMA_CPP_HIP_SHA256=8d80e3570c03dcb9033b59e5a41d0d101ba363f3d1b0b7334f7dcd7bbb9d2633
LLAMA_CPP_HIP_LICENSE_SHA256=94f29bbed6a22c35b992c5c6ebf0e7c92f13b836b90f36f461c9cf2f0f1d010d
# The same build's Vulkan zip (ggml-vulkan): its name follows from LLAMA_CPP_HIP_BUILD and it shares the LICENSE pin, so only
# its digest is pinned (llama-b11115-bin-win-vulkan-x64.zip, 31,973,078 B, 2026-09-23).
LLAMA_CPP_VULKAN_SHA256=a9ffe9b9a97a3303f75a7ac56e2da76902981846dfdfa4b54d7fca7b89f2b0fc
# AMD MIGraphX from source (windows/Dockerfile.rocm-migraphx, rocm lane only): tag rocm-10.0
# (= MIGRAPHX_VERSION, lightweight tag, so the value IS the commit). Every SHA below was measured
# 2026-09-23 with `curl -fL <url> | sha256sum`; the URLs are built in Build-MigraphxFromSource.ps1.
MIGRAPHX_WINDOWS_COMMIT=becdb3da862f2297041b746b90bc6130e2b1d1f7
MIGRAPHX_WINDOWS_SOURCE_SHA256=52038e4cd6eadc88e8f66c51b255263c2c58a84f90aeb7c76c322880864bf8b4
# Its host-C++ deps at that tag's requirements.txt pins (abseil, protobuf v30.0, msgpack-c cpp-3.3.0,
# sqlite 3.50.4 = 3500400 from sqlite.org/<YEAR>/). Re-derive all four with a MIGraphX bump.
MIGRAPHX_WINDOWS_ABSEIL_VERSION=20250512.0
MIGRAPHX_WINDOWS_ABSEIL_SHA256=7262daa7c1711406248c10f41026d685e88223bc92817d16fb93c19adb57f669
MIGRAPHX_WINDOWS_PROTOBUF_VERSION=30.0
MIGRAPHX_WINDOWS_PROTOBUF_SHA256=9df0e9e8ebe39f4fbbb9cf7db3d811287fe3616b2f191eb2bf5eaa12539c881f
MIGRAPHX_WINDOWS_MSGPACK_VERSION=3.3.0
MIGRAPHX_WINDOWS_MSGPACK_SHA256=6e114d12a5ddb8cb11f669f83f32246e484a8addd0ce93f274996f1941c1f07b
MIGRAPHX_WINDOWS_SQLITE_VERSION=3500400
MIGRAPHX_WINDOWS_SQLITE_YEAR=2025
MIGRAPHX_WINDOWS_SQLITE_SHA256=1d3049dd0f830a025a53105fc79fd2ab9431aea99e137809d064d8ee8356b032
# AMD's out-of-tree ORT plugin EP (onnxruntime/onnxruntime-ep-amdgpu): no tags, so a commit on
# branch gpuep-releases/gpuep-rel-2611. The *_VERSION pins below must equal its src/CMakeLists.txt
# FetchContent URLs (upstream declares no URL_HASH; the build refuses a mismatch), plus the abseil
# that protobuf v34.1 fetches (its cmake/dependencies.cmake). Bump them together.
ORT_AMDGPU_EP_COMMIT=99ab5cb43caa421e0b19870fa4ce9323117e5e56
ORT_AMDGPU_EP_SOURCE_SHA256=4012b64328a541089b7c6f034051bc9695b395331e06cd74181e235ee0cb42bd
ORT_AMDGPU_EP_FMT_VERSION=12.1.0
ORT_AMDGPU_EP_FMT_SHA256=695fd197fa5aff8fc67b5f2bbc110490a875cdf7a41686ac8512fb480fa8ada7
ORT_AMDGPU_EP_GSL_VERSION=4.2.1
ORT_AMDGPU_EP_GSL_SHA256=c9291d95f5f6e5c561990d06a589b01d89e553d0f366f0ce723dd1788e7a6076
ORT_AMDGPU_EP_JSON_VERSION=3.12.0
ORT_AMDGPU_EP_JSON_SHA256=42f6e95cad6ec532fd372391373363b62a14af6d771056dbfc86160e6dfff7aa
ORT_AMDGPU_EP_ZLIB_VERSION=1.3.1
ORT_AMDGPU_EP_ZLIB_SHA256=38ef96b8dfe510d42707d9c781877914792541133e1870841463bfa73f883e32
ORT_AMDGPU_EP_PROTOBUF_VERSION=34.1
ORT_AMDGPU_EP_PROTOBUF_SHA256=a79296d3ee43cab5cf72fe702ba8822a607720704c439fad6f285a37f51550b4
ORT_AMDGPU_EP_ABSEIL_VERSION=20250512.1
ORT_AMDGPU_EP_ABSEIL_SHA256=9b7a064305e9fd94d124ffa6cc358592eb42b5da588fb4e07d09254aa40086db
ORT_AMDGPU_EP_ONNX_VERSION=1.21.0
ORT_AMDGPU_EP_ONNX_SHA256=b8b56570d94ecce49fee94e6380db456bb42035722b967015c9dd6459359433e
ORT_AMDGPU_EP_FLATBUFFERS_VERSION=25.12.19
ORT_AMDGPU_EP_FLATBUFFERS_SHA256=f5d4636bfc4d30c622c9ad238ce947848c2b90b10aecd387dc62cdee2584359b
ORT_AMDGPU_EP_RANGE_V3_VERSION=0.12.0
ORT_AMDGPU_EP_RANGE_V3_SHA256=cbcb96beda464e71d293c07dec89ef5c0790ca83d37b0e199890893019441044

# --- Flutter SDK ---
# renovate: datasource=flutter-version depName=flutter
FLUTTER_VERSION=3.47.4

# --- Flatpak runtime/SDK (packaging-deps.sh, app packaging lane) ---
FLATPAK_RUNTIME_VERSION=24.08
# openh264 is versioned independently of the 24.08 runtime branch.
# renovate: datasource=github-releases depName=cisco/openh264 extractVersion=^v(?<version>.*)$
FLATPAK_OPENH264_VERSION=2.6.0
# The web lane: flutter_rust_bridge_codegen build-web shells out to wasm-pack,
# and both used to be a from-source `cargo install` in every consumer run (258
# and 174 crates). docs/consumer-image-contract.md#the-web-lane-toolchain
# renovate: datasource=github-releases depName=rustwasm/wasm-pack extractVersion=^v(?<version>.*)$
WASM_PACK_VERSION=0.15.0
# renovate: datasource=github-releases depName=fzyzcjy/flutter_rust_bridge extractVersion=^v(?<version>.*)$
FLUTTER_RUST_BRIDGE_VERSION=2.13.0
# Both publish a linux-musl release binary for x86_64 and aarch64, and building
# them under QEMU instead costs 768 s / ~1170 s on arm64 and 1813 s / 3500 s on
# riscv64 (measured, 2026-09-05). riscv64 has no published asset and keeps the
# from-source build. Bump these WITH the two versions above.
WASM_PACK_LINUX_X86_64_SHA256=c09f971ecaed9a2efc80fdcea7a00ef6b53c7fadc8c57d1f61b53a6aa66b668a
WASM_PACK_LINUX_AARCH64_SHA256=e17ef0806381c3a0acb9c9ddad643a49facaa5a2ecf657a421d4d8f3357a24b7
FLUTTER_RUST_BRIDGE_LINUX_X86_64_SHA256=58de00e9a9cc60fce98a052917f68ac61889825f90ce25eb185cc9d32dc1ff48
FLUTTER_RUST_BRIDGE_LINUX_AARCH64_SHA256=8833f7c59baf5ad097852f12764a5f0fdb31a1b9b3687310c5e159d04ce1e68d

# --- Runtime orchestrator ---
# The OrchestrANT ref the torch stage TRACKS (owner decision 2026-09-29): a branch.
# Both drivers resolve it to a commit when a run starts and build that commit, so
# the stage rebuilds exactly when the app moved. A tag or a 40-hex commit pins it.
# No renovate line: a branch has no version to bump.
# docs/linux-cross-builds.md#the-app-the-wrapper-builds
APP_REF=develop

# --- LLM stack (Ollama) ---
# renovate: datasource=github-releases depName=ollama/ollama extractVersion=^v(?<version>.*)$
OLLAMA_VERSION=0.34.2

# --- Android SDK / NDK ---
ANDROID_SDK_VERSION=15859902
ANDROID_NDK_VERSION=29.0.14206865
ANDROID_COMPILE_SDK=36
ANDROID_BUILD_TOOLS=36.0.0
# CON5: API 37 ships ALONGSIDE 36 so a consumer can move one at a time. Google's
# repository names API 37's base platform `platforms;android-37.0` (there is no
# `platforms;android-37`; `android-36` kept the un-suffixed name for backwards
# compatibility), paired with build-tools 37.0.0. The consumer that needed this
# was permission_handler_android 14.x's `compileSdk 37`.
ANDROID_EXTRA_COMPILE_SDK=37.0
ANDROID_EXTRA_BUILD_TOOLS=37.0.0
ANDROID_CMAKE_VERSION=4.1.2
ANDROID_API_LEVEL=34
# The ABI the prebuilt /opt/android SDKs are compiled for. NOT the build host:
# every cross stage builds on amd64, so deriving it from the host shipped an
# emulator-only x86_64 Android layer while the app asked for arm64-v8a.
# One ABI per image; set this to rebuild the layer for another.
# docs/linux-cross-builds.md#the-android-abi-is-a-target-not-the-build-host
ANDROID_TARGET_ABI=arm64-v8a
# The JDK Gradle needs. android-sdk.sh installs the full openjdk-21-jdk in the
# SOURCE stage; the runtime image gets the headless closure (~286 MB: 92 JDK +
# 194 JRE) because a container build needs javac, not AWT. One key so the two
# stages cannot drift to different majors.
# docs/consumer-image-contract.md#the-android-lane-needs-a-jdk
JDK_PACKAGE=openjdk-21-jdk-headless
# LOG17: AGP/Gradle versions — the AGP version lives inside the patch file
# patches/onnxruntime/001-android-gradle-agp8-compat.patch. Lifting it here
# so bump_versions.py can see it. The patch still hardcodes the version;
# updating both in sync is the operator's responsibility until the patch
# is templatized.
ANDROID_AGP_VERSION=8.3.1
ANDROID_GRADLE_VERSION=8.7

# --- Android emulator + system image (amd64 package stage, 06-packaging/install-android-emulator.sh) ---
# Both zips' sha1 equal repository2-3.xml / sys-img/google_apis/sys-img2-3.xml (emulator channel-0).
# noforward
ANDROID_EMULATOR_VERSION=37.2.12
# noforward
ANDROID_EMULATOR_BUILD=16428233
# noforward
ANDROID_EMULATOR_SHA256=b08fc43d8608d2955f607f1b287beb525041e730086bdca3af152accac3af9c1
# API 30's ndk_translation 0.2.2 SIGILLs on OmniAccelerANT's arm64 code; API 35's runs it.
# noforward
ANDROID_EMULATOR_API=35
# noforward
ANDROID_EMULATOR_SYSIMG_REVISION=9
# noforward
ANDROID_EMULATOR_SYSIMG_SHA256=c67b9ba0ff5bc0eb6d046871bfa228af14d4d47b02f0cdae94f048e511b7566e

# --- Chrome for Testing (package stage, 06-packaging/install-chrome-for-testing.sh) ---
# Google's Stable build; each zip's md5 equals storage.googleapis.com's x-goog-hash.
# noforward
CHROME_FOR_TESTING_VERSION=154.0.8037.92
# noforward
CHROME_FOR_TESTING_LINUX64_SHA256=ff43322f335e436b2f4dcdfeeec5db032299e335a7e8c1c618b326e100ce8732
# noforward
CHROME_FOR_TESTING_LINUX_ARM64_SHA256=c0af361aab66b24c72e36a4326dce4d7edf4bc23f9aede8af988c2cb6ea3fec0
# noforward
CHROMEDRIVER_LINUX64_SHA256=cc99c87cfd10e1da1b7d42ea9800a211df279f5a47c19a55b02c927cb9f606c2
# noforward
CHROMEDRIVER_LINUX_ARM64_SHA256=0f6830daf008f981a7bac2b67259909106f84668e1921ead32cee69002a21b22

# --- NVIDIA GPU (single source for BOTH Windows and Linux) ---
# Full semvers pinning the SAME release on both platforms. Each consumer
# derives its platform form:
#   Linux (Dockerfile.nvidia):  13.3.0 → 13-3 apt package suffix; cuDNN major
#                               (9) for apt package names; exact-version apt
#                               pins from the full semvers where available.
#   Windows (Build-Buildkit.ps1):        full semvers consumed directly by the CUDA
#                               installer / cuDNN download / TensorRT zip;
#                               dotted major.minor (13.3) derived in Build-Buildkit.ps1.
# renovate: datasource=custom.cuda depName=cuda
CUDA_VERSION=13.4.2
# renovate: datasource=pypi depName=nvidia-cudnn-cu13 versioning=regex:^(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)\.(?<build>\d+)$
CUDNN_VERSION=9.26.0.51
# TensorRT (Windows): OPTIONAL — place the TensorRT-*.zip in windows/downloads/
# (EULA-gated manual download) to include it. Without the zip the -Gpu lane
# builds fine: Install-Tensorrt.ps1 warns and skips, CUDA + cuDNN still work and
# ORT auto-disables the TensorRT EP (the smoke test's TENSORRT_ROOT pointer
# passes on the guaranteed-empty C:\tensorrt). A 2026-08-04 fail-fast variant
# broke the zip-less lane and was reverted 2026-08-05.
# ONE pin for BOTH lanes (owner decision 2026-08-08; a brief per-lane split was
# reverted the same day). Both consume it, differently:
#
#   Windows — MUST MATCH THE DIRECTORY NAME INSIDE the zip staged in
#     windows/downloads/. It is not merely a download coordinate:
#     windows/Dockerfile.nvidia builds the runtime PATH out of it
#       ENV PATH=…;$TENSORRT_ROOT\TensorRT-$TENSORRT_VERSION\lib;$PATH
#     while Install-Tensorrt.ps1 extracts whatever the archive contains. An
#     11.2.1.2 zip against a 11.1.0.106 pin put a NONEXISTENT directory on
#     PATH: DLLs on disk but unreachable, ORT dropping the TensorRT EP at
#     runtime with no error and a build log still reading "installation
#     complete". Bump this WITH the staged zip, never alone.
#
#   Linux — install-tensorrt.sh asks apt for `tensorrt-dev=${VERSION}*`. NVIDIA
#     Enterprise builds are NOT in the public apt repo, so this value can be
#     unservable there. That is tolerated (the script falls back to the newest
#     available) but is NO LONGER SILENT: the fallback prints a WARNING banner
#     naming both versions, so an unpinned Linux TensorRT is visible in the log
#     instead of one `echo` among thousands.
# OWNER DIRECTIVE 2026-08-14: ALWAYS TRACK THE NEWEST TENSORRT RELEASE.
# Never resolve a pin-vs-staged-zip mismatch by pinning BACKWARDS — stage the
# newer zip into windows/downloads/ instead, recompute TENSORRT_ZIP_SHA256, and
# DELETE the superseded zip (two zips present means the extract picks one of
# them; it version-sorts descending now, but the dead ~2 GB still bloats the
# `COPY downloads` layer). The zip is an EULA-gated manual NVIDIA download, so
# CI cannot fetch it.
# renovate: datasource=pypi depName=tensorrt versioning=regex:^(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)\.(?<build>\d+)$
TENSORRT_VERSION=11.3.0.99
# Target GPU architectures for all CUDA source builds (ONNX Runtime, OpenCV).
# Consumers decorate per build system: Windows clang-cl builds append `-real`;
# 87 is Jetson Orin (GA10B, sm_87) and 120 is Blackwell -- GeForce RTX 5050-5090
# and the whole RTX PRO Blackwell line. NEITHER is reachable from a neighbour: a
# cubin runs only on its own major at an equal-or-higher minor, so 86 does not
# reach 87 and 89 does not reach 120. ONNX Runtime narrows this further -- it
# rewrites every entry to sm_<cc>a-real (arch-specific, no PTX), so 120 covers
# 12.0 and NOT 12.1 (GB10/DGX Spark), and 100 would cover B100/B200 but not B300
# (10.3). Add the exact number for hardware you actually have; there is no JIT
# fallback to lean on. Not listed, each one token: 100 (B100/B200), 103
# (B300/GB300), 110 (Jetson Thor), 121 (GB10/DGX Spark). CUDA 13 floors at 75.
# Tip: set to just your local GPU's arch (e.g. 120) to cut CUDA build time to ~1/5.
# Quoted for the `;`: load-versions-env.sh strips one surrounding pair, so the value
# is unchanged, but a plain `source` of this file would otherwise run 86/89/90.
#
# RETIRED 2026-09-23 (owner), both re-addable by inserting the number in
# ascending order: 80 (Ampere GA100 -- A100, A30) and 90 (Hopper -- H100, H200).
# The consequence of an absence is a HARD one, not a slow path: neither ORT nor
# OpenCV embeds PTX, so a card outside this list gets no cubin and nothing to
# JIT from, and fails at session creation.
#   CUDA_ARCHITECTURES="80;86;87;89;90;120"   # everything, for reference
CUDA_ARCHITECTURES="86;87;89;120"

