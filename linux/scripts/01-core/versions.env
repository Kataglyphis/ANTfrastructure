# --- Flutter SDK ---
# renovate: datasource=flutter-version depName=flutter
FLUTTER_VERSION=3.47.4

# --- Flatpak runtime/SDK (packaging-deps.sh, app packaging lane) ---
FLATPAK_RUNTIME_VERSION=24.08
# openh264 is versioned independently of the 24.08 runtime branch.
# renovate: datasource=github-releases depName=cisco/openh264 extractVersion=^v(?<version>.*)$
FLATPAK_OPENH264_VERSION=2.6.0
# The web lane: flutter_rust_bridge_codegen build-web shells out to wasm-pack,
# and both used to be a from-source `cargo install` in every consumer run (258
# and 174 crates). docs/consumer-image-contract.md#the-web-lane-toolchain
# renovate: datasource=github-releases depName=rustwasm/wasm-pack extractVersion=^v(?<version>.*)$
WASM_PACK_VERSION=0.15.0
# renovate: datasource=github-releases depName=fzyzcjy/flutter_rust_bridge extractVersion=^v(?<version>.*)$
FLUTTER_RUST_BRIDGE_VERSION=2.13.0
# Both publish a linux-musl release binary for x86_64 and aarch64, and building
# them under QEMU instead costs 768 s / ~1170 s on arm64 and 1813 s / 3500 s on
# riscv64 (measured, 2026-09-05). riscv64 has no published asset and keeps the
# from-source build. Bump these WITH the two versions above.
WASM_PACK_LINUX_X86_64_SHA256=c09f971ecaed9a2efc80fdcea7a00ef6b53c7fadc8c57d1f61b53a6aa66b668a
WASM_PACK_LINUX_AARCH64_SHA256=e17ef0806381c3a0acb9c9ddad643a49facaa5a2ecf657a421d4d8f3357a24b7
FLUTTER_RUST_BRIDGE_LINUX_X86_64_SHA256=58de00e9a9cc60fce98a052917f68ac61889825f90ce25eb185cc9d32dc1ff48
FLUTTER_RUST_BRIDGE_LINUX_AARCH64_SHA256=8833f7c59baf5ad097852f12764a5f0fdb31a1b9b3687310c5e159d04ce1e68d

# --- Runtime orchestrator ---
# renovate: datasource=github-tags depName=Kataglyphis/OrchestrANT
APP_REF=v0.0.28

# --- LLM stack (Ollama) ---
# renovate: datasource=github-releases depName=ollama/ollama extractVersion=^v(?<version>.*)$
OLLAMA_VERSION=0.34.2

# --- Android SDK / NDK ---
ANDROID_SDK_VERSION=15859902
ANDROID_NDK_VERSION=29.0.14206865
ANDROID_COMPILE_SDK=36
ANDROID_BUILD_TOOLS=36.0.0
# CON5: API 37 ships ALONGSIDE 36 so a consumer can move one at a time. Google's
# repository names API 37's base platform `platforms;android-37.0` (there is no
# `platforms;android-37`; `android-36` kept the un-suffixed name for backwards
# compatibility), paired with build-tools 37.0.0. The consumer that needed this
# was permission_handler_android 14.x's `compileSdk 37`.
ANDROID_EXTRA_COMPILE_SDK=37.0
ANDROID_EXTRA_BUILD_TOOLS=37.0.0
ANDROID_CMAKE_VERSION=4.1.2
ANDROID_API_LEVEL=34
# The ABI the prebuilt /opt/android SDKs are compiled for. NOT the build host:
# every cross stage builds on amd64, so deriving it from the host shipped an
# emulator-only x86_64 Android layer while the app asked for arm64-v8a.
# One ABI per image; set this to rebuild the layer for another.
# docs/linux-cross-builds.md#the-android-abi-is-a-target-not-the-build-host
ANDROID_TARGET_ABI=arm64-v8a
# The JDK Gradle needs. android-sdk.sh installs the full openjdk-21-jdk in the
# SOURCE stage; the runtime image gets the headless closure (~286 MB: 92 JDK +
# 194 JRE) because a container build needs javac, not AWT. One key so the two
# stages cannot drift to different majors.
# docs/consumer-image-contract.md#the-android-lane-needs-a-jdk
JDK_PACKAGE=openjdk-21-jdk-headless
# LOG17: AGP/Gradle versions — the AGP version lives inside the patch file
# patches/onnxruntime/001-android-gradle-agp8-compat.patch. Lifting it here
# so bump_versions.py can see it. The patch still hardcodes the version;
# updating both in sync is the operator's responsibility until the patch
# is templatized.
ANDROID_AGP_VERSION=8.3.1
ANDROID_GRADLE_VERSION=8.7

# --- NVIDIA GPU (single source for BOTH Windows and Linux) ---
# Full semvers pinning the SAME release on both platforms. Each consumer
# derives its platform form:
#   Linux (Dockerfile.nvidia):  13.3.0 → 13-3 apt package suffix; cuDNN major
#                               (9) for apt package names; exact-version apt
#                               pins from the full semvers where available.
#   Windows (Build-Buildkit.ps1):        full semvers consumed directly by the CUDA
#                               installer / cuDNN download / TensorRT zip;
#                               dotted major.minor (13.3) derived in Build-Buildkit.ps1.
# renovate: datasource=custom.cuda depName=cuda
CUDA_VERSION=13.4.2
# renovate: datasource=pypi depName=nvidia-cudnn-cu13 versioning=regex:^(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)\.(?<build>\d+)$
CUDNN_VERSION=9.26.0.51
# TensorRT (Windows): OPTIONAL — place the TensorRT-*.zip in windows/downloads/
# (EULA-gated manual download) to include it. Without the zip the -Gpu lane
# builds fine: Install-Tensorrt.ps1 warns and skips, CUDA + cuDNN still work and
# ORT auto-disables the TensorRT EP (the smoke test's TENSORRT_ROOT pointer
# passes on the guaranteed-empty C:\tensorrt). A 2026-08-04 fail-fast variant
# broke the zip-less lane and was reverted 2026-08-05.
# ONE pin for BOTH lanes (owner decision 2026-08-08; a brief per-lane split was
# reverted the same day). Both consume it, differently:
#
#   Windows — MUST MATCH THE DIRECTORY NAME INSIDE the zip staged in
#     windows/downloads/. It is not merely a download coordinate:
#     windows/Dockerfile.nvidia builds the runtime PATH out of it
#       ENV PATH=…;$TENSORRT_ROOT\TensorRT-$TENSORRT_VERSION\lib;$PATH
#     while Install-Tensorrt.ps1 extracts whatever the archive contains. An
#     11.2.1.2 zip against a 11.1.0.106 pin put a NONEXISTENT directory on
#     PATH: DLLs on disk but unreachable, ORT dropping the TensorRT EP at
#     runtime with no error and a build log still reading "installation
#     complete". Bump this WITH the staged zip, never alone.
#
#   Linux — install-tensorrt.sh asks apt for `tensorrt-dev=${VERSION}*`. NVIDIA
#     Enterprise builds are NOT in the public apt repo, so this value can be
#     unservable there. That is tolerated (the script falls back to the newest
#     available) but is NO LONGER SILENT: the fallback prints a WARNING banner
#     naming both versions, so an unpinned Linux TensorRT is visible in the log
#     instead of one `echo` among thousands.
# OWNER DIRECTIVE 2026-08-14: ALWAYS TRACK THE NEWEST TENSORRT RELEASE.
# Never resolve a pin-vs-staged-zip mismatch by pinning BACKWARDS — stage the
# newer zip into windows/downloads/ instead, recompute TENSORRT_ZIP_SHA256, and
# DELETE the superseded zip (two zips present means the extract picks one of
# them; it version-sorts descending now, but the dead ~2 GB still bloats the
# `COPY downloads` layer). The zip is an EULA-gated manual NVIDIA download, so
# CI cannot fetch it.
# renovate: datasource=pypi depName=tensorrt versioning=regex:^(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)\.(?<build>\d+)$
TENSORRT_VERSION=11.3.0.99
# Target GPU architectures for all CUDA source builds (ONNX Runtime, OpenCV).
# Consumers decorate per build system: Windows clang-cl builds append `-real`;
# 87 is Jetson Orin (GA10B, sm_87) and 120 is Blackwell -- GeForce RTX 5050-5090
# and the whole RTX PRO Blackwell line. NEITHER is reachable from a neighbour: a
# cubin runs only on its own major at an equal-or-higher minor, so 86 does not
# reach 87 and 89 does not reach 120. ONNX Runtime narrows this further -- it
# rewrites every entry to sm_<cc>a-real (arch-specific, no PTX), so 120 covers
# 12.0 and NOT 12.1 (GB10/DGX Spark), and 100 would cover B100/B200 but not B300
# (10.3). Add the exact number for hardware you actually have; there is no JIT
# fallback to lean on. Not listed, each one token: 100 (B100/B200), 103
# (B300/GB300), 110 (Jetson Thor), 121 (GB10/DGX Spark). CUDA 13 floors at 75.
# Tip: set to just your local GPU's arch (e.g. 120) to cut CUDA build time to ~1/5.
# Quoted for the `;`: load-versions-env.sh strips one surrounding pair, so the value
# is unchanged, but a plain `source` of this file would otherwise run 86/89/90.
#
# RETIRED 2026-09-23 (owner), both re-addable by inserting the number in
# ascending order: 80 (Ampere GA100 -- A100, A30) and 90 (Hopper -- H100, H200).
# The consequence of an absence is a HARD one, not a slow path: neither ORT nor
# OpenCV embeds PTX, so a card outside this list gets no cubin and nothing to
# JIT from, and fails at session creation.
#   CUDA_ARCHITECTURES="80;86;87;89;90;120"   # everything, for reference
CUDA_ARCHITECTURES="86;87;89;120"

# --- Windows build image ---
# LTSC version for the Windows Server Core base image FROM tag
WINDOWS_LTSC=2025
# PowerShell 7 (pwsh) version installed as the default shell in the Windows
# container base image. Downloaded as ZIP from GitHub releases.
# renovate: datasource=github-releases depName=PowerShell/PowerShell extractVersion=^v(?<version>.*)$
PWSH_VERSION=7.6.6
# Windows SDK build (VS component Microsoft.VisualStudio.Component.Windows11SDK.<build>).
# Reaches Install-Vs.ps1 as a --build-arg via Build-Buildkit.ps1 + Dockerfile.base ARG -- NOT via
# Import-Versions.ps1, which deliberately runs after the VS install. 26100 = Win 11 24H2 SDK.
WINDOWS_SDK_BUILD=26100
# Visual Studio major (Install-Vs.ps1 installs the latest stable; this pins the
# expected major for Test-Container.ps1 path assertions).
VISUAL_STUDIO_VERSION=18
# --- Windows target architecture --------------------------------------------
# The Windows build HOST is always windows/amd64: Microsoft publishes no arm64
# Windows container base image (servercore/nanoserver are amd64-only and Windows
# Server has no arm64 release). An arm64 lane is therefore a CROSS build out of
# the same x64 image -- clang-cl --target=aarch64-pc-windows-msvc + lld-link --
# and its product is an artifact bundle, NOT a runnable arm64 container image.
#
# WINDOWS_TARGET_ARCH is deliberately NOT a key here (removed 2026-08-23).
#
# It is a per-BUILD switch, not a pin, and keeping it in this file actively broke
# the arm64 lane. Import-Versions.ps1 distinguishes "explicitly overridden" from
# "merely inherited" by comparing the PROCESS value against the MACHINE value: if
# they differ it keeps the process value AND bakes it; if they are equal it treats
# the key as inherited and rewrites BOTH from this file.
#
# That rule turns a successful stage into a broken successor. The ONNX stage set
# ENV=arm64 against a baked Machine=amd64, so it was correctly detected as an
# override -- and baked Machine=arm64 into its image. The FFmpeg stage, built FROM
# that image, then had process==machine==arm64, was classified as "inherited", and
# had both silently rewritten to this file's amd64. FFmpeg then link-probed as x64
# and failed with "libonnxruntime not found" against an arm64 library.
#
# The Dockerfile ARG defaults (=amd64) already supply the default, and the drivers
# pass -TargetArch as a build-arg. One source of truth, no bake to fight.
# WINDOWS_TARGET_ARCHES below stays: it is a genuine fact about supported targets,
# it has no matching ARG anywhere, so nothing can collide with it.
# Every target the Windows lane knows how to build for. Mirrors the table in
# windows/scripts/modules/WindowsTargetArch.Common.psm1 (the Windows twin of
# linux/scripts/01-core/arch-mapping.sh).
WINDOWS_TARGET_ARCHES=amd64,arm64
# --- Windows scoop toolchain pins (Install-ScoopTools.ps1) --------------------
# These three produce or shape COMPILED OUTPUT, so they are pinned like every
# other build input. Everything else scoop installs there (7zip, nano, cppcheck,
# sccache, nsis, uv, nuget, zlib, openssl, pkg-config, make, gawk) is a tool the
# build only *invokes*, and stays on scoop's current manifest deliberately.
#
# LLVM (clang-cl + lld-link) is THE compiler for the whole Windows media chain,
# and five of the patches in windows/scripts/patches/ are clang-cl-version-
# shaped (softmax keywords, opencv cmake compat, cudev LLP64, iree /EHsc, the
# litert-lm winfixes). Unpinned, a base rebuild months from now silently swaps
# the compiler and the breakage surfaces ~2 h into media-core with no way to
# reproduce the image that worked. Pinned 2026-08-07 to the version scoop's
# manifest served that day, i.e. the pin is a no-op for the next rebuild and a
# guarantee for every one after it. Bump DELIBERATELY, then re-verify the
# patches above (Test-PatchesApplyClean.ps1) on the rebuilt base.
#
# BUMPED 2026-08-26, 22.1.8 -> 23.1.0, and this one was FORCED, not chosen.
# LLVM changed its Windows packaging at 23.1.0 (.exe -> .msi) and the scoop
# main/llvm manifest followed the same day; `scoop install llvm@<ver>`
# synthesises the URL from the CURRENT manifest's template, so it now asks for
# LLVM-22.1.8-win64.msi -- which was never published. Measured:
#   LLVM-22.1.8-win64.exe 206   LLVM-22.1.8-win64.msi 404
#   LLVM-23.1.0-win64.exe 404   LLVM-23.1.0-win64.msi 206
# The old pin is therefore no longer installable through scoop at all. THE PIN
# STILL DOES ITS JOB -- it names what the image gets -- but note what it cannot
# do: it cannot hold a version whose artifact upstream has stopped shipping in
# the shape the installer expects. If a future rebuild 404s here, check the
# manifest's URL template before suspecting the pin.
# Both lanes are now on 23.1.1 (LLVM_RELEASE was bumped the same day; the
# AArch64 patches still apply — neither fix is in this release).
# renovate: datasource=github-tags depName=llvm/llvm-project extractVersion=^llvmorg-(?<version>.*)$
LLVM_WINDOWS_VERSION=23.1.1
# sha256 of the llvm-project-<ver>.src.tar.xz tarball. Overrides the $llvmSrcSha
# table in BOTH Build-TvmFromSource.ps1 and Build-LlvmFromSource.ps1 — bump
# those too.
LLVM_WINDOWS_SRC_SHA256=ebe9be46fe8756d58c5b198ffad0fa2a766257add81a4dc52179bfacc7888ee6
# sha256 of the clang+llvm-<ver>-aarch64-pc-windows-msvc.tar.xz RELEASE archive,
# from which the aarch64 clang_rt.builtins lib is mined (toolchain staging in
# Build-LlvmFromSource.ps1; merge-stage self-heal + setup-scoop-tools as
# fallbacks). Empty = download UNVERIFIED with a warning, same contract as
# QNN_SDK_ZIP_SHA256. Fill it from the first verified download's Get-FileHash.
LLVM_WINDOWS_AARCH64_RT_SHA256=c8cd61f6624accf0d0f9f4519ddcc97745c6a865205bb43f364b6aaf9c50a31e
# ninja: build-graph executor for every CMake source build in the chain.
# renovate: datasource=github-releases depName=ninja-build/ninja extractVersion=^v(?<version>.*)$
NINJA_WINDOWS_VERSION=1.13.2
# nasm: assembles FFmpeg's hand-written x86 SIMD -- a version bump changes the
# generated object code in the shipped ffmpeg/libav* binaries.
# renovate: datasource=github-releases depName=netwide-assembler/nasm extractVersion=^nasm-(?<version>.*)$
NASM_WINDOWS_VERSION=3.02
# ── sccache for the LINUX lane (added 2026-08-26, owner decision: switch the
# chain from ccache to sccache) ───────────────────────────────────────────────
# Linux previously took sccache from apt (package-lists.sh:122, core.sh:12),
# which on Ubuntu 26.04 is 0.13.0. That version is NOT usable as a ccache
# replacement here, for one specific and verifiable reason: it has no
# SCCACHE_BASEDIRS. build-gcc.sh:220 sets CCACHE_BASEDIR="${BUILD_DIR}" so the
# three arch lanes -- whose build dirs are gcc-build-<ver>-<triplet> -- can
# share cache entries for identical translation units. Without basedir
# relativization they never share, and sccache compounds it by hashing the
# working directory as well. That failure is SILENT: builds stay green and
# simply stop hitting cache. SCCACHE_BASEDIRS merged as mozilla/sccache#2521
# (2026-01-28) and first shipped in v0.14.0 (2026-02-09), so the distro 0.13.0
# is on the wrong side of it.
#
# 0.18.0 is also what the Windows lane pins (SCCACHE_WINDOWS_VERSION above),
# so both lanes run the same sccache. Upstream publishes no riscv64 asset; that
# lane keeps the distro package, which is acceptable because sccache runs on the
# amd64 BUILD host for every cross stage.
# renovate: datasource=github-releases depName=mozilla/sccache extractVersion=^v(?<version>.*)$
SCCACHE_LINUX_VERSION=0.18.0
SCCACHE_LINUX_X86_64_SHA256=45f1447fbe231e3037bde351ef70677dd212216c8d62ae7ca409fecc4d6acc89
SCCACHE_LINUX_AARCH64_SHA256=2b3284d5da3b46a47dc4229e75bb7b88ac4aa99c8d754fb7d2f84997e5a4354a
# The Windows lane installs the released 0.18.0 zip, not a source build:
# 0.18.0 ships #2722 + #2811 + #2816, which is exactly what the git-rev build
# pinned. History, the CUDA canary and the cuda_llm scope:
# docs/windows-build-resources.md § sccache.
# renovate: datasource=github-releases depName=mozilla/sccache extractVersion=^v(?<version>.*)$
SCCACHE_WINDOWS_VERSION=0.18.0
# sha256 of sccache-v0.18.0-x86_64-pc-windows-msvc.zip
SCCACHE_WINDOWS_ZIP_SHA256=8965c74d5e8a225244f741e18ad2f3f504f48228dc1bac948fc22761a348363d
# vcpkg toolchain ref (pinned release tag; Install-Vcpkg.ps1 downloads this).
# MUST be >= 2026.06: older snapshots pin a vcpkg-tool that predates VS 18 and
# rejects its v145 toolset with a misleading "Unable to find a valid Visual
# Studio instance" (2026-07-12 base-build failure; VS itself was fine). 2026.06.24
# matches the verified windows-base snapshot (tool 2026-05-27, protobuf 6.33.4).
# renovate: datasource=github-tags depName=microsoft/vcpkg versioning=loose
VCPKG_REF=2026.07.29
# Host protoc for LiteRT-LM codegen. NOT independent software: it must match the
# protobuf runtime pinned INSIDE LiteRT-LM's cmake/packages/protobuf/protobuf.cmake
# (v0.14.0 pins v6.31.1 -> protoc 31.1). Auto-bumping to latest protoc emits gencode
# the pinned runtime headers #error on (bit us 2026-08-03: 35.1 vs 6.31.1). Re-derive
# from upstream's protobuf.cmake whenever LITERT_LM_VERSION moves.
# bump:hold slaved to LiteRT-LM's internal protobuf pin, not a standalone tool
# renovate: datasource=github-tags depName=protocolbuffers/protobuf extractVersion=^v(?<version>.*)$ versioning=regex:^(?<major>\d+)\.(?<minor>\d+)$
PROTOC_VERSION=35.1
# Host protoc for the PLAIN-LiteRT (tflite) cross codegen -- a DIFFERENT protobuf
# family from LiteRT-LM's above, and the two must never be conflated: tflite's
# tools/cmake/modules/protobuf.cmake pins GIT_TAG 90b73ac3 = C++ runtime 3.21.9,
# and gencode from a 31.x protoc #includes google/protobuf/runtime_version.h,
# which 3.21.9 does not ship (measured 2026-08-24, arm64 cross run 11).
# bump:hold slaved to LiteRT's vendored protobuf commit; re-derive from that
# module file whenever LITERT_VERSION moves -- the gencode/#include clash is the
# loud drift detector.
LITERT_TFLITE_PROTOC_VERSION=21.9
# Protobuf runtime built by LiteRT-LM's protobuf_external (informational;
# matched to PROTOC_VERSION above).
# bump:hold slaved to LiteRT-LM's internal protobuf pin (see PROTOC_VERSION)
# renovate: datasource=pypi depName=protobuf
PROTOBUF_VERSION=7.35.1
# Temurin JRE major (ANTLR codegen in LiteRT-LM; fetched via adoptium API).
JRE_VERSION=21
# ANTLR version (fetched by LiteRT-LM's CMake; documentary).
# renovate: datasource=github-tags depName=antlr/antlr4
ANTLR_VERSION=4.13.2
# libffi meson-port version (GStreamer wrap pre-extract).
LIBFFI_MESON_VERSION=3.2.9999.4

# --- Python build-executor pins (supply-chain audit #18) ---
# These packages EXECUTE code at build time (code generators / build
# frontends). They were installed unpinned from PyPI at ~20 sites — the
# single largest non-reproducibility surface: the same commit built
# differently every day, and a malicious release of any of them executes
# arbitrary code in the build. Frozen 2026-08-08 to the versions the builds
# were already resolving; bump deliberately, all together, with a real build.
# MESON-GI probe (2026-08-24): 1.12.0 is STILL the newest meson release
# (git ls-remote mesonbuild/meson: no 1.12.x point release, no 1.13 exists),
# so no released meson fixes gobject-introspection's `subproject('glib')`
# resolution yet — the riscv64-cross-only meson==1.11.2 pin in
# setup-gstreamer.sh stays with its reason (watch item MESON-GI). Re-probe at
# the next bump window.
# renovate: datasource=pypi depName=meson
# noforward
PY_MESON_VERSION=1.12.0
# renovate: datasource=pypi depName=ninja
# noforward
PY_NINJA_VERSION=1.13.2
# renovate: datasource=pypi depName=Cython
# noforward
PY_CYTHON_VERSION=3.3.0
# renovate: datasource=pypi depName=pybind11
# noforward
PY_PYBIND11_VERSION=3.1.0
# renovate: datasource=pypi depName=setuptools
# noforward
PY_SETUPTOOLS_VERSION=84.0.0
# The torch wheelhouse constrains setuptools<82 (torch build compat) — its
# pinned value within that constraint:
# renovate: datasource=pypi depName=setuptools
# noforward
PY_SETUPTOOLS_LT82_VERSION=81.0.0
# renovate: datasource=pypi depName=wheel
# noforward
PY_WHEEL_VERSION=0.48.0
# renovate: datasource=pypi depName=scikit-build-core
# noforward
PY_SCIKIT_BUILD_CORE_VERSION=1.0.3
# renovate: datasource=pypi depName=setuptools-scm
# noforward
PY_SETUPTOOLS_SCM_VERSION=10.2.3
# auditwheel/patchelf REWRITE shipped wheel binaries (RPATH grafting) — the
# most binary-shaping executors of all:
# renovate: datasource=pypi depName=auditwheel
# noforward
PY_AUDITWHEEL_VERSION=6.8.2
# renovate: datasource=pypi depName=patchelf
# noforward
PY_PATCHELF_VERSION=0.19.1.0
# Package-image runtime-venv executor pins (setup-package-image.sh
# create_runtime_venv) — closed the last three BARE installs there (cmake,
# numpy, packaging; backlog "setup-package-image residual pins"). Values =
# what an unpinned install resolved on 2026-08-24, artifact-checked: pip cmake
# 4.4.2 ships riscv64+aarch64+x86_64 manylinux wheels (tracks Kitware CMAKE_VERSION
# above but is a SEPARATE artifact — bump independently), numpy 2.5.2 ships
# cp314 manylinux wheels (non-riscv64 branch only; riscv64 gets apt
# python3-numpy), packaging 26.3 is a pure-python `any` wheel. NB:
# setup-package-image.sh sources platform.sh/package-lists.sh only — NOT
# common.sh — so nothing loads the baked /opt/scripts/core/versions.env into
# its env and the script's ${VAR:-literal} fallbacks ARE the live values.
# Keep them equal to these keys (verify-arg-consistency's drift check
# compares them).
# renovate: datasource=pypi depName=cmake
# noforward
PY_CMAKE_VERSION=4.4.3
# renovate: datasource=pypi depName=numpy
# noforward
PY_NUMPY_VERSION=2.5.3
# renovate: datasource=pypi depName=packaging
# noforward
PY_PACKAGING_VERSION=26.3

# --- Supply-chain pins (audit round 3): trust anchors + build-time toolchains ---
