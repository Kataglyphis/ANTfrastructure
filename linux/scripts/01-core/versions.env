# ==============================================================================
# Canonical version defaults for the entire Linux container build pipeline.
#
# This file is the SINGLE SOURCE OF TRUTH for every version number in the project.
# Dockerfiles, orchestrator scripts, and build helpers all consume these values.
#
# Update this file when bumping versions — do NOT scatter version changes across
# individual Dockerfiles.  The old per-Dockerfile ARG defaults are kept as safety
# nets but should match the values here.
#
# After changing versions:
#   1. Run `python3 docs/scripts/sync_versions.py --write`
#   2. Update docs/linux-cross-builds.md, docs/linux-build-basics.md, AGENTS.md
# ==============================================================================

# --- Base image tooling ---
UBUNTU_VERSION=26.04
# Multi-arch manifest-LIST digest for ubuntu:${UBUNTU_VERSION} (pins the only
# floating external base). Refresh together with UBUNTU_VERSION. Fetch with:
#   curl -s "https://auth.docker.io/token?service=registry.docker.io&scope=repository:library/ubuntu:pull" | jq -r .token
#   curl -sI -H "Authorization: Bearer <tok>" -H "Accept: application/vnd.oci.image.index.v1+json" \
#     https://registry-1.docker.io/v2/library/ubuntu/manifests/${UBUNTU_VERSION} | grep -i docker-content-digest
UBUNTU_DIGEST=sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb
# Ubuntu codename for the version above (used by NVIDIA TensorRT repo paths).
UBUNTU_CODENAME=resolute
CMAKE_VERSION=4.4.2
NODE_VERSION=26.5.1
UV_VERSION=0.12.1

# --- Compiler toolchain ---
LLVM_RELEASE=22.1.8
GCC_VERSION=16.2.0

# --- Python (source-built interpreter) ---
# Single source of truth. The major.minor form (formerly PYTHON_MAJOR_MINOR /
# DEFAULT_PYTHON_VERSION) is DERIVED from this: common.sh derives it for shell
# consumers; Dockerfiles derive ARG defaults via ${PYTHON_VERSION%.*}.
PYTHON_VERSION=3.14.6
# Canonical venv location. Documentation only: the path is hardcoded as the
# literal /opt/python/.venv across the Dockerfiles/scripts, and the VENV_PATH
# *variable* is read nowhere, so there is nothing to forward.
# noforward
VENV_PATH=/opt/python/.venv

# --- Vulkan SDK ---
VULKAN_VERSION=1.4.357.0

# --- WiX Toolset (Windows-only installer authoring) ---
# Single source of truth for both the install (setup-scoop-tools.ps1) and the assert
# (verify-toolchain.ps1); surfaced as $env:* by load-versions.ps1 in Dockerfile.base.
WIX_VERSION=4.0.6
WIX_UI_EXT_VERSION=4.0.6

# --- Git for Windows (Windows-only; setup-scoop-tools.ps1 derives the installer URL:
# v<GIT_VERSION>.windows.1 tag / Git-<GIT_VERSION>-64-bit.exe) ---
GIT_VERSION=2.55.0

# --- Rust toolchain (install-rust.sh; pinned to the shipped images) ---
RUST_VERSION=1.97.1
CARGO_C_VERSION=0.10.24
RUST_NIGHTLY_TOOLCHAIN=nightly-2026-06-28

# --- SDK frameworks ---
TVM_REF=v0.25.0
# IREE (iree.dev) MLIR compiler + runtime. amd64/arm64 install the PyPI
# iree-base-{compiler,runtime} cp312-abi3 wheels (abi3 => valid on Python 3.14);
# riscv64 has no PyPI wheel, so build-app-wheelhouse.sh source-builds the runtime
# wheel (+ best-effort compiler) at this tag into /opt/wheels. Keep the leading
# v: the GitHub release tag is v3.11.0, the wheel/PyPI version is 3.11.0.
IREE_VERSION=v3.11.0

# --- Media libraries ---
ONNXRUNTIME_VERSION=v1.28.0
ONNXRUNTIME_GENAI_VERSION=v0.15.0
# Feature toggles (true/false), not version pins: WebGPU (Dawn) execution provider
# for ONNX Runtime. ORT_ENABLE_WEBGPU is the master switch (default off). Dawn is
# validated on amd64 native; cross-compiling it to arm64/riscv64 is unproven, so it
# lights up there only when ORT_WEBGPU_ALLOW_CROSS=true is also set. Forwarded to
# Dockerfile.media's onnxruntime stage (build lib/common.sh reads the env).
ORT_ENABLE_WEBGPU=true
ORT_WEBGPU_ALLOW_CROSS=true
LITERT_VERSION=v2.1.6
# v0.14.0's OSS export ships stale CMake (references the removed constrained_decoding
# + the now-header-only preprocessor without its CMakeLists). The Windows build script
# writes condition-gated INTERFACE stubs post-clone ([LiteRTLM-winfix export-stubs] in
# build-litert-lm-from-source.ps1); they self-retire once upstream exports are complete.
LITERT_LM_VERSION=0.14.0
# LiteRT for the web (prebuilt npm packages, WASM/JS — vendored, not compiled;
# https://developers.google.com/edge/litert/web). Arch-independent: the same
# assets ship to amd64/arm64/riscv64.
#   LITERTJS_VERSION       -> @litertjs/core (+ tfjs-interop, wasm-utils)  (LiteRT.js)
#   MEDIAPIPE_GENAI_VERSION -> @mediapipe/tasks-genai (LiteRT-LM's web LLM runtime)
LITERTJS_VERSION=2.5.3
MEDIAPIPE_GENAI_VERSION=0.10.29
OPENCV_VERSION=5.x
GSTREAMER_VERSION=1.29.2
FFMPEG_VERSION=n9.0
PYAV_VERSION=18.0.0
# Feature toggle (0/1), not a version pin: enable libx265 HEVC encoding in FFmpeg.
# libx265-dev is installed on all arches; historically disabled over a source-x265
# compile break, so kept off by default and probe-gated when on. Forwarded as a
# --build-arg to Dockerfile.media's ffmpeg stage (build-ffmpeg.sh reads the env).
FFMPEG_ENABLE_X265=1
# Reproducibility pins (OPT-IN). OPENCV_VERSION above tracks a live BRANCH
# (5.x, non-reproducible); FFMPEG_VERSION is a release TAG since 2026-08-04
# (n9.0 — it previously tracked master, which by then WAS the 9.0 dev line).
# To freeze a build to an immutable commit, set the matching *_COMMIT to a
# 40-hex SHA (empty = keep tracking branch/tag). build-opencv.sh /
# build-ffmpeg.sh / clone_or_update_repo consume these. Known-good HEADs
# captured 2026-07-08:
#   OPENCV_COMMIT=4ce2389a624ebfb846f06d055026723e3a0a564a
#   OPENCV_CONTRIB_COMMIT=755e50675d97db9b7d449d8bd6b09888646f6c6e
#   FFMPEG_COMMIT=c29d710cd5d0f80bbb56f7ec1f35d5fb7ed44d05
OPENCV_COMMIT=
OPENCV_CONTRIB_COMMIT=
FFMPEG_COMMIT=
VVDEC_VERSION=v3.2.0
# FFmpeg DNN-backend SDKs (build-ffmpeg.sh reads these as env defaults)
TENSORFLOW_C_VERSION=2.21.0
OPENVINO_VERSION=2026.2.1
# ArmNN + Arm Compute Library (arm64 media stage) and librice (gstreamer
# webrtcbin2 C library) — build scripts read these as env defaults.
ARMNN_VERSION=v26.07
ACL_VERSION=v53.2.0
RICE_VERSION=v0.4.3

# --- Library build dependencies (cross-compile fallbacks / header tarballs) ---
ABSEIL_VERSION=20260526.0
FREETYPE_VERSION=2.14.3
# libpng cross-compile fallback for riscv64 OpenCV: OpenCV 5.x's vendored libpng
# fails its RISC-V Vector configure probe under GCC 16.1.0, and Ubuntu Ports'
# libpng-dev:riscv64 dep set is frequently broken, so the riscv64 OpenCV build
# links an external libpng that install-deps.sh cross-compiles from this tag.
LIBPNG_VERSION=1.6.58
GOBJECT_INTROSPECTION_VERSION=1.86.0
# nv-codec-headers (ffnvcodec) — FFmpeg NVENC/NVDEC/CUVID headers. Must be a REAL upstream tag:
# the repo's tags are 4-part (n12.2.72.0, n13.0.19.0, ...); the old n12.2.1 does not exist, so the
# clone 404'd and NVENC was silently skipped on both lanes. n12.2.72.0 satisfies FFmpeg master's
# `ffnvcodec >= 12.1` requirement and is broadly driver-compatible.
NV_CODEC_HEADERS_REF=n13.1.15.0

# --- PyTorch / TorchVision (riscv64 cross wheel builds) ---
PYTORCH_VERSION=v2.13.0
TORCHVISION_VERSION=v0.28.0

# --- AMD GPU ---
ROCM_VERSION=7.2.4
MIGRAPHX_VERSION=2.14.0

# --- Flutter SDK ---
FLUTTER_VERSION=3.44.8

# --- Runtime orchestrator ---
APP_REF=v0.0.27

# --- LLM stack (Ollama) ---
# renovate: datasource=github-releases depName=ollama/ollama extractVersion=^v(?<version>.*)$
OLLAMA_VERSION=0.32.5

# --- Android SDK / NDK ---
ANDROID_SDK_VERSION=14742923
ANDROID_NDK_VERSION=29.0.14206865
ANDROID_COMPILE_SDK=36
ANDROID_BUILD_TOOLS=35.0.0
ANDROID_CMAKE_VERSION=4.1.2
ANDROID_API_LEVEL=34

# --- NVIDIA GPU (single source for BOTH Windows and Linux) ---
# Full semvers pinning the SAME release on both platforms. Each consumer
# derives its platform form:
#   Linux (Dockerfile.nvidia):  13.3.0 → 13-3 apt package suffix; cuDNN major
#                               (9) for apt package names; exact-version apt
#                               pins from the full semvers where available.
#   Windows (build.ps1):        full semvers consumed directly by the CUDA
#                               installer / cuDNN download / TensorRT zip;
#                               dotted major.minor (13.3) derived in build.ps1.
CUDA_VERSION=13.3.1
CUDNN_VERSION=9.25.0.15
# TensorRT (Windows): OPTIONAL — place the TensorRT-*.zip in windows/downloads/
# (EULA-gated manual download) to include it. Without the zip the -Gpu lane
# builds fine: setup-tensorrt.ps1 warns and skips, CUDA + cuDNN still work and
# ORT auto-disables the TensorRT EP (the smoke test's TENSORRT_ROOT pointer
# passes on the guaranteed-empty C:\tensorrt). A 2026-08-04 fail-fast variant
# broke the zip-less lane and was reverted 2026-08-05.
TENSORRT_VERSION=11.1.0.106
# Target GPU architectures for all CUDA source builds (ONNX Runtime, OpenCV).
# Consumers decorate per build system: Windows clang-cl builds append `-real`;
# the Linux ONNX build maps the trailing 90 -> 90a (Hopper arch-specific kernels).
# Tip: set to just your local GPU's arch (e.g. 86) to roughly quarter CUDA build time.
CUDA_ARCHITECTURES="80;86;89;90"

# --- Windows build image ---
# LTSC version for the Windows Server Core base image FROM tag
WINDOWS_LTSC=2025
# PowerShell 7 (pwsh) version installed as the default shell in the Windows
# container base image. Downloaded as ZIP from GitHub releases.
PWSH_VERSION=7.6.4
# Windows SDK build (VS component Microsoft.VisualStudio.Component.Windows11SDK.<build>).
# Reaches setup-vs.ps1 as a --build-arg via build.ps1 + Dockerfile.base ARG -- NOT via
# load-versions.ps1, which deliberately runs after the VS install. 26100 = Win 11 24H2 SDK.
WINDOWS_SDK_BUILD=26100
# Visual Studio major (setup-vs.ps1 installs the latest stable; this pins the
# expected major for smoke-test-container.ps1 path assertions).
VISUAL_STUDIO_VERSION=18
# vcpkg toolchain ref (pinned release tag; setup-vcpkg.ps1 downloads this).
# MUST be >= 2026.06: older snapshots pin a vcpkg-tool that predates VS 18 and
# rejects its v145 toolset with a misleading "Unable to find a valid Visual
# Studio instance" (2026-07-12 base-build failure; VS itself was fine). 2026.06.24
# matches the verified windows-base snapshot (tool 2026-05-27, protobuf 6.33.4).
VCPKG_REF=2026.07.29
# Host protoc for LiteRT-LM codegen. NOT independent software: it must match the
# protobuf runtime pinned INSIDE LiteRT-LM's cmake/packages/protobuf/protobuf.cmake
# (v0.14.0 pins v6.31.1 -> protoc 31.1). Auto-bumping to latest protoc emits gencode
# the pinned runtime headers #error on (bit us 2026-08-03: 35.1 vs 6.31.1). Re-derive
# from upstream's protobuf.cmake whenever LITERT_LM_VERSION moves.
# bump:hold slaved to LiteRT-LM's internal protobuf pin, not a standalone tool
PROTOC_VERSION=31.1
# Protobuf runtime built by LiteRT-LM's protobuf_external (informational;
# matched to PROTOC_VERSION above).
# bump:hold slaved to LiteRT-LM's internal protobuf pin (see PROTOC_VERSION)
PROTOBUF_VERSION=6.31.1
# Temurin JRE major (ANTLR codegen in LiteRT-LM; fetched via adoptium API).
JRE_VERSION=21
# ANTLR version (fetched by LiteRT-LM's CMake; documentary).
ANTLR_VERSION=4.13.2
# libffi meson-port version (GStreamer wrap pre-extract).
LIBFFI_MESON_VERSION=3.2.9999.4

# --- Cross-build defaults ---
# `# noforward` marks the variable on the NEXT line as orchestrator/host-only:
# version-forwarding.sh forwards every other variable in this file as a
# --build-arg to nerdctl build.
# noforward
CROSS_DEFAULT_ARCHES=amd64,arm64,riscv64
# noforward
FAST_UBUNTU_MIRROR_URL_DEFAULT=https://archive.ubuntu.com/ubuntu/

# --- Image registry ---
# noforward
IMAGE_REGISTRY_PREFIX=ghcr.io/kataglyphis/kataglyphis_beschleuniger

# --- Documentation image (external/Kataglyphis-DocumANTation/Dockerfile) ---
# The `pandoc_all` image that builds the book, dissertation, slides and CV. It
# is standalone rather than part of the cross chain, so its pins are marked
# noforward -- nothing passes them as --build-arg to the Linux images. They live
# here anyway so a version still changes in exactly one place, and
# sync_versions.py keeps that Dockerfile's ARG defaults equal to these.
# renovate: datasource=github-releases depName=jgm/pandoc
# noforward
PANDOC_VERSION=3.10.1

# --- binaryen / wasm-opt (WebAssembly size optimisation) ---
# Bootstrapped on demand by linux/scripts/lib/wasm-opt.sh and
# windows/scripts/modules/WindowsWasmOpt.Common.psm1 when wasm-opt is not
# already on PATH; no image installs it, hence noforward. Both the bash and the
# PowerShell side read the version AND the checksums from this file, so the pin
# lives in exactly one place across the two languages. Bump the version and BOTH
# checksums together. Fetch with:
#   curl -fL https://github.com/WebAssembly/binaryen/releases/download/${BINARYEN_VERSION}/binaryen-${BINARYEN_VERSION}-x86_64-<linux|windows>.tar.gz | sha256sum
# renovate: datasource=github-releases depName=WebAssembly/binaryen
# noforward
BINARYEN_VERSION=version_131
# noforward
BINARYEN_LINUX_X86_64_SHA256=b5bf1f0eaf17c63ee588ff7a5954dc8f6ce2c26989051c66f24dfe9ece3e46db
# noforward
BINARYEN_WINDOWS_X86_64_SHA256=2f4edac1703a2f695254d6ff52ede03481e67db1f094915763d863158c17d9bc

# --- hadolint (Dockerfile lint gate) ---
# Bootstrapped on demand by linux/scripts/lint-dockerfiles.sh when hadolint is
# not already on PATH; no image installs it, hence noforward. Bump the version
# and ALL checksums together. Fetch with:
#   curl -fL https://github.com/hadolint/hadolint/releases/download/${HADOLINT_VERSION}/hadolint-<linux-x86_64|linux-arm64|windows-x86_64.exe> | sha256sum
# renovate: datasource=github-releases depName=hadolint/hadolint
# noforward
HADOLINT_VERSION=v2.15.1
# noforward
HADOLINT_LINUX_X86_64_SHA256=c7187db94eeeeca956519a6af171adc31453941a1e777961f6e680f697c8c507
# noforward
HADOLINT_LINUX_ARM64_SHA256=f6198ef8090f404dbb771abfee086eb8c48ac177f30da7fd3510aca35b344b5d
# noforward
HADOLINT_WINDOWS_X86_64_SHA256=01d927294962b5387f9ead4f18679158452be4f17c765ad0bdffe5264b9c7b0a

# --- actionlint (GitHub workflow/composite-action lint gate) ---
# Bootstrapped on demand by linux/scripts/lint-workflows.sh. Bump the version
# and ALL checksums together. Fetch with:
#   curl -fL https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_<linux_amd64.tar.gz|linux_arm64.tar.gz|windows_amd64.zip> | sha256sum
# renovate: datasource=github-releases depName=rhysd/actionlint extractVersion=^v(?<version>.*)$
# noforward
ACTIONLINT_VERSION=1.7.12
# noforward
ACTIONLINT_LINUX_AMD64_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
# noforward
ACTIONLINT_LINUX_ARM64_SHA256=325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6
# noforward
ACTIONLINT_WINDOWS_AMD64_SHA256=6e7241b51e6817ea6a047693d8e6fed13b31819c9a0dd6c5a726e1592d22f6e9

# servercore base image digest: pins the exact monthly-patched Windows base the
# chain builds FROM (a floating :ltsc2025 tag silently moves on patch Tuesday,
# and base-image build revisions genuinely matter on this lane — see the wcifs
# commit-bug diagnosis). Bump deliberately together with a from-base rebuild:
#   curl -sI -H "Accept: application/vnd.docker.distribution.manifest.list.v2+json" https://mcr.microsoft.com/v2/windows/servercore/manifests/ltsc${WINDOWS_LTSC} | grep -i docker-content-digest
# noforward
WINDOWS_BASE_DIGEST=sha256:d5bbb83057f6bc2b6aeba5d01ec80a53003aba9bc84a6b1ebe780570cd52558a

# --- Windows toolchain download checksums ---
# Consumed inside the Windows images: as baked env (load-versions.ps1) for the
# setup scripts, and as the PWSH_ZIP_SHA256 ARG in windows/Dockerfile.base for
# the pwsh bootstrap that runs before any module is available. Update together
# with the corresponding *_VERSION key. Windows-only, hence noforward.
# pwsh zip + git installer: GitHub publishes per-asset sha256 digests
# (https://api.github.com/repos/<owner>/<repo>/releases/tags/<tag>, assets[].digest).
# noforward
PWSH_ZIP_SHA256=80832551c52809301e6071c8bac977beb5a2f1ec953eb4db9f94deb953333793
# noforward
GIT_WINDOWS_INSTALLER_SHA256=0c66e4a5875da5a74f9754386de7555ba301503b03bbdcdbafa69dc6464e548d
# nuget.exe: versioned dist URL (https://dist.nuget.org/tools.json lists releases).
#   curl -fL https://dist.nuget.org/win-x86-commandline/v${NUGET_VERSION}/nuget.exe | sha256sum
# noforward
NUGET_VERSION=7.6.0
# noforward
NUGET_EXE_SHA256=751ee5e79481626a428c1241dc7f94bca2739b32588e669715bc5fb54d8fb8a2
# CUDA full local installer (cuda_${CUDA_VERSION}_windows.exe): NVIDIA publishes
# only MD5 (docs/sidebar/md5sum.txt); this SHA256 was computed from a download
# whose MD5 matched the published value. cuDNN: sha256 straight from NVIDIA's
# redist manifest (compute/cudnn/redist/redistrib_${CUDNN_VERSION%.*}.json).
# noforward
CUDA_INSTALLER_SHA256=d68839fcce644576f0a1c6b066e0c5bc146a62db2fcac9fc6b4e6418e7ec533f
# noforward
CUDNN_ZIP_SHA256=1ee69c966cfd43d883d7e00e10b6e3052112a7b2abd2a9b0ef293eea1eae5f1e
# get.scoop.sh installer script: hash-pinned so the code we execute is the code
# we reviewed. Scoop revs this file occasionally — a mismatch is the gate doing
# its job: re-download, review, and bump this hash deliberately.
#   curl -fL https://get.scoop.sh | sha256sum
# noforward
SCOOP_INSTALLER_SHA256=48f6ea398b3a3fa26fae0093d37bd85b13e7eaa5d1d4a3e208408768408e35ae
# TensorRT zip is an EULA-gated manual download whose exact file varies per
# user; empty = skip verification. Set to the sha256 of YOUR downloaded zip to
# pin it (Get-FileHash windows\downloads\TensorRT-*.zip).
# noforward
TENSORRT_ZIP_SHA256=

# Ollama release tarballs (host-side download by llm-stack/scripts/download-ollama.sh;
# per-asset sha256 digests published on the GitHub release API). Bump with OLLAMA_VERSION.
# noforward
OLLAMA_AMD64_SHA256=f7d6bdbcf71b83aa8670c4e7dc4b6936c0952fcf8b114eaf6a11cbadb9684214
# noforward
OLLAMA_ARM64_SHA256=aa7e06b5683ee66c4a3ec68ea7236db43b5a5d0821f0dfe2c5a215f4462bddf4

# --- Download verification checksums (update when bumping versions) ---
NODE_AMD64_SHA256=cc7b3484ade63bd203a9d304f21ec37a3b622b988d7bdecf1dc4d68fc44a91b7
NODE_ARM64_SHA256=0b6b0cc2a1eecbe736f9918de8b5a6c9a48d286b88bec1298a3c1e3376182ea8
# No official RISC-V tarball; Node packages come from distro repos on riscv64
UV_AMD64_SHA256=90b2f223fb69d19db49e117da601f64978593417988530aa733d456141b4bcbb
UV_ARM64_SHA256=769d373e146692c639b5fbaae33b331c297a32e03d30448772051902df52bbf4
UV_RISCV64_SHA256=dda637a8f2f11b73a3e8da35c7909772beb49799aea61bacb04c2e7d2455b939

# Python source tarball SHA256 (build_python.sh; update when bumping PYTHON_VERSION)
PYTHON_TGZ_SHA256=74d0d71d0600e477651a077101d6e62d1e2e69b8e992ba18c993dd643b7ba222

# CMake tarball SHA256 (used by cmake.sh; follows the NODE/UV checksum pattern)
CMAKE_AMD64_SHA256=3ada9a3f5d8a85413579bdd0ea6aa8e8da86efdd6d15c91a1afa517f2021956c
CMAKE_ARM64_SHA256=9ca1aadb4451c5dcbdc67f9b4aff42dab52abbaebd8db9e2900026502dbed671

# Pandoc .deb SHA256 per arch (update together with PANDOC_VERSION). Fetch with:
#   curl -fL https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-1-<arch>.deb | sha256sum
# noforward
PANDOC_SHA256_AMD64=b419369915e0f3181be0afdb040ec8ecc6b70e72e5992652a0d83aed9e6bc109
# noforward
PANDOC_SHA256_ARM64=14add8849fda702051f8f4da7b080dfab91ac7a11144602a9643e065d3b4c206

# --- Dependency output directories (shared across media/package stages) ---
# Forwarded as build-args because Dockerfile.media / Dockerfile.package declare
# matching ARGs — keeping them forwarded lets per-build overrides win over the
# defaults below.
ONNXRUNTIME_OUTPUT_DIR=/usr/local/lib/onnxruntime-cpu
ONNXRUNTIME_GENAI_OUTPUT_DIR=/usr/local/lib/onnxruntime-genai
LITERT_OUTPUT_DIR=/usr/local
OPENCV_OUTPUT_DIR=/opt/opencv5
GSTREAMER_PREFIX=/opt/gstreamer

# --- shellcheck (shell lint gate) ---
# Bootstrapped on demand by linux/scripts/lint-shell.sh when shellcheck is not
# already on PATH; no image installs it, hence noforward. Bump the version and
# BOTH checksums together. Fetch with:
#   curl -fL https://github.com/koalaman/shellcheck/releases/download/${SHELLCHECK_VERSION}/shellcheck-${SHELLCHECK_VERSION}.linux.x86_64.tar.xz | sha256sum
#   curl -fL https://github.com/koalaman/shellcheck/releases/download/${SHELLCHECK_VERSION}/shellcheck-${SHELLCHECK_VERSION}.zip | sha256sum
# renovate: datasource=github-releases depName=koalaman/shellcheck
# noforward
SHELLCHECK_VERSION=v0.11.0
# noforward
SHELLCHECK_LINUX_X86_64_SHA256=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
# The .zip release asset is the Windows binary (used under Git Bash / MSYS).
# noforward
SHELLCHECK_WINDOWS_SHA256=8a4e35ab0b331c85d73567b12f2a444df187f483e5079ceffa6bda1faa2e740e

# --- curl|sh installer pins (rustup, uv) ---
# install-rust.sh downloads https://sh.rustup.rs to a file and, when this key
# is non-empty, verifies its sha256 before executing it. Upstream rotates the
# script without notice, so empty = skip verification (the default). To pin
# deliberately: download, review, then record the hash:
#   curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sha256sum
# noforward
RUSTUP_INIT_SHA256=
# Same optional pin for the uv installer executed by 01-core/python_uv.sh
# (uv_ensure_installed). Empty = skip (upstream rotates the script with each
# uv release):
#   curl --proto '=https' --tlsv1.2 -fsSL https://astral.sh/uv/install.sh | sha256sum
# noforward
UV_INSTALL_SH_SHA256=
