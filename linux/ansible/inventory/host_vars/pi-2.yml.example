---
# Template for inventory/host_vars/<host>.yml — the REAL file is gitignored
# (network topology and per-host decisions stay off the remote).
#
# Remote host (address + login):
ansible_host: <address>
ansible_user: <user>
#
# Control-node flags (what the weekly update does BEYOND apt) — any of these
# can also be set on a remote Pi:
# managed_compose_projects:   # nerdctl compose pull + force-recreate
#   - linux/homeassistant/compose.yaml
# manage_ansible_venv: true   # pip install --upgrade ansible (runs late)
# report_nerdctl_upstream: true  # report-only toolchain drift check
#
# The weekly backup to the NAS (playbooks/backup.yml, README "Backups to the NAS"):
# on the hub (pi-1):
# backup_nas_share: //<nas address>/Backup
# backup_nas_credentials: /etc/ansible-backup/nas.credentials   # root:root 0600
# backup_age_recipients: [age1...]   # public key only
# backup_homeassistant: true
# on any host, the hub included:
# backup_secret_paths:               # absolute paths, bundled and age-encrypted
#   - /etc/wireguard
# on a Nextcloud AIO host:
# backup_nextcloud_aio_repo: /root/nextcloud_aio/borg
