[Unit]
Description=Schedule the weekly Raspberry Pi fleet update

[Timer]
# Sunday 04:30 Berlin time, with up to 30 min jitter to avoid a synchronized
# load spike if more hosts join the fleet.
OnCalendar=Sun *-*-* 04:30:00
RandomizedDelaySec=30m
# Catch up after the Pi was powered off during the scheduled slot.
Persistent=true

[Install]
WantedBy=timers.target
