+/**
+ * Add -> Slice -> Reshape: MIGraphX keeps the sliced tensor a strided view and returns it as the
+ * partition's output, so the provider has to make it dense before ORT reads it.
+ */
+static void CreateSlicedViewModel(onnxruntime::Model& model) {
+  auto& graph = model.MainGraph();
+
+  ONNX_NAMESPACE::TypeProto float_tensor;
+  float_tensor.mutable_tensor_type()->set_elem_type(ONNX_NAMESPACE::TensorProto_DataType_FLOAT);
+  for (int dim : {1, 2, 8}) {
+    float_tensor.mutable_tensor_type()->mutable_shape()->add_dim()->set_dim_value(dim);
+  }
+  ONNX_NAMESPACE::TypeProto float_tensor_any;
+  float_tensor_any.mutable_tensor_type()->set_elem_type(ONNX_NAMESPACE::TensorProto_DataType_FLOAT);
+
+  // The NodeArg copies its TypeProto, so a local one per initializer is enough.
+  auto add_int64_initializer = [&graph](const std::string& name, const std::vector<int64_t>& values) -> NodeArg& {
+    TensorProto t;
+    t.add_dims(static_cast<int64_t>(values.size()));
+    for (auto v : values) t.add_int64_data(v);
+    t.set_data_type(ONNX_NAMESPACE::TensorProto_DataType_INT64);
+    t.set_name(name);
+    graph.AddInitializedTensor(t);
+    ONNX_NAMESPACE::TypeProto type;
+    type.mutable_tensor_type()->set_elem_type(ONNX_NAMESPACE::TensorProto_DataType_INT64);
+    type.mutable_tensor_type()->mutable_shape()->add_dim()->set_dim_value(static_cast<int64_t>(values.size()));
+    return graph.GetOrCreateNodeArg(name, &type);
+  };
+  TensorProto one;
+  one.add_dims(1);
+  one.add_float_data(1.f);
+  one.set_data_type(ONNX_NAMESPACE::TensorProto_DataType_FLOAT);
+  one.set_name("One");
+  graph.AddInitializedTensor(one);
+  auto& starts = add_int64_initializer("starts", {0});
+  auto& ends = add_int64_initializer("ends", {6});
+  auto& axes = add_int64_initializer("axes", {2});
+  auto& shape = add_int64_initializer("shape", {1, 2, 2, 3});
+
+  auto& x = graph.GetOrCreateNodeArg("X", &float_tensor);
+  auto& sum = graph.GetOrCreateNodeArg("sum", &float_tensor_any);
+  auto& sliced = graph.GetOrCreateNodeArg("sliced", &float_tensor_any);
+  auto& m = graph.GetOrCreateNodeArg("M", &float_tensor_any);
+  auto& one_arg = graph.GetOrCreateNodeArg("One", &float_tensor_any);
+  graph.AddNode("add", "Add", "", {&x, &one_arg}, {&sum});
+  graph.AddNode("slice", "Slice", "", {&sum, &starts, &ends, &axes}, {&sliced});
+  graph.AddNode("reshape", "Reshape", "", {&sliced, &shape}, {&m});
+  auto status = graph.Resolve();
+  ASSERT_TRUE(status.IsOK());
+}
+
+TEST(MIGraphXExecutionProviderTest, StridedPartitionOutputIsDense) {
+  PathString model_name = ORT_TSTR("migraphx_strided_output_test.onnx");
+  onnxruntime::Model model("migraphx_strided_output_test", false, DefaultLoggingManager().DefaultLogger());
+  CreateSlicedViewModel(model);
+  ASSERT_TRUE(onnxruntime::Model::Save(model, model_name).IsOK());
+
+  SessionOptions so;
+  so.session_logid = "MIGraphXExecutionProviderTest.StridedPartitionOutputIsDense";
+  InferenceSession session_object{so, GetEnvironment()};
+  ASSERT_TRUE(session_object.RegisterExecutionProvider(DefaultMIGraphXExecutionProvider()).IsOK());
+  ASSERT_TRUE(session_object.Load(model_name).IsOK());
+  ASSERT_TRUE(session_object.Initialize().IsOK());
+
+  std::vector<int64_t> dims_x = {1, 2, 8};
+  std::vector<float> values_x(16);
+  for (size_t i = 0; i < values_x.size(); ++i) values_x[i] = static_cast<float>(i);
+  OrtValue ml_value_x;
+  CreateMLValue<float>(TestCPUExecutionProvider()->CreatePreferredAllocators()[0], dims_x, values_x, &ml_value_x);
+  NameMLValMap feeds;
+  feeds.insert(std::make_pair("X", ml_value_x));
+
+  // (X + 1)[:, :, 0:6] reshaped to [1, 2, 2, 3]; a strided write read as dense gives other numbers.
+  std::vector<int64_t> expected_dims = {1, 2, 2, 3};
+  std::vector<float> expected_values = {1.f, 2.f, 3.f, 4.f, 5.f, 6.f, 9.f, 10.f, 11.f, 12.f, 13.f, 14.f};
+  RunOptions run_options;
+  for (int run = 0; run < 2; ++run) {
+    std::vector<OrtValue> fetches;
+    ASSERT_TRUE(session_object.Run(run_options, feeds, {"M"}, &fetches).IsOK());
+    VerifyOutputs(fetches, expected_dims, expected_values);
+  }
+}
+
