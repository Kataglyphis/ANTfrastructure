From 45b17f8cb3277c5d87953df62567f9b960a4d887 Mon Sep 17 00:00:00 2001
From: Jonas Heinle <jonasheinle@googlemail.com>
Date: Sat, 7 Nov 2026 12:19:35 +0100
Subject: [PATCH] [MIGraphX EP] Make a strided partition output dense before
 ORT reads it

MIGraphX can return a partition output as a strided view, for example when
the partition ends in Slice + Reshape. The compute function bound that
output parameter straight onto ORT's dense output tensor with MIGraphX's
shape: the view's span is larger than the dense tensor, so the write
overran the allocation and ORT read the strided bytes as dense. The result
was wrong and changed between runs (ORT 1.31.0, MIGraphX 2.18.0, gfx1201).

An output whose parameter shape is not standard is now staged in a scratch
buffer from the kernel context's allocator and copied into ORT's tensor by
a one-op "contiguous" program compiled for the same target, cached per
output parameter and rebuilt with the program. Standard outputs are bound
as before.

The new test runs Add -> Slice -> Reshape on the MIGraphX EP twice and
compares with the expected values.
---
 .../migraphx/migraphx_execution_provider.cc   | 48 ++++++++++-
 .../migraphx/migraphx_execution_provider.h    |  2 +
 .../providers/migraphx/migraphx_basic_test.cc | 84 +++++++++++++++++++
 3 files changed, 133 insertions(+), 1 deletion(-)

diff --git a/onnxruntime/core/providers/migraphx/migraphx_execution_provider.cc b/onnxruntime/core/providers/migraphx/migraphx_execution_provider.cc
index cc7144e..b1ff48e 100644
--- a/onnxruntime/core/providers/migraphx/migraphx_execution_provider.cc
+++ b/onnxruntime/core/providers/migraphx/migraphx_execution_provider.cc
@@ -1306,6 +1306,27 @@ std::string make_hash(const char* v) {
 constexpr std::uint64_t MIGraphX_Version =
     ((MIGRAPHX_VERSION_MAJOR << 16) | (MIGRAPHX_VERSION_MINOR << 8) | MIGRAPHX_VERSION_PATCH);
 
+// MIGraphX may return a partition output as a strided view (a partition that ends in Slice/Reshape).
+// ORT's output tensor is dense and smaller than the view's span, so such an output is staged in a
+// scratch buffer and copied through a one-op "contiguous" program compiled for the same target.
+static migraphx::program MakeContiguousProgram(const migraphx::shape& view, const migraphx::target& t) {
+  migraphx::program prog;
+  auto mm = prog.get_main_module();
+  auto x = mm.add_parameter("x", view);
+  auto y = mm.add_instruction(migraphx::operation("contiguous"), migraphx::instructions{x});
+  mm.add_return(migraphx::instructions{y});
+  prog.compile(t);
+  return prog;
+}
+
+struct StridedOutput {
+  std::string name;
+  migraphx::shape view;
+  void* output_data;
+  Ort::Allocator allocator;
+  Ort::MemoryAllocation scratch;  // declared last: freed before the allocator that owns it
+};
+
 Status MIGraphXExecutionProvider::Compile(const std::vector<FusedNodeAndGraph>& fused_nodes,
                                           std::vector<NodeComputeInfo>& node_compute_funcs) {
   migraphx::onnx_options options;
@@ -1534,6 +1555,7 @@ Status MIGraphXExecutionProvider::Compile(const std::vector<FusedNodeAndGraph>&
         }
 
         mgx_state->prog = prog;
+        mgx_state->contiguous_progs.clear();
         param_shapes = prog.get_parameter_shapes();
         no_input_shape = false;
       }
@@ -1541,6 +1563,7 @@ Status MIGraphXExecutionProvider::Compile(const std::vector<FusedNodeAndGraph>&
       migraphx::program_parameters m;
       auto prog_output_shapes = prog.get_output_shapes();
       std::vector<std::size_t> prog_output_indices;
+      std::vector<StridedOutput> strided_outputs;
       if (param_shapes.size() > 0) {
         for (auto&& name : param_shapes.names()) {
           if (map_input_name_index.count(name) > 0) {
@@ -1586,7 +1609,15 @@ Status MIGraphXExecutionProvider::Compile(const std::vector<FusedNodeAndGraph>&
 
               // argument shape
               auto mgx_arg_shape = param_shapes[name];
-              m.add(name, migraphx::argument(mgx_arg_shape, output_data));
+              if (mgx_arg_shape.standard()) {
+                m.add(name, migraphx::argument(mgx_arg_shape, output_data));
+              } else {
+                const OrtMemoryInfo* mem_info = output_tensor.GetTensorMemoryInfo();
+                Ort::Allocator allocator = ctx.GetAllocator(*mem_info);
+                Ort::MemoryAllocation scratch = allocator.GetAllocation(mgx_arg_shape.bytes());
+                m.add(name, migraphx::argument(mgx_arg_shape, scratch.get()));
+                strided_outputs.push_back({name, mgx_arg_shape, output_data, std::move(allocator), std::move(scratch)});
+              }
             }
           }
         }
@@ -1600,6 +1631,21 @@ Status MIGraphXExecutionProvider::Compile(const std::vector<FusedNodeAndGraph>&
         Ort::ThrowOnError(api->KernelContext_GetGPUComputeStream(context, &rocm_stream));
         auto prog_outputs = prog.run_async(m, static_cast<hipStream_t>(rocm_stream));
 
+        for (auto& out : strided_outputs) {
+          auto it = mgx_state->contiguous_progs.find(out.name);
+          if (it == mgx_state->contiguous_progs.end()) {
+            it = mgx_state->contiguous_progs.emplace(out.name, MakeContiguousProgram(out.view, t)).first;
+          }
+          auto contiguous_shapes = it->second.get_parameter_shapes();
+          migraphx::program_parameters contiguous_params;
+          for (auto&& pname : contiguous_shapes.names()) {
+            const bool is_output = std::string_view(pname).find("#output_") != std::string_view::npos;
+            contiguous_params.add(pname, migraphx::argument(contiguous_shapes[pname],
+                                                            is_output ? out.output_data : out.scratch.get()));
+          }
+          it->second.run_async(contiguous_params, static_cast<hipStream_t>(rocm_stream));
+        }
+
         // In case of input parameters are reused as output parameter call hipMemcpy
         auto output_num = prog_outputs.size();
         if (prog_output_indices.size() < output_num) {
diff --git a/onnxruntime/core/providers/migraphx/migraphx_execution_provider.h b/onnxruntime/core/providers/migraphx/migraphx_execution_provider.h
index 99f790b..c83e8c4 100644
--- a/onnxruntime/core/providers/migraphx/migraphx_execution_provider.h
+++ b/onnxruntime/core/providers/migraphx/migraphx_execution_provider.h
@@ -45,6 +45,8 @@ struct MIGraphXFuncState {
   migraphx::onnx_options options;
   migraphx::target t{};
   std::unordered_map<std::string, std::size_t> input_name_indexes;
+  // One "contiguous" program per output parameter that MIGraphX returns as a strided view, keyed by its name.
+  std::unordered_map<std::string, migraphx::program> contiguous_progs;
   std::mutex* mgx_mu_ptr = nullptr;
   bool no_input_shape = false;
   bool fp16_enable = false;
