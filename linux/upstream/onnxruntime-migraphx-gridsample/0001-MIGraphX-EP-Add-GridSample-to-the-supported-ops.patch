From 1c90993e962fe33b6fdbc0a060d6eb1e18c0bfe3 Mon Sep 17 00:00:00 2001
From: Jonas Heinle <jonasheinle@googlemail.com>
Date: Sat, 7 Nov 2026 12:19:35 +0100
Subject: [PATCH] [MIGraphX EP] Add GridSample to the supported ops

MIGraphX parses and runs ONNX GridSample (bilinear, zeros padding,
align_corners, checked with 2.18.0), but the provider's op list omitted
it, so every GridSample stayed on the CPU and split the graph around it.
A DEIM/D-FINE detector with six of them became five partitions; with
GridSample on the list it compiles as one.
---
 .../core/providers/migraphx/migraphx_execution_provider.cc       | 1 +
 1 file changed, 1 insertion(+)

diff --git a/onnxruntime/core/providers/migraphx/migraphx_execution_provider.cc b/onnxruntime/core/providers/migraphx/migraphx_execution_provider.cc
index cc7144e..45dc221 100644
--- a/onnxruntime/core/providers/migraphx/migraphx_execution_provider.cc
+++ b/onnxruntime/core/providers/migraphx/migraphx_execution_provider.cc
@@ -926,6 +926,7 @@ GetUnsupportedNodeIndices(const GraphViewer& graph_viewer,
                                                     "GlobalMaxPool",
                                                     "Greater",
                                                     "GreaterOrEqual",
+                                                    "GridSample",
                                                     "GroupNormalization",
                                                     "GroupNorm",
                                                     "GroupQueryAttention",
-- 
2.53.0

