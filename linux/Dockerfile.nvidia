# syntax=docker/dockerfile:1.27.1

# Optional NVIDIA layer (:sdk -> :toolchain-nvidia), used only by the -nvidia variants.

ARG BASE_IMAGE=local/kataglyphis:sdk
FROM ${BASE_IMAGE}

# Pins come from versions.env and are shared with windows/Dockerfile.nvidia.
ARG CUDA_VERSION=13.4.2
ARG CUDNN_VERSION=9.26.0.51
ARG TENSORRT_VERSION=11.3.0.99
# false = CUDA + cuDNN without TensorRT (Jetson); gates both the install and the strict verify.
ARG ENABLE_TENSORRT=true
# 0 on Jetson, whose host-injected libcuda the datacenter compat driver would shadow; must be an ARG to reach the script.
ARG CUDA_INSTALL_COMPAT=1
# 13.3.0 -> 13.3 (repo paths) -> 13-3 (apt suffix); cuDNN major.
ARG CUDA_VERSION_DOT=${CUDA_VERSION%.*}
ARG CUDA_VERSION_MAJOR_MINOR=${CUDA_VERSION_DOT/./-}
ARG CUDNN_MAJOR=${CUDNN_VERSION%%.*}

ARG TARGETARCH
# A foreign TARGET_ARCH installs NVIDIA's cross target (sbsa-linux) beside the host one; empty means native.
ARG TARGET_ARCH
ARG UBUNTU_CODENAME=resolute
# Update with the codename: docs/failure-modes.md#the-nvidia-apt-keyring-404s-on-ubunturesolute
ARG UBUNTU_VERSION=26.04
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL


SHELL ["bash", "-lc"]

RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    TARGET_ARCH="${TARGET_ARCH:-}" bash /tmp/core-scripts/setup-cuda-repo.sh

# CUDA toolkit, cuDNN, NCCL, math libraries
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    _cuda_cross_dir=""; \
    if [ -n "${TARGET_ARCH:-}" ] && [ "${TARGET_ARCH}" != "${TARGETARCH}" ]; then \
      case "${TARGET_ARCH}" in \
        arm64) _cuda_cross_dir="sbsa-linux" ;; \
        *) echo "ERROR: no CUDA cross target for TARGET_ARCH=${TARGET_ARCH}" >&2; exit 1 ;; \
      esac; \
    fi; \
    CUDA_CROSS_TARGET_DIR="${_cuda_cross_dir}" bash /tmp/core-scripts/install-cuda-stack.sh
    # The CUDA repo stays until the TensorRT RUN below, its last apt consumer.

# TensorRT: copy the always-present drop dir, since a glob COPY fails the build when no deb is staged.
COPY --link linux/nvidia-local-debs/ /tmp/tensorrt-staging/
# Pick the deb named for this dpkg arch, else the first in C byte order (not version order); log every candidate.
RUN set -euo pipefail; \
    export LC_ALL=C; \
    shopt -s nullglob; \
    _trt_debs=(/tmp/tensorrt-staging/tensorrt-local-repo*.deb); \
    _trt_staged=(/tmp/tensorrt-staging/*.deb); \
    shopt -u nullglob; \
    _trt_arch="$(dpkg --print-architecture 2>/dev/null || true)"; \
    _trt_pick=""; \
    _trt_rule=""; \
    if [ "${#_trt_debs[@]}" -gt 0 ]; then \
        for _trt_cand in "${_trt_debs[@]}"; do \
            case "${_trt_cand}" in \
              *_"${_trt_arch:-__no_dpkg_arch__}".deb) \
                _trt_pick="${_trt_cand}"; _trt_rule="arch-match ${_trt_arch}"; break ;; \
            esac; \
        done; \
        if [ -z "${_trt_pick}" ]; then \
            _trt_pick="${_trt_debs[0]}"; _trt_rule="first in LC_ALL=C glob order (no name carries _${_trt_arch:-?}.deb)"; \
        fi; \
    fi; \
    if [ -n "${_trt_pick}" ]; then \
        echo "TensorRT local-repo: SELECTED ${_trt_pick##*/} [${_trt_rule}] out of ${#_trt_debs[@]} pattern match(es): ${_trt_debs[*]##*/}"; \
        if [ "${#_trt_debs[@]}" -gt 1 ]; then \
            echo "WARNING: ${#_trt_debs[@]} TensorRT local-repo debs staged in linux/nvidia-local-debs/; installing ${_trt_pick##*/} and DISCARDING the rest — leave only the deb this lane should install." >&2; \
        fi; \
        mv "${_trt_pick}" /tmp/tensorrt-local-repo.deb; \
    else \
        echo "TensorRT local-repo: no linux/nvidia-local-debs/tensorrt-local-repo*.deb staged — falling through to the NVIDIA apt repo tier"; \
    fi; \
    if [ "${#_trt_staged[@]}" -gt "${#_trt_debs[@]}" ]; then \
        echo "WARNING: $(( ${#_trt_staged[@]} - ${#_trt_debs[@]} )) of ${#_trt_staged[@]} deb(s) in linux/nvidia-local-debs/ do NOT match tensorrt-local-repo*.deb and were IGNORED (staged: ${_trt_staged[*]##*/}). NVIDIA ships this artifact as nv-tensorrt-local-repo-<os>-<ver>_1.0-1_<arch>.deb — rename it to match, or widen the glob here." >&2; \
    fi; \
    rm -rf /tmp/tensorrt-staging; \
    # The COPY --link above reset /tmp to 0755: docs/failure-modes.md#apt-gpgv-exits-111-after-a-copy---link-into-tmp
    chmod 1777 /tmp
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    if [ "${ENABLE_TENSORRT}" = "false" ]; then \
        echo "ENABLE_TENSORRT=false — skipping TensorRT install (CUDA + cuDNN only)"; \
    else \
        bash /tmp/core-scripts/install-tensorrt.sh; \
    fi

# No later stage apt-installs CUDA, so drop the NVIDIA repos; the keyring package stays to keep dpkg consistent.
RUN set -euo pipefail; \
    rm -f /etc/apt/sources.list.d/cuda*.list /etc/apt/sources.list.d/nv-tensorrt-local*.list; \
    rm -rf /var/nv-tensorrt-local-repo* 2>/dev/null || true; \
    rm -rf /var/lib/apt/lists/*; \
    ldconfig

# CUDA environment
ENV CUDA_HOME=/usr/local/cuda \
    CUDA_ROOT=/usr/local/cuda \
    CUDNN_HOME=/usr/local/cuda \
    TENSORRT_HOME=/usr/local/tensorrt

# Separate ENV: ${VAR} reads the value from before its instruction. docs/code-quality-tooling.md#env-instruction-ordering-dockerfile-lint
ENV PATH="${CUDA_HOME}/bin:${PATH}" \
    LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${CUDA_HOME}/lib64/stubs:${TENSORRT_HOME}/lib:${LD_LIBRARY_PATH:-}" \
    PKG_CONFIG_PATH="${CUDA_HOME}/lib64/pkgconfig:${PKG_CONFIG_PATH:-}" \
    LIBRARY_PATH="${CUDA_HOME}/lib64/stubs:${LIBRARY_PATH:-}"

# Strict verification, as on the AMD lane: a fail-open verify let a build with nothing installed go green.
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    set -euo pipefail; \
    CUDA_STACK_STRICT=1 \
    CUDA_STACK_REQUIRE_TENSORRT="$([ "${ENABLE_TENSORRT}" = "false" ] && echo 0 || echo 1)" \
    bash /tmp/core-scripts/verify-cuda-stack.sh
LABEL org.opencontainers.image.title="Kataglyphis Toolchain NVIDIA" \
      org.opencontainers.image.description="NVIDIA GPU library layer: CUDA, cuDNN, TensorRT, NCCL, math libs, NVTX"
