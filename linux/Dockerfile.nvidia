# syntax=docker/dockerfile:1.24.0

# ==============================================================================
# Dockerfile.nvidia  —  Optional NVIDIA GPU library layer
#
# Position in the chain:
#   :sdk  →  THIS (:toolchain-nvidia)  →  :media-nvidia  →  :android-nvidia  →  :nvidia
#
# What this installs on top of the standard SDK image:
#   • CUDA Toolkit (nvcc, cudart, NVCC headers)          — CUDA_VERSION
#   • cuDNN (Deep Neural Network library)                 — CUDNN_VERSION
#   • TensorRT (inference optimizer + runtime)            — TENSORRT_VERSION
#   • NCCL (multi-GPU collective comms)                   — from CUDA repo
#   • cuBLAS, cuSPARSE, cuFFT  (CUDA math libraries)     — from CUDA repo
#   • NVTX (Nsight profiler headers)                      — from CUDA repo
#   • CUDA Firmware / driver-independent libs             — from CUDA repo
#
# The STANDARD build chain (Dockerfile.base → Dockerfile.toolchain →
# Dockerfile.sdk → Dockerfile.media → Dockerfile.android → Dockerfile)
# is UNCHANGED.
# This file is ONLY used when building the -nvidia variants.
#
# Usage:
#   docker buildx build \
#     --build-arg BASE_IMAGE=local/kataglyphis:sdk \
#     -t local/kataglyphis:toolchain-nvidia \
#     -f linux/Dockerfile.nvidia .
# ==============================================================================

ARG BASE_IMAGE=local/kataglyphis:sdk
FROM ${BASE_IMAGE}

# ------------------------------------------------------------------------------
# Version ARGs — override at build time as needed
# Single source of truth: linux/scripts/01-core/versions.env. The full semvers
# are SHARED with the Windows build (windows/Dockerfile.nvidia) so both
# platforms pin the exact same NVIDIA releases.
# ------------------------------------------------------------------------------
# CUDA 13.3 requires driver >= 590.44.01 (Linux)
ARG CUDA_VERSION=13.3.0
ARG CUDNN_VERSION=9.23.2.1
ARG TENSORRT_VERSION=11.1.0.106
# Apt package-name forms derived from the shared semvers:
#   13.3.0 → 13.3 (repo paths) → 13-3 (apt package suffix); 9.23.2.1 → 9 (cuDNN major)
ARG CUDA_VERSION_DOT=${CUDA_VERSION%.*}
ARG CUDA_VERSION_MAJOR_MINOR=${CUDA_VERSION_DOT/./-}
ARG CUDNN_MAJOR=${CUDNN_VERSION%%.*}

ARG TARGETARCH
ARG UBUNTU_CODENAME=resolute
# UBUNTU_CODENAME is the official codename (resolute for 26.04). Update in lockstep.
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL


SHELL ["bash", "-lc"]

RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    bash /tmp/core-scripts/setup-cuda-repo.sh

# ==============================================================================
# 1. NVIDIA Components (CUDA Toolkit, cuDNN, NCCL, Math Libraries)
# ==============================================================================
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    bash /tmp/core-scripts/install-cuda-stack.sh
    # NOTE: the CUDA repo (/etc/apt/sources.list.d/cuda*.list) is intentionally
    # NOT removed by install-cuda-stack.sh — the TensorRT RUN below still installs
    # tensorrt-dev / tensorrt-libs from the NVIDIA apt repo.  Repo removal happens
    # at the end of that RUN (the last apt install against NVIDIA repos in this file).

# ==============================================================================
# 2. TensorRT — try local repo deb, then NVIDIA apt repo, then skip
# ==============================================================================
# A bare `COPY tensorrt-local-repo*.deb` FAILS the whole build when no deb is
# present ("no source files were specified") — contradicting the optional
# 3-tier fallback below. COPY the committed drop-directory instead (always
# exists via its README), then normalize inside the RUN: drop your EULA-gated
# deb into linux/nvidia-local-debs/ to enable the local-repo path.
COPY linux/nvidia-local-debs/ /tmp/tensorrt-staging/
RUN set -euo pipefail; \
    _trt_deb="$(find /tmp/tensorrt-staging -maxdepth 1 -name 'tensorrt-local-repo*.deb' | head -1)"; \
    if [ -n "${_trt_deb}" ]; then mv "${_trt_deb}" /tmp/tensorrt-local-repo.deb; fi; \
    rm -rf /tmp/tensorrt-staging
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    bash /tmp/core-scripts/install-tensorrt.sh

# Repo hygiene, mirroring Dockerfile.amd (which rm's rocm.list after its last
# ROCm apt install).  This is the LAST apt install against NVIDIA repos in this
# file, and no downstream stage (media/android/package/torch) apt-installs CUDA
# packages, so drop the CUDA repo and any TensorRT local-repo sources so
# shipped images do not fetch from — or silently upgrade against — NVIDIA
# repos.  The cuda-keyring PACKAGE and its keyring under /usr/share/keyrings
# intentionally STAY: the keyring only holds NVIDIA's signing key (a few kB),
# removing it would desync the installed cuda-keyring dpkg entry, and keeping
# it lets the repo be re-enabled later with a single sources line whose
# signature verification still works.
RUN set -euo pipefail; \
    rm -f /etc/apt/sources.list.d/cuda*.list /etc/apt/sources.list.d/nv-tensorrt-local*.list; \
    rm -rf /var/nv-tensorrt-local-repo* 2>/dev/null || true; \
    rm -rf /var/lib/apt/lists/*; \
    ldconfig

# ==============================================================================
# 2. Environment variables for CUDA
#    /usr/local/cuda is the canonical symlink created by the cuda-toolkit package.
# ==============================================================================
ENV CUDA_HOME=/usr/local/cuda \
    CUDA_ROOT=/usr/local/cuda \
    CUDNN_HOME=/usr/local/cuda \
    TENSORRT_HOME=/usr/local/tensorrt \
    PATH="${CUDA_HOME}/bin:${PATH}" \
    LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${CUDA_HOME}/lib64/stubs:${TENSORRT_HOME}/lib:${LD_LIBRARY_PATH:-}" \
    PKG_CONFIG_PATH="${CUDA_HOME}/lib64/pkgconfig:${PKG_CONFIG_PATH:-}" \
    LIBRARY_PATH="${CUDA_HOME}/lib64/stubs:${LIBRARY_PATH:-}"

# ==============================================================================
# 3. Verification
# ==============================================================================
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    set -euo pipefail; \
    bash /tmp/core-scripts/verify-cuda-stack.sh
LABEL org.opencontainers.image.title="Kataglyphis Toolchain NVIDIA" \
      org.opencontainers.image.description="NVIDIA GPU library layer: CUDA, cuDNN, TensorRT, NCCL, math libs, NVTX"
