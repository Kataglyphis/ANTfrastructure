# syntax=docker/dockerfile:1.24.0

# ==============================================================================
# Dockerfile.nvidia  —  Optional NVIDIA GPU library layer
#
# Position in the chain:
#   :sdk  →  THIS (:toolchain-nvidia)  →  :media-nvidia  →  :android-nvidia  →  :nvidia
#
# What this installs on top of the standard SDK image:
#   • CUDA Toolkit (nvcc, cudart, NVCC headers)          — CUDA_VERSION
#   • cuDNN (Deep Neural Network library)                 — CUDNN_VERSION
#   • TensorRT (inference optimizer + runtime)            — TENSORRT_VERSION
#   • NCCL (multi-GPU collective comms)                   — from CUDA repo
#   • cuBLAS, cuSPARSE, cuFFT  (CUDA math libraries)     — from CUDA repo
#   • NVTX (Nsight profiler headers)                      — from CUDA repo
#   • CUDA Firmware / driver-independent libs             — from CUDA repo
#
# The STANDARD build chain (Dockerfile.base → Dockerfile.toolchain →
# Dockerfile.sdk → Dockerfile.media → Dockerfile.android → Dockerfile)
# is UNCHANGED.
# This file is ONLY used when building the -nvidia variants.
#
# Usage:
#   docker buildx build \
#     --build-arg BASE_IMAGE=local/kataglyphis:sdk \
#     -t local/kataglyphis:toolchain-nvidia \
#     -f linux/Dockerfile.nvidia .
# ==============================================================================

ARG BASE_IMAGE=local/kataglyphis:sdk
FROM ${BASE_IMAGE}

# ------------------------------------------------------------------------------
# Version ARGs — override at build time as needed
# Single source of truth: linux/scripts/01-core/versions.env. The full semvers
# are SHARED with the Windows build (windows/Dockerfile.nvidia) so both
# platforms pin the exact same NVIDIA releases.
# ------------------------------------------------------------------------------
# CUDA 13.3 requires driver >= 590.44.01 (Linux)
ARG CUDA_VERSION=13.3.1
ARG CUDNN_VERSION=9.25.0.15
ARG TENSORRT_VERSION=11.2.1.2
# Apt package-name forms derived from the shared semvers:
#   13.3.0 → 13.3 (repo paths) → 13-3 (apt package suffix); 9.23.2.1 → 9 (cuDNN major)
ARG CUDA_VERSION_DOT=${CUDA_VERSION%.*}
ARG CUDA_VERSION_MAJOR_MINOR=${CUDA_VERSION_DOT/./-}
ARG CUDNN_MAJOR=${CUDNN_VERSION%%.*}

ARG TARGETARCH
ARG UBUNTU_CODENAME=resolute
# UBUNTU_CODENAME is the official codename (resolute for 26.04). Update in lockstep.
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL


SHELL ["bash", "-lc"]

RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    bash /tmp/core-scripts/setup-cuda-repo.sh

# ==============================================================================
# 1. NVIDIA Components (CUDA Toolkit, cuDNN, NCCL, Math Libraries)
# ==============================================================================
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    bash /tmp/core-scripts/install-cuda-stack.sh
    # NOTE: the CUDA repo (/etc/apt/sources.list.d/cuda*.list) is intentionally
    # NOT removed by install-cuda-stack.sh — the TensorRT RUN below still installs
    # tensorrt-dev / tensorrt-libs from the NVIDIA apt repo.  Repo removal happens
    # at the end of that RUN (the last apt install against NVIDIA repos in this file).

# ==============================================================================
# 2. TensorRT — try local repo deb, then NVIDIA apt repo, then skip
# ==============================================================================
# A bare `COPY tensorrt-local-repo*.deb` FAILS the whole build when no deb is
# present ("no source files were specified") — contradicting the optional
# 3-tier fallback below. COPY the committed drop-directory instead (always
# exists via its README), then normalize inside the RUN: drop your EULA-gated
# deb into linux/nvidia-local-debs/ to enable the local-repo path.
COPY --link linux/nvidia-local-debs/ /tmp/tensorrt-staging/
# GPU7 fix (2026-08-17): the substitution was `$(find … | head -1) || true)"` —
# the ` || true)` sat OUTSIDE the $() and became a LITERAL part of the value, so
# with no staged deb _trt_deb=" || true)" (non-empty) → `mv` failed → set -e
# killed this RUN: the default (no-EULA-deb) nvidia build could not get past
# here.
# The `find … | head -1` that replaced it is gone too (2026-08-23): find emits
# DIRECTORY order, which is not the operator's `ls` order once the drop dir has
# been through a COPY layer — the PKGCFG-MIRROR class, where the same selector
# picks a different file inside the container than it did on the host. With two
# debs staged (a version bump dropped in beside the old one, or amd64 + arm64
# side by side) it moved an arbitrary one into place and printed nothing about
# the choice.
# The replacement SELECTS deterministically rather than refusing to build. The
# drop directory is documented as PLURAL ("Drop NVIDIA local-repo debs here",
# linux/nvidia-local-debs/README.md) and ONE COPY feeds every lane, so a
# hard-fail on 2+ debs would break setups that used to build fine. Rules, in
# order:
#   1. a name ending `_<dpkg arch>.deb` — the Debian arch suffix. dpkg/apt in
#      install-tensorrt.sh can only install THAT arch, and it is the same key
#      setup-cuda-repo.sh derives the CUDA repo URL from
#      (`dpkg --print-architecture`), so the two agree by construction.
#   2. otherwise the first name in LC_ALL=C glob order — bash sorts glob
#      matches, so this is stable byte order: no readdir order, no pipe, no
#      `head` anywhere in the pick. Byte order is NOT version order (11.10
#      sorts before 11.9), so on a version bump this can keep the OLD deb —
#      that is what the 2+-debs WARNING below is for: delete the stale one.
# The chosen FILENAME, the rule that chose it and every candidate it was chosen
# from are ECHOED (PKGCFG-MIRROR verdict: echo the RESULT, never the intent —
# the 1-deb path used to print nothing at all), and 2+ candidates additionally
# warn that the rest are discarded. Failure mode when the pick is wrong: an
# ARCH mismatch is safe (dpkg refuses it, install-tensorrt.sh's `dpkg -i … ||
# true` falls through to the NVIDIA apt-repo tier), but a wrong VERSION of the
# right arch installs cleanly — so staging two same-arch local repos for
# different TensorRT versions can ship the older one. The echoed filename is
# what makes that visible in the log; the drop directory is documented plural,
# so this is a real operator scenario, not a hypothetical. The
# default path (no deb staged at all) falls through untouched — that is the
# 3-tier fallback above, and it must never fail.
# Finally: any staged .deb that does NOT match the pattern is REPORTED instead
# of vanishing (otherwise the "none staged" line above would be an outright
# false claim while a deb sat in the directory). The glob is deliberately left as-is here, but NVIDIA's
# own artifact is `nv-tensorrt-local-repo-…deb`, which this pattern does not
# match (the rest of the lane knows the real name: install-tensorrt.sh hunts
# `nv-tensorrt-local-*-keyring.gpg`, and the hygiene RUN below rm's
# `/var/nv-tensorrt-local-repo*`). Widening the glob changes WHICH bytes get
# installed, so it is a deliberate decision, not a drive-by — until it is
# taken, an `nv-`-prefixed drop at least says so in the log instead of being
# silently skipped.
RUN set -euo pipefail; \
    export LC_ALL=C; \
    shopt -s nullglob; \
    _trt_debs=(/tmp/tensorrt-staging/tensorrt-local-repo*.deb); \
    _trt_staged=(/tmp/tensorrt-staging/*.deb); \
    shopt -u nullglob; \
    _trt_arch="$(dpkg --print-architecture 2>/dev/null || true)"; \
    _trt_pick=""; \
    _trt_rule=""; \
    if [ "${#_trt_debs[@]}" -gt 0 ]; then \
        for _trt_cand in "${_trt_debs[@]}"; do \
            case "${_trt_cand}" in \
              *_"${_trt_arch:-__no_dpkg_arch__}".deb) \
                _trt_pick="${_trt_cand}"; _trt_rule="arch-match ${_trt_arch}"; break ;; \
            esac; \
        done; \
        if [ -z "${_trt_pick}" ]; then \
            _trt_pick="${_trt_debs[0]}"; _trt_rule="first in LC_ALL=C glob order (no name carries _${_trt_arch:-?}.deb)"; \
        fi; \
    fi; \
    if [ -n "${_trt_pick}" ]; then \
        echo "TensorRT local-repo: SELECTED ${_trt_pick##*/} [${_trt_rule}] out of ${#_trt_debs[@]} pattern match(es): ${_trt_debs[*]##*/}"; \
        if [ "${#_trt_debs[@]}" -gt 1 ]; then \
            echo "WARNING: ${#_trt_debs[@]} TensorRT local-repo debs staged in linux/nvidia-local-debs/; installing ${_trt_pick##*/} and DISCARDING the rest — leave only the deb this lane should install." >&2; \
        fi; \
        mv "${_trt_pick}" /tmp/tensorrt-local-repo.deb; \
    else \
        echo "TensorRT local-repo: no linux/nvidia-local-debs/tensorrt-local-repo*.deb staged — falling through to the NVIDIA apt repo tier"; \
    fi; \
    if [ "${#_trt_staged[@]}" -gt "${#_trt_debs[@]}" ]; then \
        echo "WARNING: $(( ${#_trt_staged[@]} - ${#_trt_debs[@]} )) of ${#_trt_staged[@]} deb(s) in linux/nvidia-local-debs/ do NOT match tensorrt-local-repo*.deb and were IGNORED (staged: ${_trt_staged[*]##*/}). NVIDIA ships this artifact as nv-tensorrt-local-repo-<os>-<ver>_1.0-1_<arch>.deb — rename it to match, or widen the glob here." >&2; \
    fi; \
    rm -rf /tmp/tensorrt-staging
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    bash /tmp/core-scripts/install-tensorrt.sh

# Repo hygiene, mirroring Dockerfile.amd (which rm's rocm.list after its last
# ROCm apt install).  This is the LAST apt install against NVIDIA repos in this
# file, and no downstream stage (media/android/package/torch) apt-installs CUDA
# packages, so drop the CUDA repo and any TensorRT local-repo sources so
# shipped images do not fetch from — or silently upgrade against — NVIDIA
# repos.  The cuda-keyring PACKAGE and its keyring under /usr/share/keyrings
# intentionally STAY: the keyring only holds NVIDIA's signing key (a few kB),
# removing it would desync the installed cuda-keyring dpkg entry, and keeping
# it lets the repo be re-enabled later with a single sources line whose
# signature verification still works.
RUN set -euo pipefail; \
    rm -f /etc/apt/sources.list.d/cuda*.list /etc/apt/sources.list.d/nv-tensorrt-local*.list; \
    rm -rf /var/nv-tensorrt-local-repo* 2>/dev/null || true; \
    rm -rf /var/lib/apt/lists/*; \
    ldconfig

# ==============================================================================
# 2. Environment variables for CUDA
#    /usr/local/cuda is the canonical symlink created by the cuda-toolkit package.
# ==============================================================================
ENV CUDA_HOME=/usr/local/cuda \
    CUDA_ROOT=/usr/local/cuda \
    CUDNN_HOME=/usr/local/cuda \
    TENSORRT_HOME=/usr/local/tensorrt \
    PATH="${CUDA_HOME}/bin:${PATH}" \
    LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${CUDA_HOME}/lib64/stubs:${TENSORRT_HOME}/lib:${LD_LIBRARY_PATH:-}" \
    PKG_CONFIG_PATH="${CUDA_HOME}/lib64/pkgconfig:${PKG_CONFIG_PATH:-}" \
    LIBRARY_PATH="${CUDA_HOME}/lib64/stubs:${LIBRARY_PATH:-}"

# ==============================================================================
# 3. Verification
# ==============================================================================
# GPU2/GPU3 (2026-08-17): STRICT verification — previously CUDA_STACK_STRICT
# defaulted to 0, so a build with nvcc/cuDNN/TensorRT ALL missing still went
# green (fail-open; it masked the TensorRT silent-skip, GPU1). Now hard-gated,
# matching the AMD lane's contract (setup-rocm-repo.sh exits 1 on missing bits).
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    set -euo pipefail; \
    CUDA_STACK_STRICT=1 bash /tmp/core-scripts/verify-cuda-stack.sh
LABEL org.opencontainers.image.title="Kataglyphis Toolchain NVIDIA" \
      org.opencontainers.image.description="NVIDIA GPU library layer: CUDA, cuDNN, TensorRT, NCCL, math libs, NVTX"
