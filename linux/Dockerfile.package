# syntax=docker/dockerfile:1.27.0
# ARG defaults are safety nets for manual builds; build-runtime-manifest.sh passes versions.env values.

# Keyed on TARGETARCH so a plain `docker build` uses its own platform's base, not the amd64-only cross tag.
ARG TARGETARCH
ARG BASE_IMAGE=ghcr.io/kataglyphis/kataglyphis_beschleuniger:latest-base-${TARGETARCH}
# Must precede ARTIFACT_IMAGE: ARG expansion only sees earlier ARGs.
ARG TARGET_ARCH
ARG ARTIFACT_IMAGE=ghcr.io/kataglyphis/kataglyphis_beschleuniger:cross-android-${TARGET_ARCH:-amd64}
ARG BUILD_MODE=native
ARG TARGETPLATFORM
ARG ARTIFACT_PLATFORM=${TARGETPLATFORM}
ARG PACKAGE_BASE_STAGE=package-image
ARG ENABLE_NVIDIA=false
ARG ENABLE_AMD=false
ARG GSTREAMER_VERSION=1.29.2
ARG OPENCV_OUTPUT_DIR=/opt/opencv5
ARG ONNXRUNTIME_OUTPUT_DIR=/usr/local/lib/onnxruntime-cpu
ARG ONNXRUNTIME_GENAI_OUTPUT_DIR=/usr/local/lib/onnxruntime-genai
ARG GSTREAMER_PREFIX=/opt/gstreamer
ARG ANDROID_SDK_VERSION=15859902
ARG ANDROID_NDK_VERSION=29.0.14206865
ARG ANDROID_COMPILE_SDK=36
ARG ANDROID_BUILD_TOOLS=36.0.0
ARG ANDROID_CMAKE_VERSION=4.1.2
ARG ANDROID_API_LEVEL=34
ARG GCC_VERSION=16.2.0
ARG LLVM_RELEASE=23.1.1
ARG PYTHON_VERSION=3.14.7
# Derived: versions.env only defines PYTHON_VERSION.
ARG PYTHON_MAJOR_MINOR=${PYTHON_VERSION%.*}
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL
# Dockerfile.torch's `useradd kataglyphis` uid; trees the runtime user writes are chown'd to it at COPY time.
ARG RUNTIME_UID=1001

FROM --platform=${ARTIFACT_PLATFORM} ${ARTIFACT_IMAGE} AS artifact-source

ARG BUILD_MODE
ARG TARGET_ARCH
ARG TARGETARCH
ARG GCC_VERSION
ARG LLVM_RELEASE

RUN --mount=type=bind,source=linux/scripts/06-packaging/validate-compilers.sh,target=/tmp/validate-compilers.sh,ro \
    set -euo pipefail; \
    TARGET_ARCH="${TARGET_ARCH:-${TARGETARCH}}" \
    bash /tmp/validate-compilers.sh artifact-source

# Pruned before the /opt/vulkan COPY: docs/artifact-copy-completeness.md#the-vulkan-tree-ships-only-what-the-image-runs
RUN --mount=type=bind,source=linux/scripts/06-packaging/prune-vulkan-host-sdk.sh,target=/tmp/prune-vulkan-host-sdk.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/platform.sh,target=/tmp/platform.sh,ro \
    set -euo pipefail; \
    bash /tmp/prune-vulkan-host-sdk.sh "${TARGET_ARCH:-${TARGETARCH}}"

# The mkdir keeps an older android image mountable: docs/consumer-image-contract.md#building-the-web-lane-tools-from-source
FROM artifact-source AS web-lane-tools-src
RUN mkdir -p /opt/web-lane-tools


FROM ${BASE_IMAGE} AS package-image

ARG ONNXRUNTIME_OUTPUT_DIR
ARG ONNXRUNTIME_GENAI_OUTPUT_DIR
ARG OPENCV_OUTPUT_DIR
ARG GSTREAMER_PREFIX
ARG GCC_VERSION
ARG RUNTIME_UID
# Both gate copy-media-payloads.sh's GPU copies; without ENABLE_AMD the rocm image ships without ROCm.
ARG ENABLE_NVIDIA
ARG ENABLE_AMD
# Drops /opt/rocm/core-asan-* from the payload unless the image is an ASAN one.
ARG ENABLE_ROCM_ASAN
# Copies /opt/nvidia/deepstream out of the artifact; false leaves it behind.
ARG ENABLE_DEEPSTREAM

SHELL ["bash", "-lc"]

COPY --link --from=artifact-source ${ONNXRUNTIME_OUTPUT_DIR} ${ONNXRUNTIME_OUTPUT_DIR}
COPY --link --from=artifact-source ${OPENCV_OUTPUT_DIR} ${OPENCV_OUTPUT_DIR}
COPY --link --from=artifact-source /opt/ffmpeg /opt/ffmpeg
COPY --link --from=artifact-source ${GSTREAMER_PREFIX} ${GSTREAMER_PREFIX}
COPY --link --from=artifact-source /opt/libcamera /opt/libcamera
# arm64 only; the media stage leaves empty dirs elsewhere, so the COPY is safe on every arch.
COPY --link --from=artifact-source /opt/armnn /opt/armnn
COPY --link --from=artifact-source /opt/acl /opt/acl
# Runtime-user owned: `flutter` writes its own bin/cache. docs/artifact-copy-completeness.md#bootstrapping-flutter-in-the-package-stage
COPY --link --chown=${RUNTIME_UID}:${RUNTIME_UID} --from=artifact-source /opt/flutter /opt/flutter
# /opt/wheels is deliberately not baked here: Dockerfile.torch bind-mounts it into the one RUN that reads it.
COPY --link --from=artifact-source /opt/vulkan /opt/vulkan
COPY --link --from=artifact-source /opt/android-sdk /opt/android-sdk
COPY --link --from=artifact-source /opt/android /opt/android
COPY --link --from=artifact-source /opt/gcc-${GCC_VERSION} /opt/gcc-${GCC_VERSION}

# The pinned Rust toolchain lives outside /opt; --chown here is free. docs/artifact-copy-completeness.md#the-rust-toolchain-must-be-writable-by-the-runtime-user
COPY --link --chown=${RUNTIME_UID}:${RUNTIME_UID} --from=artifact-source /usr/local/rustup /usr/local/rustup
COPY --link --chown=${RUNTIME_UID}:${RUNTIME_UID} --from=artifact-source /usr/local/cargo /usr/local/cargo
# docs/artifact-copy-completeness.md#the-llvm-target-prefix-fills-what-it-needs-and-nothing-else
COPY --link --from=artifact-source /opt/llvm-target /usr/local/llvm-target
# Tolerant per-path copies: variant payloads such as onnxruntime-gpu may be absent.
COPY --chmod=755 linux/scripts/06-packaging/copy-media-payloads.sh /tmp/copy-media-payloads.sh
RUN --mount=type=bind,from=artifact-source,source=/,target=/artifact-src \
    set -euo pipefail; \
    # No soname repair here: that belongs to the sdk stage alone (materialize-llvm-target.sh).
    ENABLE_NVIDIA="${ENABLE_NVIDIA:-false}" ENABLE_AMD="${ENABLE_AMD:-false}" \
      ENABLE_ROCM_ASAN="${ENABLE_ROCM_ASAN:-false}" ENABLE_DEEPSTREAM="${ENABLE_DEEPSTREAM:-false}" \
      SRCPREFIX=/artifact-src bash /tmp/copy-media-payloads.sh; \
    rm -f /tmp/copy-media-payloads.sh

FROM ${PACKAGE_BASE_STAGE} AS package

# A login shell (bash -lc) misbehaves under QEMU.
SHELL ["bash", "-c"]

ARG BUILD_MODE TARGET_ARCH TARGETARCH TARGETPLATFORM RUNTIME_UID
# ARGs, not only ENV: the ENV below that uses them would read them as empty. docs/code-quality-tooling.md#env-instruction-ordering-dockerfile-lint
ARG FFMPEG_PREFIX=/opt/ffmpeg
ARG LIBCAMERA_PREFIX=/opt/libcamera
ARG GSTREAMER_VERSION OPENCV_OUTPUT_DIR ONNXRUNTIME_OUTPUT_DIR ONNXRUNTIME_GENAI_OUTPUT_DIR GSTREAMER_PREFIX
ARG ANDROID_SDK_VERSION ANDROID_NDK_VERSION ANDROID_COMPILE_SDK ANDROID_BUILD_TOOLS ANDROID_CMAKE_VERSION ANDROID_API_LEVEL
ARG ENABLE_NVIDIA ENABLE_AMD ENABLE_DEEPSTREAM
ARG GCC_VERSION LLVM_RELEASE PYTHON_VERSION PYTHON_MAJOR_MINOR
ARG JDK_PACKAGE=openjdk-21-jdk-headless
ARG WASM_PACK_VERSION=0.15.0
ARG FLUTTER_RUST_BRIDGE_VERSION=2.13.0
ARG USE_FAST_UBUNTU_MIRROR FAST_UBUNTU_MIRROR_URL FAST_UBUNTU_PORTS_MIRROR_URL

# Re-declared: the rootfs-export handoff drops base's image config, and with it every base ENV.
ENV NVIDIA_DRIVER_CAPABILITIES=all \
    NVIDIA_VISIBLE_DEVICES=all
# "yes" with DeepStream, else empty: its legacy nvstreammux fails on GStreamer >= 1.28. docs/linux-accelerator-images.md#nvstreammux-the-new-one-only
ARG DS_NEW_MUX=${ENABLE_DEEPSTREAM/false/}
ENV USE_NEW_NVSTREAMMUX=${DS_NEW_MUX/true/yes}
ARG VULKAN_VERSION=1.4.357.0
ENV VULKAN_VERSION=${VULKAN_VERSION}
# Mesa 26.0's lavapipe BVH sort needs 8-lane subgroups; 128-bit NEON/RVV gives 4 and SEGVs. docs/failure-modes.md#lavapipe-segfaults-building-an-acceleration-structure-on-arm64
ENV LP_NATIVE_VECTOR_WIDTH=256
# The smoke compares these with the binaries: docs/consumer-image-contract.md#the-web-lane-toolchain
ENV WASM_PACK_VERSION=${WASM_PACK_VERSION}
ENV FLUTTER_RUST_BRIDGE_VERSION=${FLUTTER_RUST_BRIDGE_VERSION}
# Advertised as ENV (ARG never reaches the image config) for consumers and the advertised-vs-actual smoke.
ARG UBUNTU_VERSION=26.04
ARG CMAKE_VERSION=4.4.3
ARG NODE_VERSION=26.9.0
ARG UV_VERSION=0.12.17
ARG OPENCV_VERSION=5.0.0
ARG ONNXRUNTIME_VERSION=v1.30.0
ARG ONNXRUNTIME_GENAI_VERSION=v0.15.2
ARG PYAV_VERSION=18.1.0
ARG IREE_VERSION=v3.11.0
ARG LITERT_VERSION=v2.2.0
ARG RUST_VERSION=1.98.1
ENV UBUNTU_VERSION=${UBUNTU_VERSION} \
    CMAKE_VERSION=${CMAKE_VERSION} \
    NODE_VERSION=${NODE_VERSION} \
    UV_VERSION=${UV_VERSION} \
    OPENCV_VERSION=${OPENCV_VERSION} \
    ONNXRUNTIME_VERSION=${ONNXRUNTIME_VERSION} \
    ONNXRUNTIME_GENAI_VERSION=${ONNXRUNTIME_GENAI_VERSION} \
    PYAV_VERSION=${PYAV_VERSION} \
    IREE_VERSION=${IREE_VERSION} \
    LITERT_VERSION=${LITERT_VERSION} \
    RUST_VERSION=${RUST_VERSION}
ENV BUILD_MODE=${BUILD_MODE} \
    TARGET_ARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETPLATFORM=${TARGETPLATFORM} \
    ENABLE_NVIDIA=${ENABLE_NVIDIA} \
    ENABLE_AMD=${ENABLE_AMD} \
    GCC_VERSION=${GCC_VERSION} \
    LLVM_RELEASE=${LLVM_RELEASE} \
    GCC_PREFIX=/opt/gcc-${GCC_VERSION} \
    # No PYTHON_VERSION: the image ships the distro python3.14, not /opt/python-cross.
    PYTHON_MAJOR_MINOR=${PYTHON_MAJOR_MINOR} \
    PYTHON_CROSS_STAGE_ROOT=/opt/python-cross \
    PYTHON_CROSS_ACTIVE_ROOT=/opt/python-target \
    ORT_PYTHON_VERSION=${PYTHON_MAJOR_MINOR} \
    OPENCV_PYTHON_VERSION=${PYTHON_MAJOR_MINOR} \
    VIRTUAL_ENV=/opt/python/.venv \
    UV_PYTHON=/opt/python/.venv/bin/python \
    # Cache mount and targets are different overlayfs views, so hardlinks always fell back to copy.
    UV_LINK_MODE=copy \
    MEDIA_HOST_PYTHON=/opt/python/.venv/bin/python \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    RUSTC_WRAPPER="" \
    GSTREAMER_VERSION=${GSTREAMER_VERSION} \
    GSTREAMER_PREFIX=${GSTREAMER_PREFIX} \
    OPENCV_PREFIX=${OPENCV_OUTPUT_DIR} \
    FFMPEG_PREFIX=/opt/ffmpeg \
    LIBCAMERA_PREFIX=/opt/libcamera \
    VULKAN_SDK=/opt/vulkan/active \
    VK_LAYER_PATH=/opt/vulkan/active/share/vulkan/explicit_layer.d \
    # Re-declared after the rootfs export; never under /workspace. docs/build-cache-tiers.md#the-shipped-images-cache-dirs
    CCACHE_DIR=/var/cache/ccache \
    SCCACHE_DIR=/var/cache/sccache \
    CCACHE_MAXSIZE=30G \
    SCCACHE_CACHE_SIZE=30G \
    SCCACHE_IDLE_TIMEOUT=0 \
    SCCACHE_ERROR_LOG=/tmp/sccache.log \
    # No /root/.local/bin: the image runs as uid 1001, so it was dead and a PATH-hijack precondition.
    PATH="/opt/vulkan/active/bin:${GSTREAMER_PREFIX}/bin:${OPENCV_OUTPUT_DIR}/bin:${LIBCAMERA_PREFIX}/bin:${FFMPEG_PREFIX}/bin:/opt/flutter/bin:/usr/local/bin:/opt/python/.venv/bin:/opt/gcc-${GCC_VERSION}/bin:/usr/local/cargo/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    # nvcc rejects the image's GCC by version; same flag as Dockerfile.media.
    NVCC_PREPEND_FLAGS=-allow-unsupported-compiler \
    PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${GSTREAMER_PREFIX}/lib/multiarch/pkgconfig:${OPENCV_OUTPUT_DIR}/lib/pkgconfig:${LIBCAMERA_PREFIX}/lib/pkgconfig:${LIBCAMERA_PREFIX}/lib64/pkgconfig:${FFMPEG_PREFIX}/lib/pkgconfig" \
    LD_LIBRARY_PATH="/opt/vulkan/active/lib:/usr/local/lib:${GSTREAMER_PREFIX}/lib/multiarch:${GSTREAMER_PREFIX}/lib:${OPENCV_OUTPUT_DIR}/lib:${OPENCV_OUTPUT_DIR}/lib64:${LIBCAMERA_PREFIX}/lib:${LIBCAMERA_PREFIX}/lib64:${FFMPEG_PREFIX}/lib:${FFMPEG_PREFIX}/lib64:/opt/gcc-${GCC_VERSION}/lib64:/opt/gcc-${GCC_VERSION}/lib" \
    LIBRARY_PATH="/opt/gcc-${GCC_VERSION}/lib64:/opt/gcc-${GCC_VERSION}/lib" \
    GDK_BACKEND=x11 \
    GST_PLUGIN_PATH="${GSTREAMER_PREFIX}/lib/multiarch/gstreamer-1.0:${LIBCAMERA_PREFIX}/lib/gstreamer-1.0" \
    GI_TYPELIB_PATH="${GSTREAMER_PREFIX}/lib/multiarch/girepository-1.0"

# The ort crate uses the chain ORT, never pyke's download: docs/consumer-image-contract.md#the-ort-crate-links-the-chain-onnx-runtime
ENV ORT_LIB_LOCATION=${ONNXRUNTIME_OUTPUT_DIR}/lib
ENV ORT_PREFER_DYNAMIC_LINK=1
ENV ORT_SKIP_DOWNLOAD=1
ENV ORT_DYLIB_PATH=${ONNXRUNTIME_OUTPUT_DIR}/lib/libonnxruntime.so

# Unadvertised, flutter reports no Android SDK: docs/linux-cross-builds.md#android-sdk-environment-in-the-runtime-image
ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk

# Never a bare OpenCV_DIR, which would hijack Linux find_package(OpenCV): docs/consumer-image-contract.md#the-android-sdk-roots-are-advertised
ENV GSTREAMER_ROOT_ANDROID=/opt/android/gstreamer
ENV ONNXRUNTIME_ROOT_ANDROID=/opt/android/onnxruntime
ENV LITERT_ROOT_ANDROID=/opt/android/litert
ENV OPENCV_ROOT_ANDROID=/opt/android/opencv
ENV IREE_ROOT_ANDROID=/opt/android/iree
ENV OPENCV_ANDROID_JNI_DIR=/opt/android/opencv/sdk/native/jni
ARG ANDROID_TARGET_ABI=arm64-v8a
ENV ANDROID_TARGET_ABI=${ANDROID_TARGET_ABI}

# A symlink setup-package-image.sh resolves from javac, so a JDK bump needs no edit here. docs/consumer-image-contract.md#the-android-lane-needs-a-jdk
ENV JAVA_HOME=/usr/lib/jvm/default-java

# Appended: platform-tools' own mke2fs would otherwise shadow /usr/sbin/mke2fs.
ENV PATH="${PATH}:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools"

# A login shell rebuilds PATH from /etc/profile; `:=` keeps a caller's CARGO_HOME, the case guard stays idempotent.
RUN printf '%s\n' \
      ': "${RUSTUP_HOME:=/usr/local/rustup}"; export RUSTUP_HOME' \
      ': "${CARGO_HOME:=/usr/local/cargo}"; export CARGO_HOME' \
      'case ":${PATH}:" in' \
      '  *":/usr/local/cargo/bin:"*) ;;' \
      '  *) export PATH="/usr/local/cargo/bin:${PATH}" ;;' \
      'esac' \
      > /etc/profile.d/10-rust.sh \
 && chmod 0644 /etc/profile.d/10-rust.sh \
 && sh -n /etc/profile.d/10-rust.sh

COPY linux/scripts/01-core/ /opt/scripts/core/
COPY linux/scripts/02-toolchain/ /opt/scripts/toolchain/
COPY --chmod=755 linux/scripts/02-toolchain/android-sdk.sh /opt/scripts/android-sdk.sh
COPY --chmod=755 linux/scripts/03-media/runtime/ /opt/scripts/03-media/final/
# The final install-deps.sh sources media_load_arch_flags from here.
COPY --chmod=755 linux/scripts/03-media/core/ /opt/scripts/03-media/core/
COPY --chmod=755 linux/scripts/03-media/build/gstreamer/android/ /opt/scripts/03-media/gstreamer/android/
COPY --chmod=755 linux/scripts/03-media/build/litert/android/ /opt/scripts/03-media/litert/android/
COPY --chmod=755 linux/scripts/03-media/build/onnxruntime/android/ /opt/scripts/03-media/onnxruntime/android/
COPY --chmod=755 linux/scripts/03-media/build/opencv/android/ /opt/scripts/03-media/opencv/android/
COPY --chmod=755 linux/scripts/05-frameworks/tvm.sh /opt/scripts/frameworks/tvm.sh
COPY --chmod=755 linux/scripts/05-frameworks/deepstream-verify.sh /opt/scripts/frameworks/deepstream-verify.sh
COPY --chmod=755 linux/scripts/02-toolchain/python/build_python.sh /opt/scripts/python/build_python.sh
COPY --chmod=755 linux/scripts/02-toolchain/python/fix-staged-python-pc.sh /opt/scripts/python/fix-staged-python-pc.sh
COPY --chmod=755 linux/scripts/06-packaging/setup-package-image.sh /opt/scripts/packaging/setup-package-image.sh
COPY --chmod=755 linux/scripts/06-packaging/package-image-wiring.sh /opt/scripts/packaging/package-image-wiring.sh
COPY --chmod=755 linux/scripts/06-packaging/validate-compilers.sh /opt/scripts/packaging/validate-compilers.sh
COPY --chmod=755 linux/scripts/06-packaging/setup-vulkan-symlinks.sh /opt/scripts/packaging/setup-vulkan-symlinks.sh
COPY --chmod=755 linux/scripts/06-packaging/smoke-common.sh /opt/scripts/packaging/smoke-common.sh
COPY --chmod=755 linux/scripts/06-packaging/smoke-media.sh /opt/scripts/packaging/smoke-media.sh
COPY --chmod=755 linux/scripts/06-packaging/smoke-cross-all-arches.sh /opt/scripts/packaging/smoke-cross-all-arches.sh
COPY --chmod=755 linux/scripts/06-packaging/smoke-torch-venv.sh /opt/scripts/packaging/smoke-torch-venv.sh

# The Vulkan SDK installs under x86_64/, so the other arches get symlinks.
RUN set -euo pipefail; \
    if [ ! -e /usr/local/llvm-target ] && [ -d /opt/llvm-target ]; then \
        ln -s /opt/llvm-target /usr/local/llvm-target; \
    fi; \
    if [ -d /usr/local/llvm-target/lib/clang ] && [ ! -e /usr/lib/clang ]; then \
        ln -s /usr/local/llvm-target/lib/clang /usr/lib/clang; \
    fi; \
    bash /opt/scripts/packaging/setup-vulkan-symlinks.sh "${TARGETARCH:-${TARGET_ARCH:-amd64}}" || true

# A cached LLVM may lack libFuzzer; borrow TheRock's same-ABI copy under both names, the driver wants the unsuffixed one.
RUN set -euo pipefail; \
    _resdir="$(/usr/local/llvm-target/bin/clang -print-resource-dir 2>/dev/null)"; \
    _libdir="${_resdir}/lib/x86_64-unknown-linux-gnu"; \
    if [ -n "${_resdir}" ] && [ ! -f "${_libdir}/libclang_rt.fuzzer-x86_64.a" ]; then \
        for _cand in /opt/rocm/core-*/lib/llvm/lib/clang/23/lib/linux; do \
            [ -f "${_cand}/libclang_rt.fuzzer-x86_64.a" ] || continue; \
            mkdir -p "${_libdir}"; \
            cp -a "${_cand}"/libclang_rt.fuzzer*-x86_64.a "${_libdir}/"; \
            cp -a "${_cand}"/libclang_rt.fuzzer-x86_64.a "${_libdir}/libclang_rt.fuzzer.a"; \
            cp -a "${_cand}"/libclang_rt.fuzzer_interceptors-x86_64.a "${_libdir}/libclang_rt.fuzzer_interceptors.a"; \
            echo "[INFO] staged libclang_rt.fuzzer{,_interceptors,_no_main}{,-x86_64}.a from ${_cand}"; \
            break; \
        done; \
        [ -f "${_libdir}/libclang_rt.fuzzer-x86_64.a" ] || \
            echo "[WARN] no libclang_rt.fuzzer-x86_64.a staged (no TheRock LLVM under /opt/rocm)"; \
    fi

# The inherited sources still name ports.ubuntu.com; platform.sh must sit beside ubuntu-mirror.sh or this RUN is a silent no-op.
RUN --mount=type=bind,source=linux/scripts/01-core/use-fast-ubuntu-mirror.sh,target=/tmp/core/use-fast-ubuntu-mirror.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/ubuntu-mirror.sh,target=/tmp/core/ubuntu-mirror.sh,ro \
    --mount=type=bind,source=linux/scripts/01-core/platform.sh,target=/tmp/core/platform.sh,ro \
    set -euo pipefail; \
    bash /tmp/core/use-fast-ubuntu-mirror.sh
# auto|cross|native|legacy and on|refresh|off: docs/consumer-image-contract.md#building-the-web-lane-tools-from-source
ARG WEB_LANE_TOOLS_SOURCE=auto
ARG WEB_LANE_TOOLS_CACHE=on
RUN --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-${TARGETARCH} \
    --mount=type=bind,source=linux/scripts/06-packaging/web-lane-tools.sh,target=/tmp/wlt/web-lane-tools.sh,ro \
    --mount=type=bind,from=web-lane-tools-src,source=/opt/web-lane-tools,target=/tmp/wlt/artifact,ro \
    --mount=type=cache,target=/root/.cache/web-lane-tools,id=web-lane-tools-bin-${TARGETARCH},sharing=locked \
    set -euo pipefail; \
    bash /opt/scripts/packaging/setup-package-image.sh
# No apt lists cleanup above: /var/lib/apt is a shared cache mount, never committed.

# Cross builds cannot execute the target cc, so only the execution probes are skipped.
RUN set -euo pipefail; \
    _ta="${TARGET_ARCH:-${TARGETARCH}}"; \
    if [ "${BUILD_MODE}" = "cross" ] && [ -n "${_ta}" ] && [ "${_ta}" != "amd64" ]; then \
        TARGET_ARCH="${_ta}" VALIDATE_CC_STATIC_ONLY=1 \
        bash /opt/scripts/packaging/validate-compilers.sh package; \
    else \
        TARGET_ARCH="${_ta}" \
        bash /opt/scripts/packaging/validate-compilers.sh package; \
    fi

# DeepStream's runtime wiring and gates, or proof that the image carries none: docs/linux-accelerator-images.md#deepstream-nvidia-variant
RUN --mount=type=bind,source=linux/scripts/05-frameworks,target=/opt/scripts/05-frameworks,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    if [ "${ENABLE_DEEPSTREAM:-false}" = "true" ]; then \
        DS_CORE_DIR=/opt/scripts/core bash /opt/scripts/05-frameworks/deepstream.sh stage-runtime; \
    else \
        bash /opt/scripts/05-frameworks/deepstream.sh assert-absent; \
    fi

LABEL org.opencontainers.image.title="Kataglyphis Package" \
      org.opencontainers.image.description="Runtime package image with assembled cross-compiled artifacts"

# Smoke-only target; the real runtime wrapper is Dockerfile.torch's final stage.
FROM package AS wrapper-smoke

ARG TARGET_ARCH
ARG TARGETARCH
ARG GCC_VERSION
ARG LLVM_RELEASE
ARG PYTHON_VERSION
ARG PYTHON_MAJOR_MINOR

RUN set -euo pipefail; \
    GCC_VERSION="${GCC_VERSION}" \
    LLVM_RELEASE="${LLVM_RELEASE}" \
    TARGET_ARCH="${TARGET_ARCH:-${TARGETARCH:-$(dpkg --print-architecture 2>/dev/null || uname -m)}}" \
    bash /opt/scripts/packaging/validate-compilers.sh smoke && \
    bash /opt/scripts/packaging/smoke-media.sh && \
    # No torch venv here, so this skips; STV_REQUIRE_VENV=1 belongs in the wrapper-image smoke.
    bash /opt/scripts/packaging/smoke-torch-venv.sh && \
    GCC_VERSION="${GCC_VERSION}" \
    bash /opt/scripts/packaging/smoke-cross-all-arches.sh "${TARGET_ARCH}"
# smoke-vulkan is not wired in: it probes the full SDK, and this image ships only the Vulkan runtime.
