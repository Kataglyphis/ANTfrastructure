# syntax=docker/dockerfile:1.27.0
# Digest-pinned like linux/Dockerfile.base: this image builds standalone (via
# linux/docker-compose.yml, no orchestrator forwarding), so the ARG defaults are
# load-bearing and are kept synced to versions.env by sync_versions.py.
ARG UBUNTU_VERSION=26.04
ARG UBUNTU_DIGEST=sha256:9559ceb7c21e528e233e8dff26a0fb2682f4094cce06176eeb075d87a22b31de
FROM ubuntu:${UBUNTU_VERSION}@${UBUNTU_DIGEST}
ENV DEBIAN_FRONTEND=noninteractive

# Install nginx and openssl (minimal) utilizing BuildKit cache mounts
# We use an architecture-specific ID to prevent cache corruption between amd64/arm64/riscv64
ARG TARGETARCH
RUN --mount=type=cache,id=apt-cache-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lib-${TARGETARCH},target=/var/lib/apt,sharing=locked \
    apt-get update \
 && apt-get install -y --no-install-recommends nginx ca-certificates openssl curl

# Create nginx user/group and ensure directories exist
RUN groupadd -r nginx || true \
 && useradd -r -g nginx -s /sbin/nologin -d /var/cache/nginx nginx || true \
 && mkdir -p /var/www/html /var/cache/nginx /run /etc/nginx/ssl \
 && chown -R nginx:nginx /var/www/html /var/cache/nginx \
 && ln -sf /dev/stdout /var/log/nginx/access.log \
 && ln -sf /dev/stderr /var/log/nginx/error.log

# Put your full config into the real global path
COPY ./webserver/nginx.conf /etc/nginx/nginx.conf
# Shared security-header snippet, re-included by every add_header location
# (nginx add_header inheritance is all-or-nothing).
COPY ./webserver/security-headers.conf /etc/nginx/security-headers.conf

# Copy entrypoint script to generate self-signed cert if none exists
COPY --chmod=755 ./webserver/entrypoint.sh /docker-entrypoint.sh

# Copy website files, then overlay the GENERATED license list on top.
#
# The overlay target is `/var/www/html/assets/assets/`, with the doubled
# segment, and that is not a typo. Flutter web serves declared assets under its
# own `assets/` root, so an asset declared as `assets/documents/footer/x.md`
# is fetched from `/assets/assets/documents/footer/x.md` — which is exactly the
# layout `dist/` already carries.
#
# Until 2026-08-25 this line targeted `/var/www/html/assets/`, one level too
# shallow. The generated file landed at a URL the app never requests, so the
# image served the copy baked into `dist/` — last regenerated 2026-07-22 and
# missing ~25 components (Arm NN, BuildKit, CPython, Emscripten, Ghostscript,
# ImageMagick, LiteRT-LM, Meson, Ninja, Ollama, Pandoc, Pygments, Scoop, …).
# `generate-website-licenses.py` writes only `license-assets/`, so nothing
# refreshed the served copy and nothing noticed: both files existed, both were
# valid Markdown, and only the URL told them apart.
# FROM A NAMED BUILD CONTEXT, not from the tracked tree: the site is built in
# jotrockenmitlocken and nothing here can rebuild it, so carrying 82 MB of its
# output in this repository bought a standalone build at the cost of every
# clone. Pass it at build time:
#   nerdctl build --build-context site=<jot>/build/web -f linux/webserver/Dockerfile linux
# A build with no `site` context fails HERE, by name, instead of producing an
# image that serves nothing.
# DL3022 wants --from to name a previous FROM alias. `site` is a named BUILD
# CONTEXT (--build-context site=...), which hadolint does not model; the rule is
# right about stage aliases and blind to contexts.
# hadolint ignore=DL3022
COPY --from=site --chown=nginx:nginx --chmod=755 / /var/www/html/
COPY --chown=nginx:nginx --chmod=755 ./webserver/license-assets/ /var/www/html/assets/assets/

EXPOSE 80 443

# -k: the cert is self-signed (generated by the entrypoint), curl must skip
# verification. curl is installed above for exactly this check.
HEALTHCHECK --interval=30s --timeout=10s \
    CMD curl -fsk https://localhost:443/health || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
