# syntax=docker/dockerfile:1.19

# ------------------------------------------------------------------------------
# OS + stable dependencies (rarely changes)
# This image intentionally avoids COPY of scripts to keep apt layers cacheable.
# ------------------------------------------------------------------------------
FROM ubuntu:24.04

ARG TARGETARCH
ARG TARGETPLATFORM
ARG VULKAN_VERSION=1.4.341.1
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=http://de.archive.ubuntu.com/ubuntu/

# ------------------------------------------------------------------------------
# Shell
# ------------------------------------------------------------------------------
SHELL ["bash", "-lc"]

RUN --mount=type=bind,source=linux/scripts/01-core/use-fast-ubuntu-mirror.sh,target=/tmp/use-fast-ubuntu-mirror.sh,ro \
    USE_FAST_UBUNTU_MIRROR="${USE_FAST_UBUNTU_MIRROR}" \
    FAST_UBUNTU_MIRROR_URL="${FAST_UBUNTU_MIRROR_URL}" \
    bash /tmp/use-fast-ubuntu-mirror.sh

# ------------------------------------------------------------------------------
# GPU-ENV
# ------------------------------------------------------------------------------
ENV NVIDIA_DRIVER_CAPABILITIES=all \
    NVIDIA_VISIBLE_DEVICES=all \
    VULKAN_VERSION=${VULKAN_VERSION}

# ------------------------------------------------------------------------------
# Base ENV
# ------------------------------------------------------------------------------
ENV DEBIAN_FRONTEND=noninteractive \
    APT_LISTCHANGES_FRONTEND=none \
    WORKDIR=/workspace \
    PATH=/root/.local/bin:$PATH \
    CCACHE_DIR=/var/cache/ccache \
    CCACHE_MAXSIZE=30G \
    SCCACHE_DIR=/var/cache/sccache

# ==============================================================================
# OS dependencies
# ==============================================================================

# ------------------------------------------------------------------------------
# Base packages + graphics + flutter deps + perf tools (combined for fewer layers)
# BuildKit cache mounts handle apt caching efficiently.
# ------------------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,id=apt-lib-${TARGETARCH} \
    set -eux; \
    ARCH="$(dpkg --print-architecture)"; \
    apt-get update -qq; \
    apt-get install -y --no-install-recommends \
        nano tmux vim \
        sudo curl ca-certificates gnupg wget xz-utils libssl-dev git \
        build-essential ninja-build make sccache ccache \
        libc++-18-dev libc++abi-18-dev \
        $([ "$ARCH" != "riscv64" ] && echo "clang clang-format clang-tidy lld llvm llvm-dev libclang-dev libclang-rt-dev lldb") \
        pkg-config lsb-release software-properties-common \
        meson python3 python3-venv python3-dev python3-pip \
        patchelf unzip zip \
        doxygen iwyu graphviz gcovr \
        libxrandr-dev libxinerama-dev libxcursor-dev libxi-dev \
        libglu1-mesa-dev freeglut3-dev mesa-common-dev mesa-utils \
        wayland-protocols libwayland-dev libxkbcommon-dev \
        libglx-mesa0 libosmesa6-dev \
        libgtk-3-dev libglib2.0-dev libgdk-pixbuf2.0-dev libatk1.0-dev \
        libpango1.0-dev libx11-dev libx11-xcb-dev \
        libasound2-dev libpulse-dev libdbus-1-dev \
        file dpkg-dev fakeroot binutils \
        $([ "$ARCH" != "riscv64" ] && echo "valgrind") \
        linux-tools-common;


# ------------------------------------------------------------------------------
# Install Node.js (different for RISC-V vs. other architectures)
# ------------------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/tmp/nodesource,id=nodesource-${TARGETARCH} \
    set -eux; \
    ARCH=$(dpkg --print-architecture); \
    apt-get update -qq; \
    if [ "$ARCH" = "riscv64" ]; then \
        echo "RISC-V detected: Installing Node.js from default apt repo"; \
        apt-get install -y --no-install-recommends nodejs npm; \
    else \
        echo "Non-RISC-V architecture: Installing Node.js from NodeSource"; \
        if [ ! -f /tmp/nodesource/.setup_done ]; then \
            curl -sL https://deb.nodesource.com/setup_24.x | bash -; \
            touch /tmp/nodesource/.setup_done; \
        fi; \
        apt-get update -qq && apt-get install -y --no-install-recommends nodejs; \
    fi;


# ------------------------------------------------------------------------------
# Vulkan ICD/Layer-JSONs
# ------------------------------------------------------------------------------
COPY linux/vulkan/ /tmp/vulkan/

RUN set -eux; \
    mkdir -p /etc/vulkan/icd.d /usr/share/glvnd/egl_vendor.d /etc/vulkan/implicit_layer.d; \
    cp /tmp/vulkan/10_nvidia.json /usr/share/glvnd/egl_vendor.d/10_nvidia.json; \
    sed "s|@@VULKAN_VERSION@@|${VULKAN_VERSION}|g" /tmp/vulkan/nvidia_icd.json.in > /etc/vulkan/icd.d/nvidia_icd.json; \
    sed "s|@@VULKAN_VERSION@@|${VULKAN_VERSION}|g" /tmp/vulkan/nvidia_layers.json.in > /etc/vulkan/implicit_layer.d/nvidia_layers.json; \
    rm -rf /tmp/vulkan

# ------------------------------------------------------------------------------
# uv install
# ------------------------------------------------------------------------------
RUN --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    set -eux; \
    curl -LsSf https://astral.sh/uv/install.sh | sh

# ------------------------------------------------------------------------------
# Compiler caches init
# ------------------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    set -eux; \
    ccache -M "${CCACHE_MAXSIZE}" || true
