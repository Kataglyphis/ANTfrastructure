# syntax=docker/dockerfile:1.24.0

# ------------------------------------------------------------------------------
# OS + stable dependencies (rarely changes)
# This image avoids persisting helper scripts into the image so apt layers remain
# stable while shared setup logic can still run through BuildKit bind mounts.
# ------------------------------------------------------------------------------
# Digest-pin the ONLY floating external base in the whole chain (every
# downstream stage is already content-addressed via registry_pin_ref). This is
# the multi-arch manifest-LIST digest, so amd64/arm64/riscv64 each still resolve
# their own platform manifest. Refresh UBUNTU_DIGEST in versions.env whenever
# UBUNTU_VERSION is bumped (verify-arg-consistency.sh polices the pair).
ARG UBUNTU_VERSION=26.04
ARG UBUNTU_DIGEST=sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb
FROM ubuntu:${UBUNTU_VERSION}@${UBUNTU_DIGEST}

ARG TARGETARCH
ARG VULKAN_VERSION=1.4.357.0
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL
ARG CMAKE_VERSION=4.4.2
ARG NODE_VERSION=26.5.1
ARG UV_VERSION=0.12.1

# ------------------------------------------------------------------------------
# Shell
# ------------------------------------------------------------------------------
SHELL ["bash", "-lc"]

# Bootstrap CA roots before optionally rewriting apt sources to HTTPS mirrors.
# NOTE: QEMU-emulated runs can fail with SHELL ["bash", "-lc"] because the
# login shell profile may attempt unsupported syscalls.  Use explicit /bin/bash.
# NOTE: base RUNs bind-mount only the script sub-trees base-image.sh uses --
# 01-core (its own dir) plus 02-toolchain (source_module resolves cmake.sh, and
# install-shared-build-tooling packaging-deps.sh, from there). Mounting the whole
# linux/scripts tree would fold every media/android/packaging script's checksum
# into this layer's cache key, so editing any unrelated script would bust the
# entire base rebuild.
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/scripts/01-core,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain,target=/tmp/scripts/02-toolchain,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    /bin/bash /tmp/scripts/01-core/base-image.sh bootstrap-ca

RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    set -euo pipefail; \
    bash /tmp/core-scripts/use-fast-ubuntu-mirror.sh



# ------------------------------------------------------------------------------
# GPU-ENV
# ------------------------------------------------------------------------------
ENV NVIDIA_DRIVER_CAPABILITIES=all \
    NVIDIA_VISIBLE_DEVICES=all \
    VULKAN_VERSION=${VULKAN_VERSION} \
    DEBIAN_FRONTEND=noninteractive \
    APT_LISTCHANGES_FRONTEND=none \
    PATH=/root/.local/bin:$PATH \
    CCACHE_DIR=/var/cache/ccache \
    CCACHE_MAXSIZE=30G \
    SCCACHE_DIR=/var/cache/sccache

# The cache dirs must be writable at RUNTIME for non-root users too — the
# BuildKit cache mounts only make them writable during image builds. Without
# this, any consumer running the image as a non-root user gets a fatal
# "sccache: failed to create directory /var/cache/sccache" on every compile
# (held the BeschleunigerBallett Linux CI lane red 2026-07-28..08-02).
# 1777 = world-writable with sticky bit, same trust model as /tmp.
RUN mkdir -p /var/cache/ccache /var/cache/sccache \
    && chmod 1777 /var/cache/ccache /var/cache/sccache

WORKDIR /workspace

# ==============================================================================
# OS dependencies
# ==============================================================================

# ------------------------------------------------------------------------------
# Base packages + graphics + flutter deps + perf tools (combined for fewer layers)
# BuildKit cache mounts handle apt caching efficiently.
# ------------------------------------------------------------------------------
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/scripts/01-core,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain,target=/tmp/scripts/02-toolchain,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    bash /tmp/scripts/01-core/base-image.sh install-os-packages


# ------------------------------------------------------------------------------
# Shared build tooling (CMake, packaging prerequisites)
# Keep this in the base image so compiler/toolchain builds inherit it directly.
# ------------------------------------------------------------------------------
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/scripts/01-core,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain,target=/tmp/scripts/02-toolchain,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    bash /tmp/scripts/01-core/base-image.sh install-shared-build-tooling \
      --cmake-version "${CMAKE_VERSION}"


# ------------------------------------------------------------------------------
# Install Node.js (official tarballs, apt fallback for RISC-V)
# ------------------------------------------------------------------------------
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/scripts/01-core,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain,target=/tmp/scripts/02-toolchain,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    bash /tmp/scripts/01-core/base-image.sh install-node \
      --version "${NODE_VERSION}"


# ------------------------------------------------------------------------------
# Vulkan ICD/Layer-JSONs
# ------------------------------------------------------------------------------
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/scripts/01-core,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain,target=/tmp/scripts/02-toolchain,ro \
    --mount=type=bind,source=linux/vulkan,target=/tmp/vulkan,ro \
    bash /tmp/scripts/01-core/base-image.sh install-vulkan-runtime-files \
      --version "${VULKAN_VERSION}" \
      /tmp/vulkan

# ------------------------------------------------------------------------------
# uv install + compiler caches init
# ------------------------------------------------------------------------------
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/scripts/01-core,ro \
    --mount=type=bind,source=linux/scripts/02-toolchain,target=/tmp/scripts/02-toolchain,ro \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    set -euo pipefail; \
    bash /tmp/scripts/01-core/base-image.sh install-uv \
      --version "${UV_VERSION}" && \
    bash /tmp/scripts/01-core/base-image.sh init-compiler-caches \
      --max-size "${CCACHE_MAXSIZE}"

LABEL org.opencontainers.image.title="Kataglyphis Base" \
      org.opencontainers.image.description="Base OS image with CMake, Node.js, uv, and compiler caches"
