# syntax=docker/dockerfile:1.19

FROM scratch

ARG WORKDIR=/workspace
ARG BUILD_TYPE=Release
ARG BUILD_DATE=""
ARG VCS_REF=""
ARG BUILD_BY="CI"

# This Dockerfile is the additive, copy-only end stage for the future
# cross-artifact pipeline. It expects a complete target rootfs in ./rootfs.
COPY rootfs/ /
COPY runtime/ /usr/local/bin/

WORKDIR ${WORKDIR}
VOLUME ["${WORKDIR}"]

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]

LABEL org.opencontainers.image.title="kataglyphis_beschleuniger" \
      org.opencontainers.image.description="Kataglyphis runtime image assembled from prebuilt architecture-specific artifacts" \
      org.opencontainers.image.version="${BUILD_TYPE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.authors="Jonas Heinle <jonasheinle@googlemail.com>" \
      org.opencontainers.image.url="https://github.com/Kataglyphis/Kataglyphis-DockerHub" \
      org.opencontainers.image.source="https://github.com/Kataglyphis/Kataglyphis-DockerHub" \
      org.opencontainers.image.licenses="MIT"