# Copy to secrets.yaml (gitignored) and fill in. shell_command values are
# whole-command secrets because !secret only works as a whole YAML node.
rechenkiste_mac: "aa:bb:cc:dd:ee:ff"
cmd_turn_off_rechenkiste: "ssh -i /config/.ssh/id_ed25519 -o UserKnownHostsFile=/config/.ssh/known_hosts user@host 'sudo shutdown -h now'"
