# Copy to secrets.yaml (gitignored) and fill in. shell_command values are
# whole-command secrets because !secret only works as a whole YAML node.
rechenkiste_mac: "aa:bb:cc:dd:ee:ff"
cmd_turn_off_rechenkiste: "ssh -i /config/.ssh/id_ed25519 -o UserKnownHostsFile=/config/.ssh/known_hosts user@host 'sudo shutdown -h now'"
# The cat cams: each webhook id is the end of that cam's notify_url in /etc/omni-accelerant/catcam.toml.
catcam_webhook_id: "a-long-random-id"
catcam_base_url: "http://<this-host>:8080"
catcam_futtertrog_webhook_id: "another-long-random-id"
catcam_futtertrog_base_url: "http://<tabblscatcam>:8080"
catcam_futtertrog_healthz_url: "http://<tabblscatcam>:8080/healthz"
catcam_mintberry_webhook_id: "a-third-long-random-id"
catcam_mintberry_base_url: "http://<mintberrycrunch>:8080"
catcam_mintberry_healthz_url: "http://<mintberrycrunch>:8080/healthz"
