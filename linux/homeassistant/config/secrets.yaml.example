# Copy to secrets.yaml (gitignored) and fill in. shell_command values are
# whole-command secrets because !secret only works as a whole YAML node.
rechenkiste_mac: "aa:bb:cc:dd:ee:ff"
cmd_turn_on_rechenkiste: "wakeonlan aa:bb:cc:dd:ee:ff"
cmd_turn_off_rechenkiste: "ssh user@host 'sudo shutdown -h now'"
cmd_restart_fah: "ssh user@host 'sudo /bin/systemctl restart fah-client.service'"
cmd_start_fah: "ssh user@host 'sudo /bin/systemctl start fah-client.service'"
cmd_stop_fah: "ssh user@host 'sudo /bin/systemctl stop fah-client.service'"
cmd_send_mail: "ssh user@host 'echo \"Check FAH Status; Might be illformed\" | mail -s \"[ERROR on RECHENKISTE] Fah might be in illegal state\" you@example.com'"
