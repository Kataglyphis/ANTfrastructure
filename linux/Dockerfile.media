# syntax=docker/dockerfile:1.19

# ==============================================================================
# Base stage - common setup
# ==============================================================================
ARG BASE_IMAGE=local/kataglyphis:sdk
FROM ${BASE_IMAGE} AS base

ARG TARGETARCH
SHELL ["bash", "-lc"]

RUN if [ "$TARGETARCH" = "riscv64" ]; then \
        echo 'export LIBRARY_PATH=/opt/gcc-15.2.0/lib64:/opt/gcc-15.2.0/lib:$LIBRARY_PATH' >> /etc/profile.d/10-riscv-gcc.sh && \
        echo 'export LD_LIBRARY_PATH=/opt/gcc-15.2.0/lib64:/opt/gcc-15.2.0/lib:$LD_LIBRARY_PATH' >> /etc/profile.d/10-riscv-gcc.sh; \
    fi

# ==============================================================================
# ONNX Runtime stage
# ==============================================================================
FROM base AS onnxruntime

ARG ONNXRUNTIME_VERSION=v1.24.4
ARG ONNXRUNTIME_NATIVE_BUILD_TYPE=Release
ARG ONNXRUNTIME_WASM_BUILD_TYPE=Release
ARG ONNXRUNTIME_GENAI_VERSION=v0.12.1
ARG ONNXRUNTIME_GENAI_BUILD_TYPE=Release
ARG BUILD_GENAI=true
ARG ONNXRUNTIME_OUTPUT_DIR=/usr/local/lib/onnxruntime-cpu
ARG ONNXRUNTIME_GENAI_OUTPUT_DIR=/usr/local/lib/onnxruntime-genai

ENV NATIVE_CPU_OUTPUT_DIR=${ONNXRUNTIME_OUTPUT_DIR}
ENV GENAI_OUTPUT_DIR=${ONNXRUNTIME_GENAI_OUTPUT_DIR}

COPY linux/scripts/03-media/onnxruntime/build /opt/scripts/media/onnxruntime/build
COPY linux/scripts/04-runtime/gstreamer-env.sh /opt/scripts/04-runtime/gstreamer-env.sh
RUN chmod +x /opt/scripts/media/onnxruntime/build/*.sh /opt/scripts/media/onnxruntime/build/lib/*.sh /opt/scripts/04-runtime/gstreamer-env.sh || true

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
        --mount=type=cache,target=/var/lib/apt \
        set -eux; \
        export USER=root; \
    SKIP_DEP_INSTALL=true bash /opt/scripts/media/onnxruntime/build/10-deps.sh \
            --ort-version "${ONNXRUNTIME_VERSION}" \
            --build-type "${ONNXRUNTIME_NATIVE_BUILD_TYPE}" \
            --wasm-config "${ONNXRUNTIME_WASM_BUILD_TYPE}"

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
        --mount=type=cache,target=/var/lib/apt \
        --mount=type=cache,target=/root/.cache/uv \
        --mount=type=cache,target=/root/.cache/pip \
        set -eux; \
        export USER=root; \
        bash /opt/scripts/media/onnxruntime/build/20-fetch.sh \
            --ort-version "${ONNXRUNTIME_VERSION}" \
            --build-type "${ONNXRUNTIME_NATIVE_BUILD_TYPE}" \
            --wasm-config "${ONNXRUNTIME_WASM_BUILD_TYPE}"

RUN --mount=type=cache,target=/var/cache/ccache \
        --mount=type=cache,target=/var/cache/sccache \
        --mount=type=cache,target=/usr/local/cargo/registry \
        --mount=type=cache,target=/usr/local/cargo/git \
        set -eux; \
        export USER=root; \
        bash /opt/scripts/media/onnxruntime/build/30-build-native.sh \
            --ort-version "${ONNXRUNTIME_VERSION}" \
            --build-type "${ONNXRUNTIME_NATIVE_BUILD_TYPE}" \
            --wasm-config "${ONNXRUNTIME_WASM_BUILD_TYPE}"

RUN set -eux; \
        lib_dir="${NATIVE_CPU_OUTPUT_DIR}/lib"; \
        if [ ! -d "${lib_dir}" ]; then \
            echo "ERROR: ONNX Runtime lib directory not found: ${lib_dir}"; \
            exit 1; \
        fi; \
        if [ -z "$(ls -A ${lib_dir}/*.so* 2>/dev/null)" ]; then \
            echo "ERROR: No .so files found in ${lib_dir}"; \
            ls -la "${lib_dir}" || true; \
            exit 1; \
        fi; \
        echo "ONNX Runtime native build verified:"; \
        ls -la "${lib_dir}"

RUN --mount=type=cache,target=/var/cache/ccache \
        --mount=type=cache,target=/var/cache/sccache \
        --mount=type=cache,target=/root/.cache/uv \
        --mount=type=cache,target=/root/.cache/pip \
        set -eux; \
        export USER=root; \
        BUILD_GENAI="${BUILD_GENAI}" \
        bash /opt/scripts/media/onnxruntime/build/60-build-genai.sh \
            --ort-version "${ONNXRUNTIME_VERSION}" \
            --build-type "${ONNXRUNTIME_NATIVE_BUILD_TYPE}" \
            --genai-version "${ONNXRUNTIME_GENAI_VERSION}" \
            --genai-config "${ONNXRUNTIME_GENAI_BUILD_TYPE}"

RUN --mount=type=cache,target=/var/cache/ccache \
        --mount=type=cache,target=/var/cache/sccache \
        set -eux; \
        export USER=root; \
        bash /opt/scripts/media/onnxruntime/build/40-build-wasm.sh \
            --ort-version "${ONNXRUNTIME_VERSION}" \
            --build-type "${ONNXRUNTIME_NATIVE_BUILD_TYPE}" \
            --wasm-config "${ONNXRUNTIME_WASM_BUILD_TYPE}"

RUN set -eux; \
        export USER=root; \
    bash /opt/scripts/media/onnxruntime/build/50-build-js.sh \
            --ort-version "${ONNXRUNTIME_VERSION}" \
            --build-type "${ONNXRUNTIME_NATIVE_BUILD_TYPE}" \
            --wasm-config "${ONNXRUNTIME_WASM_BUILD_TYPE}"

COPY linux/scripts/03-media/onnxruntime/runtime /opt/scripts/media/onnxruntime/runtime
RUN chmod +x /opt/scripts/media/onnxruntime/runtime/*.sh || true

RUN set -eux; \
    export USER=root; \
    bash /opt/scripts/media/onnxruntime/runtime/31-generate-pkgconfig-native.sh \
        --ort-version "${ONNXRUNTIME_VERSION}" \
        --build-type "${ONNXRUNTIME_NATIVE_BUILD_TYPE}" \
        --wasm-config "${ONNXRUNTIME_WASM_BUILD_TYPE}"

# ==============================================================================
# LiteRT stage
# ==============================================================================
FROM base AS litert

ARG LITERT_VERSION=v2.1.3
ARG LITERT_BUILD_TYPE=Release
ARG LITERT_OUTPUT_DIR=/usr/local

COPY linux/scripts/03-media/litert /opt/scripts/media/litert
RUN chmod +x /opt/scripts/media/litert/*.sh || true

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt \
    --mount=type=cache,target=/var/cache/ccache \
    --mount=type=cache,target=/var/cache/sccache \
    set -eux; \
    export USER=root; \
    bash /opt/scripts/media/litert/build-litert.sh "${LITERT_VERSION}"

RUN set -eux; \
    if [ -f "${LITERT_OUTPUT_DIR}/lib/pkgconfig/litert.pc" ]; then \
        echo "LiteRT pkg-config found:"; \
        cat "${LITERT_OUTPUT_DIR}/lib/pkgconfig/litert.pc"; \
    fi; \
    if [ -f "${LITERT_OUTPUT_DIR}/lib/pkgconfig/tensorflow-lite.pc" ]; then \
        echo "TensorFlow Lite (via LiteRT) pkg-config found:"; \
        cat "${LITERT_OUTPUT_DIR}/lib/pkgconfig/tensorflow-lite.pc"; \
    fi; \
    ls -la "${LITERT_OUTPUT_DIR}/lib"/*lite* 2>/dev/null || echo "Warning: LiteRT libraries may not be in expected location"; \
    ldconfig

# ==============================================================================
# OpenCV stage
# ==============================================================================
FROM base AS opencv

ARG OPENCV_VERSION=4.13.0
ARG OPENCV_BUILD_TYPE=Release
ARG OPENCV_WITH_CONTRIB=true
ARG OPENCV_WITH_PYTHON=true
ARG OPENCV_OUTPUT_DIR=/opt/opencv4

ENV OPENCV_PREFIX=${OPENCV_OUTPUT_DIR}
ENV PKG_CONFIG_PATH="${OPENCV_PREFIX}/lib/pkgconfig:${PKG_CONFIG_PATH}"

COPY linux/scripts/03-media/opencv /opt/scripts/media/opencv
RUN chmod +x /opt/scripts/media/opencv/*.sh || true

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt \
    set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        pkg-config \
        wget \
        unzip \
        libtbb-dev \
        libeigen3-dev \
        libgtk-3-dev \
        libavcodec-dev \
        libavformat-dev \
        libswscale-dev \
        libv4l-dev \
        libxvidcore-dev \
        libx264-dev \
        libjpeg-dev \
        libpng-dev \
        libtiff-dev \
        libopenexr-dev \
        libgstreamer1.0-dev \
        libgstreamer-plugins-base1.0-dev \
        libunwind-dev \
        libdc1394-dev \
        python3-dev \
        python3-numpy \
        python3-pip; \
    rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/var/cache/ccache \
    --mount=type=cache,target=/var/cache/sccache \
    set -eux; \
    export USER=root; \
    bash /opt/scripts/media/opencv/build-opencv.sh \
        --opencv-version "${OPENCV_VERSION}" \
        --prefix "${OPENCV_OUTPUT_DIR}" \
        --build-type "${OPENCV_BUILD_TYPE}" \
        --with-contrib "${OPENCV_WITH_CONTRIB}" \
        --with-python "${OPENCV_WITH_PYTHON}" \
        --skip-dep-install

RUN set -eux; \
    pkg-config --exists opencv4 && echo "OpenCV found: $(pkg-config --modversion opencv4)" || { \
        echo "ERROR: OpenCV not found via pkg-config"; \
        echo "PKG_CONFIG_PATH=${PKG_CONFIG_PATH}"; \
        exit 1; \
    }

# ==============================================================================
# FFmpeg stage
# ==============================================================================
FROM base AS ffmpeg

COPY linux/scripts/03-media/ffmpeg/ /opt/scripts/media/ffmpeg/
RUN chmod +x /opt/scripts/media/ffmpeg/*.sh || true

ENV FFMPEG_PREFIX=/opt/ffmpeg

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt \
    set -eux; \
    cd /opt && \
    bash /opt/scripts/media/ffmpeg/build-ffmpeg.sh

# ==============================================================================
# GStreamer stage (depends on onnxruntime + litert)
# ==============================================================================
FROM base AS gstreamer

ARG GSTREAMER_VERSION=1.28.1
ARG BUILD_TYPE=Release
ARG ONNXRUNTIME_OUTPUT_DIR=/usr/local/lib/onnxruntime-cpu
ARG LITERT_OUTPUT_DIR=/usr/local
ARG OPENCV_OUTPUT_DIR=/opt/opencv4
ARG GSTREAMER_PREFIX=/opt/gstreamer

ENV NATIVE_CPU_OUTPUT_DIR=${ONNXRUNTIME_OUTPUT_DIR} \
    GSTREAMER_PREFIX=${GSTREAMER_PREFIX} \
    GSTREAMER_VERSION=${GSTREAMER_VERSION}

COPY --from=onnxruntime ${ONNXRUNTIME_OUTPUT_DIR} ${ONNXRUNTIME_OUTPUT_DIR}
COPY --from=onnxruntime /usr/local/lib/onnxruntime-genai /usr/local/lib/onnxruntime-genai
# Bring LiteRT artifacts (libraries, headers and pkgconfig) into the gstreamer stage
COPY --from=litert ${LITERT_OUTPUT_DIR}/lib ${LITERT_OUTPUT_DIR}/lib
COPY --from=litert ${LITERT_OUTPUT_DIR}/include ${LITERT_OUTPUT_DIR}/include
COPY --from=litert ${LITERT_OUTPUT_DIR}/lib/pkgconfig ${LITERT_OUTPUT_DIR}/lib/pkgconfig
# Make OpenCV available to the gstreamer build (pkg-config + libs)
COPY --from=opencv ${OPENCV_OUTPUT_DIR} ${OPENCV_OUTPUT_DIR}

RUN set -eux; \
    triplet="$(dpkg-architecture -q DEB_HOST_MULTIARCH)"; \
    mkdir -p "/opt/gstreamer/lib/${triplet}"; \
    ln -snf "/opt/gstreamer/lib/${triplet}" "/opt/gstreamer/lib/multiarch" || true

ENV PKG_CONFIG_PATH="${OPENCV_OUTPUT_DIR}/lib/pkgconfig:${LITERT_OUTPUT_DIR}/lib/pkgconfig:${ONNXRUNTIME_OUTPUT_DIR}/runtime/lib/pkgconfig"
ENV LD_LIBRARY_PATH="${OPENCV_OUTPUT_DIR}/lib:${LITERT_OUTPUT_DIR}/lib:${ONNXRUNTIME_OUTPUT_DIR}/lib"
ENV PATH="${GSTREAMER_PREFIX}/bin:${PATH}"

COPY linux/scripts/03-media/gstreamer/common/setup-gstreamer.sh /opt/scripts/media/gstreamer/common/setup-gstreamer.sh
COPY linux/scripts/04-runtime/gstreamer-env.sh /usr/local/bin/gstreamer-env.sh
RUN chmod +x /opt/scripts/media/gstreamer/common/setup-gstreamer.sh /usr/local/bin/gstreamer-env.sh

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt \
    set -eux; \
    export USER=root; \
    cd /opt && \
    # Prefer using system-provided libraries where available to avoid circular
    # subproject includes. Do not force Meson to build wrapped fallbacks here;
    # the setup script can still be overridden via MESON_WRAP_MODE if needed.
    bash /opt/scripts/media/gstreamer/common/setup-gstreamer.sh \
        "$GSTREAMER_VERSION" \
        "$GSTREAMER_PREFIX" \
        "$BUILD_TYPE"

# ==============================================================================
# Final stage - combine all artifacts
# ==============================================================================
FROM base AS final

ARG GSTREAMER_VERSION=1.28.1
ARG OPENCV_OUTPUT_DIR=/opt/opencv4
ARG ONNXRUNTIME_OUTPUT_DIR=/usr/local/lib/onnxruntime-cpu
ARG ONNXRUNTIME_GENAI_OUTPUT_DIR=/usr/local/lib/onnxruntime-genai
ARG LITERT_OUTPUT_DIR=/usr/local
ARG GSTREAMER_PREFIX=/opt/gstreamer

ENV GSTREAMER_VERSION=${GSTREAMER_VERSION} \
    GSTREAMER_PREFIX=${GSTREAMER_PREFIX} \
    GST_PLUGIN_PATH="" \
    GI_TYPELIB_PATH="" \
    OPENCV_PREFIX=${OPENCV_OUTPUT_DIR} \
    FFMPEG_PREFIX=/opt/ffmpeg \
    LIBCAMERA_PREFIX=/opt/libcamera

COPY --from=onnxruntime ${ONNXRUNTIME_OUTPUT_DIR} ${ONNXRUNTIME_OUTPUT_DIR}
COPY --from=onnxruntime ${ONNXRUNTIME_GENAI_OUTPUT_DIR} ${ONNXRUNTIME_GENAI_OUTPUT_DIR}
COPY --from=litert ${LITERT_OUTPUT_DIR}/lib/pkgconfig ${LITERT_OUTPUT_DIR}/lib/pkgconfig
COPY --from=litert ${LITERT_OUTPUT_DIR}/lib/liblite* ${LITERT_OUTPUT_DIR}/lib/
COPY --from=opencv ${OPENCV_OUTPUT_DIR} ${OPENCV_OUTPUT_DIR}
COPY --from=ffmpeg /opt/ffmpeg /opt/ffmpeg
COPY --from=gstreamer ${GSTREAMER_PREFIX} ${GSTREAMER_PREFIX}

RUN set -eux; \
    triplet="$(dpkg-architecture -q DEB_HOST_MULTIARCH)"; \
    mkdir -p "/opt/gstreamer/lib/${triplet}"; \
    ln -snf "/opt/gstreamer/lib/${triplet}" "/opt/gstreamer/lib/multiarch" || true

ENV PATH="${GSTREAMER_PREFIX}/bin:${OPENCV_PREFIX}/bin:${LIBCAMERA_PREFIX}/bin:${FFMPEG_PREFIX}/bin:/usr/local/bin:${PATH}" \
    PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${GSTREAMER_PREFIX}/lib/multiarch/pkgconfig:${OPENCV_PREFIX}/lib/pkgconfig:${LIBCAMERA_PREFIX}/lib/pkgconfig:${LIBCAMERA_PREFIX}/lib64/pkgconfig:${FFMPEG_PREFIX}/lib/pkgconfig" \
    LD_LIBRARY_PATH="/usr/local/lib:${GSTREAMER_PREFIX}/lib/multiarch:${OPENCV_PREFIX}/lib:${LIBCAMERA_PREFIX}/lib:${LIBCAMERA_PREFIX}/lib64:${FFMPEG_PREFIX}/lib" \
    GST_PLUGIN_PATH="${GSTREAMER_PREFIX}/lib/multiarch/gstreamer-1.0:${LIBCAMERA_PREFIX}/lib/gstreamer-1.0" \
    GI_TYPELIB_PATH="${GSTREAMER_PREFIX}/lib/multiarch/girepository-1.0"

RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get purge -y 'gstreamer*' 'gstreamer1.0*' 'libgstreamer*' || true; \
    apt-get autoremove --purge -y; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    ldconfig

RUN set -eux; \
    triplet="$(dpkg-architecture -q DEB_HOST_MULTIARCH)"; \
    SYS_PKGCONF_DIR="/usr/lib/${triplet}/pkgconfig"; \
    GST_PKGCONF_DIR="/opt/gstreamer/lib/${triplet}/pkgconfig"; \
    mkdir -p "${SYS_PKGCONF_DIR}"; \
    if [ -d "${GST_PKGCONF_DIR}" ]; then \
      for pc in "${GST_PKGCONF_DIR}"/*.pc; do \
        ln -snf "$pc" "${SYS_PKGCONF_DIR}/$(basename "$pc")"; \
      done; \
    fi; \
    printf "%s\n" "/opt/gstreamer/lib/${triplet}" > /etc/ld.so.conf.d/gstreamer.conf; \
    ldconfig

COPY linux/scripts/03-media/libcamera/ /opt/scripts/media/libcamera/
COPY linux/scripts/04-runtime/gstreamer-env.sh /usr/local/bin/gstreamer-env.sh
RUN chmod +x /usr/local/bin/gstreamer-env.sh /opt/scripts/media/libcamera/*.sh || true

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/var/cache/ccache \
    --mount=type=cache,target=/var/cache/sccache \
    set -eux; \
    cd /opt && \
    bash /opt/scripts/media/libcamera/build-libcamera.sh

RUN set -eux; \
    printf "%s\n" "/opt/libcamera/lib" > /etc/ld.so.conf.d/libcamera.conf; \
    printf "%s\n" "/opt/libcamera/lib64" >> /etc/ld.so.conf.d/libcamera.conf; \
    printf "%s\n" "/opt/ffmpeg/lib" > /etc/ld.so.conf.d/ffmpeg.conf; \
    printf "%s\n" "/opt/opencv4/lib" > /etc/ld.so.conf.d/opencv.conf; \
    printf "%s\n" "/usr/local/lib/onnxruntime-cpu/lib" > /etc/ld.so.conf.d/onnxruntime.conf; \
    printf "%s\n" "/usr/local/lib/onnxruntime-genai/lib" >> /etc/ld.so.conf.d/onnxruntime.conf; \
    printf "%s\n" "/usr/local/lib" >> /etc/ld.so.conf.d/litert.conf; \
    ldconfig
