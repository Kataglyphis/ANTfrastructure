# syntax=docker/dockerfile:1.27.1
# Media libraries layer; cache-id keying: docs/build-cache-tiers.md#13-cache-mount-ids-and-source-checkouts

# Safety-net defaults; the orchestrator passes versions.env values via append_version_build_args.
ARG ONNXRUNTIME_VERSION="v1.30.0"
ARG ONNXRUNTIME_GENAI_VERSION="v0.17.0"
ARG LITERT_VERSION="v2.2.0"
ARG OPENCV_VERSION="5.0.0"
ARG GSTREAMER_VERSION="1.29.2"

# AGGRESSIVE_PARALLELISM=true only on 16GB+ hosts.
ARG AGGRESSIVE_PARALLELISM=false
ARG USE_LLD=true
ARG USE_CCACHE=true
ARG USE_SCCACHE=true

# Base stage: only shared, rarely-changing files are COPY'd; per-library scripts are bind-mounted per RUN.
ARG BASE_IMAGE=local/kataglyphis:sdk
FROM ${BASE_IMAGE} AS base

SHELL ["bash", "-lc"]

ARG BUILD_MODE=native
# Divides usable RAM so --parallel-archs builds don't collectively overcommit the host.
ARG BUILD_MEM_DIVISOR=1
ARG TARGETARCH
# Defaulted so a hand-run build still resolves the per-arch COPY below.
ARG TARGET_ARCH=${TARGETARCH}
ARG GCC_VERSION=16.2.0
ARG TARGETPLATFORM
ARG BUILDARCH
ARG BUILDPLATFORM
ARG ENABLE_NVIDIA=false
ARG ENABLE_AMD=false
# false builds the CUDA EP without TensorRT (the Jetson lane has none); read as env by 30-build-native-nvidia.sh.
ARG ENABLE_TENSORRT=true
# Peak (not average) RSS of one cicc; must be an ARG since an env var set around the orchestrator never arrives.
ARG CUDA_MB_PER_CICC=3500
# Off pending a cross-arch validation; see 03-media/core/common.sh.
ARG ENABLE_SCCACHE_RUST=0
# sccache for nvcc/hipcc, which ccache cannot wrap.
ARG ENABLE_SCCACHE_CUDA=0
ARG AGGRESSIVE_PARALLELISM
ARG USE_LLD
ARG USE_CCACHE
ARG USE_SCCACHE
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL
ARG UBUNTU_CODENAME=resolute

ENV ENABLE_NVIDIA=${ENABLE_NVIDIA} \
    ENABLE_TENSORRT=${ENABLE_TENSORRT} \
    CUDA_MB_PER_CICC=${CUDA_MB_PER_CICC} \
    ENABLE_AMD=${ENABLE_AMD} \
    ENABLE_SCCACHE_RUST=${ENABLE_SCCACHE_RUST} \
    ENABLE_SCCACHE_CUDA=${ENABLE_SCCACHE_CUDA} \
    BUILD_MODE=${BUILD_MODE} \
    BUILD_MEM_DIVISOR=${BUILD_MEM_DIVISOR} \
    UV_LINK_MODE=copy \
    TARGET_ARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETPLATFORM=${TARGETPLATFORM} \
    BUILDARCH=${BUILDARCH} \
    BUILDPLATFORM=${BUILDPLATFORM} \
    AGGRESSIVE_PARALLELISM=${AGGRESSIVE_PARALLELISM} \
    USE_LLD=${USE_LLD} \
    USE_CCACHE=${USE_CCACHE} \
    USE_SCCACHE=${USE_SCCACHE}

COPY --chmod=755 linux/scripts/03-media/core/common.sh              /opt/scripts/03-media/core/common.sh
# Only this arch's flag file: copying all three re-keyed base on every lane when one arch's flags changed.
COPY --chmod=644 linux/scripts/03-media/core/arch-flags-${TARGET_ARCH}.env /opt/scripts/03-media/core/arch-flags-${TARGET_ARCH}.env
COPY --chmod=755 linux/scripts/03-media/activate-cross-python.sh    /opt/scripts/03-media/activate-cross-python.sh
COPY --chmod=755 linux/scripts/01-core/install-deps-preamble.sh  /opt/scripts/core/install-deps-preamble.sh
COPY --chmod=755 linux/scripts/01-core/python-host.sh            /opt/scripts/core/python-host.sh
COPY --chmod=755 linux/scripts/01-core/cmake-cache-linker.sh     /opt/scripts/core/cmake-cache-linker.sh
COPY --chmod=755 linux/scripts/01-core/modules.sh                /opt/scripts/core/modules.sh

# Fail fast: :sdk has no nvcc, and every CUDA consumer below would otherwise die deep in a build.
RUN set -euo pipefail; \
    if [ "${ENABLE_NVIDIA}" = "true" ] && [ ! -x "${CUDA_HOME:-/usr/local/cuda}/bin/nvcc" ]; then \
        echo "ERROR: ENABLE_NVIDIA=true but no nvcc at ${CUDA_HOME:-/usr/local/cuda}/bin/nvcc." >&2; \
        echo "       This stage's BASE_IMAGE has no CUDA toolkit, so every GPU build below would fail deep." >&2; \
        echo "       Build the NVIDIA layer (linux/Dockerfile.nvidia) and point this stage at it:" >&2; \
        echo "         CROSS_MEDIA_BASE_IMAGE=<repo>:cross-toolchain-nvidia-<arch> ..." >&2; \
        exit 1; \
    fi; \
    if [ "${ENABLE_NVIDIA}" = "true" ]; then \
        printf '%s\n' 'export NVIDIA_CODEC_HEADERS=yes' > /etc/profile.d/nvidia-codec-headers.sh; \
    fi; \
    bash /opt/scripts/03-media/activate-cross-python.sh

# External repos inherited from :sdk (ROCm, Kitware) cause version conflicts; per-file mounts keep 01-core edits from re-keying base.
RUN --mount=type=bind,source=linux/scripts/01-core/ubuntu-mirror.sh,target=/tmp/core-scripts/ubuntu-mirror.sh,readonly \
    --mount=type=bind,source=linux/scripts/01-core/platform.sh,target=/tmp/core-scripts/platform.sh,readonly \
    set -euo pipefail; \
    rm -f /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources \
          /etc/apt/preferences.d/* 2>/dev/null || true; \
    . /tmp/core-scripts/ubuntu-mirror.sh; \
    _archive_url="${FAST_UBUNTU_MIRROR_URL:-https://archive.ubuntu.com/ubuntu/}"; \
    _ports_url="$(ubuntu_effective_ports_mirror_url "${_archive_url}" "${FAST_UBUNTU_PORTS_MIRROR_URL:-}")"; \
    # Host source serves the build host's own arch; hard-coded amd64 broke native arm64 hosts.
    _build_arch="$(build_arch_oci 2>/dev/null || echo amd64)"; \
    _host_url="${_archive_url}"; \
    ubuntu_arch_uses_ports "${_build_arch}" && _host_url="${_ports_url}"; \
    ubuntu_write_deb822_source /etc/apt/sources.list.d/ubuntu.sources "${_host_url}" "${UBUNTU_CODENAME}" "${_build_arch}" 1; \
    # Target source only for a foreign target, under the per-arch name cross-apt.sh's prune keeps.
    _tgt="${TARGET_ARCH:-amd64}"; \
    if [ "${_tgt}" != "${_build_arch}" ]; then \
      _tgt_url="${_archive_url}"; \
      ubuntu_arch_uses_ports "${_tgt}" && _tgt_url="${_ports_url}"; \
      ubuntu_write_deb822_source "/etc/apt/sources.list.d/ubuntu-ports-${_tgt}.sources" "${_tgt_url}" "${UBUNTU_CODENAME}" "${_tgt}" 1; \
    fi; \
    apt-get update -qq

# Inherited UV_PYTHON points into the venv `--clear` deletes, so seed from the base CPython without it.
RUN set -euo pipefail; \
    _base_py=/usr/local/bin/python3; \
    [ -x "${_base_py}" ] || _base_py="$(command -v python3.14 || command -v python3)"; \
    env -u UV_PYTHON uv venv --clear --python "${_base_py}" /opt/python/.venv; \
    UV_PYTHON="/opt/python/.venv/bin/python" uv pip install \
        --upgrade pip setuptools wheel cython pybind11 numpy

# install-deps resets the alternatives, so GCC is registered as default again.
RUN --mount=type=bind,source=linux/scripts/01-core/register-gcc-alternatives.sh,target=/tmp/core-scripts/register-gcc-alternatives.sh,ro \
    set -euo pipefail; \
    bash /tmp/core-scripts/register-gcc-alternatives.sh

# CUDA refuses GCC > 15; a second host compiler (g++-15) splits libstdc++ and breaks linking, so waive the gate instead.
ARG NVCC_ALLOW_UNSUPPORTED_COMPILER=-allow-unsupported-compiler

# CMake searches PATH, so CC/CXX pin it to this GCC.
ENV NVIDIA_CODEC_HEADERS=auto \
    UV_PYTHON="/opt/python/.venv/bin/python" \
    VIRTUAL_ENV="/opt/python/.venv" \
    NVCC_PREPEND_FLAGS=${NVCC_ALLOW_UNSUPPORTED_COMPILER} \
    CC=/opt/gcc-${GCC_VERSION:-16.2.0}/bin/gcc \
    CXX=/opt/gcc-${GCC_VERSION:-16.2.0}/bin/g++

# ONNX Runtime stage
FROM base AS onnxruntime
# Stage-scoped so the ${TARGET_ARCH} mount ids below expand per lane.
ARG TARGET_ARCH

ARG ONNXRUNTIME_VERSION
ARG ONNXRUNTIME_NATIVE_BUILD_TYPE=Release
ARG ONNXRUNTIME_WASM_BUILD_TYPE=Release
ARG ONNXRUNTIME_GENAI_VERSION
ARG ONNXRUNTIME_GENAI_BUILD_TYPE=Release
ARG BUILD_GENAI=true
ARG ONNXRUNTIME_OUTPUT_DIR=/usr/local/lib/onnxruntime-cpu
ARG ONNXRUNTIME_GENAI_OUTPUT_DIR=/usr/local/lib/onnxruntime-genai
# Cross arches also need ORT_WEBGPU_ALLOW_CROSS (Dawn cross-build unproven); see onnxruntime/build/lib/common.sh.
ARG ORT_ENABLE_WEBGPU=true
ARG ORT_WEBGPU_ALLOW_CROSS=true
# Default must equal versions.env (verify-arg-consistency.sh); docs/gen1-riscv64-genai.md
ARG GENAI_ALLOW_RISCV64=true

ENV NATIVE_CPU_OUTPUT_DIR=${ONNXRUNTIME_OUTPUT_DIR} \
    GENAI_OUTPUT_DIR=${ONNXRUNTIME_GENAI_OUTPUT_DIR} \
    ORT_VERSION=${ONNXRUNTIME_VERSION} \
    NATIVE_CPU_CONFIG=${ONNXRUNTIME_NATIVE_BUILD_TYPE} \
    WASM_CONFIG=${ONNXRUNTIME_WASM_BUILD_TYPE} \
    GENAI_VERSION=${ONNXRUNTIME_GENAI_VERSION} \
    GENAI_CONFIG=${ONNXRUNTIME_GENAI_BUILD_TYPE} \
    BUILD_GENAI=${BUILD_GENAI} \
    ORT_ENABLE_WEBGPU=${ORT_ENABLE_WEBGPU} \
    ORT_WEBGPU_ALLOW_CROSS=${ORT_WEBGPU_ALLOW_CROSS} \
    GENAI_ALLOW_RISCV64=${GENAI_ALLOW_RISCV64}

# Per-file mounts so later build-step edits don't re-pay this layer; 01-core stays whole (source_module pulls most of it).
RUN --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=bind,source=linux/scripts/03-media/build/onnxruntime/build/build-onnxruntime.sh,target=/opt/scripts/03-media/build/onnxruntime/build/build-onnxruntime.sh,readonly \
    --mount=type=bind,source=linux/scripts/03-media/build/onnxruntime/build/10-deps.sh,target=/opt/scripts/03-media/build/onnxruntime/build/10-deps.sh,readonly \
    --mount=type=bind,source=linux/scripts/03-media/build/onnxruntime/build/20-fetch.sh,target=/opt/scripts/03-media/build/onnxruntime/build/20-fetch.sh,readonly \
    --mount=type=bind,source=linux/scripts/03-media/build/onnxruntime/build/lib,target=/opt/scripts/03-media/build/onnxruntime/build/lib,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH}-onnx \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH}-onnx \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
    set -euo pipefail; \
    SKIP_DEP_INSTALL=true bash /opt/scripts/03-media/build/onnxruntime/build/build-onnxruntime.sh --step deps && \
    bash /opt/scripts/03-media/build/onnxruntime/build/build-onnxruntime.sh --step fetch

# Per-file mounts: `--step cpu` runs only 30-build-native.sh, so other step edits must not re-key this build.
RUN --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=bind,source=linux/scripts/03-media/build/onnxruntime/build/build-onnxruntime.sh,target=/opt/scripts/03-media/build/onnxruntime/build/build-onnxruntime.sh,readonly \
    --mount=type=bind,source=linux/scripts/03-media/build/onnxruntime/build/30-build-native.sh,target=/opt/scripts/03-media/build/onnxruntime/build/30-build-native.sh,readonly \
    --mount=type=bind,source=linux/scripts/03-media/build/onnxruntime/build/lib,target=/opt/scripts/03-media/build/onnxruntime/build/lib,readonly \
    --mount=type=bind,source=linux/scripts/03-media/free-threaded-wheels.sh,target=/opt/scripts/03-media/free-threaded-wheels.sh,readonly \
    --mount=type=bind,source=linux/scripts/03-media/free-threaded-twins.txt,target=/opt/scripts/03-media/free-threaded-twins.txt,readonly \
    --mount=type=bind,source=linux/scripts/02-toolchain/python/free-threaded-wheel.py,target=/opt/scripts/03-media/free-threaded-wheel.py,readonly \
    --mount=type=bind,source=linux/qnn-sdk,target=/opt/scripts/qnn-sdk,readonly \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    bash /opt/scripts/03-media/build/onnxruntime/build/build-onnxruntime.sh --step cpu

RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=bind,source=linux/scripts/03-media/runtime/verify-media-artifacts.sh,target=/opt/scripts/03-media/runtime/verify-media-artifacts.sh,readonly \
    set -euo pipefail; \
    bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh onnxruntime-cpu

RUN --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=bind,source=linux/scripts/patches/onnxruntime,target=/opt/scripts/patches/onnxruntime,readonly \
    --mount=type=bind,source=linux/scripts/03-media/runtime/verify-media-artifacts.sh,target=/opt/scripts/03-media/runtime/verify-media-artifacts.sh,readonly \
    --mount=type=bind,source=linux/scripts/03-media/build/onnxruntime,target=/opt/scripts/03-media/build/onnxruntime,readonly \
    --mount=type=bind,source=linux/scripts/03-media/free-threaded-wheels.sh,target=/opt/scripts/03-media/free-threaded-wheels.sh,readonly \
    --mount=type=bind,source=linux/scripts/03-media/free-threaded-twins.txt,target=/opt/scripts/03-media/free-threaded-twins.txt,readonly \
    --mount=type=bind,source=linux/scripts/02-toolchain/python/free-threaded-wheel.py,target=/opt/scripts/03-media/free-threaded-wheel.py,readonly \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    if [ "${ENABLE_NVIDIA}" = "true" ] || [ "${ENABLE_AMD}" = "true" ]; then \
        bash /opt/scripts/03-media/build/onnxruntime/build/build-onnxruntime.sh --step gpu; \
        bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh onnxruntime-gpu; \
    else \
        echo "Skipping ONNX GPU build (ENABLE_NVIDIA=${ENABLE_NVIDIA:-false}, ENABLE_AMD=${ENABLE_AMD:-false})"; \
    fi

# The patches mount carries the riscv64 target_platform patch; docs/gen1-riscv64-genai.md
RUN --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=bind,source=linux/scripts/patches/onnxruntime-genai,target=/opt/scripts/patches/onnxruntime-genai,readonly \
    --mount=type=bind,source=linux/scripts/03-media/build/onnxruntime,target=/opt/scripts/03-media/build/onnxruntime,readonly \
    --mount=type=bind,source=linux/qnn-sdk,target=/opt/scripts/qnn-sdk,readonly \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    bash /opt/scripts/03-media/build/onnxruntime/build/build-onnxruntime.sh --step genai

# Mounted per file: build/onnxruntime/ and runtime/ are mounted/copied whole elsewhere, so either dir would re-key them.
RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=bind,source=linux/scripts/03-media/runtime/verify-media-artifacts.sh,target=/opt/scripts/03-media/runtime/verify-media-artifacts.sh,readonly \
    --mount=type=bind,source=linux/scripts/03-media/verify-genai-ort.sh,target=/opt/scripts/03-media/verify-genai-ort.sh,readonly \
    --mount=type=bind,source=linux/scripts/03-media/ort-provenance.sh,target=/opt/scripts/03-media/ort-provenance.sh,readonly \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
    set -euo pipefail; \
    if [ "${BUILD_GENAI:-true}" = "true" ]; then \
      bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh onnxruntime-genai; \
      bash /opt/scripts/03-media/verify-genai-ort.sh --src-dir /opt/onnxruntime-genai \
        --output-dir "${ONNXRUNTIME_GENAI_OUTPUT_DIR}" --ort-root "${ONNXRUNTIME_OUTPUT_DIR}" --ort-root /usr/local/lib/onnxruntime-gpu; \
    else \
      echo "Skipping onnxruntime-genai verification (BUILD_GENAI=${BUILD_GENAI:-true})"; \
    fi

# Arch-independent wasm, compiled once per ORT version and shared; bump -wgpu1 whenever the built flavor set changes.
RUN --mount=type=bind,source=linux/scripts/03-media/build/onnxruntime,target=/opt/scripts/03-media/build/onnxruntime,readonly \
    --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/onnxruntime-web-shared,id=onnxruntime-web-shared-${ONNXRUNTIME_VERSION}-wgpu1,sharing=locked \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    _ortweb=/usr/local/lib/onnxruntime-web; _shared=/var/cache/onnxruntime-web-shared; \
    mkdir -p "${_ortweb}"; \
    if [ -f "${_shared}/.complete" ]; then \
        echo "Reusing shared onnxruntime-web assets (compiled once, arch-independent)"; \
        cp -a "${_shared}/." "${_ortweb}/"; \
    else \
        echo "Shared onnxruntime-web cache empty on target=${TARGET_ARCH}; compiling (arch-independent, runs on the amd64 host) and populating the cache for the other arches"; \
        # Optional browser asset: a wasm failure ships it empty instead of failing the media build.
        if bash /opt/scripts/03-media/build/onnxruntime/build/build-onnxruntime.sh --step wasm; then \
            if cp -a "${_ortweb}/." "${_shared}/"; then \
                : > "${_shared}/.complete"; \
            else \
                echo "WARNING: copying onnxruntime-web assets into the shared cache failed; NOT stamping it complete so the next arch recompiles instead of inheriting a partial set"; \
                rm -f "${_shared}/.complete"; \
            fi; \
        else \
            echo "WARNING: onnxruntime-web WASM build failed on target=${TARGET_ARCH}; shipping without onnx-web (optional, non-fatal)"; \
        fi; \
    fi

RUN --mount=type=bind,source=linux/scripts/03-media/build/onnxruntime,target=/opt/scripts/03-media/build/onnxruntime,readonly \
    --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
    set -euo pipefail; \
    bash /opt/scripts/03-media/build/onnxruntime/build/build-onnxruntime.sh --step js; \
    bash /opt/scripts/03-media/build/onnxruntime/build/build-onnxruntime.sh --step pkgconfig

RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=bind,source=linux/scripts/03-media/runtime/verify-media-artifacts.sh,target=/opt/scripts/03-media/runtime/verify-media-artifacts.sh,readonly \
    set -euo pipefail; \
    bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh onnxruntime-pkgconfig

# LiteRT stage
FROM base AS litert
# Stage-scoped so the ${TARGET_ARCH} mount ids below expand per lane.
ARG TARGET_ARCH

ARG LITERT_VERSION
ARG LITERT_OUTPUT_DIR=/usr/local
ARG LITERTJS_VERSION=2.5.3
ARG MEDIAPIPE_GENAI_VERSION=0.10.29

# Every install-deps RUN mounts exactly cross-env.sh's source closure, so build-script edits don't re-pay the apt layer.
RUN --mount=type=bind,source=linux/scripts/03-media/build/litert/install-deps.sh,target=/opt/scripts/03-media/build/litert/install-deps.sh,readonly \
    --mount=type=bind,source=linux/scripts/01-core/cross-env.sh,target=/opt/scripts/core/cross-env.sh,readonly \
    --mount=type=bind,source=linux/scripts/01-core/cross-gcc.sh,target=/opt/scripts/core/cross-gcc.sh,readonly \
    --mount=type=bind,source=linux/scripts/01-core/cross-python.sh,target=/opt/scripts/core/cross-python.sh,readonly \
    --mount=type=bind,source=linux/scripts/01-core/cross-apt.sh,target=/opt/scripts/core/cross-apt.sh,readonly \
    --mount=type=bind,source=linux/scripts/01-core/cross-meson.sh,target=/opt/scripts/core/cross-meson.sh,readonly \
    --mount=type=bind,source=linux/scripts/01-core/platform.sh,target=/opt/scripts/core/platform.sh,readonly \
    --mount=type=bind,source=linux/scripts/01-core/ubuntu-mirror.sh,target=/opt/scripts/core/ubuntu-mirror.sh,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH}-litert \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH}-litert \
    set -euo pipefail; \
    bash /opt/scripts/03-media/build/litert/install-deps.sh

# Prebuilt npm web runtimes; best-effort (exits 0) so a registry hiccup can't break the media build.
RUN --mount=type=bind,source=linux/scripts/03-media/build/litert,target=/opt/scripts/03-media/build/litert,readonly \
    --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    LITERTJS_VERSION="${LITERTJS_VERSION}" MEDIAPIPE_GENAI_VERSION="${MEDIAPIPE_GENAI_VERSION}" \
    bash /opt/scripts/03-media/build/litert/install-litert-web.sh

RUN --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=bind,source=linux/scripts/patches/litert,target=/opt/scripts/patches/litert,readonly \
    --mount=type=bind,source=linux/scripts/03-media/build/litert,target=/opt/scripts/03-media/build/litert,readonly \
    --mount=type=bind,source=linux/qnn-sdk,target=/opt/scripts/qnn-sdk,readonly \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    bash /opt/scripts/03-media/build/litert/build-litert.sh "${LITERT_VERSION}"

RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=bind,source=linux/scripts/03-media/runtime/verify-media-artifacts.sh,target=/opt/scripts/03-media/runtime/verify-media-artifacts.sh,readonly \
    set -euo pipefail; \
    bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh litert && \
    bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh litert-headers

# TVM stage: best-effort on every arch; both wheels are needed, see docs/linux-cross-builds.md#tvm-cross-wheels-what-must-not-be-simplified-away
FROM base AS tvm

ARG TVM_REF=v0.27.0
# tvm.sh reads versions.env itself; this ARG only lets an explicit --build-arg land too.
ARG TVM_COMMIT=
# Re-declared: Dockerfile.sdk bakes 0 into ENV, and without an ARG the GPU lane could not pass 1.
ARG TVM_USE_CUDA=0
ENV TVM_USE_CUDA=${TVM_USE_CUDA}
ARG TARGET_ARCH
ARG TARGETARCH

# Only the five tvm*.sh files, so unrelated 05-frameworks edits don't re-pay this build.
RUN --mount=type=bind,source=linux/scripts/05-frameworks/tvm.sh,target=/opt/scripts/05-frameworks/tvm.sh,readonly \
    --mount=type=bind,source=linux/scripts/05-frameworks/tvm-detect.sh,target=/opt/scripts/05-frameworks/tvm-detect.sh,readonly \
    --mount=type=bind,source=linux/scripts/05-frameworks/tvm-config.sh,target=/opt/scripts/05-frameworks/tvm-config.sh,readonly \
    --mount=type=bind,source=linux/scripts/05-frameworks/tvm-python.sh,target=/opt/scripts/05-frameworks/tvm-python.sh,readonly \
    --mount=type=bind,source=linux/scripts/05-frameworks/tvm-llvm-compat.sh,target=/opt/scripts/05-frameworks/tvm-llvm-compat.sh,readonly \
    --mount=type=bind,source=linux/scripts/03-media/free-threaded-wheels.sh,target=/opt/scripts/03-media/free-threaded-wheels.sh,readonly \
    --mount=type=bind,source=linux/scripts/03-media/free-threaded-twins.txt,target=/opt/scripts/03-media/free-threaded-twins.txt,readonly \
    --mount=type=bind,source=linux/scripts/02-toolchain/python/free-threaded-wheel.py,target=/opt/scripts/03-media/free-threaded-wheel.py,readonly \
    --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=bind,source=linux/qnn-sdk,target=/opt/scripts/qnn-sdk,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH}-tvm \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH}-tvm \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    mkdir -p /opt/tvm/wheels /opt/tvm/wheels-cp314t /opt/tvm/lib; \
    # Best-effort: a failure ships without TVM; EXP_TVM=<ver> in the smoke is what makes it mandatory.
    echo "TVM build: target=${TARGET_ARCH:-amd64} BUILD_MODE=${BUILD_MODE:-native}"; \
    if bash /opt/scripts/05-frameworks/tvm.sh --ref "${TVM_REF}" --prefix /opt/tvm --workdir /tmp/tvm-src; then \
        echo "TVM build OK; wheel(s):"; ls -1 /opt/tvm/wheels/ 2>/dev/null || true; \
        [ -d /opt/tvm/lib64 ] && cp -a /opt/tvm/lib64/. /opt/tvm/lib/ 2>/dev/null || true; \
    else \
        echo "WARNING: TVM build failed for target=${TARGET_ARCH:-?}; shipping media image without TVM python (non-fatal)"; \
        rm -f /opt/tvm/wheels/*.whl /opt/tvm/wheels-cp314t/*.whl 2>/dev/null || true; \
    fi

# OpenCV stage
FROM base AS opencv
# Stage-scoped so the ${TARGET_ARCH} mount ids below expand per lane.
ARG TARGET_ARCH

ARG OPENCV_VERSION
# Optional 40-hex SHAs, pinned separately; empty tracks the OPENCV_VERSION branch.
ARG OPENCV_COMMIT=""
ARG OPENCV_CONTRIB_COMMIT=""
ARG OPENCV_BUILD_TYPE=Release
ARG OPENCV_WITH_CONTRIB=true
ARG OPENCV_WITH_PYTHON=true
ARG OPENCV_OUTPUT_DIR=/opt/opencv5

ENV OPENCV_PREFIX=${OPENCV_OUTPUT_DIR}
ENV PKG_CONFIG_PATH="${OPENCV_PREFIX}/lib/pkgconfig:${PKG_CONFIG_PATH}"

RUN --mount=type=bind,source=linux/scripts/03-media/build/opencv,target=/opt/scripts/03-media/build/opencv,readonly \
    --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH}-opencv \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH}-opencv \
    set -euo pipefail; \
    bash /opt/scripts/03-media/build/opencv/install-deps.sh

RUN --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=bind,source=linux/scripts/patches/opencv,target=/opt/scripts/patches/opencv,readonly \
    --mount=type=bind,source=linux/scripts/03-media/build/opencv,target=/opt/scripts/03-media/build/opencv,readonly \
    --mount=type=bind,source=linux/scripts/03-media/ort-provenance.sh,target=/opt/scripts/03-media/ort-provenance.sh,readonly \
    --mount=type=bind,from=onnxruntime,source=/usr/local/lib/onnxruntime-cpu,target=/usr/local/lib/onnxruntime-cpu,readonly \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    export OPENCV_COMMIT="${OPENCV_COMMIT}" OPENCV_CONTRIB_COMMIT="${OPENCV_CONTRIB_COMMIT}"; \
    bash /opt/scripts/03-media/build/opencv/build-opencv.sh \
        --opencv-version "${OPENCV_VERSION}" \
        --prefix "${OPENCV_OUTPUT_DIR}" \
        --build-type "${OPENCV_BUILD_TYPE}" \
        --with-contrib "${OPENCV_WITH_CONTRIB}" \
        --with-python "${OPENCV_WITH_PYTHON}" \
        --skip-dep-install

RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=bind,source=linux/scripts/03-media/runtime/verify-media-artifacts.sh,target=/opt/scripts/03-media/runtime/verify-media-artifacts.sh,readonly \
    set -euo pipefail; \
    bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh opencv-core && \
    bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh opencv

# App wheelhouse stage (riscv64: torch+vision+IREE cross; amd64/arm64: IREE only)
FROM base AS app-wheelhouse

ARG TARGET_ARCH
# Without these ARGs the source build ignores versions.env and riscv64 cannot follow a pin bump.
ARG PYTORCH_VERSION=v2.14.1
ARG TORCHVISION_VERSION=v0.29.1
ARG IREE_VERSION=v3.12.0

# No cargo mount: build-app-wheelhouse.sh never runs cargo, and an inert mount reads as coverage.
RUN --mount=type=bind,source=linux/scripts/05-frameworks/torch,target=/opt/scripts/frameworks/torch,readonly \
    --mount=type=bind,source=linux/scripts/03-media/free-threaded-wheels.sh,target=/opt/scripts/03-media/free-threaded-wheels.sh,readonly \
    --mount=type=bind,source=linux/scripts/03-media/free-threaded-twins.txt,target=/opt/scripts/03-media/free-threaded-twins.txt,readonly \
    --mount=type=bind,source=linux/scripts/02-toolchain/python/free-threaded-wheel.py,target=/opt/scripts/03-media/free-threaded-wheel.py,readonly \
    --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=bind,source=linux/scripts/patches/torchvision,target=/opt/scripts/patches/torchvision,readonly \
    --mount=type=bind,source=linux/qnn-sdk,target=/opt/scripts/qnn-sdk,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH}-wheelhouse \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH}-wheelhouse \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    case "${TARGET_ARCH:-amd64}" in \
      amd64|arm64|riscv64) ;; \
      *) echo "Skipping app-wheelhouse (unsupported arch ${TARGET_ARCH})"; \
         mkdir -p /opt/app-wheels /opt/app-wheels-cp314t; \
         exit 0 ;; \
    esac; \
    if ! command -v uv >/dev/null 2>&1; then \
      echo "WARNING: uv not found in app-wheelhouse stage; installing..."; \
      pip3 install uv 2>/dev/null || echo "WARNING: could not install uv"; \
    fi; \
    export PYTORCH_VERSION="${PYTORCH_VERSION}" TORCHVISION_VERSION="${TORCHVISION_VERSION}" IREE_VERSION="${IREE_VERSION}"; \
    bash /opt/scripts/frameworks/torch/build-app-wheelhouse.sh; \
    mkdir -p /opt/app-wheels-cp314t; \
    if [ ! -d /opt/app-wheels ] || [ -z "$(ls -A /opt/app-wheels 2>/dev/null)" ]; then \
        mkdir -p /opt/app-wheels; \
        touch /opt/app-wheels/.placeholder; \
        echo "WARNING: app wheelhouse is empty — riscv64 cross wheel builds may have failed; continuing"; \
    fi

RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=bind,source=linux/scripts/03-media/runtime/verify-media-artifacts.sh,target=/opt/scripts/03-media/runtime/verify-media-artifacts.sh,readonly \
    set -euo pipefail; \
    bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh app-wheels

# Arm NN stage (arm64 only; provides ONNX Runtime Arm NN EP)
FROM base AS armnn

ARG TARGET_ARCH
ARG BUILD_MODE

# Own apt ids: on other lanes this RUN only echoes, yet it queued for the locked lane-wide store.
RUN --mount=type=bind,source=linux/scripts/03-media/build/armnn,target=/opt/scripts/03-media/build/armnn,readonly \
    --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH}-armnn \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH}-armnn \
    set -euo pipefail; \
    case "${TARGET_ARCH:-${TARGETARCH:-}}" in \
        arm64|aarch64) bash /opt/scripts/03-media/build/armnn/install-deps.sh ;; \
        *) echo "Skipping Arm NN deps (arm64 only, got ${TARGET_ARCH:-${TARGETARCH:-}})" ;; \
    esac

RUN --mount=type=bind,source=linux/scripts/03-media/build/armnn,target=/opt/scripts/03-media/build/armnn,readonly \
    --mount=type=bind,source=linux/scripts/03-media/runtime/verify-media-artifacts.sh,target=/opt/scripts/03-media/runtime/verify-media-artifacts.sh,readonly \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    case "${TARGET_ARCH:-${TARGETARCH:-}}" in \
        arm64|aarch64) \
            bash /opt/scripts/03-media/build/armnn/build-arm-compute-library.sh && \
            bash /opt/scripts/03-media/build/armnn/build-armnn.sh && \
            bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh armnn ;; \
        *) \
            echo "Skipping Arm NN build (arm64 only, got ${TARGET_ARCH:-${TARGETARCH:-}})"; \
            mkdir -p /opt/armnn /opt/acl ;; \
    esac

# FFmpeg stage
FROM base AS ffmpeg
# Stage-scoped so the ${TARGET_ARCH} mount ids below expand per lane.
ARG TARGET_ARCH

# Optional 40-hex SHA; empty tracks FFMPEG_VERSION.
ARG FFMPEG_COMMIT=""

# 1 probe-gates --enable-libx265; see build-ffmpeg.sh.
ARG FFMPEG_ENABLE_X265=1

# Off by default: the TF C SDK adds ~500 MB for one optional DNN backend.
ARG FFMPEG_ENABLE_TF=0

ENV FFMPEG_PREFIX=/opt/ffmpeg \
    FFMPEG_ENABLE_X265=${FFMPEG_ENABLE_X265} \
    FFMPEG_ENABLE_TF=${FFMPEG_ENABLE_TF}

RUN --mount=type=bind,source=linux/scripts/03-media/build/ffmpeg,target=/opt/scripts/03-media/build/ffmpeg,readonly \
    --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH}-ffmpeg \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH}-ffmpeg \
    set -euo pipefail; \
    bash /opt/scripts/03-media/build/ffmpeg/install-deps.sh

RUN --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=bind,source=linux/scripts/03-media/build/ffmpeg,target=/opt/scripts/03-media/build/ffmpeg,readonly \
    --mount=type=bind,source=linux/scripts/03-media/ort-provenance.sh,target=/opt/scripts/03-media/ort-provenance.sh,readonly \
    --mount=type=bind,from=onnxruntime,source=/usr/local/lib/onnxruntime-cpu,target=/usr/local/lib/onnxruntime-cpu,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ffmpeg-sdks,id=ffmpeg-sdks-${TARGET_ARCH},sharing=shared \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    export PKG_CONFIG_PATH="/var/cache/ffmpeg-sdks:/usr/local/lib/onnxruntime-cpu/runtime/lib/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}"; \
    export ENABLE_NVIDIA="${ENABLE_NVIDIA}"; \
    export FFMPEG_COMMIT="${FFMPEG_COMMIT}"; \
    echo "--- ffmpeg build v3: DNN backends (TensorFlow, OpenVINO, ONNX) + CUDA HW accel ---"; \
    bash /opt/scripts/03-media/build/ffmpeg/build-ffmpeg.sh

RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=bind,source=linux/scripts/03-media/runtime/verify-media-artifacts.sh,target=/opt/scripts/03-media/runtime/verify-media-artifacts.sh,readonly \
    set -euo pipefail; \
    bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh ffmpeg

# PyAV stage: layered on ffmpeg, not inside it, so /opt/ffmpeg stays byte-identical for downstream caches.
FROM ffmpeg AS pyav
# Stage-scoped so the ${TARGET_ARCH} mount ids below expand per lane.
ARG TARGET_ARCH
ARG PYAV_VERSION=19.0.1

ENV PYAV_VERSION=${PYAV_VERSION}

RUN --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=bind,source=linux/scripts/03-media/build/pyav,target=/opt/scripts/03-media/build/pyav,readonly \
    --mount=type=bind,source=linux/scripts/03-media/free-threaded-wheels.sh,target=/opt/scripts/03-media/free-threaded-wheels.sh,readonly \
    --mount=type=bind,source=linux/scripts/03-media/free-threaded-twins.txt,target=/opt/scripts/03-media/free-threaded-twins.txt,readonly \
    --mount=type=bind,source=linux/scripts/02-toolchain/python/free-threaded-wheel.py,target=/opt/scripts/03-media/free-threaded-wheel.py,readonly \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    bash /opt/scripts/03-media/build/pyav/build-pyav.sh

# Media inputs stage: aggregates the library outputs
FROM base AS media-inputs

ARG ONNXRUNTIME_OUTPUT_DIR=/usr/local/lib/onnxruntime-cpu
ARG ONNXRUNTIME_GENAI_OUTPUT_DIR=/usr/local/lib/onnxruntime-genai
ARG LITERT_OUTPUT_DIR=/usr/local
ARG OPENCV_OUTPUT_DIR=/opt/opencv5

ENV NATIVE_CPU_OUTPUT_DIR=${ONNXRUNTIME_OUTPUT_DIR} \
    FFMPEG_PREFIX=/opt/ffmpeg \
    PKG_CONFIG_PATH="/opt/ffmpeg/lib/pkgconfig:${OPENCV_OUTPUT_DIR}/lib/pkgconfig:${LITERT_OUTPUT_DIR}/lib/pkgconfig:${ONNXRUNTIME_OUTPUT_DIR}/runtime/lib/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}" \
    LD_LIBRARY_PATH="/opt/ffmpeg/lib:${OPENCV_OUTPUT_DIR}/lib:${LITERT_OUTPUT_DIR}/lib:${ONNXRUNTIME_OUTPUT_DIR}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    LIBRARY_PATH="/opt/ffmpeg/lib:${LITERT_OUTPUT_DIR}/lib:${OPENCV_OUTPUT_DIR}/lib:${ONNXRUNTIME_OUTPUT_DIR}/lib${LIBRARY_PATH:+:${LIBRARY_PATH}}"

COPY --link --from=onnxruntime ${ONNXRUNTIME_OUTPUT_DIR} ${ONNXRUNTIME_OUTPUT_DIR}
COPY --link --from=onnxruntime ${ONNXRUNTIME_GENAI_OUTPUT_DIR} ${ONNXRUNTIME_GENAI_OUTPUT_DIR}
COPY --link --from=litert ${LITERT_OUTPUT_DIR}/include ${LITERT_OUTPUT_DIR}/include
COPY --link --from=litert ${LITERT_OUTPUT_DIR}/lib ${LITERT_OUTPUT_DIR}/lib
COPY --link --from=opencv ${OPENCV_OUTPUT_DIR} ${OPENCV_OUTPUT_DIR}
COPY --link --from=ffmpeg /opt/ffmpeg /opt/ffmpeg
COPY --link --from=armnn /opt/armnn /opt/armnn
COPY --link --from=armnn /opt/acl /opt/acl

RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=bind,source=linux/scripts/03-media/runtime/verify-media-artifacts.sh,target=/opt/scripts/03-media/runtime/verify-media-artifacts.sh,readonly \
    set -euo pipefail; \
    bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh media-inputs

# `--target media-smoke` skips the slow gstreamer/libcamera tail.
FROM media-inputs AS media-smoke


# GStreamer stage
FROM media-inputs AS gstreamer

ARG GSTREAMER_VERSION
ARG BUILD_TYPE=Release
ARG GSTREAMER_PREFIX=/opt/gstreamer
ARG TARGET_ARCH
ARG TARGETARCH
ARG BUILD_MODE
ARG GCC_VERSION=16.2.0

ENV GSTREAMER_PREFIX=${GSTREAMER_PREFIX} \
    GSTREAMER_VERSION=${GSTREAMER_VERSION} \
    CSOUND_LIB_DIR=/usr/lib \
    PATH="${GSTREAMER_PREFIX}/bin:${PATH}" \
    BUILD_MODE=${BUILD_MODE} \
    TARGET_ARCH=${TARGET_ARCH}

RUN --mount=type=bind,source=linux/scripts/03-media/build/gstreamer,target=/opt/scripts/03-media/build/gstreamer,readonly \
    --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH} \
    set -euo pipefail; \
    bash /opt/scripts/03-media/build/gstreamer/install-deps.sh

# The only cargo consumer; its lock sits outside these mounts: docs/build-cache-tiers.md#13-cache-mount-ids-and-source-checkouts
RUN --mount=type=bind,source=linux/scripts/03-media/build/gstreamer,target=/opt/scripts/03-media/build/gstreamer,readonly \
    --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=bind,source=linux/scripts/patches/gstreamer,target=/opt/scripts/patches/gstreamer,readonly \
    --mount=type=bind,source=linux/scripts/03-media/ort-provenance.sh,target=/opt/scripts/03-media/ort-provenance.sh,readonly \
    --mount=type=bind,source=linux/scripts/04-runtime/gstreamer-env.sh,target=/usr/local/bin/gstreamer-env.sh,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH} \
    # Same ids as Dockerfile.toolchain: crate sources are arch-independent.
    --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-${TARGETARCH} \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    bash /opt/scripts/03-media/build/gstreamer/common/build-gstreamer-stage.sh \
        "$GSTREAMER_VERSION" \
        "$GSTREAMER_PREFIX" \
        "$BUILD_TYPE"

RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=bind,source=linux/scripts/03-media/runtime/verify-media-artifacts.sh,target=/opt/scripts/03-media/runtime/verify-media-artifacts.sh,readonly \
    set -euo pipefail; \
    bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh gstreamer

# libcamera stage
FROM gstreamer AS libcamera
# Stage-scoped so the ${TARGET_ARCH} mount ids below expand per lane.
ARG TARGET_ARCH

RUN --mount=type=bind,source=linux/scripts/03-media/build/libcamera,target=/opt/scripts/03-media/build/libcamera,readonly \
    --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH} \
    set -euo pipefail; \
    bash /opt/scripts/03-media/build/libcamera/install-deps.sh

# No cargo mount: build-libcamera.sh never runs cargo.
RUN --mount=type=bind,source=linux/scripts/03-media/build/libcamera,target=/opt/scripts/03-media/build/libcamera,readonly \
    --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=bind,source=linux/scripts/patches/libcamera,target=/opt/scripts/patches/libcamera,readonly \
    --mount=type=bind,source=linux/scripts/patches/libyuv,target=/opt/scripts/patches/libyuv,readonly \
    --mount=type=bind,source=linux/scripts/04-runtime/gstreamer-env.sh,target=/usr/local/bin/gstreamer-env.sh,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    bash /opt/scripts/03-media/build/libcamera/build-libcamera.sh

RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=bind,source=linux/scripts/03-media/runtime/verify-media-artifacts.sh,target=/opt/scripts/03-media/runtime/verify-media-artifacts.sh,readonly \
    set -euo pipefail; \
    bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh libcamera

# OpenCV pass 2: pass 1 feeds GStreamer's opencv plugin, this pass links videoio against the source-built GStreamer.
FROM gstreamer AS opencv-gst
# Stage-scoped so the ${TARGET_ARCH} mount ids below expand per lane.
ARG TARGET_ARCH

ARG OPENCV_VERSION
ARG OPENCV_COMMIT=""
ARG OPENCV_CONTRIB_COMMIT=""
ARG OPENCV_BUILD_TYPE=Release
ARG OPENCV_WITH_CONTRIB=true
ARG OPENCV_WITH_PYTHON=true
ARG OPENCV_OUTPUT_DIR=/opt/opencv5
ENV OPENCV_PREFIX=${OPENCV_OUTPUT_DIR}

RUN --mount=type=bind,source=linux/scripts/03-media/build/opencv,target=/opt/scripts/03-media/build/opencv,readonly \
    --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH} \
    set -euo pipefail; \
    bash /opt/scripts/03-media/build/opencv/install-deps.sh

RUN --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=bind,source=linux/scripts/patches/opencv,target=/opt/scripts/patches/opencv,readonly \
    --mount=type=bind,source=linux/scripts/03-media/build/opencv,target=/opt/scripts/03-media/build/opencv,readonly \
    --mount=type=bind,source=linux/scripts/03-media/ort-provenance.sh,target=/opt/scripts/03-media/ort-provenance.sh,readonly \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    export OPENCV_COMMIT="${OPENCV_COMMIT}" OPENCV_CONTRIB_COMMIT="${OPENCV_CONTRIB_COMMIT}"; \
    export FORCE_REBUILD=1 OPENCV_GSTREAMER_PASS=2; \
    _gst_pc="$(find "${GSTREAMER_PREFIX:-/opt/gstreamer}/lib" -name 'gstreamer-1.0.pc' -type f 2>/dev/null | head -1)"; \
    if [ -n "${_gst_pc}" ]; then _gst_dir="$(dirname "${_gst_pc}")"; export PKG_CONFIG_PATH="${_gst_dir}:${PKG_CONFIG_PATH:-}"; fi; \
    echo "opencv pass 2: gstreamer .pc=${_gst_pc:-NONE}  PKG_CONFIG_PATH=${PKG_CONFIG_PATH:-<unset>}"; \
    bash /opt/scripts/03-media/build/opencv/build-opencv.sh \
        --opencv-version "${OPENCV_VERSION}" \
        --prefix "${OPENCV_OUTPUT_DIR}" \
        --build-type "${OPENCV_BUILD_TYPE}" \
        --with-contrib "${OPENCV_WITH_CONTRIB}" \
        --with-python "${OPENCV_WITH_PYTHON}" \
        --skip-dep-install

RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=bind,source=linux/scripts/03-media/runtime/verify-media-artifacts.sh,target=/opt/scripts/03-media/runtime/verify-media-artifacts.sh,readonly \
    set -euo pipefail; \
    bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh opencv-core && \
    bash /opt/scripts/03-media/runtime/verify-media-artifacts.sh opencv

# DeepStream (nvidia variant, ENABLE_DEEPSTREAM=true only): docs/linux-accelerator-images.md#deepstream-nvidia-variant
FROM gstreamer AS deepstream
# Stage-scoped so the ${TARGET_ARCH} mount ids below expand per lane.
ARG TARGET_ARCH
ARG TARGETARCH
ARG ENABLE_DEEPSTREAM=false

# /var/tmp, not a tmpfs: the TensorRT 10 debs and the source tree need several GB of scratch.
RUN --mount=type=bind,source=linux/scripts/05-frameworks/deepstream.sh,target=/opt/scripts/05-frameworks/deepstream.sh,readonly \
    --mount=type=bind,source=linux/scripts/05-frameworks/deepstream-verify.sh,target=/opt/scripts/05-frameworks/deepstream-verify.sh,readonly \
    --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH} \
    --mount=type=cache,target=/var/cache/deepstream,sharing=locked,id=deepstream-downloads-${TARGET_ARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    set -euo pipefail; \
    mkdir -p /opt/nvidia; \
    if [ "${ENABLE_DEEPSTREAM}" = "true" ]; then \
        DS_DOWNLOAD_CACHE=/var/cache/deepstream TMPDIR=/var/tmp bash /opt/scripts/05-frameworks/deepstream.sh build; \
    else \
        echo "ENABLE_DEEPSTREAM=${ENABLE_DEEPSTREAM}: no DeepStream in this image"; \
    fi

# Final stage: build scripts are not shipped, only runtime ones
FROM media-inputs AS final
# Stage-scoped so the ${TARGET_ARCH} mount ids below expand per lane.
ARG TARGET_ARCH

ARG GSTREAMER_VERSION
# Exported as ENV: the android stages mount no versions.env, so inherited ENV is their only version source.
ARG OPENCV_VERSION
ARG OPENCV_OUTPUT_DIR=/opt/opencv5
ARG ONNXRUNTIME_OUTPUT_DIR=/usr/local/lib/onnxruntime-cpu
ARG ONNXRUNTIME_GENAI_OUTPUT_DIR=/usr/local/lib/onnxruntime-genai
ARG LITERT_OUTPUT_DIR=/usr/local
ARG GSTREAMER_PREFIX=/opt/gstreamer
ARG FFMPEG_PREFIX=/opt/ffmpeg
ARG LIBCAMERA_PREFIX=/opt/libcamera
ARG GCC_VERSION=16.2.0
ARG PYTHON_VERSION=3.14.8
# Derived; an empty PYTHON_VERSION falls through to the :-3.14 defaults below.
ARG PYTHON_MAJOR_MINOR=${PYTHON_VERSION%.*}

ENV GSTREAMER_VERSION=${GSTREAMER_VERSION} \
    OPENCV_VERSION=${OPENCV_VERSION} \
    GSTREAMER_PREFIX=${GSTREAMER_PREFIX} \
    GST_PLUGIN_PATH="" \
    GI_TYPELIB_PATH="" \
    OPENCV_PREFIX=${OPENCV_OUTPUT_DIR} \
    FFMPEG_PREFIX=/opt/ffmpeg \
    LIBCAMERA_PREFIX=/opt/libcamera \
    GCC_VERSION=${GCC_VERSION:-16.2.0} \
    PYTHON_MAJOR_MINOR=${PYTHON_MAJOR_MINOR:-3.14} \
    PYTHONPATH="${OPENCV_OUTPUT_DIR}/lib/python${PYTHON_MAJOR_MINOR:-3.14}/site-packages:${PYTHONPATH}"

COPY --link --from=onnxruntime /usr/local/lib/onnxruntime-gpu /usr/local/lib/onnxruntime-gpu

COPY --link --from=litert ${LITERT_OUTPUT_DIR}/wheels /opt/litert-wheels
COPY --link --from=litert /usr/local/lib/litert-web /usr/local/lib/litert-web
COPY --link --from=litert /usr/local/lib/litert-lm-web /usr/local/lib/litert-lm-web
COPY --link --from=onnxruntime /usr/local/lib/onnxruntime-web /usr/local/lib/onnxruntime-web
COPY --link --from=app-wheelhouse /opt/app-wheels /opt/app-wheels
# The cp314t twins travel beside the GIL wheels into a store of their own: docs/consumer-image-contract.md#the-free-threaded-wheels
COPY --link --from=app-wheelhouse /opt/app-wheels-cp314t /opt/app-wheels-cp314t
# Dir-to-dir COPYs tolerate the empty (skipped or failed) TVM build.
COPY --link --from=tvm /opt/tvm/wheels /opt/tvm-wheels
COPY --link --from=tvm /opt/tvm/wheels-cp314t /opt/tvm-wheels-cp314t
COPY --link --from=tvm /opt/tvm/lib/ /usr/local/lib/
# collect-artifacts.sh keeps wheels already in /opt/wheels, so PyAV joins the normal repair/verify path.
COPY --link --from=pyav /opt/pyav/wheels /opt/wheels
COPY --link --from=pyav /opt/pyav/wheels-cp314t /opt/wheels-cp314t
# Must follow the media-inputs tree: the pass-2 OpenCV replaces pass 1.
COPY --link --from=opencv-gst ${OPENCV_OUTPUT_DIR} ${OPENCV_OUTPUT_DIR}
COPY --link --from=gstreamer ${GSTREAMER_PREFIX} ${GSTREAMER_PREFIX}
COPY --link --from=gstreamer /usr/local/lib/libvvdec* /usr/local/lib/
# The libvvdec* glob above does not reach the pkgconfig/ subdir.
COPY --link --from=gstreamer /usr/local/lib/pkgconfig/libvvdec.pc /usr/local/lib/pkgconfig/libvvdec.pc
# Best-effort rice-proto rides ${GSTREAMER_PREFIX}/lib; a hard COPY of it would fail when skipped.
COPY --link --from=libcamera /opt/libcamera /opt/libcamera

COPY --chmod=755 linux/scripts/03-media/runtime /opt/scripts/03-media/runtime
COPY --chmod=755 linux/scripts/06-packaging/smoke-common.sh /opt/scripts/packaging/smoke-common.sh
COPY --chmod=755 linux/scripts/06-packaging/smoke-media.sh /opt/scripts/packaging/smoke-media.sh

RUN --mount=type=bind,source=linux/scripts/03-media/runtime,target=/opt/scripts/03-media/runtime,readonly \
    --mount=type=bind,source=linux/scripts/03-media/free-threaded-wheels.sh,target=/opt/scripts/03-media/free-threaded-wheels.sh,readonly \
    --mount=type=bind,source=linux/scripts/03-media/free-threaded-twins.txt,target=/opt/scripts/03-media/free-threaded-twins.txt,readonly \
    --mount=type=bind,source=linux/scripts/02-toolchain/python/free-threaded-wheel.py,target=/opt/scripts/03-media/free-threaded-wheel.py,readonly \
    --mount=type=bind,source=linux/scripts/01-core,target=/opt/scripts/core,readonly \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    source /opt/scripts/03-media/runtime/media-env.sh; \
    bash /opt/scripts/03-media/runtime/collect-artifacts.sh && \
    bash /opt/scripts/03-media/runtime/install-deps.sh && \
    bash /opt/scripts/03-media/runtime/configure-runtime.sh && \
    bash /opt/scripts/03-media/runtime/repair-wheels.sh && \
    bash /opt/scripts/03-media/runtime/verify-wheels.sh && \
    bash /opt/scripts/03-media/runtime/repair-wheels.sh --free-threaded && \
    bash /opt/scripts/03-media/runtime/verify-wheels.sh --free-threaded && \
    bash /opt/scripts/03-media/runtime/free-threaded-store.sh && \
    { uv pip install --no-deps /opt/wheels/*.whl || { [ "${TARGET_ARCH:-amd64}" != "amd64" ] || { echo "ERROR: uv pip install of collected wheels failed on amd64 — native wheels must install" >&2; exit 1; }; echo "WARNING: uv pip install of collected wheels failed (tolerated for cross-arch ${TARGET_ARCH} wheels)" >&2; }; } && \
    bash /opt/scripts/03-media/runtime/validate-media-runtime.sh && \
    PYTHONPATH="$(echo /opt/opencv5/lib/python*/site-packages 2>/dev/null):${PYTHONPATH:-}" \
    bash /opt/scripts/packaging/smoke-media.sh

# Keep in sync with linux/scripts/03-media/runtime/media-env.sh (canonical definition).
ENV PATH="${GSTREAMER_PREFIX}/bin:${OPENCV_PREFIX}/bin:${LIBCAMERA_PREFIX}/bin:${FFMPEG_PREFIX}/bin:/usr/local/bin:${PATH}" \
    PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${GSTREAMER_PREFIX}/lib/multiarch/pkgconfig:${OPENCV_PREFIX}/lib/pkgconfig:${LIBCAMERA_PREFIX}/lib/pkgconfig:${LIBCAMERA_PREFIX}/lib64/pkgconfig:${FFMPEG_PREFIX}/lib/pkgconfig" \
    LD_LIBRARY_PATH="/opt/gcc-${GCC_VERSION}/lib64:/opt/gcc-${GCC_VERSION}/lib:/usr/local/lib:${GSTREAMER_PREFIX}/lib/multiarch:${GSTREAMER_PREFIX}/lib:${OPENCV_PREFIX}/lib:${OPENCV_PREFIX}/lib64:${LIBCAMERA_PREFIX}/lib:${LIBCAMERA_PREFIX}/lib64:${FFMPEG_PREFIX}/lib:${FFMPEG_PREFIX}/lib64:${LD_LIBRARY_PATH}" \
    GDK_BACKEND="x11" \
    GST_PLUGIN_PATH="${GSTREAMER_PREFIX}/lib/multiarch/gstreamer-1.0:${LIBCAMERA_PREFIX}/lib/gstreamer-1.0" \
    GI_TYPELIB_PATH="${GSTREAMER_PREFIX}/lib/multiarch/girepository-1.0"

# Empty unless ENABLE_DEEPSTREAM=true; last, so a DeepStream change re-runs nothing above it.
COPY --link --from=deepstream /opt/nvidia /opt/nvidia

LABEL org.opencontainers.image.title="Kataglyphis Media" \
      org.opencontainers.image.description="Media libraries layer with ONNX Runtime, LiteRT, OpenCV, GStreamer, FFmpeg, and libcamera"
