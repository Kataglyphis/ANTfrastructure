# syntax=docker/dockerfile:1.24.0

# Global Version Arguments (safety-net defaults; orchestrator passes canonical values from versions.env)
ARG ONNXRUNTIME_VERSION="v1.26.0"
ARG ONNXRUNTIME_GENAI_VERSION="v0.13.1"
ARG LITERT_VERSION="v2.1.5"
ARG OPENCV_VERSION="5.x"
ARG GSTREAMER_VERSION="1.29.1"

# Build Acceleration Arguments
# Set AGGRESSIVE_PARALLELISM=true for faster builds on high-memory machines (32GB+)
# Set USE_LLD=false to disable lld linker
# Set USE_CCACHE=false to disable ccache
ARG AGGRESSIVE_PARALLELISM=false
ARG USE_LLD=true
ARG USE_CCACHE=true
ARG USE_SCCACHE=true

# Stage dependency DAG — BuildKit parallelizes independent stages automatically:
#
#   base ─┬─ onnxruntime ───────┐
#         ├─ litert ────────────┤
#         ├─ opencv ────────────┼─ media-inputs ─ gstreamer ─ libcamera ─ final
#         ├─ ffmpeg ────────────┤
#         └─ app-wheelhouse ────┘
#
# Stages are ordered by dependency. gstreamer depends on media-inputs
# which collects everything from onnxruntime/litert/opencv/ffmpeg.
# libcamera depends on gstreamer. final collectly everything.

# ==============================================================================
# Base stage - common setup
# ==============================================================================
ARG BASE_IMAGE=local/kataglyphis:sdk
FROM ${BASE_IMAGE} AS base

SHELL ["bash", "-lc"]

ARG BUILD_MODE=native
ARG TARGET_ARCH
ARG TARGETARCH
ARG TARGETPLATFORM
ARG BUILDARCH
ARG BUILDPLATFORM
ARG ENABLE_NVIDIA=false
ARG ENABLE_AMD=false
ARG AGGRESSIVE_PARALLELISM
ARG USE_LLD
ARG USE_CCACHE
ARG USE_SCCACHE
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL

ENV ENABLE_NVIDIA=${ENABLE_NVIDIA} \
    ENABLE_AMD=${ENABLE_AMD} \
    BUILD_MODE=${BUILD_MODE} \
    TARGET_ARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETPLATFORM=${TARGETPLATFORM} \
    BUILDARCH=${BUILDARCH} \
    BUILDPLATFORM=${BUILDPLATFORM} \
    AGGRESSIVE_PARALLELISM=${AGGRESSIVE_PARALLELISM} \
    USE_LLD=${USE_LLD} \
    USE_CCACHE=${USE_CCACHE} \
    USE_SCCACHE=${USE_SCCACHE}

# Core build scripts (compiler-cache, parallelism helpers) are inherited from
# the compiler base image via the SDK layer.
COPY --chmod=755 linux/scripts/03-media/activate-cross-python.sh /opt/scripts/media/activate-cross-python.sh

RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    bash /tmp/core-scripts/use-fast-ubuntu-mirror.sh; \
    if [ "${ENABLE_NVIDIA}" = "true" ]; then \
        printf '%s\n' 'export NVIDIA_CODEC_HEADERS=yes' > /etc/profile.d/nvidia-codec-headers.sh; \
    fi

# Python virtual environment (/opt/python/.venv) and core build tooling
# (wheel, setuptools, numpy, meson, ninja, cmake, packaging) are baked
# into the compiler base image.

RUN set -euo pipefail; bash /opt/scripts/media/activate-cross-python.sh

ENV NVIDIA_CODEC_HEADERS=auto

# VIRTUAL_ENV, PATH, UV_PYTHON, and MEDIA_HOST_PYTHON are inherited from
# the compiler base image (baked into Dockerfile.toolchain).

# ==============================================================================
# ONNX Runtime stage
# ==============================================================================
FROM base AS onnxruntime

ARG ONNXRUNTIME_VERSION
ARG ONNXRUNTIME_NATIVE_BUILD_TYPE=Release
ARG ONNXRUNTIME_WASM_BUILD_TYPE=Release
ARG ONNXRUNTIME_GENAI_VERSION
ARG ONNXRUNTIME_GENAI_BUILD_TYPE=Release
ARG BUILD_GENAI=true
ARG ONNXRUNTIME_OUTPUT_DIR=/usr/local/lib/onnxruntime-cpu
ARG ONNXRUNTIME_GENAI_OUTPUT_DIR=/usr/local/lib/onnxruntime-genai

ENV NATIVE_CPU_OUTPUT_DIR=${ONNXRUNTIME_OUTPUT_DIR} \
    GENAI_OUTPUT_DIR=${ONNXRUNTIME_GENAI_OUTPUT_DIR} \
    ORT_VERSION=${ONNXRUNTIME_VERSION} \
    NATIVE_CPU_CONFIG=${ONNXRUNTIME_NATIVE_BUILD_TYPE} \
    WASM_CONFIG=${ONNXRUNTIME_WASM_BUILD_TYPE} \
    GENAI_VERSION=${ONNXRUNTIME_GENAI_VERSION} \
    GENAI_CONFIG=${ONNXRUNTIME_GENAI_BUILD_TYPE} \
    BUILD_GENAI=${BUILD_GENAI}

COPY --chmod=755 linux/scripts/03-media/onnxruntime/build /opt/scripts/media/onnxruntime/build

# deps + fetch combined: both are fast IO-bound operations
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
        --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
        --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
        --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
        set -euo pipefail; \
    SKIP_DEP_INSTALL=true bash /opt/scripts/media/onnxruntime/build/build-onnxruntime.sh --step deps && \
    bash /opt/scripts/media/onnxruntime/build/build-onnxruntime.sh --step fetch

RUN --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
        --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
        --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-${TARGETARCH} \
        --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git-${TARGETARCH} \
        set -euo pipefail; \
        bash /opt/scripts/media/onnxruntime/build/build-onnxruntime.sh \
            --step cpu

RUN --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
        --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
        --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-${TARGETARCH} \
        --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git-${TARGETARCH} \
        set -euo pipefail; \
        if [ "${ENABLE_NVIDIA}" = "true" ] || [ "${ENABLE_AMD}" = "true" ]; then \
            bash /opt/scripts/media/onnxruntime/build/build-onnxruntime.sh \
                --step gpu; \
        else \
            echo "Skipping ONNX GPU build (ENABLE_NVIDIA=${ENABLE_NVIDIA:-false}, ENABLE_AMD=${ENABLE_AMD:-false})"; \
        fi

RUN --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
        --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
        --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
        --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
        set -euo pipefail; \
        bash /opt/scripts/media/onnxruntime/build/build-onnxruntime.sh \
            --step genai

# wasm + js + pkgconfig combined: wasm uses uv/pip for dependencies
COPY --chmod=755 linux/scripts/03-media/onnxruntime/runtime /opt/scripts/media/onnxruntime/runtime
RUN --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
    set -euo pipefail; \
        bash /opt/scripts/media/onnxruntime/build/build-onnxruntime.sh --step wasm; \
        bash /opt/scripts/media/onnxruntime/build/build-onnxruntime.sh --step js; \
        bash /opt/scripts/media/onnxruntime/build/build-onnxruntime.sh --step pkgconfig

# ==============================================================================
# LiteRT stage
# ==============================================================================
FROM base AS litert

ARG LITERT_VERSION
ARG LITERT_BUILD_TYPE=Release
ARG LITERT_OUTPUT_DIR=/usr/local

COPY --chmod=755 linux/scripts/03-media/litert /opt/scripts/media/litert

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    bash /opt/scripts/media/litert/install-deps.sh

RUN --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    set -euo pipefail; \
    bash /opt/scripts/media/litert/build-litert.sh "${LITERT_VERSION}"

# ==============================================================================
# OpenCV stage
# ==============================================================================
FROM base AS opencv

ARG OPENCV_VERSION
ARG OPENCV_BUILD_TYPE=Release
ARG OPENCV_WITH_CONTRIB=true
ARG OPENCV_WITH_PYTHON=true
ARG OPENCV_OUTPUT_DIR=/opt/opencv5

ENV OPENCV_PREFIX=${OPENCV_OUTPUT_DIR}
ENV PKG_CONFIG_PATH="${OPENCV_PREFIX}/lib/pkgconfig:${PKG_CONFIG_PATH}"

COPY --chmod=755 linux/scripts/03-media/opencv /opt/scripts/media/opencv

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    bash /opt/scripts/media/opencv/install-deps.sh

RUN --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    set -euo pipefail; \
    bash /opt/scripts/media/opencv/build-opencv.sh \
        --opencv-version "${OPENCV_VERSION}" \
        --prefix "${OPENCV_OUTPUT_DIR}" \
        --build-type "${OPENCV_BUILD_TYPE}" \
        --with-contrib "${OPENCV_WITH_CONTRIB}" \
        --with-python "${OPENCV_WITH_PYTHON}" \
        --skip-dep-install

# ==============================================================================
# App wheelhouse stage (best-effort riscv64 cross-only)
# ==============================================================================
FROM base AS app-wheelhouse

COPY --chmod=755 linux/scripts/05-frameworks/torch /opt/scripts/frameworks/torch

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
    --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-${TARGETARCH} \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    set -euo pipefail; \
    bash /opt/scripts/frameworks/torch/build-app-wheelhouse.sh

# ==============================================================================
# FFmpeg stage
# ==============================================================================
FROM base AS ffmpeg

COPY --chmod=755 linux/scripts/03-media/ffmpeg/ /opt/scripts/media/ffmpeg/

ENV FFMPEG_PREFIX=/opt/ffmpeg

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    bash /opt/scripts/media/ffmpeg/install-deps.sh

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    cd /opt; \
    bash /opt/scripts/media/ffmpeg/build-ffmpeg.sh

# ==============================================================================
# Shared media build inputs stage
# ==============================================================================
FROM base AS media-inputs

ARG ONNXRUNTIME_OUTPUT_DIR=/usr/local/lib/onnxruntime-cpu
ARG ONNXRUNTIME_GENAI_OUTPUT_DIR=/usr/local/lib/onnxruntime-genai
ARG LITERT_OUTPUT_DIR=/usr/local
ARG OPENCV_OUTPUT_DIR=/opt/opencv5

ENV NATIVE_CPU_OUTPUT_DIR=${ONNXRUNTIME_OUTPUT_DIR} \
    FFMPEG_PREFIX=/opt/ffmpeg \
    PKG_CONFIG_PATH="/opt/ffmpeg/lib/pkgconfig:${OPENCV_OUTPUT_DIR}/lib/pkgconfig:${LITERT_OUTPUT_DIR}/lib/pkgconfig:${ONNXRUNTIME_OUTPUT_DIR}/runtime/lib/pkgconfig${PKG_CONFIG_PATH:+:${PKG_CONFIG_PATH}}" \
    LD_LIBRARY_PATH="/opt/ffmpeg/lib:${OPENCV_OUTPUT_DIR}/lib:${LITERT_OUTPUT_DIR}/lib:${ONNXRUNTIME_OUTPUT_DIR}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
    LIBRARY_PATH="/opt/ffmpeg/lib:${LITERT_OUTPUT_DIR}/lib:${OPENCV_OUTPUT_DIR}/lib:${ONNXRUNTIME_OUTPUT_DIR}/lib${LIBRARY_PATH:+:${LIBRARY_PATH}}"

COPY --from=onnxruntime ${ONNXRUNTIME_OUTPUT_DIR} ${ONNXRUNTIME_OUTPUT_DIR}
COPY --from=onnxruntime ${ONNXRUNTIME_GENAI_OUTPUT_DIR} ${ONNXRUNTIME_GENAI_OUTPUT_DIR}
COPY --from=litert ${LITERT_OUTPUT_DIR}/include ${LITERT_OUTPUT_DIR}/include
COPY --from=litert ${LITERT_OUTPUT_DIR}/lib ${LITERT_OUTPUT_DIR}/lib
COPY --from=opencv ${OPENCV_OUTPUT_DIR} ${OPENCV_OUTPUT_DIR}
COPY --from=ffmpeg /opt/ffmpeg /opt/ffmpeg



# ==============================================================================
# GStreamer stage (depends on onnxruntime + litert)
# ==============================================================================
FROM media-inputs AS gstreamer

ARG GSTREAMER_VERSION
ARG BUILD_TYPE=Release
ARG GSTREAMER_PREFIX=/opt/gstreamer
ARG TARGET_ARCH
ARG BUILD_MODE

ENV GSTREAMER_PREFIX=${GSTREAMER_PREFIX} \
    GSTREAMER_VERSION=${GSTREAMER_VERSION} \
    CSOUND_LIB_DIR=/usr/lib \
    PATH="${GSTREAMER_PREFIX}/bin:${PATH}" \
    BUILD_MODE=${BUILD_MODE} \
    TARGET_ARCH=${TARGET_ARCH}

COPY --chmod=755 linux/scripts/03-media/gstreamer /opt/scripts/media/gstreamer
COPY --chmod=755 linux/scripts/04-runtime/gstreamer-env.sh /usr/local/bin/gstreamer-env.sh

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    bash /opt/scripts/media/gstreamer/install-deps.sh

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    if [ "${BUILD_MODE}" = "cross" ] && [ "${TARGET_ARCH}" != "amd64" ]; then \
        export CFLAGS="${CFLAGS:-} -D_LIBCPP_VERSION=20220101"; \
        export CXXFLAGS="${CXXFLAGS:-} -D_LIBCPP_VERSION=20220101"; \
    fi; \
    bash /opt/scripts/media/gstreamer/common/build-gstreamer-stage.sh \
        "$GSTREAMER_VERSION" \
        "$GSTREAMER_PREFIX" \
        "$BUILD_TYPE"

# ==============================================================================
# libcamera stage
# ==============================================================================
FROM gstreamer AS libcamera

ARG GSTREAMER_PREFIX

ENV GSTREAMER_PREFIX=${GSTREAMER_PREFIX}

COPY --chmod=755 linux/scripts/03-media/libcamera/ /opt/scripts/media/libcamera/

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    bash /opt/scripts/media/libcamera/install-deps.sh

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
    --mount=type=cache,target=/usr/local/cargo/registry,id=cargo-registry-${TARGETARCH} \
    --mount=type=cache,target=/usr/local/cargo/git,id=cargo-git-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    set -euo pipefail; \
    cd /opt; \
    bash /opt/scripts/media/libcamera/build-libcamera.sh

# ==============================================================================
# Final stage - combine all artifacts while keeping runtime inputs selective.
# ==============================================================================
FROM base AS final

ARG GSTREAMER_VERSION
ARG OPENCV_OUTPUT_DIR=/opt/opencv5
ARG ONNXRUNTIME_OUTPUT_DIR=/usr/local/lib/onnxruntime-cpu
ARG ONNXRUNTIME_GENAI_OUTPUT_DIR=/usr/local/lib/onnxruntime-genai
ARG LITERT_OUTPUT_DIR=/usr/local
ARG GSTREAMER_PREFIX=/opt/gstreamer

ENV GSTREAMER_VERSION=${GSTREAMER_VERSION} \
    GSTREAMER_PREFIX=${GSTREAMER_PREFIX} \
    GST_PLUGIN_PATH="" \
    GI_TYPELIB_PATH="" \
    OPENCV_PREFIX=${OPENCV_OUTPUT_DIR} \
    FFMPEG_PREFIX=/opt/ffmpeg \
    LIBCAMERA_PREFIX=/opt/libcamera

COPY --from=onnxruntime ${ONNXRUNTIME_OUTPUT_DIR} ${ONNXRUNTIME_OUTPUT_DIR}
COPY --from=onnxruntime ${ONNXRUNTIME_GENAI_OUTPUT_DIR} ${ONNXRUNTIME_GENAI_OUTPUT_DIR}
COPY --from=onnxruntime /usr/local/lib/onnxruntime-gpu /usr/local/lib/onnxruntime-gpu

COPY --from=litert ${LITERT_OUTPUT_DIR}/lib/pkgconfig ${LITERT_OUTPUT_DIR}/lib/pkgconfig
COPY --from=litert ${LITERT_OUTPUT_DIR}/lib/liblite* ${LITERT_OUTPUT_DIR}/lib/
COPY --from=litert ${LITERT_OUTPUT_DIR}/lib/libtensor* ${LITERT_OUTPUT_DIR}/lib/
COPY --from=litert ${LITERT_OUTPUT_DIR}/include /usr/local/include
COPY --from=litert ${LITERT_OUTPUT_DIR}/wheels /opt/litert-wheels
COPY --from=app-wheelhouse /opt/app-wheels /opt/app-wheels
COPY --from=opencv ${OPENCV_OUTPUT_DIR} ${OPENCV_OUTPUT_DIR}
COPY --from=ffmpeg /opt/ffmpeg /opt/ffmpeg
COPY --from=gstreamer ${GSTREAMER_PREFIX} ${GSTREAMER_PREFIX}
COPY --from=gstreamer /usr/local/lib/libvvdec* /usr/local/lib/
COPY --from=libcamera /opt/libcamera /opt/libcamera
COPY --chmod=755 linux/scripts/03-media/final /opt/scripts/media/final

RUN set -euo pipefail; \
    bash /opt/scripts/media/final/collect-artifacts.sh

ENV PATH="${GSTREAMER_PREFIX}/bin:${OPENCV_PREFIX}/bin:${LIBCAMERA_PREFIX}/bin:${FFMPEG_PREFIX}/bin:/usr/local/bin:${PATH}" \
    PKG_CONFIG_PATH="/usr/local/lib/pkgconfig:${GSTREAMER_PREFIX}/lib/multiarch/pkgconfig:${OPENCV_PREFIX}/lib/pkgconfig:${LIBCAMERA_PREFIX}/lib/pkgconfig:${LIBCAMERA_PREFIX}/lib64/pkgconfig:${FFMPEG_PREFIX}/lib/pkgconfig" \
    LD_LIBRARY_PATH="/usr/local/lib:${GSTREAMER_PREFIX}/lib/multiarch:${GSTREAMER_PREFIX}/lib:${OPENCV_PREFIX}/lib:${OPENCV_PREFIX}/lib64:${LIBCAMERA_PREFIX}/lib:${LIBCAMERA_PREFIX}/lib64:${FFMPEG_PREFIX}/lib:${FFMPEG_PREFIX}/lib64:${LD_LIBRARY_PATH}" \
    GDK_BACKEND="x11" \
    GST_PLUGIN_PATH="${GSTREAMER_PREFIX}/lib/multiarch/gstreamer-1.0:${LIBCAMERA_PREFIX}/lib/gstreamer-1.0" \
    GI_TYPELIB_PATH="${GSTREAMER_PREFIX}/lib/multiarch/girepository-1.0"

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    set -euo pipefail; \
    bash /opt/scripts/media/final/install-deps.sh && \
    bash /opt/scripts/media/final/configure-runtime.sh && \
    bash /opt/scripts/media/final/repair-wheels.sh && \
    bash /opt/scripts/media/final/verify-wheels.sh && \
    bash /opt/scripts/media/final/validate-media-runtime.sh

LABEL org.opencontainers.image.title="Kataglyphis Media" \
      org.opencontainers.image.description="Media libraries layer with ONNX Runtime, LiteRT, OpenCV, GStreamer, FFmpeg, and libcamera"
