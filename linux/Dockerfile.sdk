# syntax=docker/dockerfile:1.19

ARG BASE_IMAGE=local/kataglyphis:compiler

# Build ONNX Runtime / ONNX Runtime GenAI in an isolated, cacheable stage.
# This stage is intentionally narrow in its inputs (only the ONNX build scripts)
# so that unrelated changes (GStreamer, Vulkan, etc.) do not invalidate its cache.
FROM ${BASE_IMAGE} AS ai-sdks

# ONNX build args (scoped to the ai-sdks stage)
ARG ONNXRUNTIME_VERSION=v1.24.4
ARG ONNXRUNTIME_NATIVE_BUILD_TYPE=Release
ARG ONNXRUNTIME_WASM_BUILD_TYPE=Release
ARG ONNXRUNTIME_GENAI_VERSION=v0.12.1
ARG ONNXRUNTIME_GENAI_BUILD_TYPE=Release
ARG BUILD_GENAI=true
ARG ONNXRUNTIME_OUTPUT_DIR=/usr/local/lib/onnxruntime-cpu
ARG ONNXRUNTIME_GENAI_OUTPUT_DIR=/usr/local/lib/onnxruntime-genai
ENV NATIVE_CPU_OUTPUT_DIR=${ONNXRUNTIME_OUTPUT_DIR}
ENV GENAI_OUTPUT_DIR=${ONNXRUNTIME_GENAI_OUTPUT_DIR}

ARG OPENCV_VERSION=4.13.0
ARG OPENCV_BUILD_TYPE=Release
ARG OPENCV_WITH_CONTRIB=true
ARG OPENCV_WITH_PYTHON=true
ARG OPENCV_OUTPUT_DIR=/opt/opencv4
ENV OPENCV_OUTPUT_DIR=${OPENCV_OUTPUT_DIR}

SHELL ["bash", "-lc"]

# Copy only the minimal ONNX build scripts and tools required for building.
COPY --chmod=+x linux/scripts/03-media/onnxruntime/build /opt/scripts/media/onnxruntime/build
COPY --chmod=+x linux/scripts/03-media/opencv /opt/scripts/media/opencv

# Install ONNX deps (apt), fetch sources, and perform the heavy builds.
# Use cache mounts to preserve apt, pip, ccache, sccache and cargo caches between builds.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    export USER=root; \
    SKIP_DEP_INSTALL=true bash /opt/scripts/media/onnxruntime/build/10-deps.sh \
        --ort-version "${ONNXRUNTIME_VERSION}" \
        --build-type "${ONNXRUNTIME_NATIVE_BUILD_TYPE}" \
        --wasm-config "${ONNXRUNTIME_WASM_BUILD_TYPE}"

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.cache/pip \
    set -eux; \
    export USER=root; \
    bash /opt/scripts/media/onnxruntime/build/20-fetch.sh \
        --ort-version "${ONNXRUNTIME_VERSION}" \
        --build-type "${ONNXRUNTIME_NATIVE_BUILD_TYPE}" \
        --wasm-config "${ONNXRUNTIME_WASM_BUILD_TYPE}"

RUN --mount=type=cache,target=/var/cache/ccache \
    --mount=type=cache,target=/var/cache/sccache \
    --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    set -eux; \
    export USER=root; \
    bash /opt/scripts/media/onnxruntime/build/30-build-native.sh \
        --ort-version "${ONNXRUNTIME_VERSION}" \
        --build-type "${ONNXRUNTIME_NATIVE_BUILD_TYPE}" \
        --wasm-config "${ONNXRUNTIME_WASM_BUILD_TYPE}"

# Verify ONNX Runtime native build artifacts exist
RUN set -eux; \
    lib_dir="${NATIVE_CPU_OUTPUT_DIR}/lib"; \
    if [ ! -d "${lib_dir}" ]; then \
        echo "ERROR: ONNX Runtime lib directory not found: ${lib_dir}"; \
        exit 1; \
    fi; \
    if [ -z "$(ls -A ${lib_dir}/*.so* 2>/dev/null)" ]; then \
        echo "ERROR: No .so files found in ${lib_dir}"; \
        ls -la "${lib_dir}" || true; \
        exit 1; \
    fi; \
    echo "ONNX Runtime native build verified:"; \
    ls -la "${lib_dir}"

# GenAI and WASM/JS builds
RUN --mount=type=cache,target=/var/cache/ccache \
    --mount=type=cache,target=/var/cache/sccache \
    --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/root/.cache/pip \
    set -eux; \
    export USER=root; \
    BUILD_GENAI="${BUILD_GENAI}" \
    bash /opt/scripts/media/onnxruntime/build/60-build-genai.sh \
        --ort-version "${ONNXRUNTIME_VERSION}" \
        --build-type "${ONNXRUNTIME_NATIVE_BUILD_TYPE}" \
        --genai-version "${ONNXRUNTIME_GENAI_VERSION}" \
        --genai-config "${ONNXRUNTIME_GENAI_BUILD_TYPE}"

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt \
    set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        pkg-config \
        wget \
        unzip \
        libtbb-dev \
        libeigen3-dev \
        libgtk-3-dev \
        libavcodec-dev \
        libavformat-dev \
        libswscale-dev \
        libv4l-dev \
        libxvidcore-dev \
        libx264-dev \
        libjpeg-dev \
        libpng-dev \
        libtiff-dev \
        libopenexr-dev \
        libgstreamer1.0-dev \
        libgstreamer-plugins-base1.0-dev \
        libdc1394-dev \
        python3-dev \
        python3-numpy \
        python3-pip; \
    rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/var/cache/ccache \
    --mount=type=cache,target=/var/cache/sccache \
    set -eux; \
    export USER=root; \
    bash /opt/scripts/media/opencv/build-opencv.sh \
        --opencv-version "${OPENCV_VERSION}" \
        --prefix "${OPENCV_OUTPUT_DIR}" \
        --build-type "${OPENCV_BUILD_TYPE}" \
        --with-contrib "${OPENCV_WITH_CONTRIB}" \
        --with-python "${OPENCV_WITH_PYTHON}" \
        --skip-dep-install

RUN --mount=type=cache,target=/var/cache/ccache \
    --mount=type=cache,target=/var/cache/sccache \
    set -eux; \
    export USER=root; \
    bash /opt/scripts/media/onnxruntime/build/40-build-wasm.sh \
        --ort-version "${ONNXRUNTIME_VERSION}" \
        --build-type "${ONNXRUNTIME_NATIVE_BUILD_TYPE}" \
        --wasm-config "${ONNXRUNTIME_WASM_BUILD_TYPE}"

RUN set -eux; \
    export USER=root; \
    bash /opt/scripts/media/onnxruntime/build/50-build-js.sh \
        --ort-version "${ONNXRUNTIME_VERSION}" \
        --build-type "${ONNXRUNTIME_NATIVE_BUILD_TYPE}" \
        --wasm-config "${ONNXRUNTIME_WASM_BUILD_TYPE}"

# Leave artifacts in the expected output directories (/usr/local/lib/onnxruntime-*)

### End ai-sdks stage

FROM ${BASE_IMAGE}

ARG BUILD_TYPE=Release
ARG VULKAN_VERSION=1.4.341.1
ARG TARGETARCH
ARG TARGETPLATFORM

LABEL org.opencontainers.image.title="Kataglyphis SDK"
LABEL org.opencontainers.image.description="SDK layer with Vulkan on top of compiler toolchain"

SHELL ["bash", "-lc"]

# ------------------------------------------------------------------------------
# Vulkan SDK setup
# ------------------------------------------------------------------------------

# Copy ONNX artifacts built in the ai-sdks stage into the SDK image.
# This creates a standalone layer containing only ONNX build outputs that
# BuildKit can cache independently from later framework work.
COPY --from=ai-sdks /usr/local/lib/onnxruntime-cpu /usr/local/lib/onnxruntime-cpu
COPY --from=ai-sdks /usr/local/lib/onnxruntime-genai /usr/local/lib/onnxruntime-genai
COPY --from=ai-sdks /opt/opencv4 /opt/opencv4

# Copy the small runtime/pkg-config generator and run it here so it can pick
# up the ONNX artifacts we copied above. Keeping this step separate keeps the
# heavy ONNX builds isolated in ai-sdks while allowing small, frequent changes
# to runtime scripts without invalidating the ONNX build cache.
COPY --chmod=+x linux/scripts/03-media/onnxruntime/runtime /opt/scripts/media/onnxruntime/runtime
RUN chmod +x /opt/scripts/media/onnxruntime/runtime/*.sh || true
RUN set -eux; \
    export USER=root; \
    bash /opt/scripts/media/onnxruntime/runtime/31-generate-pkgconfig-native.sh \
        --ort-version "${ONNXRUNTIME_VERSION:-v1.24.4}" \
        --build-type "${ONNXRUNTIME_NATIVE_BUILD_TYPE:-Release}" \
        --wasm-config "${ONNXRUNTIME_WASM_BUILD_TYPE:-Release}"

ENV OPENCV_PREFIX=/opt/opencv4
ENV PATH="${OPENCV_PREFIX}/bin:${PATH}"
ENV PKG_CONFIG_PATH="${OPENCV_PREFIX}/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
ENV LD_LIBRARY_PATH="${OPENCV_PREFIX}/lib:${LD_LIBRARY_PATH:-}"

RUN set -eux; \
    printf "%s\n" "/opt/opencv4/lib" > /etc/ld.so.conf.d/opencv.conf; \
    ldconfig

# 5. VULKAN (Heavy Layer)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=tmpfs,target=/tmp \
    set -eux; \
    bash /opt/scripts/toolchain/setup-dependencies.sh --vulkan-version "${VULKAN_VERSION}" vulkan

# 6. VERIFICATION
RUN bash /opt/scripts/toolchain/setup-dependencies.sh verify

# ==============================================================================
# Frameworks; TVM
# ==============================================================================
COPY --chmod=+x linux/scripts/05-frameworks/ /opt/scripts/frameworks/

ARG TVM_REF=v0.22.0
ARG TVM_BUILD_TYPE=${BUILD_TYPE}
ARG TVM_USE_VULKAN=1
ARG TVM_INSTALL_PYTHON=1

ENV TVM_REF=${TVM_REF} \
    TVM_BUILD_TYPE=${TVM_BUILD_TYPE} \
    TVM_USE_VULKAN=${TVM_USE_VULKAN}

# Uncomment below to enable TVM build
# RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
#     --mount=type=cache,target=/var/lib/apt \
#     --mount=type=cache,target=/var/cache/ccache \
#     --mount=type=cache,target=/var/cache/sccache \
#     --mount=type=cache,target=/root/.cache/uv \
#     --mount=type=cache,target=/root/.cache/pip \
#     --mount=type=tmpfs,target=/tmp \
#     set -eux; \
#     arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
#     if [ "${TVM_INSTALL_PYTHON}" = "1" ]; then \
#         py_flag=""; \
#     else \
#         py_flag="--no-python"; \
#     fi; \
#     bash /opt/scripts/frameworks/tvm.sh \
#         --ref "${TVM_REF}" \
#         --build-type "${TVM_BUILD_TYPE}" \
#         ${py_flag}
