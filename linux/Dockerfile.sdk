# syntax=docker/dockerfile:1.19

ARG BASE_IMAGE=local/kataglyphis:compiler
FROM ${BASE_IMAGE}

ARG BUILD_TYPE=Release
ARG BUILD_MODE=native
ARG VULKAN_VERSION=1.4.341.1
ARG TARGET_ARCH
ARG TARGETARCH
ARG TARGETPLATFORM
ARG BUILDARCH
ARG BUILDPLATFORM
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/


SHELL ["bash", "-lc"]

ENV BUILD_MODE=${BUILD_MODE} \
    TARGET_ARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETPLATFORM=${TARGETPLATFORM} \
    BUILDARCH=${BUILDARCH} \
    BUILDPLATFORM=${BUILDPLATFORM}

RUN --mount=type=bind,source=linux/scripts/01-core/use-fast-ubuntu-mirror.sh,target=/tmp/use-fast-ubuntu-mirror.sh,ro \
    USE_FAST_UBUNTU_MIRROR="${USE_FAST_UBUNTU_MIRROR}" \
    FAST_UBUNTU_MIRROR_URL="${FAST_UBUNTU_MIRROR_URL}" \
    bash /tmp/use-fast-ubuntu-mirror.sh

COPY linux/scripts/01-core/ /opt/scripts/core/
COPY linux/scripts/02-toolchain/ /opt/scripts/toolchain/

# ------------------------------------------------------------------------------
# Vulkan SDK setup
# ------------------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -eux; \
    target_arch="${TARGET_ARCH}"; \
    if [ "${BUILD_MODE}" = "cross" ]; then \
        case "${target_arch}" in \
            *,*) \
                echo "TARGET_ARCH must be a single architecture for linux/Dockerfile.sdk: ${target_arch}" >&2; \
                echo "Use TARGET_ARCH=${target_arch} ./linux/scripts/build-sdk-artifacts.sh --fast-ubuntu-mirror, ./linux/scripts/build-sdk-artifacts.sh --target-arches ${target_arch}, or loop over one TARGET_ARCH per nerdctl build." >&2; \
                exit 1 ;; \
            x86_64) target_arch="amd64" ;; \
            aarch64) target_arch="arm64" ;; \
            riscv64|riscv|rv64*) target_arch="riscv64" ;; \
        esac; \
        export TARGET_ARCH="${target_arch}" TARGETARCH="${target_arch}" TARGETPLATFORM="linux/${target_arch}"; \
        case "${target_arch}" in \
            amd64) ;; \
            arm64) triplet="aarch64-linux-gnu" ;; \
            riscv64) triplet="riscv64-linux-gnu" ;; \
            *) \
                echo "Unsupported TARGET_ARCH=${target_arch}" >&2; \
                exit 1 ;; \
        esac; \
        if [ -n "${triplet:-}" ]; then \
            mkdir -p /opt/cross-bin; \
            ln -sf "$(command -v ${triplet}-gcc)" /opt/cross-bin/gcc; \
            ln -sf "$(command -v ${triplet}-g++)" /opt/cross-bin/g++; \
            ln -sf "$(command -v ${triplet}-gcc)" /opt/cross-bin/cc; \
            ln -sf "$(command -v ${triplet}-g++)" /opt/cross-bin/c++; \
            ln -sf "$(command -v ${triplet}-as)" /opt/cross-bin/as; \
            ln -sf "$(command -v ${triplet}-ld)" /opt/cross-bin/ld; \
            ln -sf "$(command -v ${triplet}-ar)" /opt/cross-bin/ar; \
            ln -sf "$(command -v ${triplet}-nm)" /opt/cross-bin/nm; \
            ln -sf "$(command -v ${triplet}-ranlib)" /opt/cross-bin/ranlib; \
            ln -sf "$(command -v ${triplet}-strip)" /opt/cross-bin/strip; \
            ln -sf "$(command -v ${triplet}-objcopy)" /opt/cross-bin/objcopy; \
            if command -v "clang-${target_arch}" >/dev/null 2>&1; then \
                ln -sf "$(command -v clang-${target_arch})" /opt/cross-bin/clang; \
            fi; \
            if command -v "clang++-${target_arch}" >/dev/null 2>&1; then \
                ln -sf "$(command -v clang++-${target_arch})" /opt/cross-bin/clang++; \
            fi; \
        fi; \
        source /opt/scripts/core/cross-env.sh; \
        setup_linux_cross_env; \
        bash /opt/scripts/toolchain/setup-dependencies.sh --arch "${target_arch}" --vulkan-version "${VULKAN_VERSION}" vulkan; \
    else \
        bash /opt/scripts/toolchain/setup-dependencies.sh --vulkan-version "${VULKAN_VERSION}" vulkan; \
    fi

# 6. VERIFICATION
RUN set -eux; \
    if [ "${BUILD_MODE}" = "cross" ]; then \
        bash /opt/scripts/toolchain/setup-dependencies.sh --arch "${TARGET_ARCH}" verify; \
    else \
        bash /opt/scripts/toolchain/setup-dependencies.sh verify; \
    fi

# ==============================================================================
# Frameworks; TVM
# ==============================================================================
COPY --chmod=+x linux/scripts/05-frameworks/ /opt/scripts/frameworks/

ARG TVM_REF=v0.23.0
ARG TVM_BUILD_TYPE=${BUILD_TYPE}
ARG TVM_USE_VULKAN=1
ARG TVM_INSTALL_PYTHON=1

ENV TVM_REF=${TVM_REF} \
    TVM_BUILD_TYPE=${TVM_BUILD_TYPE} \
    TVM_USE_VULKAN=${TVM_USE_VULKAN}

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/pip,id=pip-cache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -eux; \
    tvm_args=(--ref "${TVM_REF}" --build-type "${TVM_BUILD_TYPE}"); \
    if [ "${TVM_INSTALL_PYTHON}" != "1" ]; then \
        tvm_args+=(--no-python); \
    fi; \
    if [ "${BUILD_MODE}" = "cross" ]; then \
        source /opt/scripts/core/cross-env.sh; \
        setup_linux_cross_env; \
        llvm_config=""; \
        if [ -n "${LLVM_RELEASE:-}" ]; then \
            llvm_major="${LLVM_RELEASE%%.*}"; \
            if command -v "llvm-config-${llvm_major}" >/dev/null 2>&1; then \
                llvm_config="$(command -v llvm-config-${llvm_major})"; \
            elif [ -x "/usr/local/llvm-${llvm_major}/bin/llvm-config" ]; then \
                llvm_config="/usr/local/llvm-${llvm_major}/bin/llvm-config"; \
            elif [ -x "/usr/bin/llvm-config-${llvm_major}" ]; then \
                llvm_config="/usr/bin/llvm-config-${llvm_major}"; \
            fi; \
        fi; \
        if [ -z "${llvm_config}" ] && command -v llvm-config >/dev/null 2>&1; then \
            llvm_config="$(command -v llvm-config)"; \
        fi; \
        if [ -x "${llvm_config}" ]; then \
            tvm_args=(--llvm-config "${llvm_config}" "${tvm_args[@]}"); \
        else \
            echo "llvm-config from base toolchain image not found; continuing without LLVM in TVM cross mode" >&2; \
        fi; \
    fi; \
    bash /opt/scripts/frameworks/tvm.sh "${tvm_args[@]}"
LABEL org.opencontainers.image.title="Kataglyphis SDK"
LABEL org.opencontainers.image.description="SDK layer with Vulkan on top of compiler toolchain and the amd64-hosted cross artifact lane"
