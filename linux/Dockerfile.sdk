# syntax=docker/dockerfile:1.24.0

ARG BASE_IMAGE=local/kataglyphis:compiler
FROM ${BASE_IMAGE}

SHELL ["bash", "-lc"]

ARG BUILD_TYPE=Release
ARG BUILD_MODE=native
# Divide usable RAM by this in parallelism.sh so N concurrent per-arch builds
# (--parallel-archs) don't collectively overcommit the host. 1 = serial default.
ARG BUILD_MEM_DIVISOR=1
ARG VULKAN_VERSION=1.4.357.0
ARG LLVM_RELEASE=22.1.8
ARG TARGET_ARCH
ARG TARGETARCH
ARG TARGETPLATFORM
ARG BUILDARCH
ARG BUILDPLATFORM
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL


ENV BUILD_MODE=${BUILD_MODE} \
    BUILD_MEM_DIVISOR=${BUILD_MEM_DIVISOR} \
    TARGET_ARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETPLATFORM=${TARGETPLATFORM} \
    BUILDARCH=${BUILDARCH} \
    BUILDPLATFORM=${BUILDPLATFORM} \
    VULKAN_VERSION=${VULKAN_VERSION} \
    LLVM_RELEASE=${LLVM_RELEASE}
# Flutter is amd64+arm64 only (riscv64 is silently skipped by setup-flutter.sh).
# Only advertise FLUTTER_ROOT / prepend PATH on arches that actually install Flutter.
# NOTE: arm64 images carry the x86-64 Flutter SDK (no linux-arm64 upstream archive
# exists), so this advertisement does not imply a native arm64 Flutter toolchain.
RUN if [ "${TARGET_ARCH:-${TARGETARCH:-amd64}}" != "riscv64" ]; then \
      echo 'export PATH="/opt/flutter/bin:${PATH}"' >> /etc/profile.d/flutter.sh && \
      echo 'export FLUTTER_ROOT=/opt/flutter'        >> /etc/profile.d/flutter.sh ; \
    fi
# FLUTTER_ROOT / Flutter PATH are intentionally NOT in a global ENV because
# Flutter is riscv64-skipped. Login shells pick them up via /etc/profile.d on
# amd64/arm64 only (see RUN above), so on riscv64 the image honestly advertises
# "no Flutter" instead of pointing at a non-existent dir.
# Refresh the scripts the sdk stage's own RUNs execute from the build context,
# PER-FILE, each RUN's traced source closure placed directly above it (the
# Dockerfile.media per-file pattern). The compiler base bakes the whole
# 01-core/ + 02-toolchain/ trees (Dockerfile.toolchain), but that base can be
# OLDER than the current scripts (e.g. resuming the chain mid-way with a
# pinned compiler) — without a refresh, a fix to e.g. vulkan.sh would silently
# require a full compiler rebuild to take effect. The previous whole-dir COPYs
# refreshed ~100 files here, which put the long Vulkan RUN below (~14 min/arch,
# x3 arches) in the cache blast radius of EVERY file in those trees; only the
# closures below are executed by this stage. Non-closure files still exist in
# the image at the compiler base's version.
#
# platform.sh: sourced by the /opt/llvm-target RUN below for assert_elf_arch
# (it is also part of the setup-dependencies.sh closure further down).
COPY --chmod=755 linux/scripts/01-core/platform.sh /opt/scripts/core/platform.sh

# ------------------------------------------------------------------------------
# Materialize the per-arch native Clang at the canonical /opt/llvm-target.
# The SHARED compiler stage installs each cross target-clang into
# /opt/llvm-target-<arch> (a single fixed prefix would clobber across arches and
# leak one arch's clang into every image). Select THIS build's arch; amd64 is
# native so it ships the host LLVM as its target-native clang. Downstream
# (media/android/package) then inherits a correct, self-contained
# /opt/llvm-target for every arch — the package image COPYs it to
# /usr/local/llvm-target so each runtime ships its own native clang.
# ------------------------------------------------------------------------------
# DF2 (2026-08-18): the 86-line inline materialization moved to
# materialize-llvm-target.sh (comment-preserving home; logic verbatim).
COPY --chmod=755 linux/scripts/02-toolchain/materialize-llvm-target.sh /opt/scripts/toolchain/materialize-llvm-target.sh
RUN set -euo pipefail; \
    bash /opt/scripts/toolchain/materialize-llvm-target.sh; \
    rm -f /opt/scripts/toolchain/materialize-llvm-target.sh

# ------------------------------------------------------------------------------
# Vulkan SDK setup
# ------------------------------------------------------------------------------
# Transitive source closure of setup-dependencies.sh, shared by this vulkan RUN
# and the verify RUN below. setup-dependencies.sh loads modules.sh, then
# source_module's common/cross-env/repos/core/cmake/llvm/gcc/vulkan/verify
# UNCONDITIONALLY at file scope (before command dispatch), and those pull in
# the rest: common.sh → logging/platform/arch-mapping/ubuntu-mirror/downloads/
# parallelism + versions.env; cross-env.sh → its four cross-* siblings;
# llvm.sh → llvm-cross/llvm-validate; vulkan.sh → downloads + vulkan-env
# (standalone-source fallbacks). platform.sh is already COPY'd above. Editing
# any OTHER 01-core/02-toolchain file no longer re-runs this ~14-min RUN.
COPY --chmod=755 \
    linux/scripts/01-core/modules.sh \
    linux/scripts/01-core/common.sh \
    linux/scripts/01-core/load-versions-env.sh \
    linux/scripts/01-core/logging.sh \
    linux/scripts/01-core/arch-mapping.sh \
    linux/scripts/01-core/ubuntu-mirror.sh \
    linux/scripts/01-core/downloads.sh \
    linux/scripts/01-core/parallelism.sh \
    linux/scripts/01-core/cross-env.sh \
    linux/scripts/01-core/cross-gcc.sh \
    linux/scripts/01-core/cross-python.sh \
    linux/scripts/01-core/cross-apt.sh \
    linux/scripts/01-core/cross-meson.sh \
    linux/scripts/01-core/repos.sh \
    linux/scripts/01-core/verify.sh \
    linux/scripts/01-core/vulkan-env.sh \
    /opt/scripts/core/
# versions.env is DATA loaded by common.sh via load_versions_env — the Vulkan
# SDK sha pin (VULKAN_SDK_SHA256) and toolchain version majors come from it.
COPY --chmod=644 linux/scripts/01-core/versions.env /opt/scripts/core/versions.env
COPY --chmod=755 \
    linux/scripts/02-toolchain/setup-dependencies.sh \
    linux/scripts/02-toolchain/core.sh \
    linux/scripts/02-toolchain/cmake.sh \
    linux/scripts/02-toolchain/llvm.sh \
    linux/scripts/02-toolchain/llvm-cross.sh \
    linux/scripts/02-toolchain/llvm-validate.sh \
    linux/scripts/02-toolchain/gcc.sh \
    linux/scripts/02-toolchain/vulkan.sh \
    /opt/scripts/toolchain/
RUN     --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGET_ARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGET_ARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    SETUP_DEPENDENCIES_SKIP_CORE_TOOLS=true \
    bash /opt/scripts/toolchain/setup-dependencies.sh --arch "${TARGET_ARCH}" --vulkan-version "${VULKAN_VERSION}" vulkan

# 6. VERIFICATION
RUN set -euo pipefail; \
    bash /opt/scripts/toolchain/setup-dependencies.sh --arch "${TARGET_ARCH}" verify; \
    # Vulkan SDK gate (audit round 2: the verify above checks compilers only —
    # the SDK install had no assertion at all; verify.sh's contribution was
    # literally a "Reminder: source setup-env.sh" log line). The install root
    # must exist and be non-empty for the arch this SDK image targets.
    test -d /opt/vulkan || { echo "ERROR: /opt/vulkan missing after Vulkan SDK install" >&2; exit 1; }; \
    [ -n "$(ls -A /opt/vulkan 2>/dev/null)" ] || { echo "ERROR: /opt/vulkan is empty after Vulkan SDK install" >&2; exit 1; }

# ==============================================================================
# Frameworks; TVM version contract (build itself REMOVED — see below)
# ==============================================================================
ARG TVM_REF=v0.26.0
ARG TVM_BUILD_TYPE=${BUILD_TYPE}
ARG TVM_USE_VULKAN=1
# CUDA / OpenCL are disabled by default — GPU EP layers build separately via
# Dockerfile.nvidia / Dockerfile.amd. Exposed as ARGs for parity with
# TVM_USE_VULKAN so callers can opt in without editing the script.
ARG TVM_USE_CUDA=0
ARG TVM_USE_OPENCL=0
ARG TVM_INSTALL_PYTHON=1
ARG FLUTTER_VERSION=3.47.0

ENV TVM_REF=${TVM_REF} \
    TVM_BUILD_TYPE=${TVM_BUILD_TYPE} \
    TVM_USE_VULKAN=${TVM_USE_VULKAN} \
    TVM_USE_CUDA=${TVM_USE_CUDA} \
    TVM_USE_OPENCL=${TVM_USE_OPENCL} \
    TVM_INSTALL_PYTHON=${TVM_INSTALL_PYTHON}

# NO sdk-stage TVM build (removed 2026-08-12, refactoring-backlog BS2). This
# stage used to run tvm.sh here (~14 min/arch, amd64-native, x3 per chain) but
# NOTHING consumed the result: with no --prefix/--workdir it installed to
# /opt/src/tvm-install plus a private venv at /opt/src/tvm/.venv, and no
# downstream Dockerfile or script references /opt/src at all. The media image
# builds its own TVM in a dedicated stage (Dockerfile.media `FROM base AS tvm`:
# fresh clone in /tmp/tvm-src, install to /opt/tvm) and its final stage COPYs
# only from THAT stage; any sdk-venv python install was additionally dead
# because media's venv step recreates /opt/python/.venv with `uv venv --clear`.
# The TVM_* ARG/ENV block above is KEPT deliberately: the ENV values persist
# into the media image, whose tvm stage reads TVM_REF / TVM_USE_* from the
# environment (an inherited ENV overrides media's same-named ARG default in
# RUN steps), so the orchestrator's TVM pins still flow through this image.

# ==============================================================================
# Frameworks; Flutter SDK (amd64 + arm64; riscv64 skipped)
# ==============================================================================
# Closure of the flutter RUN: setup-flutter.sh is self-contained except for
# /opt/scripts/core/downloads.sh (standalone-source fallback) and
# /opt/scripts/core/versions.env (FLUTTER_SDK_SHA256 pin) — both already
# COPY'd above the vulkan RUN.
COPY --chmod=755 linux/scripts/05-frameworks/flutter/setup-flutter.sh /opt/scripts/frameworks/flutter/setup-flutter.sh
RUN --mount=type=cache,target=/var/cache/flutter,id=flutter-cache-${TARGET_ARCH},sharing=locked \
    set -euo pipefail; \
    mkdir -p /var/cache/flutter; \
    mkdir -p /opt/flutter && cp -an /var/cache/flutter/. /opt/flutter/ 2>/dev/null || true; \
    if [ ! -x /opt/flutter/bin/flutter ]; then \
        bash /opt/scripts/frameworks/flutter/setup-flutter.sh \
          --arch "${TARGET_ARCH}" \
          --version "${FLUTTER_VERSION}" \
          --dir /opt; \
        cp -an /opt/flutter/. /var/cache/flutter/ 2>/dev/null || true; \
    fi; \
    # Real gate (audit round 2: Flutter shipped with zero verification — a
    # failed install was only discovered by a user). riscv64 is the documented
    # skip; every other arch must end this RUN with a working flutter binary.
    if [ "${TARGET_ARCH:-amd64}" != "riscv64" ]; then \
        test -x /opt/flutter/bin/flutter || { echo "ERROR: /opt/flutter/bin/flutter missing/not executable after install" >&2; exit 1; }; \
    fi

LABEL org.opencontainers.image.title="Kataglyphis SDK" \
      org.opencontainers.image.description="SDK layer with Vulkan on top of compiler toolchain and the amd64-hosted cross artifact lane"
