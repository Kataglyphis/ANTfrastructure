# /etc/garage.toml on the VPS: Garage v2.4.1, one node, the S3 API on the WireGuard address only.
# Generate both secrets with `openssl rand -hex 32`; never commit the real file.
metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "lmdb"
replication_factor = 1
# sccache objects are zstd already.
compression_level = "none"

# A single node talks to itself only.
rpc_bind_addr = "127.0.0.1:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "REPLACE_ME"

[s3_api]
s3_region = "garage"
api_bind_addr = "192.168.188.216:3900"
root_domain = ".s3.garage"

[admin]
api_bind_addr = "127.0.0.1:3903"
admin_token = "REPLACE_ME"
