[Unit]
Description=Garage S3 server for shared sccache (WireGuard only)
After=wg-quick@wg0.service network-online.target
BindsTo=wg-quick@wg0.service

[Service]
User=garage
Group=garage
Environment=RUST_LOG=garage=info
Environment=GARAGE_CONFIG_FILE=/etc/garage/garage.toml
ExecStart=/usr/local/bin/garage server
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/garage
PrivateTmp=yes
LimitNOFILE=65536
MemoryMax=1G

[Install]
WantedBy=multi-user.target
