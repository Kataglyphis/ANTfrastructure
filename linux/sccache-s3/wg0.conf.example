# /etc/wireguard/wg0.conf, root 600: the FritzBox's export for this device, routed to the home LAN only.
[Interface]
PrivateKey = REPLACE_ME
# The address the FritzBox gave this device, IPv4 and its IPv6 ULA (the export's own prefix).
Address = <s3-server-lan-ip>/32,<ula-prefix>::216/128
# The export's DNS lines stay commented, so the VPS keeps its own resolver.
# DNS = <router-lan-ip>
# DNS = fritz.box

[Peer]
# The FritzBox's public key and preshared key, from the export.
PublicKey = REPLACE_ME
PresharedKey = REPLACE_ME
# The split tunnel: the export routes 0.0.0.0/0, which would send the VPS's own traffic home.
AllowedIPs = <home-lan-cidr>, <ula-prefix>::/64
# The FritzBox's MyFritz name; wg resolves it once, so wg-reresolve-dns@wg0.timer follows an address change.
Endpoint = <name>.myfritz.net:<port>
PersistentKeepalive = 25
