#!/bin/bash
# Size cap for the sccache bucket: sccache never deletes, so the oldest objects (LastModified) go until 90% of CAP_GB.
set -euo pipefail
CAP=$(( ${CAP_GB:-60} * 1024**3 )); TARGET=$(( CAP * 9 / 10 ))
KEYFILE=/etc/garage/evict-key.txt
AWS_ACCESS_KEY_ID=$(grep -oP 'Key ID:\s*\K\S+' "$KEYFILE")
AWS_SECRET_ACCESS_KEY=$(grep -oP 'Secret key:\s*\K\S+' "$KEYFILE")
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_REGION=garage
# The S3 endpoint is what [s3_api] binds; [admin] has an api_bind_addr too.
S3_ADDR=$(awk -F'"' '/^\[/{s=($0=="[s3_api]")} s && /^api_bind_addr/{print $2; exit}' /etc/garage/garage.toml)
S5="s5cmd --endpoint-url http://${S3_ADDR}"
# cheap check first so the bucket is only listed when it is over the cap
ADMIN_TOKEN=$(grep -oP '^admin_token = "\K[^"]+' /etc/garage/garage.toml)
BUCKET_SIZE=$(curl -sf -H "Authorization: Bearer $ADMIN_TOKEN" 'http://127.0.0.1:3903/v2/GetBucketInfo?globalAlias=sccache' | python3 -c 'import json,sys; print(json.load(sys.stdin)["bytes"])')
# Nextcloud and its backups share this disk, so low free space shrinks the bucket below the cap, down to FLOOR.
FLOOR=$(( ${FLOOR_GB:-10} * 1024**3 ))
SHORT=$(( ${MIN_FREE_GB:-25} * 1024**3 - $(df --output=avail -B1 /srv/garage | tail -n 1) ))
if [ "$SHORT" -gt 0 ]; then
  # A delete frees the disk only after resync; space already on its way must not be deleted for twice.
  QUEUE=$(garage -c /etc/garage/garage.toml stats | awk '/resync queue length/ {q = $NF} END {print q + 0}') || QUEUE=0
  [ "$QUEUE" -gt 1000 ] && SHORT=0
fi
[ "$BUCKET_SIZE" -le "$CAP" ] && { [ "$SHORT" -le 0 ] || [ "$BUCKET_SIZE" -le "$FLOOR" ]; } && exit 0
WORK=$(mktemp -d); trap 'rm -rf "$WORK"' EXIT
$S5 ls 's3://sccache/*' | awk '{print $1"T"$2, $3, $4}' > "$WORK/list"
USED=$(awk '{s+=$2} END{print s+0}' "$WORK/list")
if [ "$SHORT" -gt 0 ]; then
  DISK_TARGET=$(( USED - SHORT - 5 * 1024**3 ))
  [ "$DISK_TARGET" -lt "$FLOOR" ] && DISK_TARGET=$FLOOR
  [ "$DISK_TARGET" -lt "$TARGET" ] && TARGET=$DISK_TARGET
fi
[ "$USED" -le "$TARGET" ] && exit 0
# awk reads to the end: an early exit kills sort with SIGPIPE, and pipefail then ends the script before any delete.
sort -k1,1 "$WORK/list" | awk -v free=$(( USED - TARGET )) \
  'free > 0 { print "rm \"s3://sccache/" $3 "\""; free -= $2 }' > "$WORK/cmds"
$S5 --numworkers 64 run "$WORK/cmds" >/dev/null
logger -t sccache-evict "garage: deleted $(wc -l < "$WORK/cmds") objects, was $USED bytes (cap ${CAP_GB:-60}G, ${SHORT} bytes short of free space)"
