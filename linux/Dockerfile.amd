# syntax=docker/dockerfile:1.27.1

# Optional AMD GPU (ROCm + MIGraphX) layer: :sdk -> :toolchain-amd -> :media-amd -> :android-amd -> :amd

ARG BASE_IMAGE=local/kataglyphis:sdk
FROM ${BASE_IMAGE}

ARG TARGETARCH
ARG LLVM_RELEASE=23.1.3
ARG ROCM_VERSION=10.0
ARG MIGRAPHX_VERSION=2.17.0
# ASAN-instrumented ROCm beside the normal one, off by default. See docs/linux-accelerator-images.md § ROCm
ARG ENABLE_ROCM_ASAN=false
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL

SHELL ["bash", "-lc"]

# Add AMD ROCm repository + install MIGraphX + ROCm stack
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    ENABLE_ROCM_ASAN="${ENABLE_ROCM_ASAN}" ROCM_VERSION="${ROCM_VERSION}" MIGRAPHX_VERSION="${MIGRAPHX_VERSION}" \
      bash /tmp/core-scripts/setup-rocm-repo.sh

ENV PATH="/usr/lib/llvm-${LLVM_RELEASE%%.*}/bin:/opt/rocm/bin:${PATH}" \
    ROCM_HOME="/opt/rocm" \
    MIGRAPHX_HOME="/opt/rocm"

LABEL org.opencontainers.image.title="Kataglyphis AMD GPU" \
      org.opencontainers.image.description="AMD GPU (MIGraphX) acceleration layer for the Kataglyphis accelerator toolchain"
