# syntax=docker/dockerfile:1.24.0

# ==============================================================================
# Dockerfile.amd  —  Optional AMD GPU (ROCm) library layer
#
# Position in the chain:
#   :sdk  →  THIS (:toolchain-amd)  →  :media-amd  →  :android-amd  →  :amd
#
# What this installs on top of the standard SDK image:
#   • HIP runtime + compiler (hipcc)
#   • MIOpen (Deep Neural Network library)
#   • RCCL (multi-GPU collective comms)
#   • rocBLAS, rocSPARSE, rocFFT, rocSOLVER (ROCm math libraries)
#
# Uses native Ubuntu 26.04 universe packages (ROCm 7.1.x) — no external repo needed.
#
# Usage:
#   docker buildx build \
#     --build-arg BASE_IMAGE=local/kataglyphis:sdk \
#     -t local/kataglyphis:toolchain-amd \
#     -f linux/Dockerfile.amd .
# ==============================================================================

ARG BASE_IMAGE=local/kataglyphis:sdk
FROM ${BASE_IMAGE}

ARG TARGETARCH
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL

SHELL ["bash", "-lc"]

# Install ROCm stack from Ubuntu universe (native packages, ROCm 7.1.x) + verify
RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    bash /tmp/core-scripts/use-fast-ubuntu-mirror.sh; \
    apt-get update && apt-get install -y --no-install-recommends \
        libamdhip64-dev \
        librocblas-dev \
        librocfft-dev \
        librccl-dev \
        librocsparse-dev \
        librocsolver-dev \
        libmiopen-dev; \
    echo "/usr/lib/rocm/lib" > /etc/ld.so.conf.d/rocm.conf; \
    ldconfig; \
    rm -rf /var/lib/apt/lists/*; \
    test -x "$(command -v hipcc)"; \
    ldconfig -p | grep -E 'librocblas|librccl|librocfft|librocsparse|libmiopen' >/dev/null

ARG LLVM_RELEASE=22.1.6
ENV PATH="/usr/lib/llvm-${LLVM_RELEASE%%.*}/bin:/usr/lib/rocm/bin:${PATH}"

LABEL org.opencontainers.image.title="Kataglyphis AMD GPU" \
      org.opencontainers.image.description="AMD GPU (ROCm) acceleration layer for the Kataglyphis accelerator toolchain"
