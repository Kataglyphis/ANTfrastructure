# syntax=docker/dockerfile:1.28.0

# Optional AMD GPU (ROCm + MIGraphX) layer: :sdk -> :toolchain-amd -> :media-amd -> :android-amd -> :amd

ARG BASE_IMAGE=local/kataglyphis:sdk
FROM ${BASE_IMAGE}

ARG HUB_SCRIPTS_KEY

LABEL org.kataglyphis.build-script-closure=migraphx-image

ARG TARGETARCH
ARG LLVM_RELEASE=23.1.5
ARG ROCM_VERSION=10.1
ARG MIGRAPHX_VERSION=2.18.0
ARG JOBS
# ASAN-instrumented ROCm beside the normal one, off by default. See docs/linux-accelerator-images.md § ROCm
ARG ENABLE_ROCM_ASAN=false
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL

SHELL ["bash", "-lc"]

# Add AMD ROCm repository + install MIGraphX + ROCm stack
LABEL kataglyphis.step=rocm
RUN --mount=type=secret,id=asset_mirror,required=false --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    set -euo pipefail; \
    ENABLE_ROCM_ASAN="${ENABLE_ROCM_ASAN}" ROCM_VERSION="${ROCM_VERSION}" MIGRAPHX_VERSION="${MIGRAPHX_VERSION}" \
      bash /tmp/core-scripts/setup-rocm-repo.sh


# Compile the corrected backend with the shared cache and original source/notice contracts.
LABEL kataglyphis.step=migraphx-source
RUN --mount=type=secret,id=asset_mirror,required=false --mount=type=secret,id=sccache_s3,required=false \
    --mount=type=bind,from=hub-scripts,source=/${HUB_SCRIPTS_KEY}/files,target=/opt/scripts,ro \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH},sharing=locked \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH},sharing=locked \
    --mount=type=cache,target=/var/cache/migraphx-source,id=migraphx-source-${TARGETARCH},sharing=locked \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH},sharing=locked \
    set -euo pipefail; \
    status=0; \
    trap 'status=$?; if [ "${status}" -ne 0 ]; then bash /opt/scripts/core/sccache-s3-level.sh drain || true; fi; exit "${status}"' EXIT; \
    bash /opt/scripts/03-media/build/migraphx/build-image.sh /tmp/migraphx-source-stack /var/cache/migraphx-source /opt/rocm; \
    rm -r -- /tmp/migraphx-source-stack; \
    bash /opt/scripts/core/sccache-s3-level.sh drain

ENV PATH="/opt/rocm/migraphx/bin:${PATH}:/opt/rocm/bin" \
    ROCM_HOME="/opt/rocm" \
    MIGRAPHX_HOME="/opt/rocm/migraphx" \
    PKG_CONFIG_PATH="/opt/rocm/migraphx/lib/pkgconfig:/opt/rocm/migraphx/lib64/pkgconfig:${PKG_CONFIG_PATH:-}" \
    PYTHONPATH="/opt/rocm/migraphx/lib:${PYTHONPATH:-}" \
    CMAKE_PREFIX_PATH="/opt/rocm/migraphx:${CMAKE_PREFIX_PATH:-}" \
    LD_LIBRARY_PATH="/opt/rocm/migraphx/lib:/opt/rocm/migraphx/lib64:${LD_LIBRARY_PATH:-}"

LABEL org.opencontainers.image.title="Kataglyphis AMD GPU" \
      org.opencontainers.image.description="AMD GPU (MIGraphX) acceleration layer for the Kataglyphis accelerator toolchain"
