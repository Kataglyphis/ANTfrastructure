# syntax=docker/dockerfile:1.24.0

ARG BASE_IMAGE="ghcr.io/kataglyphis/kataglyphis_beschleuniger:android"
FROM ${BASE_IMAGE} AS torch

ARG ONNX_PACKAGE="onnxruntime-webgpu"
ARG PYTORCH_EXTRA="pytorch-cpu"
ARG ENABLE_NVIDIA="false"
ARG ENABLE_AMD="false"

ARG BUILD_MODE=native
ARG TARGET_ARCH
ARG TARGETARCH
ARG TORCH_APP_MODE=all
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL
ENV VENV=/opt/venv \
    TORCH_APP_MODE=${TORCH_APP_MODE}

RUN --mount=type=bind,source=linux/scripts/01-core,target=/tmp/core-scripts,ro \
    bash /tmp/core-scripts/use-fast-ubuntu-mirror.sh

COPY --chmod=755 linux/scripts/01-core/platform.sh /opt/scripts/core/platform.sh
COPY --chmod=755 linux/scripts/01-core/ubuntu-mirror.sh /opt/scripts/core/ubuntu-mirror.sh
COPY --chmod=755 linux/scripts/01-core/cross-env.sh /opt/scripts/core/cross-env.sh
COPY --chmod=755 linux/scripts/03-media/final/assemble-torch-app.sh /opt/scripts/media/final/assemble-torch-app.sh
COPY --chmod=755 linux/scripts/06-packaging/setup-torch-venv.sh /opt/scripts/packaging/setup-torch-venv.sh

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    set -eux; \
    bash /opt/scripts/packaging/setup-torch-venv.sh

ENV VIRTUAL_ENV=${VENV} \
    PATH=${VENV}/bin:${PATH} \
    UV_PYTHON=${VENV}/bin/python \
    MEDIA_HOST_PYTHON=${VENV}/bin/python \
    UV_LOCK_TIMEOUT=14400 \
    PIP_DEFAULT_TIMEOUT=1200 \
    UV_HTTP_TIMEOUT=1200

WORKDIR /opt/Kataglyphis-Orchestr-ANT-ion

FROM scratch AS venv-export
COPY --from=torch /opt/venv /opt/venv

FROM torch AS final

ARG BUILD_TYPE=Release
ARG ENABLE_NVIDIA
ARG ENABLE_AMD

# ==============================================================================
# Runtime scripts — copy LAST to maximize cache hits
# ==============================================================================
COPY --chmod=755 linux/scripts/02-toolchain/vulkan.sh /usr/local/bin/vulkan.sh
COPY --chmod=755 linux/scripts/04-runtime/*.sh /usr/local/bin/

# ------------------------------------------------------------------------------
# Workspace & EntryPoint (formerly in linux/Dockerfile wrapper)
# ------------------------------------------------------------------------------
ARG WORKDIR=/workspace
WORKDIR ${WORKDIR}
VOLUME ["${WORKDIR}"]

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]

# ------------------------------------------------------------------------------
# OCI-Labels
# ------------------------------------------------------------------------------
ARG BUILD_DATE="" VCS_REF=""
LABEL org.opencontainers.image.title="kataglyphis_beschleuniger" \
      org.opencontainers.image.description="My beschleuniger image for 2D AI" \
      org.opencontainers.image.version="${BUILD_TYPE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.authors="Jonas Heinle <jonasheinle@googlemail.com>" \
      org.opencontainers.image.url="https://github.com/Kataglyphis/Kataglyphis-DockerHub" \
      org.opencontainers.image.source="https://github.com/Kataglyphis/Kataglyphis-DockerHub" \
      org.opencontainers.image.licenses="MIT"
