# syntax=docker/dockerfile:1.19

# Global Version Arguments
ARG LITERT_VERSION="2.1.4"
FROM ghcr.io/kataglyphis/kataglyphis_beschleuniger:android

ARG LITERT_VERSION

ARG TARGETARCH
SHELL ["bash", "-lc"]
ENV VENV=/opt/venv

# Initialize the venv
RUN --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    uv venv --seed --python="cpython-3.14" "${VENV}"
ENV VIRTUAL_ENV=${VENV}
ENV PATH=${VENV}/bin:${PATH}
ENV UV_LOCK_TIMEOUT=14400
ENV PIP_DEFAULT_TIMEOUT=1200
ENV UV_HTTP_TIMEOUT=1200

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,id=apt-lib-${TARGETARCH} \
    apt-get update && \
    # Do NOT remove. need to build PyGObject from source on RISCV
    apt-get install -y libgirepository-2.0-dev libcairo2-dev libgirepository1.0-dev && \
    apt-get install -y --no-install-recommends \
      python3-gi python3-dev libpython3-dev \
      gir1.2-glib-2.0 gir1.2-gtk-3.0 \
      git libopenblas-dev liblapack-dev \
      # wxPython / GTK3 Dependencies (CRITICAL)
      libgtk-3-dev \
      libglib2.0-dev:$(dpkg --print-architecture) \
      libglib2.0-dev \
      libjpeg-dev \
      libtiff-dev \
      libpng-dev \
      libsdl2-dev \
      libnotify-dev \
      libsm-dev \
      libxtst-dev \
      freeglut3-dev \
      libxxf86vm-dev \
      libegl1-mesa-dev \
      libglu1-mesa-dev \
      pkg-config \
      # ADDED: Matplotlib build dependencies to avoid meson timeouts
      libfreetype6-dev \
      libqhull-dev \
      libharfbuzz-dev \
      libfribidi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    git clone https://github.com/Kataglyphis/Kataglyphis-Orchestr-ANT-ion.git && \
    cd Kataglyphis-Orchestr-ANT-ion && \
    git checkout v0.0.17 && \
    source ${VENV}/bin/activate && \
    # Remove conflicting system headers to force use of PyPI version
    apt-get remove -y pybind11-dev python3-pybind11 || true && \
    # ---------------------------------------------------------
    # Variable $UV_OPTS wird hier eingefügt
    rm -rf /root/.cache/uv/* && \
    rm -f uv.lock && \
    echo "Debugging local wheels:" && ls -la /opt/wheels || true && \
    uv pip install /opt/wheels/ai_edge_litert*.whl || true && \
    sed -i 's/"onnxruntime"/"onnxruntime-webgpu"/g' pyproject.toml && \
    sed -i 's/"onnxruntime>=.*"/"onnxruntime-webgpu"/g' pyproject.toml && \
    sed -i 's/"opencv-python-headless"/"opencv-contrib-python"/g' pyproject.toml && \
    sed -i 's/"opencv-python-headless>=.*"/"opencv-contrib-python"/g' pyproject.toml && \
    echo -e "\n[tool.uv]\nconstraint-dependencies = [\"ai-edge-litert==${LITERT_VERSION}\", \"numpy==2.4.4\"]" >> pyproject.toml && \
    uv lock --find-links /opt/wheels && \
    uv sync --find-links /opt/wheels --active --extra "ml-ai" --extra "pytorch-cpu" --extra "test" --extra "frontend" --extra "docs" && \
    uv pip uninstall opencv-python opencv-python-headless opencv-contrib-python opencv-contrib-python-headless || true && \
    uv pip install --force-reinstall /opt/wheels/*.whl && \
    uv pip install PyGObject && \
    # Debug OpenCV shared libraries to see what might be missing
    find /opt/venv -name "cv2*.so" -exec ldd {} \; || true && \
    # 6. Verify
    uv run --active python -c "import gi, numpy, contourpy; print('gi OK'); print('numpy', numpy.__version__);" && \
    uv run --active python -c "import os; os.environ['OPENCV_LOG_LEVEL']='DEBUG'; import cv2; print('cv2', cv2.__version__);"

WORKDIR /opt/Kataglyphis-Orchestr-ANT-ion
