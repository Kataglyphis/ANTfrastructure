# syntax=docker/dockerfile:1.19

# Global Version Arguments
ARG LITERT_VERSION="2.1.4"
ARG BASE_IMAGE="ghcr.io/kataglyphis/kataglyphis_beschleuniger:android"
FROM ${BASE_IMAGE}

ARG LITERT_VERSION
ARG ONNX_PACKAGE="onnxruntime-webgpu"
ARG PYTORCH_EXTRA="pytorch-cpu"
ARG ENABLE_NVIDIA="false"
ARG ENABLE_AMD="false"

ARG BUILD_MODE=native
ARG TARGET_ARCH
ARG TARGETARCH
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL
SHELL ["bash", "-lc"]
ENV VENV=/opt/venv
ENV BUILD_MODE=${BUILD_MODE} \
    TARGET_ARCH=${TARGET_ARCH:-${TARGETARCH}} \
    TARGETARCH=${TARGET_ARCH:-${TARGETARCH}}

RUN --mount=type=bind,source=linux/scripts/01-core/use-fast-ubuntu-mirror.sh,target=/tmp/use-fast-ubuntu-mirror.sh,ro \
    USE_FAST_UBUNTU_MIRROR="${USE_FAST_UBUNTU_MIRROR}" \
    FAST_UBUNTU_MIRROR_URL="${FAST_UBUNTU_MIRROR_URL}" \
    FAST_UBUNTU_PORTS_MIRROR_URL="${FAST_UBUNTU_PORTS_MIRROR_URL}" \
    bash /tmp/use-fast-ubuntu-mirror.sh

COPY --chmod=755 linux/scripts/03-media/final/assemble-torch-app.sh /opt/scripts/media/final/assemble-torch-app.sh

# Initialize the venv
RUN --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    set -eux; \
    source /opt/scripts/core/cross-env.sh; \
    python_mm="$(host_python_major_minor)"; \
    test -x "/usr/local/bin/python${python_mm}" || { \
      echo "Expected source-built interpreter /usr/local/bin/python${python_mm} from the base image was not found" >&2; \
      ls -1 /usr/local/bin/python* 2>/dev/null || true; \
      exit 1; \
    }; \
    uv venv --seed --python="/usr/local/bin/python${python_mm}" "${VENV}"
ENV VIRTUAL_ENV=${VENV}
ENV PATH=${VENV}/bin:${PATH}
ENV UV_PYTHON=${VENV}/bin/python
ENV MEDIA_HOST_PYTHON=${VENV}/bin/python
ENV UV_LOCK_TIMEOUT=14400
ENV PIP_DEFAULT_TIMEOUT=1200
ENV UV_HTTP_TIMEOUT=1200

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,id=apt-lib-${TARGETARCH} \
    if [ "${BUILD_MODE}" = "cross" ]; then \
      echo "Skipping torch environment assembly in cross mode; target wheels cannot be installed into a live amd64 venv"; \
      exit 0; \
    fi && \
    apt-get update && \
    # Do NOT remove. need to build PyGObject from source on RISCV
    apt-get install -y libgirepository-2.0-dev libcairo2-dev libgirepository1.0-dev && \
    apt-get install -y --no-install-recommends \
      python3-gi \
      gir1.2-glib-2.0 gir1.2-gtk-3.0 \
      git libopenblas-dev liblapack-dev \
      # wxPython / GTK3 Dependencies (CRITICAL)
      libgtk-3-dev \
      libglib2.0-dev:$(dpkg --print-architecture) \
      libglib2.0-dev \
      libjpeg-dev \
      libtiff-dev \
      libpng-dev \
      libsdl2-dev \
      libnotify-dev \
      libsm-dev \
      libxtst-dev \
      freeglut3-dev \
      libxxf86vm-dev \
      libegl1-mesa-dev \
      libglu1-mesa-dev \
      pkg-config \
      # ADDED: Matplotlib build dependencies to avoid meson timeouts
      libfreetype6-dev \
      libqhull-dev \
      libharfbuzz-dev \
      libfribidi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    if [ "${BUILD_MODE}" = "cross" ]; then \
      echo "Skipping torch application install/validation in cross mode"; \
      exit 0; \
    fi && \
    /opt/scripts/media/final/assemble-torch-app.sh

WORKDIR /opt/Kataglyphis-Orchestr-ANT-ion
