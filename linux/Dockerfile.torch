# syntax=docker/dockerfile:1.27.0

# BuildKit populates TARGETARCH in the global scope, so a plain `docker build`
# defaults to the CURRENT platform's package image instead of silently producing
# a wrong-arch wrapper (the orchestrator always overrides BASE_IMAGE anyway).
ARG TARGETARCH
ARG BASE_IMAGE="ghcr.io/kataglyphis/kataglyphis_beschleuniger:latest-package-${TARGETARCH}"
# AP3 (2026-08-18, correct re-implementation of the 2026-08-17 revert): the
# cross wheelhouse is no longer BAKED into the package image — it is
# bind-mounted here, in the ONE RUN that reads it (setup-torch-venv.sh
# `--find-links /opt/wheels`). WHEELS_IMAGE mirrors Dockerfile.package's
# ARTIFACT_IMAGE default; the runtime helper passes the digest-pinned android
# ref (runtime_android_pin). A missing /opt/wheels in that image fails the
# mount LOUDLY at build time — the exact failure mode that silently broke the
# first AP3 attempt is now impossible.
ARG WHEELS_IMAGE=ghcr.io/kataglyphis/kataglyphis_beschleuniger:cross-android-${TARGETARCH}
FROM ${WHEELS_IMAGE} AS wheels-source
# RUNTIME_WHEELS_SOURCE=export builds only this stage (--output type=local) and hands the
# directory back as WHEELS_IMAGE. docs/linux-cross-builds.md#the-wrappers-wheelhouse-two-deliveries
FROM scratch AS wheels-export
COPY --link --from=wheels-source /opt/wheels /opt/wheels
FROM ${BASE_IMAGE} AS torch

SHELL ["bash", "-lc"]

ARG ENABLE_NVIDIA="false"
ARG ENABLE_AMD="false"

ARG BUILD_MODE=native
ARG TARGET_ARCH
ARG TARGETARCH
ARG TORCH_APP_MODE=all
ARG USE_FAST_UBUNTU_MIRROR=false
ARG FAST_UBUNTU_MIRROR_URL=https://archive.ubuntu.com/ubuntu/
ARG FAST_UBUNTU_PORTS_MIRROR_URL
# APP_REF: the OrchestrANT tag assemble-torch-app.sh clones. The runtime
# orchestrator already forwards --build-arg APP_REF from versions.env; this ARG +
# ENV is what actually lets it reach the assemble RUN (previously unconsumed, so the
# clone always fell back to the script default). Default kept in sync with
# versions.env so a plain `docker build` matches the orchestrated build.
ARG APP_REF=v0.0.28
# ONNX_PACKAGE / PYTORCH_EXTRA: documented operator overrides (runtime-build-fns.sh
# usage). These ARGs are what let the orchestrator's --build-arg reach the venv
# setup (previously hardcoded here, so a documented GPU override silently baked
# the CPU defaults). Defaults preserve the historical baked values.
ARG ONNX_PACKAGE=onnxruntime
ARG PYTORCH_EXTRA="pytorch-cpu"
# The build pins the runtime smoke asserts. The app lock may lag them, and on
# the arches PyTorch publishes cp314 wheels for, the pinned pair installs from
# the CPU index (assemble-torch-app.sh's enforce_torch_version_pins). riscv64
# has no wheels and keeps its versions.env <KEY>_RISCV64 pair.
ARG PYTORCH_VERSION=v2.14.0
ARG TORCHVISION_VERSION=v0.29.0
# The ROCm image's torch wheel line (versions.env PYTORCH_ROCM_INDEX).
ARG PYTORCH_ROCM_INDEX=rocm7.14
ENV VENV=/opt/venv \
    TORCH_APP_MODE=${TORCH_APP_MODE} \
    ONNX_PACKAGE=${ONNX_PACKAGE} \
    PYTORCH_EXTRA="${PYTORCH_EXTRA}" \
    PYTORCH_VERSION=${PYTORCH_VERSION} \
    TORCHVISION_VERSION=${TORCHVISION_VERSION} \
    PYTORCH_ROCM_INDEX=${PYTORCH_ROCM_INDEX} \
    APP_REF=${APP_REF} \
    ORT_CHAIN_WHEEL_DIR=/opt/onnxruntime-wheels \
    SKIP_TORCH_TEST_EXTRAS=true

COPY --chmod=755 linux/scripts/01-core/logging.sh linux/scripts/01-core/platform.sh linux/scripts/01-core/ubuntu-mirror.sh linux/scripts/01-core/cross-env.sh /opt/scripts/core/
COPY --chmod=755 linux/scripts/03-media/runtime/assemble-torch-app.sh /opt/scripts/03-media/final/assemble-torch-app.sh
# The ORT census assemble-torch-app.sh runs from beside itself (every ORT dist must be a chain wheel).
COPY --chmod=755 linux/scripts/03-media/runtime/ort-venv-census.py /opt/scripts/03-media/final/ort-venv-census.py
COPY --chmod=755 linux/scripts/06-packaging/setup-torch-venv.sh /opt/scripts/packaging/setup-torch-venv.sh

# ORPHAN-PINS consumer half (2026-08-23): this mount is the ONLY channel by
# which the media stage's optional frameworks reach /opt/venv — setup-torch-
# venv.sh → assemble-torch-app.sh classifies every wheel (wheel_family) and
# installs the tvm/iree ones best-effort. That half IS wired: TVM is missing
# from all three shipped images because the media stage produces no tvm wheel
# (tvm-python.sh's verdict), not because anything here drops one.
# Its NATIVE half never arrives though. Stated without line numbers, because
# the anchor this used to carry had already rotted: Dockerfile.media's FINAL
# stage does `COPY --link --from=tvm /opt/tvm/lib/ /usr/local/lib/`, so
# libtvm*.so exists in the media (hence android) image — but THIS image's
# libraries come from BASE_IMAGE, the package image, and nothing there carries
# it over. Dockerfile.package's `COPY --link --from=artifact-source` lines name
# only whole /opt trees plus rustup/cargo/llvm-target, and copy-media-payloads.sh
# copies an EXPLICIT allowlist out of /usr/local/lib (onnxruntime-genai,
# onnxruntime-gpu, LiteRT, tensorflow-lite, VVdec) with no libtvm entry, so
# /usr/local/lib/libtvm*.so is dropped at the media→package boundary. Nothing
# in this repo's Linux lane sets TVM_LIBRARY_PATH either. Fix it THERE (the
# package image's payload set) if the wheel turns out not to bundle its own
# runtime — a COPY glob here would hard-fail every build while the file is
# absent ("no source files were specified"), which is the same trap the
# drop-DIRECTORY COPY in Dockerfile.nvidia exists to dodge. (Not GPU7: that
# label belongs to the `|| true` outside the $() in the same file.)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked,id=apt-cache-${TARGETARCH} \
    --mount=type=cache,target=/var/lib/apt,sharing=locked,id=apt-lib-${TARGETARCH} \
    --mount=type=cache,target=/root/.cache/uv,id=uv-cache-${TARGETARCH} \
    --mount=type=bind,from=wheels-source,source=/opt/wheels,target=/opt/wheels,rw \
    set -euo pipefail; \
    echo "[torch-run] start epoch=$(date -u +%s) arch=${TARGETARCH}"; \
    export UV_LOCK_TIMEOUT=14400 UV_HTTP_TIMEOUT=1200 PIP_DEFAULT_TIMEOUT=1200; \
    rm -rf /root/.cache/uv/git-v0/locks/ 2>/dev/null || true; \
    bash /opt/scripts/packaging/setup-torch-venv.sh

ENV VIRTUAL_ENV=${VENV} \
    PATH=${VENV}/bin:${PATH} \
    UV_PYTHON=${VENV}/bin/python \
    MEDIA_HOST_PYTHON=${VENV}/bin/python \
    UV_LOCK_TIMEOUT=14400 \
    PIP_DEFAULT_TIMEOUT=1200 \
    UV_HTTP_TIMEOUT=1200

FROM torch AS final

# Must equal Dockerfile.package's RUNTIME_UID: that stage chowns /opt/flutter
# bin/cache to it. docs/artifact-copy-completeness.md#the-runtime-uid-is-a-contract
ARG RUNTIME_UID=1001
ARG BUILD_TYPE=Release
ARG WORKDIR=/workspace
ARG BUILD_DATE=""
ARG VCS_REF=""
# POS2: re-declared for the version LABEL below (ARGs are per-stage; the torch
# stage's APP_REF does not reach this stage). Default matches versions.env.
ARG APP_REF=v0.0.28

# Runtime scripts, entrypoint, CMD, VOLUME, HEALTHCHECK, user, and OCI
# labels.  This is the canonical source for shared final-stage elements.
# Dockerfile.package wrapper-smoke delegates its smoke-only validation to
# validate-compilers.sh and does not duplicate these.
COPY --chmod=755 linux/scripts/02-toolchain/vulkan.sh /usr/local/bin/vulkan.sh
COPY --chmod=755 linux/scripts/04-runtime/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chmod=755 linux/scripts/04-runtime/gstreamer-env.sh /usr/local/bin/gstreamer-env.sh
COPY --chmod=755 linux/scripts/04-runtime/libcamera-env.sh /usr/local/bin/libcamera-env.sh
COPY --chmod=755 linux/scripts/04-runtime/start-webrtc-signalling.sh /usr/local/bin/start-webrtc-signalling.sh

WORKDIR ${WORKDIR}
VOLUME ["${WORKDIR}"]

# ------------------------------------------------------------------------------
# Hailo payload (amd64/arm64) — built in so the standard runtime carries it by
# default. HailoRT + hailortcli + the hailonet GStreamer element; riscv64 has
# no HailoRT support and skips. Plan and upstream matrix: docs/hailo-support.md.
# The runtime image already has GCC/cmake/ninja and the GStreamer dev files, so
# the build is native. This is the ONLY Hailo build: the standalone :hailo
# variant (Dockerfile.hailo) was retired on 2026-09-22 as a duplicate of it.
# ------------------------------------------------------------------------------
ARG HAILORT_VERSION=5.4.0
ARG HAILORT_SOURCE_SHA256=7a0e43df03cad7086643029fd7dc3773a8231b1f6383705fe3036896a70472b0
ARG HAILO_PROTOBUF_VERSION=21.12
ARG HAILO_PROTOBUF_SHA256=22fdaf641b31655d4b2297f9981fa5203b2866f8332d3c6333f6b0107bb320de
ARG TAPPAS_VERSION=5.4.0
ARG TAPPAS_SOURCE_SHA256=ebc6814f95070ec9adc5741b35be07158119691809d76a82a434f414016b4dbd
ARG HAILO_LIBZMQ_VERSION=4.3.5
ARG HAILO_LIBZMQ_SHA256=6653ef5910f17954861fe72332e68b03ca6e4d9c7160eb3a8de5a5a913bfab43
ARG HAILO_CPPZMQ_VERSION=4.11.0
ARG HAILO_CPPZMQ_SHA256=0fff4ff311a7c88fdb76fceefba0e180232d56984f577db371d505e4d4c91afd
ARG HAILO_PREFIX=/opt/hailo
ARG GSTREAMER_PREFIX=/opt/gstreamer
# The build's switches (hailo-build-lib.sh); an exported value is forwarded like a pin.
# docs/hailo-support.md#the-nested-build-cache-and-pyhailort-two-switches
ARG HAILO_NESTED_CACHE=carry
ARG HAILO_PYHAILORT_IPO=off
COPY --chmod=755 linux/scripts/01-core/ /opt/scripts/core/
COPY --chmod=755 linux/scripts/03-media/core/ /opt/scripts/03-media/core/
COPY --chmod=755 linux/scripts/03-media/build/hailo/ /opt/scripts/03-media/build/hailo/
COPY --chmod=755 linux/hailo-sdk/ /opt/scripts/hailo-sdk/
# The caps are Dockerfile.base's: this image lost base's ENV, and a smaller cap trims the shared mount.
RUN --mount=type=cache,target=/var/cache/hailo-build,id=hailo-build-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/ccache,id=ccache-${TARGETARCH} \
    --mount=type=cache,target=/var/cache/sccache,id=sccache-${TARGETARCH} \
    --mount=type=tmpfs,target=/tmp \
    set -euo pipefail; \
    if [ "${TARGETARCH}" = "riscv64" ]; then \
        echo "Hailo: no HailoRT support on riscv64 -- skipping"; \
    else \
        TARGET_ARCH="${TARGETARCH}" \
        HAILORT_VERSION="${HAILORT_VERSION}" \
        HAILORT_SOURCE_SHA256="${HAILORT_SOURCE_SHA256}" \
        HAILO_PROTOBUF_VERSION="${HAILO_PROTOBUF_VERSION}" \
        HAILO_PROTOBUF_SHA256="${HAILO_PROTOBUF_SHA256}" \
        TAPPAS_VERSION="${TAPPAS_VERSION}" \
        TAPPAS_SOURCE_SHA256="${TAPPAS_SOURCE_SHA256}" \
        HAILO_LIBZMQ_VERSION="${HAILO_LIBZMQ_VERSION}" \
        HAILO_LIBZMQ_SHA256="${HAILO_LIBZMQ_SHA256}" \
        HAILO_CPPZMQ_VERSION="${HAILO_CPPZMQ_VERSION}" \
        HAILO_CPPZMQ_SHA256="${HAILO_CPPZMQ_SHA256}" \
        HAILO_PREFIX="${HAILO_PREFIX}" \
        GSTREAMER_PREFIX="${GSTREAMER_PREFIX}" \
        HAILO_NESTED_CACHE="${HAILO_NESTED_CACHE}" \
        HAILO_PYHAILORT_IPO="${HAILO_PYHAILORT_IPO}" \
        SCCACHE_CACHE_SIZE=30G CCACHE_MAXSIZE=30G \
        bash /opt/scripts/03-media/build/hailo/build-hailort.sh; \
        install -D -m 0644 "${HAILO_PREFIX}/lib/gstreamer-1.0/gsthailo.so" \
          "${GSTREAMER_PREFIX}/lib/multiarch/gstreamer-1.0/gsthailo.so"; \
        printf '%s\n' "${HAILO_PREFIX}/lib" > /etc/ld.so.conf.d/000-hailo.conf; \
        ldconfig; \
        ln -sf "${HAILO_PREFIX}/bin/hailortcli" /usr/local/bin/hailortcli; \
        hailortcli --version >/dev/null; \
        gst-inspect-1.0 hailonet >/dev/null; \
        gst-inspect-1.0 hailotools >/dev/null; \
        if [ "${TARGETARCH}" = "amd64" ]; then \
            for _dfc in /opt/scripts/hailo-sdk/*.whl; do \
                [ -e "${_dfc}" ] || continue; \
                echo "Hailo: installing staged Dataflow Compiler wheel $(basename "${_dfc}")"; \
                uv pip install --python /opt/venv/bin/python --no-deps "${_dfc}"; \
            done; \
        fi; \
    fi
ENV HAILO_PREFIX=${HAILO_PREFIX}

# Create the unprivileged runtime user AND give it ownership of its WORKDIR/
# VOLUME. Without the chown, WORKDIR/VOLUME are created root-owned (they run as
# root here) and `USER kataglyphis` then cannot write into /workspace -- the
# whole point of the VOLUME. PYTHONDONTWRITEBYTECODE stops Python trying to
# write .pyc files into the root-owned /opt/venv on first import, which also
# makes the image runnable with --read-only.
# Drop the build-time fake `sudo` shim (created in Dockerfile.toolchain to work
# around sudo-rs env filtering) from the shipped runtime image: it grants no
# privilege, shadows any real sudo, and silently runs `sudo cmd` as the
# unprivileged user -- misleading at runtime. Build stages that need it keep it.
# RP1 (security): also purge the REAL setuid sudo the base pulled in
# (package-lists.sh installs it for build stages). No sudoers/group grants exist
# and USER kataglyphis (uid 1001) can never use it — it is pure LPE attack
# surface (the sudo CVE stream) with zero runtime benefit. rm the binaries and
# clear any residual setuid bits; no runtime script invokes sudo (verified).
RUN id -u kataglyphis >/dev/null 2>&1 || useradd -m -l -u ${RUNTIME_UID} -s /bin/bash kataglyphis; \
    [ "$(id -u kataglyphis)" = "${RUNTIME_UID}" ] || { echo "ERROR: kataglyphis is uid $(id -u kataglyphis), not RUNTIME_UID=${RUNTIME_UID}; Dockerfile.package chown'd /opt/flutter to the wrong owner" >&2; exit 1; }; \
    mkdir -p ${WORKDIR} && chown -R kataglyphis:kataglyphis ${WORKDIR}; \
    rm -f /usr/local/bin/sudo /usr/bin/sudo /usr/bin/sudoedit /usr/local/bin/sudoedit; \
    find / -xdev -perm -4000 -name 'sudo*' -type f -delete 2>/dev/null || true

ENV PYTHONDONTWRITEBYTECODE=1

USER kataglyphis

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]

# RP3: timeout raised 5s→30s — a cold import of the multi-hundred-MB onnxruntime
# .so on riscv64 under qemu plausibly exceeds 5s, flapping the container to
# unhealthy on a healthy image. The timeout only bounds the FAILURE path, so a
# generous value costs nothing on a fast native import.
HEALTHCHECK --interval=30s --timeout=30s --start-period=30s --retries=3 \
  CMD /opt/venv/bin/python3 -c "import onnxruntime" || exit 1

# POS2 (2026-08-17): image.version used to carry BUILD_TYPE ("Release") — not a
# version. Point it at the shipped app ref (APP_REF, versions.env-driven) and
# keep the build type as a custom label.
LABEL org.opencontainers.image.title="kataglyphis_beschleuniger" \
      org.opencontainers.image.description="My beschleuniger image for 2D AI" \
      org.opencontainers.image.version="${APP_REF}" \
      org.kataglyphis.build-type="${BUILD_TYPE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.authors="Jonas Heinle <jonasheinle@googlemail.com>" \
      org.opencontainers.image.url="https://github.com/Kataglyphis/ANTfrastructure" \
      org.opencontainers.image.source="https://github.com/Kataglyphis/ANTfrastructure" \
      org.opencontainers.image.licenses="MIT"
